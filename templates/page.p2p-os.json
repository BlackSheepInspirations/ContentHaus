        "faq-1": { "type": "faq", "settings": { "q": "Where do I start?", "a": "<p>Right here. Work top to bottom down the sidebar — each step builds on the last, from finding your direction all the way to launching with ROOTED.</p>" } },
        "faq-2": { "type": "faq", "settings": { "q": "What if I only have one Haus?", "a": "<p>You'll still see everything here. What you own is unlocked; the rest shows a lock with a way to add it whenever you're ready.</p>" } },
        "faq-3": { "type": "faq", "settings": { "q": "I'm not techy — is that okay?", "a": "<p>Completely. This home base was built for exactly that. One step at a time, plain language, and your Haus Mates are here to help.</p>" } },
        "faq-4": { "type": "faq", "settings": { "q": "How do I get better results from the generators?", "a": "<p>Be specific, give an example of what 'good' looks like, and tell it who it's for. Small, clear details beat long vague ones every time.</p>" } },

