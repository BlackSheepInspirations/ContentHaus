{% comment %}
  The AI Creator's Project Haus — main tool section.
  Gated on customer.tags contains "product-haus-access" (added by its own
  Shopify Flow automation on order paid — separate product/tag from
  Prompt Haus's and Marketing Haus's own access control, so all three are
  independently purchasable). request.design_mode bypasses the gate inside
  the theme editor only.
{% endcomment %}

{% assign ch_has_access = false %}
{% if customer and customer.tags contains section.settings.access_tag %}
  {% assign ch_has_access = true %}
{% endif %}
{% if request.design_mode %}
  {% assign ch_has_access = true %}
{% endif %}

{{ 'product-haus.css' | asset_url | stylesheet_tag }}

{% comment %}
  Rendered as a sibling of #product-haus-app, never inside it — the JS
  does root.innerHTML = "" on every re-render.
{% endcomment %}
<div class="pdh-brand-header">
  <div class="pdh-marketing__hero">
    <p class="pdh-marketing__eyebrow">{{ section.settings.brand_eyebrow }}</p>
    <h1 class="pdh-marketing__heading">{{ section.settings.brand_heading | replace: 'Product', '<span class="pdh-heading-accent">Product</span>' }}</h1>
    <div class="pdh-marketing__subheading">{{ section.settings.brand_subheading }}</div>
  </div>
</div>

{% if ch_has_access %}
  <div id="product-haus-app" data-section-id="{{ section.id }}"></div>

  <script src="{{ 'product-haus-util.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'product-haus-engine.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'product-haus-favorites.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'product-haus-styledna.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'product-haus-brandkit.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'product-haus-looklock.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'product-haus-invitations.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'product-haus-stationery.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'product-haus-devotional.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'product-haus-generators.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'product-haus-generators-coloringpage.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'product-haus-generators-plannerpages.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'product-haus-generators-junkjournal.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'product-haus-generators-notebookcover.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'product-haus-generators-journalpages.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'product-haus-generators-kidsworksheet.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'product-haus-generators-wallart.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'product-haus-generators-quotewallart.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'product-haus-generators-coloringbook.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'product-haus-generators-activitybook.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'product-haus-generators-adultcoloring.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'product-haus-generators-learningcards.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'product-haus-generators-stickers.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'product-haus-generators-prayercards.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'product-haus-generators-devotionalpages.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'product-haus-generators-ebookpages.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'product-haus-checklists-eventchecklist.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'product-haus-generators-eventchecklist.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'product-haus-checklists-vendorchecklist.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'product-haus-generators-vendorchecklist.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'product-haus-ui.js' | asset_url }}" defer="defer"></script>
{% else %}
  <div class="pdh-locked">
    <h2 class="pdh-locked__heading">{{ section.settings.locked_heading | replace: 'Product', '<span class="pdh-heading-accent">Product</span>' }}</h2>
    <div class="pdh-locked__body">{{ section.settings.locked_body }}</div>
    <div class="pdh-locked__actions">
      {% if section.settings.access_product %}
        <a href="{{ section.settings.access_product.url }}" class="pdh-btn pdh-btn--copy">
          Get Access{% if section.settings.access_product.price %} — {{ section.settings.access_product.price | money }}{% endif %}
        </a>
      {% endif %}
      {% if section.settings.learn_more_url != blank %}
        <a href="{{ section.settings.learn_more_url }}" class="pdh-btn pdh-btn--reset pdh-locked__learn-more">Learn more</a>
      {% endif %}
    </div>
  </div>
{% endif %}

{% render 'haus-links', current: 'product-haus' %}

{% schema %}
{
  "name": "Project Haus Builder",
  "settings": [
    {
      "type": "text",
      "id": "brand_eyebrow",
      "label": "Eyebrow text",
      "default": "Black Sheep Creations & Inspirations"
    },
    {
      "type": "text",
      "id": "brand_heading",
      "label": "Heading",
      "default": "The Project Haus"
    },
    {
      "type": "textarea",
      "id": "brand_subheading",
      "label": "Subheading",
      "default": "Create the sellable digital products around your brand — invitations, devotional cards, and more. Customized your way."
    },
    {
      "type": "text",
      "id": "access_tag",
      "label": "Access tag",
      "default": "product-haus-access",
      "info": "Customer tag that unlocks the tool. Must match the tag your Shopify Flow automation adds on purchase."
    },
    {
      "type": "product",
      "id": "access_product",
      "label": "Access product",
      "info": "Shown as the \"Get Access\" button for shoppers who don't have the tag yet."
    },
    {
      "type": "url",
      "id": "learn_more_url",
      "label": "Learn more link",
      "info": "e.g. link to your Project Haus marketing page."
    },
    {
      "type": "text",
      "id": "locked_heading",
      "label": "Locked state heading",
      "default": "Unlock The Project Haus"
    },
    {
      "type": "richtext",
      "id": "locked_body",
      "label": "Locked state body",
      "default": "<p>Get instant access to the Invitations & Stationery Studio and the Devotional & Motivation Card Studio — create sellable digital products around your brand, ready to design and list.</p>"
    }
  ],
  "presets": [
    {
      "name": "Project Haus Builder"
    }
  ]
}
{% endschema %}
