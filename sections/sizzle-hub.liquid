#p2psz .node.hit span {animation:litnode .55s 2.45s both}
@keyframes litnode{to{color:#06120e;background:linear-gradient(135deg,#c9f5ea,var(--mint));font-weight:800;box-shadow:0 0 22px rgba(143,240,224,.7);transform:translate(-50%,-50%) scale(1.28)}}
#p2psz .sweep {position:absolute;left:50%;top:50%;width:13px;height:13px;margin:-6.5px;border-radius:50%;background:var(--mint);box-shadow:0 0 18px var(--mint),0 0 6px #fff;animation:sweepspin 2.6s cubic-bezier(.12,.7,.15,1) forwards}
@keyframes sweepspin{from{transform:rotate(0deg) translateY(-110px)}to{transform:rotate(var(--fr)) translateY(-110px)}}
#p2psz .a11 {font-size:11px;color:var(--mut);letter-spacing:.12em;text-transform:uppercase;margin-top:6px}
#p2psz .facets {display:grid;grid-template-columns:1fr 1fr;gap:10px}
#p2psz .facet {background:rgba(255,255,255,.06);border:1px solid rgba(143,240,224,.25);border-radius:14px;padding:15px 10px;font-weight:700;font-size:14px;color:var(--cream);animation:pop .4s both}
#p2psz .facet:nth-child(2) {animation-delay:.1s}
#p2psz .facet:nth-child(3) {animation-delay:.2s}
#p2psz .facet:nth-child(4) {animation-delay:.3s}
#p2psz /* brand dna real wheel */
  .dnaw {position:relative;width:330px;max-width:92%;aspect-ratio:1;display:grid;place-items:center;animation:fadein .5s both}
#p2psz .dnaimg {width:100%;height:100%;border-radius:50%;box-shadow:0 12px 34px rgba(0,0,0,.5)}
#p2psz .dnapin {position:absolute;left:50%;top:50%;width:20px;height:20px;margin:-10px;border-radius:50%;background:var(--mint);box-shadow:0 0 22px var(--mint),0 0 8px #fff;z-index:3;animation:pinspin 2.6s cubic-bezier(.12,.7,.15,1) forwards}
@keyframes pinspin{from{transform:rotate(0deg) translateY(-144px)}to{transform:rotate(var(--fr)) translateY(-144px)}}
#p2psz /* niche lanes */
  .lanes {display:flex;gap:9px;height:54%;width:100%;align-items:stretch;animation:fadein .4s both}
#p2psz .lane {flex:1;border-radius:16px;background:rgba(255,255,255,.05);border:1px dashed rgba(255,255,255,.16);display:flex;flex-direction:column;align-items:center;justify-content:flex-end;gap:6px;padding:14px 5px;animation:rise .4s both}
#p2psz .lane b {font-size:11px;font-weight:700;color:var(--mut);text-align:center;line-height:1.2}
#p2psz .lane i {font-style:normal;font-size:20px;color:var(--mint)}
#p2psz .lane.you {background:linear-gradient(180deg,rgba(143,240,224,.16),rgba(232,201,121,.08));border:1.5px solid var(--mint);box-shadow:0 0 28px rgba(143,240,224,.35)}
#p2psz .lane.you b {color:#fff;font-weight:800}
#p2psz .lane.you i {animation:nudgeup 1.2s ease-in-out infinite}
@keyframes nudgeup{50%{transform:translateY(-6px)}}
#p2psz .rhyme {font-size:clamp(34px,10.5cqw,58px);font-weight:900;letter-spacing:-.02em;line-height:1;animation:slamBig .45s both}
#p2psz /* frank & ruth / flock / tabs / thrive */
  .faces {display:flex;gap:16px;justify-content:center}
#p2psz .face {display:flex;flex-direction:column;align-items:center;gap:7px}
#p2psz .face img {width:118px;height:118px;border-radius:50%;box-shadow:0 8px 22px rgba(0,0,0,.45);border:2px solid rgba(143,240,224,.4)}
#p2psz .face .fn {font-size:17px;font-weight:800;color:var(--cream)}
#p2psz .face .fr {font-size:11px;color:var(--mut);letter-spacing:.03em}
#p2psz .face--l img {animation:flyL .7s cubic-bezier(.16,.9,.3,1) both}
#p2psz .face--r img {animation:flyR .7s .12s cubic-bezier(.16,.9,.3,1) both}
#p2psz .flock {display:grid;grid-template-columns:repeat(6,1fr);gap:12px;width:78%}
#p2psz .flock i {aspect-ratio:1;border-radius:50%;background:rgba(255,255,255,.2);animation:pop .3s both}
#p2psz .flock i.black {background:radial-gradient(circle at 40% 35%,#2b3140,#05070d);border:1.5px solid var(--mint);box-shadow:0 0 22px rgba(143,240,224,.6);transform:scale(1.28)}
#p2psz .tabchips {display:flex;flex-wrap:wrap;gap:8px;justify-content:center;max-width:330px}
#p2psz .tabchip {background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.14);border-radius:10px;padding:8px 11px;font-size:12px;font-weight:600;color:var(--mut);animation:pop .35s both}
#p2psz .tico {font-size:clamp(46px,14cqw,74px);line-height:1;animation:pop .5s both}
#p2psz .checkbadge {display:inline-flex;align-items:center;gap:6px;background:rgba(143,240,224,.12);border:1px solid rgba(143,240,224,.42);color:var(--mint);font-weight:800;font-size:12px;letter-spacing:.16em;text-transform:uppercase;padding:8px 16px;border-radius:30px;margin-bottom:6px;animation:rise .5s both}
#p2psz /* progress + play */
  .prog {position:absolute;left:0;bottom:0;height:4px;width:100%;background:rgba(255,255,255,.08);z-index:5}
#p2psz .prog i {display:block;height:100%;width:0;background:linear-gradient(90deg,var(--mint),var(--gold))}
#p2psz .playbtn {position:absolute;inset:0;z-index:6;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:10px;
    background:rgba(4,7,13,.55);backdrop-filter:blur(3px);border:0;color:#fff;cursor:pointer;font-family:inherit}
#p2psz .playbtn span {width:72px;height:72px;border-radius:50%;display:grid;place-items:center;font-size:25px;padding-left:5px;
    background:linear-gradient(135deg,#c9f5ea,var(--mint));color:#06120e;box-shadow:0 10px 30px rgba(143,240,224,.4)}
#p2psz .playbtn b {font-size:15px;font-weight:800;letter-spacing:.02em}
#p2psz .playbtn em {font-size:12.5px;color:var(--mint);font-style:normal;letter-spacing:.1em;text-transform:uppercase}
#p2psz .playbtn.hide {display:none}
#p2psz /* panel */
  .playrow {display:flex;gap:16px;align-items:flex-start;justify-content:center;flex-wrap:wrap;width:100%}
#p2psz .scriptbox {width:min(360px,92vw);height:min(760px,calc(42vh*16/9));min-height:340px;display:flex;flex-direction:column;background:#0b1424;border:1px solid rgba(143,240,224,.2);border-radius:20px;overflow:hidden;box-shadow:0 20px 50px rgba(0,0,0,.4)}
#p2psz .sb-head {display:flex;align-items:center;justify-content:space-between;gap:10px;padding:14px 16px;border-bottom:1px solid rgba(255,255,255,.08);flex:0 0 auto}
#p2psz .sb-title {color:var(--gold);font-size:14px;font-weight:800}
#p2psz .sb-copy {font-family:inherit;font-size:12.5px;font-weight:800;color:#06120e;background:linear-gradient(135deg,#c9f5ea,var(--mint));border:0;border-radius:24px;padding:8px 14px;cursor:pointer;white-space:nowrap}
#p2psz .sb-copy.done {background:var(--gold)}
#p2psz .sb-charcount {font-size:11px;font-weight:700;color:var(--mut)}
#p2psz .sb-tabs {display:flex;flex-wrap:wrap;gap:4px;padding:8px 10px;border-bottom:1px solid rgba(255,255,255,.08);flex:0 0 auto}
#p2psz .sb-tab {font-family:inherit;font-size:11px;font-weight:800;color:var(--mut);background:rgba(255,255,255,.05);border:1px solid rgba(255,255,255,.1);border-radius:20px;padding:5px 10px;cursor:pointer;transition:all .14s}
#p2psz .sb-tab:hover {color:var(--cream);border-color:rgba(143,240,224,.4)}
#p2psz .sb-tab.active {color:#06120e;background:linear-gradient(135deg,#c9f5ea,var(--mint));border-color:transparent}
#p2psz .sb-tab .sb-tdot {display:inline-block;width:6px;height:6px;border-radius:50%;background:var(--mint2);margin-left:4px;vertical-align:middle;opacity:0}
#p2psz .sb-tab.done .sb-tdot {opacity:1}
#p2psz .sb-text {margin:0;padding:14px 16px;overflow:auto;white-space:pre-wrap;word-break:break-word;font-family:inherit;font-size:13px;line-height:1.55;color:#dbe6f0;flex:1;background:transparent;border:0;resize:none;width:100%}
#p2psz .sb-text:focus {outline:none;box-shadow:inset 0 0 0 2px rgba(143,240,224,.25)}
#p2psz .sb-actions {display:flex;align-items:center;gap:10px;padding:10px 14px;border-top:1px solid rgba(255,255,255,.08);flex:0 0 auto}
#p2psz .sb-copy {font-family:inherit;font-size:12.5px;font-weight:800;color:#06120e;background:linear-gradient(135deg,#c9f5ea,var(--mint));border:0;border-radius:24px;padding:9px 16px;cursor:pointer;white-space:nowrap}
#p2psz .sb-copy.done {background:var(--gold)}
#p2psz .sb-editnote {font-size:10.5px;color:var(--mut);font-style:italic}
#p2psz .sb-posted {display:flex;align-items:center;gap:8px;padding:0 14px 12px;flex:0 0 auto;flex-wrap:wrap}
#p2psz .sb-plabel {font-size:11px;font-weight:800;color:var(--mut);letter-spacing:.04em}
#p2psz .sb-dots {display:flex;gap:5px;flex-wrap:wrap}
#p2psz .pdot {font-family:inherit;font-size:10px;font-weight:800;color:var(--mut);background:rgba(255,255,255,.05);border:1px solid rgba(255,255,255,.12);border-radius:14px;padding:4px 8px;cursor:pointer;transition:all .14s}
#p2psz .pdot:hover {border-color:rgba(143,240,224,.4)}
#p2psz .pdot.on {color:#06120e;background:var(--mint2);border-color:transparent}
#p2psz /* studio toolbar */
  .studiobar {display:flex;align-items:center;gap:10px;flex-wrap:wrap;justify-content:center;width:100%;max-width:960px;background:#0b1424;border:1px solid rgba(143,240,224,.18);border-radius:16px;padding:10px 14px}
#p2psz .search {flex:1;min-width:180px;background:rgba(0,0,0,.32);border:1px solid rgba(255,255,255,.12);border-radius:24px;padding:9px 15px;color:#fff;font-family:inherit;font-size:13px}
#p2psz .search::placeholder {color:#6b7f90}
#p2psz .search:focus {outline:none;border-color:var(--mint)}
#p2psz .filters {display:flex;gap:4px}
#p2psz .fchip {font-family:inherit;font-size:11.5px;font-weight:800;color:var(--mut);background:rgba(255,255,255,.05);border:1px solid rgba(255,255,255,.12);border-radius:20px;padding:7px 12px;cursor:pointer;transition:all .14s}
#p2psz .fchip:hover {color:var(--cream)}
#p2psz .fchip.active {color:#06120e;background:linear-gradient(135deg,#c9f5ea,var(--mint));border-color:transparent}
#p2psz .surprise {font-family:inherit;font-size:12px;font-weight:800;color:var(--cream);background:linear-gradient(135deg,var(--violet),var(--grape));border:0;border-radius:20px;padding:8px 14px;cursor:pointer;white-space:nowrap}
#p2psz .surprise:hover {filter:brightness(1.1)}
#p2psz .progress {font-size:12px;font-weight:800;color:var(--gold);white-space:nowrap;padding:0 4px}
#p2psz .reel.posted::after {content:"✓";color:var(--mint2);font-weight:900;margin-left:auto;font-size:12px}
#p2psz .reel.hide, #p2psz .reelacc.hide {display:none}
#p2psz .tools {display:flex;gap:6px;flex-wrap:wrap;justify-content:center}
#p2psz .tool {font-family:inherit;font-size:12px;font-weight:800;color:var(--cream);background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.14);border-radius:20px;padding:8px 13px;cursor:pointer;white-space:nowrap;transition:all .14s}
#p2psz .tool:hover {color:#fff;border-color:rgba(143,240,224,.45);background:rgba(143,240,224,.1)}
#p2psz /* modals */
  .modal {display:none;position:fixed;inset:0;z-index:80;background:rgba(3,6,12,.72);backdrop-filter:blur(4px);align-items:flex-start;justify-content:center;padding:24px 14px;overflow-y:auto}
#p2psz .modal.open {display:flex}
#p2psz .modal-card {width:min(640px,96vw);background:#0b1424;border:1px solid rgba(143,240,224,.25);border-radius:20px;box-shadow:0 30px 80px rgba(0,0,0,.6);padding:20px;margin:auto}
#p2psz .modal-head {display:flex;align-items:center;justify-content:space-between;margin-bottom:12px}
#p2psz .modal-head b {font-size:17px;color:var(--gold)}
#p2psz .modal-x {font-family:inherit;font-size:15px;font-weight:800;color:var(--mut);background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.14);border-radius:50%;width:34px;height:34px;cursor:pointer}
#p2psz .modal-x:hover {color:#fff}
#p2psz .modal-sub, #p2psz .modal-foot {color:var(--mut);font-size:12.5px;line-height:1.5}
#p2psz .modal-foot {margin:14px 0 0;text-align:center}
#p2psz /* calendar */
  .cal-hint {color:var(--cream);font-size:13px;margin:0 0 10px;text-align:center}
#p2psz .cal-nav {display:flex;align-items:center;justify-content:center;gap:16px;margin-bottom:12px}
#p2psz .cal-nav b {font-size:15px;color:var(--text);min-width:150px;text-align:center}
#p2psz .cal-nav button {font-family:inherit;font-size:18px;font-weight:800;color:#06120e;background:linear-gradient(135deg,#c9f5ea,var(--mint));border:0;border-radius:50%;width:34px;height:34px;cursor:pointer}
#p2psz .cal-grid {display:grid;grid-template-columns:repeat(7,1fr);gap:4px}
#p2psz .cal-dow {text-align:center;font-size:10.5px;font-weight:800;color:var(--mut);padding:4px 0;letter-spacing:.04em}
#p2psz .cal-cell {min-height:64px;background:rgba(255,255,255,.03);border:1px solid rgba(255,255,255,.07);border-radius:8px;padding:3px;position:relative;display:flex;flex-direction:column;gap:2px}
#p2psz .cal-cell.empty {background:transparent;border:0}
#p2psz .cal-cell.today {border-color:var(--mint);box-shadow:inset 0 0 0 1px rgba(143,240,224,.4)}
#p2psz .cal-d {font-size:10.5px;font-weight:800;color:var(--mut);padding:1px 3px}
#p2psz .cal-chip {font-size:9.5px;font-weight:700;color:#06120e;background:linear-gradient(135deg,#c9f5ea,var(--mint));border-radius:5px;padding:2px 5px;cursor:pointer;line-height:1.25;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
#p2psz .cal-chip i {font-style:normal;font-weight:900;opacity:.7;margin-right:3px}
#p2psz .cal-add {margin-top:auto;font-family:inherit;font-size:11px;font-weight:800;color:var(--mut);background:rgba(255,255,255,.05);border:1px dashed rgba(255,255,255,.18);border-radius:5px;cursor:pointer;padding:1px 0}
#p2psz .cal-add:hover {color:var(--mint);border-color:var(--mint)}
#p2psz /* new reel form */
  .fld {display:block;font-size:12.5px;font-weight:800;color:var(--cream);margin-bottom:12px}
#p2psz .fld span {font-weight:600;color:var(--mut)}
#p2psz .fld input, #p2psz .fld textarea, #p2psz .vault-add input {width:100%;margin-top:6px;background:rgba(0,0,0,.32);border:1px solid rgba(255,255,255,.14);border-radius:10px;padding:10px 12px;color:#fff;font-family:inherit;font-size:13px;resize:vertical}
#p2psz .fld input:focus, #p2psz .fld textarea:focus, #p2psz .vault-add input:focus {outline:none;border-color:var(--mint)}
#p2psz .nr-err {color:#ffb4b4;font-size:12px;margin:0 0 8px;min-height:14px}
#p2psz .btn-primary {font-family:inherit;font-size:13px;font-weight:800;color:#06120e;background:linear-gradient(135deg,#c9f5ea,var(--mint));border:0;border-radius:24px;padding:11px 20px;cursor:pointer;width:100%}
#p2psz .nr-list {margin-top:14px;display:flex;flex-direction:column;gap:6px}
#p2psz .nr-item {display:flex;align-items:center;justify-content:space-between;gap:8px;background:rgba(255,255,255,.04);border:1px solid rgba(255,255,255,.1);border-radius:8px;padding:8px 12px;font-size:13px;color:var(--cream)}
#p2psz .nr-item button {font-family:inherit;color:#ffb4b4;background:none;border:0;font-size:14px;font-weight:800;cursor:pointer}
#p2psz .muted {color:var(--mut);font-size:12.5px;text-align:center;margin:6px 0}
#p2psz /* vault */
  .vault-add {display:flex;gap:8px;margin-bottom:12px}
#p2psz .vault-add input {margin-top:0}
#p2psz .vault-add button {font-family:inherit;font-size:12.5px;font-weight:800;color:#06120e;background:linear-gradient(135deg,#c9f5ea,var(--mint));border:0;border-radius:20px;padding:0 18px;cursor:pointer;white-space:nowrap}
#p2psz .vault-list {display:flex;flex-direction:column;gap:6px;max-height:52vh;overflow-y:auto}
#p2psz .vault-item {display:flex;align-items:center;justify-content:space-between;gap:10px;background:rgba(255,255,255,.04);border:1px solid rgba(255,255,255,.1);border-radius:10px;padding:9px 13px}
#p2psz .vault-item span {font-size:13px;color:var(--text);line-height:1.4}
#p2psz .vault-btns {display:flex;gap:5px;flex:0 0 auto}
#p2psz .vault-copy, #p2psz .vault-del {font-family:inherit;font-size:12px;font-weight:800;border:0;border-radius:16px;cursor:pointer;padding:6px 10px}
#p2psz .vault-copy {color:#06120e;background:linear-gradient(135deg,#c9f5ea,var(--mint))}
#p2psz .vault-del {color:#ffb4b4;background:rgba(255,255,255,.06)}
#p2psz.rec .modal {display:none!important}
#p2psz .panel {width:100%;max-width:760px;text-align:center}
#p2psz /* record mode: big clean frame, #p2psz everything else hidden */
  .recbar {display:none}
#p2psz .recbar button {font-family:inherit;font-weight:800;font-size:13px;color:#06120e;background:linear-gradient(135deg,#c9f5ea,var(--mint));border:0;border-radius:24px;padding:9px 16px;cursor:pointer}
#p2psz.rec {align-items:center}
#p2psz.rec .recbar {display:flex;gap:10px;position:fixed;top:10px;left:50%;transform:translateX(-50%);z-index:60}
#p2psz.rec .reels, #p2psz.rec .scriptbox, #p2psz.rec .panel, #p2psz.rec .studiobar {display:none}
#p2psz.rec .playrow {justify-content:center;width:100%}
#p2psz.rec .stagewrap {margin-top:8vh}
#p2psz.rec .stage {height:min(84vh,900px);width:auto;max-width:96vw}
#p2psz .reels {display:flex;flex-direction:column;gap:6px;width:min(250px,92vw);flex:0 0 auto;align-self:stretch;max-height:min(80vh,760px);min-height:0;overflow-y:auto;overscroll-behavior:contain;padding-right:4px;scrollbar-width:thin;scrollbar-color:rgba(143,240,224,.4) transparent}
#p2psz .reels::-webkit-scrollbar {width:7px}
#p2psz .reels::-webkit-scrollbar-thumb {background:rgba(143,240,224,.25);border-radius:8px}
#p2psz .reelacc {flex:0 0 auto;border:1px solid rgba(255,255,255,.1);border-radius:12px;background:rgba(255,255,255,.03);overflow:hidden}
#p2psz .reelacc[open] {background:rgba(255,255,255,.05)}
#p2psz .reelsum {cursor:pointer;list-style:none;padding:11px 14px;font-size:12.5px;font-weight:800;letter-spacing:.05em;color:var(--cream);display:flex;align-items:center;gap:8px}
#p2psz .reelsum::-webkit-details-marker {display:none}
#p2psz .reelsum .reelcount {margin-left:auto;color:var(--mut);font-weight:700;font-size:11px}
#p2psz .reelsum::after {content:"▾";color:var(--mut);font-size:11px;transition:transform .2s}
#p2psz .reelacc[open]>.reelsum::after {transform:rotate(180deg)}
#p2psz .reelrow {display:flex;flex-direction:column;gap:4px;padding:2px 8px 10px}
#p2psz .reel {font-family:inherit;font-size:12.5px;font-weight:700;color:var(--mut);background:rgba(255,255,255,.05);
    border:1px solid rgba(255,255,255,.12);border-radius:8px;padding:8px 12px;cursor:pointer;transition:.15s;width:100%;text-align:left;display:flex;align-items:center;gap:6px}
#p2psz .reel.active {color:#06120e;background:linear-gradient(135deg,#c9f5ea,var(--mint));border-color:transparent}
#p2psz .ctrls {display:flex;gap:10px;justify-content:center;margin-bottom:10px}
#p2psz .ctl {font-family:inherit;font-size:14px;font-weight:700;color:#06120e;background:linear-gradient(135deg,#c9f5ea,var(--mint));border:0;border-radius:30px;padding:10px 20px;cursor:pointer}
#p2psz .ctl--ghost {background:transparent;color:var(--mut);border:1px solid rgba(147,167,187,.35)}
#p2psz .ctl--ghost b {color:var(--mint)}
#p2psz .hint {color:var(--mut);font-size:12px;line-height:1.5;max-width:410px;margin:0 auto}
@media(prefers-reduced-motion:reduce){
#p2psz .au {animation:none!important}
#p2psz .stars {animation:none}
}
#p2psz{width:100vw;max-width:100vw;margin-left:calc(50% - 50vw);margin-right:calc(50% - 50vw);overflow-x:hidden}
#p2psz.rec{position:fixed;inset:0;z-index:99999;background:radial-gradient(120% 90% at 50% 0%,#0c1626,#05070d 70%);overflow:auto;padding:6vh 12px 40px;min-height:100dvh}
{%- endstyle -%}

{% schema %}
{
  "name": "P2P Sizzle Hub",
  "settings": [
