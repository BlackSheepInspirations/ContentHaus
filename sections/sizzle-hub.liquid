{%- comment -%}
  P2P Sizzle Hub — the create-once content studio, ported from the standalone artifact.
  Owner-gated (customer tag = access_tag, default "owner"); request.design_mode previews in the editor.
  All CSS scoped under #p2psz; images served from theme assets (haus-emblem-*.png).
  Assign this section's template (page.sizzle-hub) to the /p2p-sizzle-reels page.
{%- endcomment -%}
{%- assign sz_ok = false -%}
{%- if customer and customer.tags contains section.settings.access_tag -%}{%- assign sz_ok = true -%}{%- endif -%}
{%- if request.design_mode -%}{%- assign sz_ok = true -%}{%- endif -%}

{%- if sz_ok -%}
<div id="p2psz">
<div class="wrap">
  <div class="recbar" id="recbar"><button id="recReplay">↻ Replay</button><button id="exitRec">✕ Exit record mode</button></div>

  <div class="studiobar" id="studiobar">
    <input id="search" class="search" type="text" placeholder="🔎 Search reels…" aria-label="Search reels">
    <div class="filters" id="filters">
      <button class="fchip active" data-f="all">All</button>
      <button class="fchip" data-f="todo">To post</button>
      <button class="fchip" data-f="done">Posted</button>
    </div>
    <div class="tools">
      <button class="surprise" id="surprise">🎲 What should I post?</button>
      <button class="tool" id="calBtn">📅 Calendar</button>
      <button class="tool" id="newBtn">✎ New reel</button>
      <button class="tool" id="vaultBtn">💬 One-liners</button>
    </div>
    <div class="progress" id="progress">Posted 0 / 0</div>
  </div>

  <div class="playrow">
  <div class="reels" id="reels"></div>
  <div class="stagewrap">
    <div class="stage" id="stage">
      <div class="aurora">
        <span class="au a1"></span><span class="au a2"></span>
        <span class="au a3"></span><span class="au a4"></span>
        <div class="stars"></div><div class="vign"></div>
      </div>
      <div class="scenes" id="scenes"></div>
      <div class="prog"><i id="progBar"></i></div>
      <button class="playbtn" id="playbtn"><span>▶</span><b>Play</b><em id="playLabel">The Stack</em></button>
    </div>
  </div>
    <aside class="scriptbox">
      <div class="sb-head"><b class="sb-title" id="sbTitle">The Stack</b><span class="sb-charcount" id="charCount"></span></div>
      <div class="sb-tabs" id="sbTabs"></div>
      <textarea class="sb-text" id="sbText" spellcheck="false"></textarea>
      <div class="sb-actions">
        <button class="sb-copy" id="copyBtn">⧉ Copy for <b id="copyPlat">TikTok</b></button>
        <span class="sb-editnote">✎ tweak before copying</span>
      </div>
      <div class="sb-posted"><span class="sb-plabel">Mark posted →</span><div class="sb-dots" id="sbDots"></div></div>
    </aside>
  </div>

  <div class="panel">
    <div class="ctrls">
      <button class="ctl" id="replay">↻ Replay</button>
      <button class="ctl" id="recBtn">⛶ Record mode</button>
      <button class="ctl ctl--ghost" id="speed">Speed: <b id="speedState">1.35×</b></button>
      <button class="ctl ctl--ghost" id="loop">Loop: <b id="loopState">off</b></button>
    </div>
    <p class="hint">Pick a reel → <b>Play</b> → screen-record just the tall frame (9:16). These controls sit outside the frame, so they won't appear in your capture. Feature scenes are stylized — splice in real OS clips in CapCut for extra punch.</p>
  </div>

  <!-- ===== Calendar modal ===== -->
  <div class="modal" id="modalCal">
    <div class="modal-card">
      <div class="modal-head"><b>📅 Content Calendar</b><button class="modal-x">✕</button></div>
      <p class="cal-hint" id="calHint"></p>
      <div class="cal-nav"><button id="calPrev">‹</button><b id="calTitle"></b><button id="calNext">›</button></div>
      <div class="cal-grid" id="calGrid"></div>
      <p class="modal-foot">Plans are saved in this browser. Click a chip to remove it.</p>
    </div>
  </div>

  <!-- ===== New reel modal ===== -->
  <div class="modal" id="modalNew">
    <div class="modal-card">
      <div class="modal-head"><b>✎ Create your own reel</b><button class="modal-x">✕</button></div>
      <label class="fld">Title <span>(shows in the menu)</span>
        <input id="nrLabel" type="text" placeholder="e.g. Stop waiting">
      </label>
      <label class="fld">Beats <span>(one line = one screen; first line is your hook)</span>
        <textarea id="nrBeats" rows="6" placeholder="Your idea isn't the problem.&#10;Your silence is.&#10;Post the thing."></textarea>
      </label>
      <p class="nr-err" id="nrErr"></p>
      <button class="btn-primary" id="saveReel">＋ Add reel</button>
      <div class="nr-list" id="nrList"></div>
      <p class="modal-foot">Custom reels get their own platform caption packs and posted tracking, just like the built-ins.</p>
    </div>
  </div>

  <!-- ===== One-liner vault modal ===== -->
  <div class="modal" id="modalVault">
    <div class="modal-card">
      <div class="modal-head"><b>💬 One-liner vault</b><button class="modal-x">✕</button></div>
      <p class="modal-sub">Quick, brand-voice lines for hooks, captions, and on-screen text. Tap ⧉ to copy.</p>
      <div class="vault-add"><input id="vaultInput" type="text" placeholder="Add your own one-liner…"><button id="vaultAdd">Add</button></div>
      <div class="vault-list" id="vaultList"></div>
    </div>
  </div>
</div>
</div>
<script>window.P2PSZ_EMB = {
    "content": "{{ 'haus-emblem-content.png' | asset_url }}",
    "marketing": "{{ 'haus-emblem-marketing.png' | asset_url }}",
    "graphics": "{{ 'haus-emblem-graphics.png' | asset_url }}",
    "project": "{{ 'haus-emblem-project.png' | asset_url }}",
    "brand": "{{ 'haus-emblem-brand.png' | asset_url }}",
    "growth": "{{ 'haus-emblem-growth.png' | asset_url }}",
    "p2p": "{{ 'haus-emblem-p2p.png' | asset_url }}",
    "idea": "{{ 'haus-emblem-idea.png' | asset_url }}",
    "build": "{{ 'haus-emblem-build.png' | asset_url }}",
    "bscfull": "{{ 'haus-emblem-bscfull.png' | asset_url }}",
    "treecolor": "{{ 'haus-emblem-treecolor.png' | asset_url }}",
    "treegrey": "{{ 'haus-emblem-treegrey.png' | asset_url }}",
    "dnawheel": "{{ 'haus-emblem-dnawheel.png' | asset_url }}",
    "frank": "{{ 'haus-emblem-frank.png' | asset_url }}",
    "ruth": "{{ 'haus-emblem-ruth.png' | asset_url }}"
  };</script>
<script>

  const EMB = window.P2PSZ_EMB || {};
  const ROOT=document.getElementById('p2psz');
  const $=s=>ROOT.querySelector(s);
  const scenes=$('#scenes'), stage=$('#stage');
  function render(html){ scenes.innerHTML='<div class="card">'+html+'</div>'; runCounters(); }
  function runCounters(){
    scenes.querySelectorAll('[data-to]').forEach(el=>{
      const to=+el.dataset.to, pre=el.dataset.pre||'', suf=el.dataset.suf||''; let t0=null;
      const step=ts=>{ if(!t0)t0=ts; const p=Math.min((ts-t0)/1100,1); const v=Math.round(to*(0.2+0.8*p)*(p<1?1:1)*(p));
        el.textContent=pre+ (Math.round(to*p)).toLocaleString() +suf; if(p<1)requestAnimationFrame(step); else el.textContent=pre+to.toLocaleString()+suf; };
      requestAnimationFrame(step);
    });
  }
  // reusable card builders
  const cta = ()=>`<img class="ctaEmb" src="${EMB.p2p}"><p class="ctaName">PURPOSE 2 PROFIT</p><p class="ctaSub">Comment <b style="color:var(--mint)">“FLOCK”</b> to get in ⬇︎</p><div class="ctaBtn">💬 Comment “FLOCK”</div><p class="bscby">an original by</p><img class="bscfull" src="${EMB.bscfull}" alt="Black Sheep Creations & Inspirations">`;
  // fast product scroll (idea overload)
  function productScroll(){
    const items=[['👕','Tees'],['☕','Mugs'],['📓','Planners'],['🔖','Stickers'],['🥤','Tumblers'],['🖼️','Posters'],['🧢','Hats'],['📔','Journals'],['🎨','Clipart'],['📱','Phone cases'],['🖍️','Coloring books'],['🧥','Hoodies'],['📝','Templates'],['🎒','Totes'],['🗓️','Calendars'],['📄','Printables'],['🛏️','Blankets'],['📖','eBooks'],['🔮','Wall art'],['💌','Cards']];
    const dup=a=>[...a,...a].map(([e,l])=>`<div class="pcard"><span>${e}</span><b>${l}</b></div>`).join('');
    const h=Math.ceil(items.length/2);
    return `<div class="pscroll"><div class="ptrack up">${dup(items.slice(0,h))}</div><div class="ptrack dn">${dup(items.slice(h))}</div></div><div class="pscrim"></div>`;
  }
  const title=(k,b,s)=>`${k?`<p class="kick">${k}</p>`:''}<p class="big">${b}</p>${s?`<p class="sub">${s}</p>`:''}`;
  const lead=t=>`<p class="lead">${t}</p>`;
  const emb=(key,word)=>`<img class="embC" src="${EMB[key]}"><div class="word">${word}</div>`;
  // framework letter cards
  function acro(a,i){return '<div class="acro">'+a.map((l,k)=>k===i?`<b>${l}</b>`:`<span style="opacity:.5">${l}</span>`).join('<em>·</em>')+'</div>';}
  const letter=(L,w,o,arr,i)=>`${acro(arr,i)}<div class="letter">${L}</div><div class="lword">${w}</div><p class="lone">${o}</p>`;
  const waves=()=>`<div class="waves"><svg viewBox="0 0 400 60" preserveAspectRatio="none"><path d="M0,30 C50,12 110,48 200,30 S350,12 400,30 V60 H0 Z" fill="rgba(143,240,224,.16)"/></svg></div>`;
  const RAFTA=['R','A','F','T'],GA=['G','R','O','W','S'],RO=['R','O','O','T','E','D'];
  // brand dna archetype wheel (real UI image + orbiting pointer honing in on Trail-Forger, bottom)
  function wheel(){
    const fr=360*3 + 180; // land at the bottom segment (Trail Forger)
    return `<div class="dnaw"><img class="dnaimg" src="${EMB.dnawheel}" alt="Brand DNA wheel"><div class="dnapin" style="--fr:${fr}deg"></div></div>`;
  }
  // niche lanes
  function lanes(){
    const L=[['Too broad',0],['Too crowded',0],['Not you',0],['Your lane',1]];
    return '<div class="lanes">'+L.map(([l,you],i)=>`<div class="lane${you?' you':''}" style="animation-delay:${i*0.1}s"><b>${l}</b>${you?'<i>↑</i>':''}</div>`).join('')+'</div>';
  }
  function flock(){ let h='<div class="flock">'; for(let i=0;i<24;i++){h+=`<i class="${i===14?'black':''}" style="animation-delay:${(i*0.03).toFixed(2)}s"></i>`;} return h+'</div>'; }
  function tabchips(){ const t=['ChatGPT','Canva','Midjourney','Notion','CapCut','Buffer','Google Docs','Later','Pinterest','Etsy','Printify','+ 6 more']; return '<div class="tabchips">'+t.map((x,i)=>`<span class="tabchip" style="animation-delay:${(i*0.05).toFixed(2)}s">${x}</span>`).join('')+'</div>'; }

  const AV=[['#8ff0e0','A'],['#e8c979','M'],['#9b6cff','J'],['#34e0a1','K'],['#f4a8c0','S'],['#7cc6ff','D'],['#c9f5ea','R'],['#ffd27c','T']];
  function bubbles(){ let h='<div class="bubbles">';
    const pos=[[10,10],[62,4],[38,30],[80,34],[6,50],[50,56],[30,68],[74,66]];
    pos.forEach((p,i)=>{const[c,l]=AV[i];h+=`<span class="bub" style="left:${p[0]}%;top:${p[1]}%;background:linear-gradient(135deg,${c},#fff);animation-delay:${i*0.12}s">${l}</span>`;});
    return h+'</div>'; }

  const jpath='M20,40 C90,10 60,110 130,90 S180,150 250,120 S320,80 360,140';
  function journey(){
    const nodes=[[20,40,'START'],[130,90,'MINDSET'],[250,120,'BUILD'],[360,140,'LAUNCH']];
    let n='';nodes.forEach((nd,i)=>{n+=`<g class="jnode" style="animation-delay:${1+i*0.45}s"><circle cx="${nd[0]}" cy="${nd[1]}" r="9" fill="#8ff0e0"/><circle cx="${nd[0]}" cy="${nd[1]}" r="15" fill="none" stroke="#8ff0e0" stroke-opacity=".4"/></g>`;});
    return `<svg class="jsvg" viewBox="0 0 380 170"><defs><linearGradient id="jg" x1="0" x2="1"><stop offset="0" stop-color="#9b6cff"/><stop offset=".5" stop-color="#8ff0e0"/><stop offset="1" stop-color="#e8c979"/></linearGradient></defs><path class="jpath" d="${jpath}"/>${n}</svg>`;
  }
  function ring(){ return `<div style="position:relative;display:grid;place-items:center"><svg class="ring" width="190" height="190"><circle cx="95" cy="95" r="85" fill="none" stroke="rgba(255,255,255,.08)" stroke-width="12"/><circle class="ringfg" cx="95" cy="95" r="85"/></svg><span class="ringlbl">50+</span></div>`; }
  function certificate(){ return `<div class="cert"><div class="seal">🏅</div><div class="ct">CERTIFICATE OF COMPLETION</div><div class="cn">Purpose 2 Profit · Learning Journey</div></div>`; }
  function radar(){
    const cx=95,cy=95,R=78,pts=[[95,20],[168,72],[140,160],[50,160],[22,72]];
    const grid=[1,.66,.33].map(f=>{const p=pts.map(([x,y])=>`${cx+(x-cx)*f},${cy+(y-cy)*f}`).join(' ');return `<polygon class="rgrid" points="${p}"/>`}).join('');
    const poly=[[95,30],[150,80],[128,150],[58,140],[40,78]].map(p=>p.join(',')).join(' ');
    return `<svg class="radar" viewBox="0 0 190 190">${grid}<polygon class="rpoly" points="${poly}"/></svg>`;
  }

  // ===== REELS =====
  const REELS={
    stack:{label:'The Stack',total:22000,steps:[
      [0,()=>render(title('','Everyone’s using the same AI.','Making the same stuff.'))],
      [2600,()=>render(`<img class="embC" src="${EMB.p2p}"><p class="big" style="margin-top:6px">What if you didn’t?</p>`)],
      [5200,()=>render(emb('content','CREATE'))],[6600,()=>render(emb('marketing','MARKET'))],
      [8000,()=>render(emb('graphics','DESIGN'))],[9400,()=>render(emb('project','SHIP'))],
      [10800,()=>render(emb('brand','BRAND'))],[12200,()=>render(emb('growth','LAUNCH'))],
      [13800,()=>render(`<div style="display:flex;gap:12px"><img class="embC mid" style="width:40%" src="${EMB.idea}"><img class="embC mid" style="width:40%" src="${EMB.build}"></div><p class="big sm">Five tools. Two AI partners.<br><span class="mint">One clear path.</span></p>`)],
      [17400,()=>render(`<p class="tag a">BORN AN ORIGINAL.</p><p class="tag two b">DON’T DIE A COPY.</p>`)],
      [20000,()=>render(cta())],
    ]},
    community:{label:'Community',total:16500,steps:[
      [0,()=>render(title('The Haus','Building alone is the hard way.'))],
      [2600,()=>render(`${bubbles()}<p class="big sm">Your flock is <span class="mint">forming.</span></p><p class="chip">🐑 founding members wanted</p>`)],
      [6000,()=>render(`<div class="post"><div class="row"><div class="av">✦</div><div><div class="nm">Share a win</div><div class="tm">this is how it works</div></div></div><div class="bd">“Just made my first sale from a design I built in Graphics Haus 🎉”</div><div class="rx"><span>❤️ React</span><span>💬 Reply</span><span>🔥 Cheer</span></div></div>`)],
      [9600,()=>render(lead('Wins celebrated.<br><b>Questions answered.</b> Daily.'))],
      [12400,()=>render(title('','You + a flock<br>that <span class="mint">gets it.</span>'))],
      [14600,()=>render(cta())],
    ]},
    courses:{label:'Courses & Journey',total:17500,steps:[
      [0,()=>render(title('The Learning Journey','Most courses are a pile of videos you’ll never finish.'))],
      [2800,()=>render(`<p class="kick">A path, not a pile</p>${journey()}<p class="sub">5 realms · idea → launch</p>`)],
      [6600,()=>render(`${ring()}<p class="big sm" style="margin-top:6px">50+ courses.<br><span class="mint">5 realms. One quest.</span></p>`)],
      [10200,()=>render(`${certificate()}<p class="lead" style="margin-top:6px">Finish something. <b>For real.</b></p>`)],
      [13600,()=>render(title('','Learn by doing.<br><span class="gold">Level up for real.</span>'))],
      [15600,()=>render(cta())],
    ]},
    game:{label:'Gamification',total:17500,steps:[
      [0,()=>render(title('Gamified','What if growing your business<br>felt like a <span class="mint">game?</span>'))],
      [2800,()=>render(`<div class="xpwrap"><div class="xplbl"><span>Level up as you build</span><span>XP</span></div><div class="xpbar"><i class="xpfill"></i></div></div><p class="pts">LEVEL UP</p><p class="chip"><span class="flame">🔥</span> Build a daily streak</p>`)],
      [6600,()=>render(`<p class="kick">Badges unlocked</p><div class="badges"><span class="badge">🏅</span><span class="badge" style="animation-delay:.15s">⚡</span><span class="badge" style="animation-delay:.3s">🎯</span><span class="badge" style="animation-delay:.45s">👑</span></div>`)],
      [9800,()=>render(`<div class="rank"><div class="rk">Seeker</div><div class="rk" style="animation-delay:.1s">Builder</div><div class="rk now" style="animation-delay:.25s">Trailblazer <span class="d">▲ rank up!</span></div><div class="rk" style="animation-delay:.4s;opacity:.5">Icon</div></div>`)],
      [13200,()=>render(title('','Points. Streaks.<br><span class="gold">Badges. Ranks.</span>'))],
      [15600,()=>render(cta())],
    ]},
    brand:{label:'Brand Identity',total:17000,steps:[
      [0,()=>render(title('Brand Haus','“Just be yourself.”<br>Cool. <span class="mint">How?</span>'))],
      [2800,()=>render(`<img class="embC" src="${EMB.brand}">`)],
      [5400,()=>render(`<p class="kick">Your Brand DNA</p>${radar()}<p class="sub">Voice · values · vibe · edge</p>`)],
      [9000,()=>render(`<div class="arch"><div class="al">Your archetype, revealed</div><div class="an">The Trail-Forger</div></div><p class="lead" style="margin-top:8px">Clarity, not <b>guesswork.</b></p>`)],
      [12600,()=>render(title('','Your fingerprint.<br><span class="gold">Your brand.</span>'))],
      [15000,()=>render(cta())],
    ]},
    ideas:{label:'Too many ideas',total:15500,steps:[
      [0,()=>render(productScroll())],
      [2700,()=>render(title('','Stuck with <span class="mint">too many ideas?</span>','Digital, POD, printables, merch… and no clue which to build first.'))],
      [5600,()=>render(title('','12 ideas.<br>0 <span class="gold">shipped.</span>'))],
      [7800,()=>render(`<img class="embC" src="${EMB.p2p}"><p class="big sm" style="margin-top:6px">Let’s turn the pile<br>into a <span class="mint">plan.</span></p>`)],
      [11000,()=>render(lead('Pick one. Ship it.<br><b>The Haus shows you how.</b>'))],
      [13500,()=>render(cta())],
    ]},
    raft:{label:'RAFT loop',total:16500,steps:[
      [0,()=>render(`<p class="kick">The weekly loop</p><p class="big">Got an idea…<br>but <span class="mint">lost at sea?</span></p><div class="bob">🛟</div>${waves()}`)],
      [2600,()=>render(letter('R','RELIEVE','Clear your single biggest blocker.',RAFTA,0))],
      [5100,()=>render(letter('A','ACT','One committed action — this week.',RAFTA,1))],
      [7600,()=>render(letter('F','FAST WIN','Ship one thing that didn’t exist before.',RAFTA,2))],
      [10100,()=>render(letter('T','TRACTION','Measure it. Then run it back.',RAFTA,3))],
      [12600,()=>render(title('','Stop drifting.<br><span class="gold">Get on the RAFT.</span>'))],
      [14600,()=>render(cta())],
    ]},
    grows:{label:'GROWS formula',total:18700,steps:[
      [0,()=>render(`<p class="kick">The GROWS formula</p><p class="big">“I’ll figure it out”<br>is <span class="mint">not a plan.</span></p>`)],
      [2400,()=>render(letter('G','GROUND ZERO','Where you actually stand — not where you wish you stood.',GA,0))],
      [4700,()=>render(letter('R','ROADMAP','The ordered steps from here to your vision.',GA,1))],
      [7000,()=>render(letter('O','OWNERSHIP','What YOU ship this week — not “once it’s ready.”',GA,2))],
      [9300,()=>render(letter('W','WINDOW OF TIME','A real deadline. Skip it and the plan drifts.',GA,3))],
      [11600,()=>render(letter('S','SUCCESS VISION','What “done” looks like — clear enough to know you’ve arrived.',GA,4))],
      [13900,()=>render(`<p class="kick">The formula</p><p class="formula"><span class="mint">(G + R)</span><span class="op">×</span>O<span class="op">×</span>W<span class="op">=</span><span class="s">S</span></p><p class="sub">A plan you’ll actually finish.</p>`)],
      [16700,()=>render(cta())],
    ]},
    rooted:{label:'ROOTED method',total:21000,steps:[
      [0,()=>render(`<p class="kick">The ROOTED method · Growth Haus</p><p class="big">You’re ready.<br>So why aren’t you <span class="mint">launched?</span></p>`)],
      [2400,()=>render(`<img class="embC" src="${EMB.growth}">`)],
      [4600,()=>render(letter('R','REACH','Warm up the right audience before you sell.',RO,0))],
      [6700,()=>render(letter('O','OPEN','Open the loops — build anticipation.',RO,1))],
      [8800,()=>render(letter('O','OFFER','Show the transformation, then the offer.',RO,2))],
      [10900,()=>render(letter('T','TRIGGER','Give them a reason to decide now.',RO,3))],
      [13000,()=>render(letter('E','ESCALATE','Raise the stakes as the window closes.',RO,4))],
      [15100,()=>render(letter('D','DEEPEN','Turn buyers into believers.',RO,5))],
      [17200,()=>render(title('','From ready<br><span class="gold">→ launched.</span>'))],
      [19200,()=>render(cta())],
    ]},
    brandtree:{label:'You are the brand',total:14200,steps:[
      [0,()=>render(title('Brand Haus','You don’t <span class="mint">have</span> a brand.'))],
      [2200,()=>render(`<img class="tree" src="${EMB.treecolor}"><p class="treecap">You <span class="gold">are</span> the brand.</p>`)],
      [5200,()=>render(lead('Your fingerprint. Your roots.<br><b>Your mark.</b>'))],
      [7800,()=>render(title('','No one else<br>has your <span class="mint">print.</span>','That’s the whole advantage.'))],
      [10800,()=>render(`<p class="tag a">BORN AN ORIGINAL.</p>`)],
      [12400,()=>render(cta())],
    ]},
    purpose:{label:'Your purpose',total:16200,steps:[
      [0,()=>render(`<div class="treewrap"><img class="tree" src="${EMB.treegrey}"></div><p class="treecap dim">Somewhere, you<br>went <span style="color:#cfd8e2">grey.</span></p>`)],
