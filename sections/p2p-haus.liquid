                  <option value="gemini">Gemini</option>
                  <option value="canva">Canva</option>
                  <option value="kittl">Kittl</option>
                  <option value="runway">Runway</option>
                  <option value="kling">Kling</option>
                  <option value="veo">Veo</option>
                  <option value="sora">Sora</option>
                  <option value="other">Other</option>
                </select>
              </div>

              <div class="field-group">
                <label for="aiPlatformCustom">
                  Other AI platform
                </label>

                <input
                  id="aiPlatformCustom"
                  name="aiPlatformCustom"
                  type="text"
                  data-field-key="aiPlatformCustom"
                  data-category="delivery"
                >
              </div>

              <div class="field-group">
                <label for="deliveryMode">
                  Prompt delivery mode
                  <span aria-hidden="true">*</span>
                </label>

                <select
                  id="deliveryMode"
                  name="deliveryMode"
                  data-field-key="deliveryMode"
                  data-category="delivery"
                  required
                >
                  <option value="single">
                    One standalone prompt
                  </option>
                  <option value="separate" selected>
                    Separate prompts for selected items
                  </option>
                  <option value="combined">
                    One combined master prompt
                  </option>
                  <option value="both">
                    Separate and combined prompts
                  </option>
                  <option value="hybrid">
                    Hybrid selection
                  </option>
                </select>
              </div>
            </div>

            <div
              id="combinationControls"
              class="combination-controls"
              hidden
            >
              <h3>Prompt Combination Choices</h3>

              <p>
                Choose whether each selected item should be combined,
                kept separate, summarized, or excluded.
              </p>

              <div id="combinationItemList"></div>
            </div>
          </section>

          <!-- INGREDIENT REVIEW -->
          <details
            id="ingredientReviewSection"
            class="form-section form-section--advanced"
          >
            <summary class="advanced-summary">
              <span class="advanced-summary__label">
                <span class="section-number">Optional · Advanced</span>
                <span class="advanced-summary__title">Prompt Ingredient Review</span>
              </span>
              <span class="advanced-summary__chev" aria-hidden="true">+</span>
            </summary>

            <div class="advanced-body">
              <p class="section-description">
                A quick recap of everything you've entered, grouped by area.
              </p>
              <div id="ingredientReview" class="ingredient-review"></div>
            </div>
          </details>

          <!-- VALIDATION -->
          <section
            id="validationSection"
            class="form-section"
            aria-labelledby="validationSectionTitle"
          >
            <div class="section-heading">
              <div>
                <p class="section-number">Review &amp; generate</p>
                <h2 id="validationSectionTitle">
                  Review and Generate
                </h2>
              </div>
            </div>

            <div
              id="validationSummary"
              class="validation-summary"
              role="alert"
              aria-live="assertive"
              tabindex="-1"
            >
              Complete the required fields, then generate your prompts.
            </div>

            <div class="action-row">
              <button
                id="generateBtn"
                type="submit"
              >
                Generate Prompt Options
              </button>

              <button
                id="clearAllBtn"
                type="button"
              >
                Clear All
              </button>
            </div>
          </section>
        </form>

          <aside class="build-rail" aria-label="Build summary">
            <div class="build-rail__pinned">
              <div class="build-rail__card">
                <p class="build-rail__eyebrow">Your pack</p>
                <div id="railReadiness" class="build-rail__readiness"></div>
                <button
                  id="railGenerateBtn"
                  type="button"
                  class="build-rail__generate"
                >
                  Generate my pack
                </button>
                <p
                  id="railStatus"
                  class="build-rail__status"
                  role="status"
                  aria-live="polite"
                ></p>
              </div>
            </div>

            <div class="build-rail__extras">
              <div class="build-rail__card">
              <div id="railBrandKit" class="rail-brandkit" hidden></div>

              <details class="rail-panel">
                <summary class="rail-panel__summary">
                  <span>Your selections</span>
                  <span class="rail-panel__chev" aria-hidden="true">+</span>
                </summary>
                <div id="railSelections" class="rail-panel__body ingredient-review"></div>
              </details>

              <details class="rail-panel">
                <summary class="rail-panel__summary">
                  <span>Your Vault <span id="railVaultCount" class="rail-panel__count">(0)</span></span>
                  <span class="rail-panel__chev" aria-hidden="true">+</span>
                </summary>
                <div id="railVault" class="rail-panel__body"></div>
              </details>

              <details class="rail-panel">
                <summary class="rail-panel__summary">
                  <span>Recently Generated <span id="railRecentCount" class="rail-panel__count">(0)</span></span>
                  <span class="rail-panel__chev" aria-hidden="true">+</span>
                </summary>
                <div id="railRecent" class="rail-panel__body"></div>
              </details>

              <button id="railClearAllBtn" type="button" class="rail-clear-all">
                Clear all &amp; start over
              </button>
              </div>
            </div>
          </aside>
        </div>

        <!-- RESULTS -->
        <section
          id="resultsSection"
          class="form-section"
          aria-labelledby="resultsSectionTitle"
          hidden
        >
          <div class="section-heading">
            <div>
              <p class="section-number">Results</p>
              <h2 id="resultsSectionTitle">
                Generated Prompt Options
              </h2>
            </div>
          </div>

          <p
            id="outputUpdateNotice"
            class="status-message"
            role="status"
            aria-live="polite"
            hidden
          >
            Your inputs changed. Generate again to update the results.
          </p>

          <div id="generatorOptionsOutput">
            <p class="empty-state">
              Generated options will appear here.
            </p>
          </div>

          <div
            id="qualityResult"
            class="quality-result"
            role="status"
            aria-live="polite"
          >
            Quality review has not run yet.
          </div>
        </section>

        <!-- PROMPT ASSEMBLY -->
        <section
          id="promptAssemblySection"
          class="form-section"
          aria-labelledby="promptAssemblyTitle"
          hidden
        >
          <div class="section-heading">
            <div>
              <p class="section-number">Final Step</p>
              <h2 id="promptAssemblyTitle">
                Prompt Assembly
              </h2>
            </div>
          </div>

          <article id="standalonePromptOutput" hidden>
            <div class="output-heading">
              <h3>Standalone Prompt</h3>

              <button
                id="copyStandaloneBtn"
                type="button"
                data-output-target="standalonePromptText"
              >
                Copy
              </button>
            </div>

            <textarea
              id="standalonePromptText"
              rows="18"
              readonly
            ></textarea>
          </article>

          <article id="separatePromptsOutput" hidden>
            <div class="output-heading">
              <h3>Separate Prompts</h3>
            </div>

            <div id="separatePromptList">
              <p class="empty-state">
                Separate prompts will appear here.
              </p>
            </div>
          </article>

          <article id="combinedPromptOutput" hidden>
            <div class="output-heading">
              <h3>Combined Master Prompt</h3>

              <button
                id="copyCombinedBtn"
                type="button"
                data-output-target="combinedPromptText"
              >
                Copy
              </button>
            </div>

            <textarea
              id="combinedPromptText"
              rows="24"
              readonly
            ></textarea>
          </article>

          <article id="hybridPromptOutput" hidden>
            <div class="output-heading">
              <h3>Hybrid Prompt Package</h3>

              <button
                id="copyHybridBtn"
                type="button"
                data-output-target="hybridPromptText"
              >
                Copy
              </button>
            </div>

            <textarea
              id="hybridPromptText"
              rows="24"
              readonly
            ></textarea>
          </article>

          <article>
            <div class="output-heading">
              <h3>Final Prompt Package</h3>

              <button
                id="copyFinalPackageBtn"
                type="button"
                data-output-target="finalPromptPackage"
              >
                Copy Final Package
              </button>

              <button
                id="saveFinalPromptBtn"
                type="button"
              >
                Save to Vault
              </button>

              <button
                id="copyAllBtn"
                type="button"
                class="copy-all-btn"
              >
                📋 Copy Everything
              </button>

              <button
                id="downloadAllBtn"
                type="button"
              >
                Download Everything (.txt)
              </button>

              <button
                id="printKitBtn"
                type="button"
              >
                Print / PDF
              </button>
            </div>

            <textarea
              id="finalPromptPackage"
              rows="28"
              readonly
              aria-label="Final prompt package"
            ></textarea>
          </article>
        </section>

        <!-- PREMIUM OUTPUT MODULES -->
        <section
          id="premiumSection"
          class="form-section premium-section"
          aria-labelledby="premiumTitle"
          hidden
        >
          <div class="section-heading">
            <div>
              <p class="section-number">Bonus modules</p>
              <h2 id="premiumTitle">Premium Output Modules</h2>
            </div>
          </div>

          <p class="section-description">
            Four extra, ready-to-use deliverables built from the same inputs.
            Pick a tab, then copy — each one is complete and paste-ready.
          </p>

          <div class="premium-tabs" role="tablist" aria-label="Premium output modules">
            <button
              type="button"
              class="premium-tab is-active"
              data-premium-tab="adpackage"
              role="tab"
              aria-selected="true"
            >
              Full Ad Package
            </button>
            <button
              type="button"
              class="premium-tab"
              data-premium-tab="launchplan"
              role="tab"
              aria-selected="false"
            >
              The ROOTED Method
            </button>
            <button
              type="button"
              class="premium-tab"
              data-premium-tab="calendar"
              role="tab"
              aria-selected="false"
            >
              30-Day Calendar
            </button>
            <button
              type="button"
              class="premium-tab"
              data-premium-tab="suno"
              role="tab"
              aria-selected="false"
            >
              Suno Music
            </button>
            <button
              type="button"
              class="premium-tab"
              data-premium-tab="video"
              role="tab"
              aria-selected="false"
            >
              Video Script
            </button>
            <button
              type="button"
              class="premium-tab"
              data-premium-tab="voice"
              role="tab"
              aria-selected="false"
            >
              Voiceover Script
            </button>
            <button
              type="button"
              class="premium-tab"
              data-premium-tab="marketing"
              role="tab"
              aria-selected="false"
            >
              Marketing Campaign
            </button>
            <button
              type="button"
              class="premium-tab"
              data-premium-tab="gpt"
              role="tab"
              aria-selected="false"
            >
              Custom GPT Builder
            </button>
            <button
              type="button"
              class="premium-tab"
              data-premium-tab="animate"
              role="tab"
              aria-selected="false"
            >
              Photo Animation
            </button>
          </div>

          <div class="premium-panels">
            <div class="premium-panel is-active" data-premium-panel="adpackage">
              <div class="output-heading">
                <h3>Full Ad Package</h3>
                <button type="button" data-output-target="premiumAdPackageText">
                  Copy
                </button>
              </div>
              <p class="field-note">
                The whole ad in one brief — concept, scene-by-scene visuals with the
                voiceover, a background-music direction, caption, hashtags, and a
                production checklist. Hand it to an editor or follow it yourself.
              </p>
              <textarea
                id="premiumAdPackageText"
                class="premium-output"
                rows="26"
                readonly
                aria-label="Full ad package brief"
              ></textarea>
            </div>

            <div class="premium-panel" data-premium-panel="launchplan" hidden>
              <div class="output-heading">
                <h3>The ROOTED Method &mdash; Launch Plan</h3>
                <button type="button" data-output-target="premiumLaunchPlanText">
                  Copy
                </button>
              </div>
              <p class="field-note">
                Your launch, run on the 6-stage ROOTED Method (Reach, Open, Offer,
                Trigger, Escalate, Deepen) &mdash; sequenced to your kit, with a
                checklist.
              </p>

              <div class="rooted-stages" id="rootedStages"></div>
              <div class="rooted-deepen-toggle" id="rootedDeepenToggle"></div>

              <textarea
                id="premiumLaunchPlanText"
                class="premium-output"
                rows="22"
                readonly
                aria-label="ROOTED Method launch plan"
              ></textarea>

              <div class="rooted-calendar" id="rootedCalendar"></div>
              <div class="rooted-quality" id="rootedQualityCheck"></div>
            </div>

            <div class="premium-panel" data-premium-panel="calendar" hidden>
              <div class="output-heading">
                <h3>30-Day Content Calendar</h3>
                <button type="button" data-output-target="premiumCalendarText">
                  Copy
                </button>
              </div>
              <p class="field-note">
                A month of daily content ideas, themed and rotating — so your feed
                keeps selling long after launch day.
              </p>
              <textarea
                id="premiumCalendarText"
                class="premium-output"
                rows="22"
                readonly
                aria-label="Thirty day content calendar"
              ></textarea>
            </div>

            <div class="premium-panel" data-premium-panel="suno" hidden>
              <div class="output-heading">
                <h3>Suno AI Music Prompt</h3>
                <button type="button" data-output-target="premiumSunoText">
                  Copy
                </button>
              </div>
              <p class="field-note">
                Two options for Suno: a full branded song (with lyrics), and an
                instrumental background track to sit under a video or ad.
              </p>
              <textarea
                id="premiumSunoText"
                class="premium-output"
                rows="20"
                readonly
                aria-label="Suno AI music prompt"
              ></textarea>
            </div>

            <div class="premium-panel" data-premium-panel="video" hidden>
              <div class="output-heading">
                <h3>Video Script Prompt</h3>
                <button type="button" data-output-target="premiumVideoText">
                  Copy
                </button>
              </div>
              <p class="field-note">
                What happens on screen — scene by scene, plus a shot list, caption,
                and hashtags. The spoken words are in the Voiceover Script tab.
              </p>
              <textarea
                id="premiumVideoText"
                class="premium-output"
                rows="20"
                readonly
                aria-label="Video script prompt"
              ></textarea>
            </div>

            <div class="premium-panel" data-premium-panel="voice" hidden>
              <div class="output-heading">
                <h3>Voiceover Script</h3>
                <button type="button" data-output-target="premiumVoiceText">
                  Copy
                </button>
              </div>
              <p class="field-note">
                Just the spoken words, timed to match the video scenes — record it
                yourself or paste into a voice AI (ElevenLabs, Play.ht).
              </p>
              <textarea
                id="premiumVoiceText"
                class="premium-output"
                rows="20"
                readonly
                aria-label="Voiceover script"
              ></textarea>
            </div>

            <div class="premium-panel" data-premium-panel="marketing" hidden>
              <div class="output-heading">
                <h3>Marketing Campaign Prompt</h3>
                <button type="button" data-output-target="premiumMarketingText">
                  Copy
                </button>
              </div>
              <p class="field-note">
                A complete multi-channel campaign prompt — email, social, ad, and
                subject lines — ready to run in any AI.
              </p>
              <textarea
                id="premiumMarketingText"
                class="premium-output"
                rows="20"
                readonly
                aria-label="Marketing campaign prompt"
              ></textarea>
            </div>

            <div class="premium-panel" data-premium-panel="gpt" hidden>
              <div class="output-heading">
                <h3>Custom GPT Builder</h3>
                <button type="button" data-output-target="premiumGptText">
                  Copy
                </button>
              </div>
              <p class="field-note">
                A complete Custom GPT configuration — instructions, knowledge files,
                starters, welcome message, rules, and a testing checklist.
              </p>
              <textarea
                id="premiumGptText"
                class="premium-output"
                rows="24"
                readonly
                aria-label="Custom GPT builder configuration"
              ></textarea>
            </div>

            <div class="premium-panel" data-premium-panel="animate" hidden>
              <div class="output-heading">
                <h3>Photo → Animation &amp; Video</h3>
                <button type="button" data-output-target="premiumAnimateText">
                  Copy
                </button>
              </div>
              <p class="field-note">
                The full photo workflow: a <b>still photo prompt</b> to create your
                product image (text-to-image), then <b>animation</b> and
                <b>hero-video</b> prompts to bring it to life. Want more photo
                options? Add a <b>Lifestyle Image</b>, <b>Product Mockup</b>, or
                <b>Hero Banner</b> generator above.
              </p>
              <textarea
                id="premiumAnimateText"
                class="premium-output"
                rows="22"
                readonly
                aria-label="Photo animation and video prompt"
              ></textarea>
            </div>
          </div>
        </section>
      </main>

      <footer class="site-footer">
        <p>
          Growth Haus — Build clearer prompts and launch
          products faster.
        </p>
      </footer>

      <!-- TOAST -->
      <div
        id="appToast"
        class="toast"
        role="status"
        aria-live="polite"
        aria-atomic="true"
        hidden
      ></div>

      <!-- CONFIRMATION MODAL -->
      <div
        id="confirmationModal"
        class="modal"
        role="dialog"
        aria-modal="true"
        aria-labelledby="modalTitle"
        aria-describedby="modalMessage"
        hidden
      >
        <div class="modal__content">
          <h2 id="modalTitle">Please Confirm</h2>

          <p id="modalMessage">
            Are you sure you want to continue?
          </p>

          <div class="modal__actions">
            <button id="modalConfirmBtn" type="button">
              Confirm
            </button>

            <button id="modalCancelBtn" type="button">
              Cancel
            </button>
          </div>
        </div>
      </div>

      <!-- Back-to-top button removed for Shopify — the theme provides its own. -->
  </div>

  <script src="{{ 'p2p-haus.js' | asset_url }}" defer="defer"></script>
{% else %}
  <div class="p2p-locked">
    <span class="p2p-locked__family">Black Sheep Creations &amp; Inspirations</span>
    <h2 class="p2p-locked__heading">{{ section.settings.locked_heading }}</h2>
    <div class="p2p-locked__body">{{ section.settings.locked_body }}</div>
    <div class="p2p-locked__actions">
      {% if section.settings.access_product %}
        <a href="{{ section.settings.access_product.url }}" class="p2p-locked__btn p2p-locked__btn--get">
          Get the Access Pass{% if section.settings.access_product.price %} — {{ section.settings.access_product.price | money }}{% endif %}
        </a>
      {% endif %}
      {% if section.settings.learn_more_url != blank %}
        <a href="{{ section.settings.learn_more_url }}" class="p2p-locked__btn p2p-locked__btn--learn">See what's inside</a>
      {% endif %}
    </div>
  </div>
{% endif %}

{% render 'haus-links', current: 'p2p-haus' %}

{% schema %}
{
  "name": "Growth Haus",
  "settings": [
    { "type": "header", "content": "Access control" },
    {
      "type": "text",
      "id": "access_tag",
      "label": "Access tag",
      "default": "P2P-haus-access",
      "info": "Customer tag that unlocks the tool (matched case-insensitively). Must match the tag your Shopify Flow adds on purchase."
    },
    {
      "type": "product",
      "id": "access_product",
      "label": "Access Pass product",
      "info": "Shown as the Get Access button for visitors who don't have the tag yet."
    },
    {
      "type": "url",
      "id": "learn_more_url",
      "label": "Preview / learn-more URL",
      "info": "Where the locked-state secondary button points (e.g. /pages/p2p-haus-preview)."
    },
    { "type": "header", "content": "Layout" },
    {
      "type": "range",
      "id": "sticky_offset",
      "label": "Sticky rail top offset",
      "min": 0, "max": 320, "step": 4, "unit": "px", "default": 152,
      "info": "Space above the sticky \"Your Pack\" progress widget so it clears your sticky theme banner/header. Increase if the widget hides under the banner (try 200-260 for a tall banner)."
    },
    { "type": "header", "content": "Locked-state copy" },
    {
      "type": "text",
      "id": "locked_heading",
      "label": "Locked heading",
      "default": "Your launch to <span class=\"accent\">Profit</span> starts here."
    },
    {
      "type": "textarea",
      "id": "locked_body",
      "label": "Locked body",
      "default": "The Growth Haus turns your product into a full, on-brand launch kit — copy, social, images, video, and a day-by-day ROOTED plan. Unlock it with the Access Pass."
    }
  ],
  "presets": [{ "name": "Growth Haus" }]
}
{% endschema %}
