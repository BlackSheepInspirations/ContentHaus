            <div class="premium-panel" data-premium-panel="launchplan" hidden>
              <div class="output-heading">
                <h3>The ROOTED Method &mdash; Launch Plan</h3>
                <button type="button" data-output-target="premiumLaunchPlanText">
                  Copy
                </button>
              </div>
              <p class="field-note">
                Your launch, run on the 6-stage ROOTED Method (Reach, Open, Offer,
                Trigger, Escalate, Deepen) &mdash; sequenced to your kit, with a
                checklist.
              </p>

              <div class="rooted-stages" id="rootedStages"></div>
              <div class="rooted-deepen-toggle" id="rootedDeepenToggle"></div>

              <textarea
                id="premiumLaunchPlanText"
                class="premium-output"
                rows="22"
                readonly
                aria-label="ROOTED Method launch plan"
              ></textarea>

              <div class="rooted-calendar" id="rootedCalendar"></div>
              <div class="rooted-quality" id="rootedQualityCheck"></div>
            </div>

            <div class="premium-panel" data-premium-panel="calendar" hidden>
              <div class="output-heading">
                <h3>30-Day Content Calendar</h3>
                <button type="button" data-output-target="premiumCalendarText">
                  Copy
                </button>
              </div>
              <p class="field-note">
                A month of daily content ideas, themed and rotating — so your feed
                keeps selling long after launch day.
              </p>
              <textarea
                id="premiumCalendarText"
                class="premium-output"
                rows="22"
                readonly
                aria-label="Thirty day content calendar"
              ></textarea>
            </div>

            <div class="premium-panel" data-premium-panel="suno" hidden>
              <div class="output-heading">
                <h3>Suno AI Music Prompt</h3>
                <button type="button" data-output-target="premiumSunoText">
                  Copy
                </button>
              </div>
              <p class="field-note">
                Two options for Suno: a full branded song (with lyrics), and an
                instrumental background track to sit under a video or ad.
              </p>
              <textarea
                id="premiumSunoText"
                class="premium-output"
                rows="20"
                readonly
                aria-label="Suno AI music prompt"
              ></textarea>
            </div>

            <div class="premium-panel" data-premium-panel="video" hidden>
              <div class="output-heading">
                <h3>Video Script Prompt</h3>
                <button type="button" data-output-target="premiumVideoText">
                  Copy
                </button>
              </div>
              <p class="field-note">
                What happens on screen — scene by scene, plus a shot list, caption,
                and hashtags. The spoken words are in the Voiceover Script tab.
              </p>
              <textarea
                id="premiumVideoText"
                class="premium-output"
                rows="20"
                readonly
                aria-label="Video script prompt"
              ></textarea>
            </div>

            <div class="premium-panel" data-premium-panel="voice" hidden>
              <div class="output-heading">
                <h3>Voiceover Script</h3>
                <button type="button" data-output-target="premiumVoiceText">
                  Copy
                </button>
              </div>
              <p class="field-note">
                Just the spoken words, timed to match the video scenes — record it
                yourself or paste into a voice AI (ElevenLabs, Play.ht).
              </p>
              <textarea
                id="premiumVoiceText"
                class="premium-output"
                rows="20"
                readonly
                aria-label="Voiceover script"
              ></textarea>
            </div>

            <div class="premium-panel" data-premium-panel="marketing" hidden>
              <div class="output-heading">
                <h3>Marketing Campaign Prompt</h3>
                <button type="button" data-output-target="premiumMarketingText">
                  Copy
                </button>
              </div>
              <p class="field-note">
                A complete multi-channel campaign prompt — email, social, ad, and
                subject lines — ready to run in any AI.
              </p>
              <textarea
                id="premiumMarketingText"
                class="premium-output"
                rows="20"
                readonly
                aria-label="Marketing campaign prompt"
              ></textarea>
            </div>

            <div class="premium-panel" data-premium-panel="gpt" hidden>
              <div class="output-heading">
                <h3>Custom GPT Builder</h3>
                <button type="button" data-output-target="premiumGptText">
                  Copy
                </button>
              </div>
              <p class="field-note">
                A complete Custom GPT configuration — instructions, knowledge files,
                starters, welcome message, rules, and a testing checklist.
              </p>
              <textarea
                id="premiumGptText"
                class="premium-output"
                rows="24"
                readonly
                aria-label="Custom GPT builder configuration"
              ></textarea>
            </div>

            <div class="premium-panel" data-premium-panel="animate" hidden>
              <div class="output-heading">
                <h3>Photo → Animation &amp; Video</h3>
                <button type="button" data-output-target="premiumAnimateText">
                  Copy
                </button>
              </div>
              <p class="field-note">
                The full photo workflow: a <b>still photo prompt</b> to create your
                product image (text-to-image), then <b>animation</b> and
                <b>hero-video</b> prompts to bring it to life. Want more photo
                options? Add a <b>Lifestyle Image</b>, <b>Product Mockup</b>, or
                <b>Hero Banner</b> generator above.
              </p>
              <textarea
                id="premiumAnimateText"
                class="premium-output"
                rows="22"
                readonly
                aria-label="Photo animation and video prompt"
              ></textarea>
            </div>
          </div>
        </section>
      </main>

      <footer class="site-footer">
        <p>
          Growth Haus — Build clearer prompts and launch
          products faster.
        </p>
      </footer>

      <!-- TOAST -->
      <div
        id="appToast"
        class="toast"
        role="status"
        aria-live="polite"
        aria-atomic="true"
        hidden
      ></div>

      <!-- CONFIRMATION MODAL -->
      <div
        id="confirmationModal"
        class="modal"
        role="dialog"
        aria-modal="true"
        aria-labelledby="modalTitle"
        aria-describedby="modalMessage"
        hidden
      >
        <div class="modal__content">
          <h2 id="modalTitle">Please Confirm</h2>

          <p id="modalMessage">
            Are you sure you want to continue?
          </p>

          <div class="modal__actions">
            <button id="modalConfirmBtn" type="button">
              Confirm
            </button>

            <button id="modalCancelBtn" type="button">
              Cancel
            </button>
          </div>
        </div>
      </div>

      <!-- Back-to-top button removed for Shopify — the theme provides its own. -->
  </div>

  <script src="{{ 'p2p-haus.js' | asset_url }}" defer="defer"></script>
{% else %}
  <div class="p2p-locked">
    <span class="p2p-locked__family">Black Sheep Creations &amp; Inspirations</span>
    <h2 class="p2p-locked__heading">{{ section.settings.locked_heading }}</h2>
    <div class="p2p-locked__body">{{ section.settings.locked_body }}</div>
    <div class="p2p-locked__actions">
      {% if section.settings.access_product %}
        <a href="{{ section.settings.access_product.url }}" class="p2p-locked__btn p2p-locked__btn--get">
          Get the Access Pass{% if section.settings.access_product.price %} — {{ section.settings.access_product.price | money }}{% endif %}
        </a>
      {% endif %}
      {% if section.settings.learn_more_url != blank %}
        <a href="{{ section.settings.learn_more_url }}" class="p2p-locked__btn p2p-locked__btn--learn">See what's inside</a>
      {% endif %}
    </div>
  </div>
{% endif %}

{% render 'haus-links', current: 'p2p-haus' %}

{% schema %}
{
  "name": "Growth Haus",
  "settings": [
    { "type": "header", "content": "Access control" },
    {
      "type": "text",
      "id": "access_tag",
      "label": "Access tag",
      "default": "P2P-haus-access",
      "info": "Customer tag that unlocks the tool (matched case-insensitively). Must match the tag your Shopify Flow adds on purchase."
    },
    {
      "type": "product",
      "id": "access_product",
      "label": "Access Pass product",
      "info": "Shown as the Get Access button for visitors who don't have the tag yet."
    },
    {
      "type": "url",
      "id": "learn_more_url",
      "label": "Preview / learn-more URL",
      "info": "Where the locked-state secondary button points (e.g. /pages/p2p-haus-preview)."
    },
    { "type": "header", "content": "Layout" },
    {
      "type": "range",
      "id": "sticky_offset",
      "label": "Sticky rail top offset",
      "min": 0, "max": 320, "step": 4, "unit": "px", "default": 152,
      "info": "Space above the sticky \"Your Pack\" progress widget so it clears your sticky theme banner/header. Increase if the widget hides under the banner (try 200-260 for a tall banner)."
    },
    { "type": "header", "content": "Locked-state copy" },
    {
      "type": "text",
      "id": "locked_heading",
      "label": "Locked heading",
      "default": "Your launch to <span class=\"accent\">Profit</span> starts here."
    },
    {
      "type": "textarea",
      "id": "locked_body",
      "label": "Locked body",
      "default": "The Growth Haus turns your product into a full, on-brand launch kit — copy, social, images, video, and a day-by-day ROOTED plan. Unlock it with the Access Pass."
    }
  ],
  "presets": [{ "name": "Growth Haus" }]
}
{% endschema %}
