        <div class="quickstart">
          <span class="quickstart__label">Jump-start with a template</span>
          <button type="button" data-preset="etsy">Etsy digital download</button>
          <button type="button" data-preset="course">Online course</button>
          <button type="button" data-preset="shopify">Shopify product</button>
          <button type="button" data-preset="service">Coaching / service</button>
          <span class="quickstart__sep" aria-hidden="true"></span>
          <button type="button" class="quickstart__sample" data-preset="sample">&#10024; Try a sample</button>
        </div>

        <div class="brand-setup">
          <div class="mode-toggle" role="group" aria-label="What are you launching">
            <span class="mode-toggle__label">You're launching:</span>
            <button type="button" class="mode-btn" data-mode="product">A product / niche</button>
            <button type="button" class="mode-btn" data-mode="creator">I am the brand</button>
            <button id="loadBrandKitBtn" type="button" class="load-kit-btn" hidden>Load your Brand Kit</button>
          </div>

          <details class="brand-import">
            <summary class="brand-import__summary">Coming from Brand Haus? Load your Brand DNA Blueprint&trade;</summary>
            <div class="brand-import__body">
              <p class="field-note">
                Paste your Brand DNA Blueprint&trade; block from Brand Haus (use its Copy button)
                to auto-fill your brand tone, visual style, colors, and keywords.
              </p>
              <textarea
                id="brandDnaInput"
                rows="6"
                placeholder="Paste your Brand DNA block here..."
                aria-label="Brand DNA to import"
              ></textarea>
              <button id="importBrandDnaBtn" type="button">Import Blueprint&trade;</button>
            </div>
          </details>
        </div>

        <div class="build-layout">
        <form id="generatorForm" novalidate>
          <div class="phase-divider">
            <p class="phase-divider__num">Phase 01</p>
            <h2 class="phase-divider__title">Your product</h2>
            <p class="phase-divider__desc">
              Tell us what you're selling, who it's for, and how your brand
              should sound. This is the foundation every prompt is built on.
            </p>
          </div>

          <!-- PRODUCT INFORMATION -->
          <section
            id="productSection"
            class="form-section"
            data-category="product"
            aria-labelledby="productSectionTitle"
          >
            <div class="section-heading">
              <div>
                <p class="section-number">The product</p>
                <h2 id="productSectionTitle">Product Information</h2>
              </div>

              <button
                type="button"
                data-clear-category="product"
                aria-label="Clear unlocked product information"
              >
                Clear Category
              </button>
            </div>

            <p class="section-description">
              Enter the core facts that should remain consistent across all
              generated prompts.
            </p>

            <div class="form-grid">
              <div class="field-group">
                <label for="productName">
                  Product name
                  <span aria-hidden="true">*</span>
                </label>

                <input
                  id="productName"
                  name="productName"
                  type="text"
                  data-field-key="productName"
                  data-category="product"
                  autocomplete="off"
                  required
                >

                <label class="lock-control">
                  <input
                    id="productNameLock"
                    type="checkbox"
                    data-lock-target="productName"
                  >
                  Lock this field
                </label>
              </div>

              <div class="field-group">
                <label for="productType">
                  Product type
                  <span aria-hidden="true">*</span>
                </label>

                <select
                  id="productType"
                  name="productType"
                  data-field-key="productType"
                  data-category="product"
                  required
                >
                  <option value="">Choose a product type</option>
                  <option value="digital-product">Digital product</option>
                  <option value="physical-product">Physical product</option>
                  <option value="pod-product">
                    Print-on-demand product
                  </option>
                  <option value="course">Course</option>
                  <option value="membership">Membership</option>
                  <option value="lead-magnet">Lead magnet</option>
                  <option value="service">Service</option>
                  <option value="productized-service">
                    Productized service
                  </option>
                  <option value="bundle">Bundle</option>
                  <option value="image-asset">
                    Image or graphic asset
                  </option>
                  <option value="other">Other</option>
                </select>

                <label class="lock-control">
                  <input
                    id="productTypeLock"
                    type="checkbox"
                    data-lock-target="productType"
                  >
                  Lock this field
                </label>
              </div>

              <div class="field-group field-group--full">
                <label for="productDescription">
                  Product description
                  <span aria-hidden="true">*</span>
                </label>

                <textarea
                  id="productDescription"
                  name="productDescription"
                  rows="5"
                  data-field-key="productDescription"
                  data-category="product"
                  required
                  placeholder="Describe what the product is, what it includes, and how it helps the customer."
                ></textarea>

                <label class="lock-control">
                  <input
                    id="productDescriptionLock"
                    type="checkbox"
                    data-lock-target="productDescription"
                  >
                  Lock this field
                </label>
              </div>

              <div class="field-group">
                <label for="productFormat">
                  Product format
                </label>

                <select
                  id="productFormat"
                  name="productFormat"
                  data-field-key="productFormat"
                  data-category="product"
                  multiple
                >
                  <option value="pdf">PDF</option>
                  <option value="template">Template</option>
                  <option value="workbook">Workbook</option>
                  <option value="planner">Planner</option>
                  <option value="journal">Journal</option>
                  <option value="ebook">E-book</option>
                  <option value="video">Video</option>
                  <option value="audio">Audio</option>
                  <option value="image">Image</option>
                  <option value="printable">Printable</option>
                  <option value="physical-item">Physical item</option>
                  <option value="service-delivery">
                    Service delivery
                  </option>
                  <option value="other">Other</option>
                </select>

                <label for="productFormatUsageMode">
                  How should this be used?
                </label>

                <select
                  id="productFormatUsageMode"
                  name="productFormatUsageMode"
                  data-usage-mode
                >
                  <option value="included">
                    Use selected choices
                  </option>
                  <option value="choice-plus-custom">
                    Use choices plus custom details
                  </option>
                  <option value="custom-only">
                    Use only custom details
                  </option>
                  <option value="optional">
                    Use only if helpful
                  </option>
                  <option value="excluded">
                    Do not include
                  </option>
                </select>

                <label for="productFormatCustom">
                  Custom product format
                </label>

                <input
                  id="productFormatCustom"
                  name="productFormatCustom"
                  type="text"
                  data-field-key="productFormatCustom"
                  data-category="product"
                >
              </div>

              <div class="field-group">
                <label for="salesPlatform">
                  Sales platform or marketplace
                </label>

                <select
                  id="salesPlatform"
                  name="salesPlatform"
                  data-field-key="salesPlatform"
                  data-category="product"
                  multiple
                >
                  <option value="etsy">Etsy</option>
                  <option value="shopify">Shopify</option>
                  <option value="amazon">Amazon</option>
                  <option value="gumroad">Gumroad</option>
                  <option value="stan-store">Stan Store</option>
                  <option value="payhip">Payhip</option>
                  <option value="website">Independent website</option>
                  <option value="social-commerce">
                    Social commerce
                  </option>
                  <option value="other">Other</option>
                </select>

                <label for="salesPlatformCustom">
                  Add another platform
                </label>

                <input
                  id="salesPlatformCustom"
                  name="salesPlatformCustom"
                  type="text"
                  data-field-key="salesPlatformCustom"
                  data-category="product"
                >
              </div>

              <div class="field-group field-group--full">
                <label for="productContents">
                  Product contents
                </label>

                <textarea
                  id="productContents"
                  name="productContents"
                  rows="4"
                  data-field-key="productContents"
                  data-category="product"
                  placeholder="List pages, files, modules, bonuses, designs, or included materials."
                ></textarea>
              </div>

              <div class="field-group field-group--full">
                <label for="productFeatures">
                  Product features
                </label>

                <textarea
                  id="productFeatures"
                  name="productFeatures"
                  rows="4"
                  data-field-key="productFeatures"
                  data-category="product"
                  placeholder="Enter one feature per line."
                ></textarea>
              </div>

              <div class="field-group field-group--full">
                <label for="productBenefits">
                  Product benefits
                </label>

                <textarea
                  id="productBenefits"
                  name="productBenefits"
                  rows="4"
                  data-field-key="productBenefits"
                  data-category="product"
                  placeholder="Enter one benefit per line."
                ></textarea>
              </div>

              <div class="field-group">
                <label for="marketingGoal">
                  Marketing goal
                  <span aria-hidden="true">*</span>
                </label>

                <select
                  id="marketingGoal"
                  name="marketingGoal"
                  data-field-key="marketingGoal"
                  data-category="product"
                  required
                >
                  <option value="launch">Launch a new product</option>
                  <option value="listing">
                    Improve an existing listing
                  </option>
                  <option value="promotion">Promote a sale</option>
                  <option value="awareness">Build awareness</option>
                  <option value="lead-generation">
                    Generate leads
                  </option>
                  <option value="conversion">
                    Increase conversions
                  </option>
                  <option value="evergreen">
                    Create evergreen marketing
                  </option>
                  <option value="relaunch">
                    Relaunch or refresh
                  </option>
                  <option value="custom">Custom</option>
                </select>
              </div>

              <div class="field-group">
                <label for="marketingGoalCustom">
                  Custom marketing goal
                </label>

                <input
                  id="marketingGoalCustom"
                  name="marketingGoalCustom"
                  type="text"
                  data-field-key="marketingGoalCustom"
                  data-category="product"
                >
              </div>
            </div>
          </section>

          <!-- AUDIENCE -->
          <section
            id="audienceSection"
            class="form-section"
            data-category="audience"
            aria-labelledby="audienceSectionTitle"
          >
            <div class="section-heading">
              <div>
                <p class="section-number">The audience</p>
                <h2 id="audienceSectionTitle">
                  Audience and Positioning
                </h2>
              </div>

              <button
                type="button"
                data-clear-category="audience"
              >
                Clear Category
              </button>
            </div>

            <div class="form-grid">
              <div class="field-group field-group--full">
                <label for="targetAudience">
                  Target audience
                  <span aria-hidden="true">*</span>
                </label>

                <textarea
                  id="targetAudience"
                  name="targetAudience"
                  rows="4"
                  data-field-key="targetAudience"
                  data-category="audience"
                  required
                  placeholder="Describe the people most likely to buy or use this product."
                ></textarea>
              </div>

              <div class="field-group field-group--full">
                <label for="buyerProblem">
                  Buyer problem
                </label>

                <textarea
                  id="buyerProblem"
                  name="buyerProblem"
                  rows="4"
                  data-field-key="buyerProblem"
                  data-category="audience"
                ></textarea>
              </div>

              <div class="field-group field-group--full">
                <label for="buyerOutcome">
                  Desired buyer outcome
                </label>

                <textarea
                  id="buyerOutcome"
                  name="buyerOutcome"
                  rows="4"
                  data-field-key="buyerOutcome"
                  data-category="audience"
                ></textarea>
              </div>

              <div class="field-group">
                <label for="buyerMotivation">
                  Buyer motivations
                </label>

                <select
                  id="buyerMotivation"
                  name="buyerMotivation"
                  data-field-key="buyerMotivation"
                  data-category="audience"
