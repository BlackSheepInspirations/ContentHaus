        Skip to main content
      </a>

      <header class="site-header">
        <div class="site-header__bar">
          <span class="site-header__family">Black Sheep Creations &amp; Inspirations</span>
          <span class="wordmark">
            Growth
            <span class="wordmark__tag">Haus</span>
          </span>
        </div>

        <div class="site-header__content">
          <div class="marquee__intro">
            <p class="eyebrow">From product to launch-ready marketing</p>

            <h1>Turn what you sell into <span class="accent">paste-ready</span> AI prompts.</h1>

            <p class="site-header__description">
              Describe your product once, choose what you want to create, and get
              professional, ready-to-run prompts for copy, social, images, and
              video — tuned to your brand and your platform.
            </p>

          </div>

          <div class="marquee__media">
            <div class="video-frame">
              <video
                id="howToVideo"
                class="video-frame__player"
                controls
                preload="metadata"
                playsinline
                poster="{{ 'how-to-poster.jpg' | asset_url }}"
              >
                <source src="{{ 'how-to.mp4' | asset_url }}" type="video/mp4">
              </video>

              <div class="video-frame__placeholder" id="howToPlaceholder" hidden>
                <span class="video-frame__play" aria-hidden="true">&#9654;</span>
                <p class="video-frame__title">Video walkthrough coming soon</p>
                <p class="video-frame__note">
                  Add your clip at <code>assets/how-to.mp4</code>
                </p>
              </div>
            </div>

            <script>
              /* Reveal the "coming soon" placeholder when the how-to clip isn't uploaded yet,
                 instead of showing a broken/empty player. */
              (function () {
                var v = document.getElementById('howToVideo'),
                    ph = document.getElementById('howToPlaceholder');
                if (!v || !ph) return;
                var src = v.querySelector('source');
                function showPlaceholder() { if (ph.hidden) { ph.hidden = false; v.style.display = 'none'; } }
                if (src) src.addEventListener('error', showPlaceholder);
                v.addEventListener('error', showPlaceholder);
                setTimeout(function () { if (!v.readyState) showPlaceholder(); }, 2500);
              })();
            </script>

            <p class="video-frame__caption">
              Watch: how to turn your product into a prompt pack — in about 60 seconds.
            </p>
          </div>
        </div>

        <div class="site-header__actions">
