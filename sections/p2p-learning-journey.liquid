{% schema %}
{
  "name": "P2P Learning Journey",
  "settings": [
    { "type": "header", "content": "Hero" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Black Sheep Creations & Inspirations" },
    { "type": "text", "id": "title_pre", "label": "Title — first part", "default": "Purpose" },
    { "type": "text", "id": "title_mid", "label": "Title — highlighted middle", "default": "2" },
    { "type": "text", "id": "title_post", "label": "Title — last part", "default": "Profit" },
    { "type": "text", "id": "title_sub", "label": "Title — second line (caps)", "default": "Learning Journey" },
    { "type": "textarea", "id": "description", "label": "Description", "default": "Start wherever you are. One course at a time. Unlock your next win and level up your craft at your pace. This journey isn't about finishing first — it's about building something that is uniquely you." },
    { "type": "text", "id": "journey_name", "label": "Journey name", "default": "Purpose 2 Profit Learning Journey" },
    { "type": "text", "id": "os_url", "label": "Operating System back-link (URL)", "info": "Shown as a back button at the top of the hero on every realm. Point at your P2P Operating System page. Leave blank to hide it.", "default": "/pages/p2p-os" },
    { "type": "text", "id": "os_label", "label": "Operating System back-link — label", "default": "P2P Operating System" },
    { "type": "checkbox", "id": "moment_show", "label": "Show Mindset Moment card", "info": "A daily rotating quote / affirmation / verse in the hero. Content lives in assets/p2p-moments.js.", "default": true },
    { "type": "text", "id": "moment_label", "label": "Mindset Moment — label", "default": "Daily Mindset Moment" },

    { "type": "header", "content": "Access" },
    { "type": "text", "id": "access_tag", "label": "Access tag", "info": "Customer tag that unlocks the journey. Must match the tag your Shopify Flow automation adds on purchase.", "default": "p2p-learning" },
    { "type": "product", "id": "access_product", "label": "Access product", "info": "Shown as the \"Get Access\" button on the locked state." },
    { "type": "url", "id": "learn_more_url", "label": "Learn more link", "info": "e.g. link to your Purpose 2 Profit marketing page." },
    { "type": "text", "id": "locked_heading", "label": "Locked state heading", "default": "Unlock The Purpose 2 Profit Learning Journey" },
    { "type": "richtext", "id": "locked_body", "label": "Locked state body", "default": "<p>Get instant access to the full Learning Journey — every course, badge, and side-quest on the map.</p>" },

    { "type": "url", "id": "milestones_url", "label": "Milestones (badges) page", "info": "Where the Milestones tab links." },
    { "type": "url", "id": "tutorial_url", "label": "Tutorial page", "info": "The annotated 'How it works' walkthrough page (e.g. /pages/p2p-tutorial). Adds a link in the Welcome pop-up and Help menu. Leave blank to hide." },

    { "type": "header", "content": "Board" },
    { "type": "image_picker", "id": "board_image", "label": "Board image", "info": "This Realm's own board art. Leave blank to use the shared placeholder image until this Realm's art is ready." },
    { "type": "text", "id": "offshoot_hub_handle", "label": "Default Offshoot hub course handle", "info": "An Offshoot block with no handle of its own falls back to this — e.g. \"storefront-essentials\". Saves repeating it on every Offshoot block on the same board.", "default": "storefront-essentials" },
    { "type": "checkbox", "id": "intro_required", "label": "Require onboarding before Main courses unlock", "info": "Turn off only if this Realm should skip the \"Your Journey Begins Here\" gate entirely.", "default": true },
    { "type": "text", "id": "unlock_after_handle", "label": "Realm unlock — required course handle", "info": "Leave blank if this Realm has no anchor (e.g. Realm 1). Set to the anchor course's handle for a Realm gated behind another course — e.g. \"grow\" or \"rooted\"." },

    { "type": "header", "content": "Framework scroll (RAFT / GROWS / …)" },
    { "type": "text", "id": "scroll_title", "label": "Scroll title", "info": "The clickable framework scroll painted on the board. Leave blank for no scroll on this Realm." },
    { "type": "textarea", "id": "scroll_body", "label": "Scroll popup text" },
    { "type": "number", "id": "scroll_left", "label": "Scroll — center left %" },
    { "type": "number", "id": "scroll_top", "label": "Scroll — center top %" },
    { "type": "number", "id": "scroll_width", "label": "Scroll — width %" },
    { "type": "number", "id": "scroll_height", "label": "Scroll — height %" },

    { "type": "header", "content": "Next-realm marker (bottom)" },
    { "type": "text", "id": "nextrealm_asset", "label": "Next-realm image (asset filename)", "info": "e.g. p2p-next-realm.png to overlay a compass+text graphic. Leave blank if the board art already includes the compass/text — then it's just an invisible clickable." },
    { "type": "number", "id": "nextrealm_left", "label": "Next-realm — center left %" },
    { "type": "number", "id": "nextrealm_top", "label": "Next-realm — center top %" },
    { "type": "number", "id": "nextrealm_width", "label": "Next-realm — width %" },
    { "type": "number", "id": "nextrealm_height", "label": "Next-realm — height % (only when no image)" },

    { "type": "header", "content": "Layout" },
    { "type": "range", "id": "sticky_offset", "min": 0, "max": 120, "step": 2, "unit": "px", "label": "Sticky bar offset", "info": "Match your theme header/announcement bar height.", "default": 6 },

