{% comment %}
  Purpose 2 Profit — Learning Journey (journey map page).
  Gate matches every other Haus exactly: customer.tags contains the access
  tag (added by a Shopify Flow on order paid), or request.design_mode inside
  the theme editor. No client-side code redemption — locked visitors receive
  none of the gated markup at all, same as Product/Graphics/Marketing/Brand
  Haus's own access-gate pattern.
  Board art + course/sign/side-quest positions are tuned to assets/p2p-journey-board.jpg.
{% endcomment %}

{{ 'p2p-journey.css' | asset_url | stylesheet_tag }}

{%- assign has_access = false -%}
{%- if customer and section.settings.access_tag != blank and customer.tags contains section.settings.access_tag -%}
  {%- assign has_access = true -%}
{%- endif -%}
{%- if request.design_mode -%}{%- assign has_access = true -%}{%- endif -%}

{%- comment -%} course-block count (drives the Progress ring) + first Main course (drives the "Up next" card + onboarding's final link) — replaces the old fixed course_1..5_* settings now that courses are section blocks. {%- endcomment -%}
{%- assign board_courses_count = 0 -%}
{%- assign first_course_title = '' -%}
{%- assign first_course_url = '/pages/p2p-course' -%}
{%- for block in section.blocks -%}
  {%- if block.type == 'course' -%}
    {%- assign board_courses_count = board_courses_count | plus: 1 -%}
    {%- if first_course_title == '' -%}
      {%- assign first_course_title = block.settings.title -%}
      {%- assign first_course_url = block.settings.url | default: first_course_url -%}
    {%- endif -%}
  {%- endif -%}
{%- endfor -%}

<div id="p2pj"
     data-board-courses="{{ board_courses_count }}"
     data-intro-required="{{ section.settings.intro_required }}"
     data-unlock-after="{{ section.settings.unlock_after_handle }}"
     style="--p2pj-sticky:{{ section.settings.sticky_offset | default: 6 }}px;">

  <div class="p2pj-aurora"><div class="rib a"></div><div class="rib b"></div><div class="rib c"></div><div class="rib d"></div></div>

  <div class="wrap">

    <header class="hero">
      {%- if section.settings.eyebrow != blank -%}<div class="eyebrow">{{ section.settings.eyebrow }}</div>{%- endif -%}
      <h1>{{ section.settings.title_pre }}<span class="two">{{ section.settings.title_mid }}</span>{{ section.settings.title_post }}</h1>
      {%- if section.settings.title_sub != blank -%}<div class="ttl-sub">{{ section.settings.title_sub }}</div>{%- endif -%}
      {%- if section.settings.description != blank -%}<p class="desc">{{ section.settings.description }}</p>{%- endif -%}
    </header>

    {%- if has_access -%}

    {%- comment -%} ---- STICKY NAV + STATS ---- {%- endcomment -%}
    <div class="bar">
      <div class="bar-main">
      <nav class="nav">
        <a class="on" href="#" data-panel="journey" data-tip="Your map — courses, signs &amp; side-quests"><svg viewBox="0 0 24 24"><path d="M3 6l6-2 6 2 6-2v14l-6 2-6-2-6 2z"/><path d="M9 4v14M15 6v14"/></svg><small>Journey Map</small></a>
        <a href="#" data-panel="progress" data-tip="Your points, badges &amp; streaks"><svg viewBox="0 0 24 24"><path d="M4 20V12M9.5 20V6M15 20v-9M20.5 20V8"/><path d="M3 20h18"/></svg><small>Progress</small></a>
        <a href="#" data-panel="bonuses" data-tip="Side-quests: Mindset, Purpose &amp; Heart"><svg viewBox="0 0 24 24"><rect x="3.5" y="9" width="17" height="11" rx="1.2"/><path d="M2.5 9h19v3.4h-19z"/><path d="M12 9v11M12 9c-3.4-5.5-7.4-1.2-3 .6M12 9c3.4-5.5 7.4-1.2 3 .6"/></svg><small>Bonuses</small></a>
        <a href="{{ section.settings.milestones_url | default: '/pages/p2p-badges' }}" data-tip="Badges you've earned"><svg viewBox="0 0 24 24"><path d="M12 3l2.6 5.6 6.1.7-4.5 4.2 1.2 6L12 16.9 6.6 19.5l1.2-6L3.3 9.3l6.1-.7z"/></svg><small>Milestones</small></a>
        <a href="#" data-panel="journal" data-tip="Your notes &amp; reflections"><svg viewBox="0 0 24 24"><path d="M12 6C10 4.4 5.5 4.2 3.5 5.2v13.6c2-1 6.5-.8 8.5.8 2-1.6 6.5-1.8 8.5-.8V5.2C18.5 4.2 14 4.4 12 6z"/><path d="M12 6v13.6"/></svg><small>Journal</small></a>
      </nav>
      <a class="barinfo" href="#" data-info data-tip="Info, rules &amp; help"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M12 11v5.5" stroke-linecap="round"/><circle cx="12" cy="7.6" r="1.1" fill="#fff" stroke="none"/></svg></a>
      <div class="stats">
        <button class="stat stat-points" type="button" data-points data-tip="See how points work"><b><svg viewBox="0 0 24 24"><path fill="#f4c534" stroke="#b98f1e" stroke-width="1" d="M12 3l2.6 5.6 6.1.7-4.5 4.2 1.2 6L12 16.9 6.6 19.5l1.2-6L3.3 9.3l6.1-.7z"/></svg><span class="p2pj-points">{{ section.settings.stat_points | default: '0' }}</span></b><small>Points</small></button>
        <div class="stat"><b><svg viewBox="0 0 24 24"><path fill="#39c5c0" stroke="#1f7f7c" stroke-width="1" d="M6 3h12l3 6-9 12L3 9z"/></svg><span class="p2pj-badges">{{ section.settings.stat_badges | default: '0' }}</span></b><small>Badges</small></div>
        <div class="stat"><b><svg viewBox="0 0 24 24"><path fill="#8f6fd6" stroke="#5b3c8c" stroke-width="1" d="M6 3h12l3 6-9 12L3 9z"/></svg><span class="p2pj-streak">{{ section.settings.stat_streak | default: '0' }}</span></b><small>Streak</small></div>
        <div class="level"><div class="coin"><svg viewBox="0 0 24 24"><path d="M12 3l2.6 5.6 6.1.7-4.5 4.2 1.2 6L12 16.9 6.6 19.5l1.2-6L3.3 9.3l6.1-.7z"/></svg></div><small>Merit <span class="p2pj-level">{{ section.settings.stat_level | default: '1' }}</span></small></div>
      </div>
      </div>

      {%- comment -%} ---- realm navigation (second toolbar row) ---- {%- endcomment -%}
      <div class="bar-realms">
        <div class="realms-scroll">
        <span class="brlbl">Realms</span>
        {%- assign defnames = 'The Shoreline,The Thicket,The Bloom,The Fields,The Evergreens' | split: ',' -%}
        {%- assign cur = section.settings.current_realm | default: 1 -%}
        {%- for r in (1..5) -%}
          {%- assign kn = 'realm_' | append: r | append: '_name' -%}
          {%- assign ku = 'realm_' | append: r | append: '_url' -%}
          {%- assign kl = 'realm_' | append: r | append: '_locked' -%}
          {%- assign rn = section.settings[kn] | default: defnames[forloop.index0] -%}
          {%- assign ru = section.settings[ku] -%}
          {%- assign rl = section.settings[kl] -%}
          {%- if rl -%}
            <span class="rbtn locked" data-tip="Locked — keep progressing to open this realm"><b>🔒</b><span>{{ rn }}</span></span>
          {%- else -%}
            <a class="rbtn{% if cur == r %} on{% endif %}" href="{{ ru | default: '#' }}"><b>{{ r }}</b><span>{{ rn }}</span></a>
          {%- endif -%}
        {%- endfor -%}
        </div>
        <div class="stat stat-ring board-right" data-tip="% of this board's courses completed"><div class="ring-mini p2pj-ring" style="--p:0"><b class="p2pj-ringpct">0%</b></div><small>Board</small></div>
      </div>
    </div>

    {%- comment -%} ---- BOARD (baked art + interactive overlays) ---- {%- endcomment -%}
    <div class="board">
      {%- comment -%} board art fallback chain: an uploaded board_image wins if
         set; otherwise Realm 1 (current_realm 1) defaults to its own painted
         Open Water art; every other Realm falls back to the shared
         placeholder jpg until its own art exists. {%- endcomment -%}
      {%- if section.settings.board_image != blank -%}
        <img class="bg" src="{{ section.settings.board_image | image_url: width: 2000 }}" alt="{{ section.settings.journey_name | default: 'Purpose 2 Profit Learning Journey' | escape }} map" loading="eager" />
      {%- elsif section.settings.current_realm == 1 -%}
        <img class="bg" src="{{ 'p2p-journey-board-openwater.jpg' | asset_url }}" alt="{{ section.settings.journey_name | default: 'Purpose 2 Profit Learning Journey' | escape }} map" loading="eager" />
      {%- else -%}
        <img class="bg" src="{{ 'p2p-journey-board.jpg' | asset_url }}" alt="{{ section.settings.journey_name | default: 'Purpose 2 Profit Learning Journey' | escape }} map" loading="eager" />
      {%- endif -%}

      {%- comment -%} "Your Journey Begins Here" — always present, opens onboarding {%- endcomment -%}
      <button class="hs" style="left:38%; top:6.5%; width:22%; height:5%" data-begin data-title="Your Journey Begins Here"></button>

      {%- comment -%} Main / Offshoot / Check nodes — from section blocks. Lock state, done state,
         and the progress overlays are all computed client-side in p2p-journey.js from
         window.P2P.isCourseDone() + the onboarding flag; nothing here is hardcoded. {%- endcomment -%}
      {%- for block in section.blocks -%}
        {%- assign b = block.settings -%}
        {%- assign pos = 'left:' | append: b.pos_left | append: '%; top:' | append: b.pos_top | append: '%; width:' | append: b.pos_width | append: '%; height:' | append: b.pos_height | append: '%;' -%}
        {%- case block.type -%}
          {%- when 'course' -%}
            <button class="hs" style="{{ pos }}" data-type="course" data-handle="{{ b.handle }}" data-title="{{ b.title }}" data-body="{{ b.body }}" data-cta="Open course" data-url="{{ b.url }}"{{ block.shopify_attributes }}></button>
          {%- when 'offshoot' -%}
            {%- assign unlock_handle = b.unlock_after_handle -%}
            {%- if unlock_handle == blank -%}{%- assign unlock_handle = section.settings.offshoot_hub_handle -%}{%- endif -%}
            <button class="hs hs--offshoot" style="{{ pos }}" data-type="offshoot" data-handle="{{ b.handle }}" data-unlock-after="{{ unlock_handle }}" data-title="{{ b.title }}" data-body="{{ b.body }}" data-cta="Open course" data-url="{{ b.url }}"{{ block.shopify_attributes }}></button>
          {%- when 'check' -%}
            <button class="hs hs--check" style="{{ pos }}" data-type="check" data-title="{{ b.title }}" data-pulse-items="{{ b.pulse_items | strip_newlines | escape }}" data-link-url="{{ b.link_url }}" data-link-label="{{ b.link_label | default: 'Open' }}"{{ block.shopify_attributes }}></button>
        {%- endcase -%}
      {%- endfor -%}

      {%- comment -%} RAFT framework scroll — clickable reference, no state marker {%- endcomment -%}
      <button class="hs hs--plain" style="left:85.5%; top:13%; width:27%; height:8%" data-type="info" data-title="The RAFT Framework" data-body="Your life raft to get out of the ocean. R: Relieve · A: Act · F: Fast Win · T: Traction. Work these four in order and you're moving." data-cta="Continue"></button>

      {%- comment -%} next-realm compass (bottom) — onward link with gold label {%- endcomment -%}
      {%- assign next_n = section.settings.current_realm | default: 1 | plus: 1 -%}
      {%- assign nrk = 'realm_' | append: next_n | append: '_url' -%}
      {%- assign next_realm_url = section.settings[nrk] -%}
      <a class="p2pj-nextrealm" href="{{ next_realm_url | default: '#' }}" style="left:55%; top:96.5%; width:38%; height:8%;" data-tip="On to the next realm"><span class="nr-text">Journey to the<br>Next Realm</span></a>
    </div>

    {%- comment -%} ---- PROGRESS PANEL ---- {%- endcomment -%}
    <div class="panel" data-panel="progress">
      <div class="pnl-head"><h2>Your Progress</h2><p>Where you are on the trail — your pace, your win.</p></div>
      <div class="prog-top">
        <div class="prog-ring p2pj-ring" style="--p:40"><b class="p2pj-ringpct">40%</b><span>Complete</span></div>
        <div class="prog-tiles">
          <div class="ptile"><b><span class="p2pj-courses">0</span><i>/{{ board_courses_count }}</i></b><small>Courses done</small></div>
          <div class="ptile"><b><span class="p2pj-points">{{ section.settings.stat_points | default: '0' }}</span></b><small>Points</small></div>
          <div class="ptile"><b><span class="p2pj-badges">{{ section.settings.stat_badges | default: '0' }}</span></b><small>Badges</small></div>
          <div class="ptile"><b><span class="p2pj-streak">{{ section.settings.stat_streak | default: '0' }}</span></b><small>Day streak</small></div>
          <div class="ptile"><b><span class="p2pj-level">{{ section.settings.stat_level | default: '1' }}</span></b><small>Merit</small></div>
        </div>
      </div>
      <div class="prog-next">
        <div class="pn-lbl">Up next on your trail</div>
        <a class="pn-card" href="{{ first_course_url }}">
          <span class="pn-title">{{ first_course_title | default: 'Your next course' }}</span>
          <span class="pn-go">Continue →</span>
        </a>
      </div>
    </div>

    {%- comment -%} ---- BONUSES PANEL (Checks — non-gating pulse checks) ---- {%- endcomment -%}
    <div class="panel" data-panel="bonuses">
      <div class="pnl-head"><h2>Bonus Checks</h2><p>Optional pulse checks to keep you steady between courses — never locked.</p></div>
      <div class="bq-grid">
        {%- for block in section.blocks -%}
          {%- if block.type == 'check' -%}
            {%- assign b = block.settings -%}
            <div class="bqcard" data-type="check" data-title="{{ b.title }}" data-pulse-items="{{ b.pulse_items | strip_newlines | escape }}" data-link-url="{{ b.link_url }}" data-link-label="{{ b.link_label | default: 'Open' }}">
              <b>{{ b.title }}</b><span class="bq-go">Enter →</span>
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>

    {%- comment -%} ---- JOURNAL PANEL (localStorage; export to keep a copy) ---- {%- endcomment -%}
    <div class="panel" data-panel="journal">
      <div class="pnl-head"><h2>Your Journal</h2><p>A private space to reflect. Saved on this device — <strong>Export</strong> anytime to keep a permanent copy.</p></div>
      <div class="jr-compose">
        <label class="jr-lbl" for="p2pj-jr-prompt">Reflect on…</label>
        <select id="p2pj-jr-prompt">
          <option value="">Free write</option>
          <option>What's one thing I'm taking from this?</option>
          <option>Where did I feel resistance — and why?</option>
          <option>What does my Founder Fingerprint look like today?</option>
          <option>What's my next small, obvious step?</option>
          <option>What am I proud of right now?</option>
        </select>
        <textarea id="p2pj-jr-text" rows="5" placeholder="Write freely…"></textarea>
        <div class="jr-actions">
          <button class="jr-save" id="p2pj-jr-save" type="button">Save entry</button>
          <button class="jr-export" id="p2pj-jr-export" type="button">Export journal</button>
        </div>
      </div>
      <div class="jr-list-head">Your entries <span id="p2pj-jr-count"></span></div>
      <div class="jr-list" id="p2pj-jr-list"></div>
    </div>

    {%- else -%}

    {%- comment -%} ---- LOCKED STATE (matches every other Haus's pattern) ---- {%- endcomment -%}
    <div class="p2pj-locked">
      <div class="ge">Members Only</div>
      <h2>{{ section.settings.locked_heading | default: 'Unlock The Purpose 2 Profit Learning Journey' }}</h2>
      <div class="p2pj-locked__body">{{ section.settings.locked_body | default: "<p>Get instant access to the full Learning Journey — every course, badge, and side-quest on the map.</p>" }}</div>
      <div class="p2pj-locked__actions">
        {%- if section.settings.access_product != blank -%}
          <a class="gbtn" href="{{ section.settings.access_product.url }}">Get Access{% if section.settings.access_product.price %} — {{ section.settings.access_product.price | money }}{% endif %}</a>
        {%- endif -%}
        {%- if section.settings.learn_more_url != blank -%}
          <a class="p2pj-locked__learn-more" href="{{ section.settings.learn_more_url }}">Learn more</a>
        {%- endif -%}
      </div>
    </div>

    {%- endif -%}
  </div>

  {%- if has_access -%}
  {%- comment -%} ---- WELCOME POP-UP ---- {%- endcomment -%}
  <div id="p2pj-welcome">
    <div class="wc">
      <span class="wx" id="p2pj-wx">✕</span>
      <div class="we">{{ section.settings.welcome_eyebrow | default: 'Welcome, Traveler' }}</div>
      <h2>{{ section.settings.welcome_title | default: 'Your Journey Begins' }}</h2>
      <p>{{ section.settings.welcome_body | default: "This is your map from the shore all the way to freedom. Complete each course to light up the path, earn badges, and unlock what's next. Tap any glowing marker to begin — and check the signs along the way for guidance." }}</p>
      <button class="wbtn" id="p2pj-wstart">Start exploring</button>
      <label class="wchk"><input type="checkbox" id="p2pj-wdont"> Don't show this again</label>
    </div>
  </div>

  {%- comment -%} ---- INFO MODAL ---- {%- endcomment -%}
  <div id="p2pj-modal">
    <div class="modal-card">
      <span class="x" id="p2pj-mx">✕</span>
      <div class="kicker" id="p2pj-mk"></div>
      <h3 id="p2pj-mt"></h3>
      <p id="p2pj-mb"></p>
      <a class="cta" id="p2pj-mc"></a>
    </div>
  </div>

  {%- comment -%} ---- CHECK POPUP (Mindset/Purpose/Heart — pulse items, never gated) ---- {%- endcomment -%}
  <div id="p2pj-check">
    <div class="modal-card">
      <span class="x" id="p2pj-cx">✕</span>
      <div class="kicker">Pulse Check</div>
      <h3 id="p2pj-ct"></h3>
      <ul class="pulse-items" id="p2pj-cb"></ul>
      <a class="cta" id="p2pj-cc"></a>
    </div>
  </div>

  {%- comment -%} ---- INFO / HELP MODAL ---- {%- endcomment -%}
  <div id="p2pj-info">
    <div class="ic">
      <span class="ix">✕</span>
      <div class="ik">Info &amp; Help</div>
      <h3>{{ section.settings.info_title | default: 'About This Journey' }}</h3>
      <div class="ibody">{{ section.settings.info_body }}</div>
      {%- if section.settings.info_link != blank -%}<a class="ilink" href="{{ section.settings.info_link }}">{{ section.settings.info_link_label | default: 'Back to Purpose 2 Profit' }}</a>{%- endif -%}
      <div class="ifoot">{{ section.settings.info_footer | default: '© Black Sheep Creations &amp; Inspirations. All rights reserved.' }}</div>
    </div>
  </div>

  {%- comment -%} ---- POINTS breakdown chart ---- {%- endcomment -%}
  {%- assign p_course  = section.settings.pts_course     | default: 100 -%}
  {%- assign p_dna     = section.settings.pts_brand_dna  | default: 75 -%}
  {%- assign p_side    = section.settings.pts_sidequest  | default: 40 -%}
  {%- assign p_cert    = section.settings.pts_cert       | default: 25 -%}
  {%- assign p_journal = section.settings.pts_journal    | default: 5 -%}
  {%- assign p_streak  = section.settings.pts_streak     | default: 5 -%}
  {%- assign p_level   = section.settings.pts_level_step | default: 250 -%}
  {%- assign p_max     = p_course -%}
  <div id="p2pj-points">
    <div class="pc">
      <span class="px">✕</span>
      <div class="pk">How Points Work</div>
      <h3>Points are proof you showed up</h3>
      <p class="psub">They add up as you do the work — not to race anyone, just to make your progress visible.</p>
      <div class="pt-chart">
        <div class="pt-row"><span class="pt-label">Finish a course</span><span class="pt-bar"><i style="width:{{ p_course | times: 100 | divided_by: p_max }}%"></i></span><b class="pt-val">+{{ p_course }}</b></div>
        <div class="pt-row"><span class="pt-label">Brand DNA Blueprint</span><span class="pt-bar"><i style="width:{{ p_dna | times: 100 | divided_by: p_max }}%"></i></span><b class="pt-val">+{{ p_dna }}</b></div>
        <div class="pt-row"><span class="pt-label">Side quest — Mindset · Purpose · Heart</span><span class="pt-bar"><i style="width:{{ p_side | times: 100 | divided_by: p_max }}%"></i></span><b class="pt-val">+{{ p_side }}</b></div>
        <div class="pt-row"><span class="pt-label">Download a certificate</span><span class="pt-bar"><i style="width:{{ p_cert | times: 100 | divided_by: p_max }}%"></i></span><b class="pt-val">+{{ p_cert }}</b></div>
        <div class="pt-row"><span class="pt-label">Journal entry <em>· up to 5/day</em></span><span class="pt-bar"><i style="width:{{ p_journal | times: 100 | divided_by: p_max }}%"></i></span><b class="pt-val">+{{ p_journal }}</b></div>
        <div class="pt-row"><span class="pt-label">Show up — daily streak <em>· each day</em></span><span class="pt-bar"><i style="width:{{ p_streak | times: 100 | divided_by: p_max }}%"></i></span><b class="pt-val">+{{ p_streak }}</b></div>
      </div>
      <div class="pt-foot"><span class="pt-coin"><svg viewBox="0 0 24 24"><path d="M12 3l2.6 5.6 6.1.7-4.5 4.2 1.2 6L12 16.9 6.6 19.5l1.2-6L3.3 9.3l6.1-.7z"/></svg></span> Every <b>{{ p_level }}</b> points earns a Merit.</div>
      <p class="pt-note">These numbers will grow with you — as new courses land, so might new ways to earn.</p>
    </div>
  </div>

  {%- comment -%} ---- JOURNEY BEGINS onboarding ---- {%- endcomment -%}
  {%- assign lesson1_url = first_course_url -%}
  {%- assign brand_dna = section.settings.brand_dna_url | default: '/pages/brand-haus' -%}
  <div id="p2pj-begin">
    <div class="bc">
      <span class="bx">✕</span>

      <div class="step on" data-step="welcome1">
        <div class="be">A Note From Andrea</div>
        <h3>Welcome to Purpose 2 Profit</h3>
        <p>Welcome to <strong>The Purpose 2 Profit Learning Journey</strong>, powered by Black Sheep Creations &amp; Inspirations.</p>
        <p>I'm Andrea, and I built this program because I know exactly where you're standing right now — and I am so proud of you for <strong>choosing YOU</strong>.</p>
        <p>Maybe you're excited. Maybe, if I'm honest, there's also a quieter thought sitting underneath it: <em>"I hope this wasn't a mistake."</em></p>
        <p>If that's you, take a breath.</p>
        <p>That feeling doesn't mean you got it wrong. It just means you're about to do something new — and new things can feel like this right before they start.</p>
        <button class="btn gold" data-go="welcome2">Next</button>
      </div>

      <div class="step" data-step="welcome2">
        <div class="be">A Note From Andrea</div>
        <h3>You Have a Founder Fingerprint</h3>
        <p>Here's what I want you to know before anything else: <strong>you weren't created to build a copy of someone else's business.</strong></p>
        <p>You have a <span class="hl">Founder Fingerprint</span> — a purpose, a spark, a way of doing things that's yours alone. No one else on this trail has it, and no one else ever will. That's not a slogan sitting in the background. It's the whole reason this journey starts with figuring out who you are before it ever asks you to build anything at all.</p>
        <p>You're standing at the very start of the trail — <strong>Know · Build · Launch · Grow</strong>. You don't need to see the whole path to take the first step on it. You just need to be here, willing to start.</p>
        <p class="bar-line">That's it. That's the bar.</p>
        <p>Before you open Lesson 1, a few quick things.</p>
        <button class="btn gold" data-go="choice">Next</button>
      </div>

      <div class="step" data-step="choice">
        <div class="be">Before You Begin</div>
        <h3>Your Journey Begins Here</h3>
        <p>One quick question before you step onto the path.</p>
        <p class="q">Have you completed your Brand DNA Blueprint?</p>
        <div class="choices">
          <button class="btn gold" data-go="main" data-dna-done>Yes, I've completed it</button>
          <button class="btn ghost" data-go="notyet">Not yet</button>
        </div>
      </div>

      <div class="step" data-step="notyet">
        <div class="be">Start Strong</div>
        <h3>Build It Around You</h3>
        <p>This journey works best when it's built around who you are, not a generic template. Take 10 minutes now:</p>
        <a class="cont" href="{{ brand_dna }}">Start My Brand DNA Blueprint</a>
        <p style="margin-top:16px;">Come back here the moment you're done — Lesson 1 will be unlocked and waiting for you.</p>
        <span class="skip" data-go="main">Skip for now — start Lesson 1 anyway</span>
      </div>

      <div class="step" data-step="main">
        <div class="be">You're In</div>
        <h3>Welcome Aboard</h3>
        <p>Perfect — Lesson 1 is unlocked and waiting for you below.</p>

        <h4>How This Journey Works</h4>
        <p style="margin-bottom:8px;">A few quick things so nothing here feels unfamiliar:</p>
        <ul class="works">
          <li><b>The map is your progress.</b> Every course you finish leads to the next step on your Journey Map — you'll always see how far you've come, not just how far you have to go.</li>
          <li><b>Badges mark real moments, not busywork.</b> Some come from finishing a framework leg (RAFT, GROWS, ROOTED), some from a streak, some just for showing up at the right time.</li>
          <li><b>Points and streaks make progress visible</b> — not to compete with anyone else. Your pace is your pace.</li>
          <li><b>Some courses unlock in order.</b> That's on purpose — this journey is built to take you somewhere, not hand you a library and hope you find your way.</li>
          <li><b>You'll always know where you are.</b> If you're ever unsure what's next, the Journey Map shows you.</li>
          <li><b>Don't skip your bonus checkpoints.</b> Mindset, Purpose, and Heart Checks help you thrive and stay on track between courses.</li>
        </ul>

        <a class="cont" href="{{ lesson1_url }}">Continue to Lesson 1: RAFT — Your Life Raft</a>
      </div>

    </div>
  </div>

  {%- comment -%} ---- persistent corner help button ---- {%- endcomment -%}
  <a class="p2pj-corner-info" href="#" data-info data-tip="Info, rules &amp; help" aria-label="Info and Help"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M12 11v5.5" stroke-linecap="round"/><circle cx="12" cy="7.6" r="1.1" fill="#fff" stroke="none"/></svg></a>
  {%- endif -%}
</div>

{%- if has_access -%}
