    cert:    {{ section.settings.pts_cert       | default: 25 }},
    journal: {{ section.settings.pts_journal    | default: 5 }},
    streak:  {{ section.settings.pts_streak     | default: 5 }},
    level:   {{ section.settings.pts_level_step | default: 250 }}
  };
</script>
<script src="{{ 'p2p-progress.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'p2p-journey.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

