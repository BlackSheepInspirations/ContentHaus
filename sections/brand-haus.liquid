{% comment %}
  The AI Creator's Brand Haus — main tool section.
  Gated on customer.tags contains "brand-haus-access" (added by its own
  Shopify Flow automation on order paid — separate product/tag from
  Marketing Haus's own access control, so the two are independently
  purchasable). request.design_mode bypasses the gate inside the theme
  editor only.

  Split out of Marketing Haus (see docs/brand-dna-working-canon.md) since
  the Brand DNA Blueprint grew into flagship-product weight of its own —
  the Founder Interview, Branding Studio, and Logo Studio all live here
  now. Marketing Haus keeps a lighter, manual Brand Kit for people who
  own it without Brand Haus.
{% endcomment %}

{% assign bh_has_access = false %}
{% if customer and customer.tags contains section.settings.access_tag %}
  {% assign bh_has_access = true %}
{% endif %}
{% if request.design_mode %}
  {% assign bh_has_access = true %}
{% endif %}
{% comment %} master all-access tag unlocks every Haus {% endcomment %}
{% if customer and customer.tags contains 'all-access' %}
  {% assign bh_has_access = true %}
{% endif %}

{{ 'brand-haus.css' | asset_url | stylesheet_tag }}

{% comment %}
  Rendered as a sibling of #brand-haus-app, never inside it — the JS does
  root.innerHTML = "" on every re-render.
{% endcomment %}
<div class="bh-brand-header">
  <div class="bh-marketing__hero">
    <p class="bh-marketing__eyebrow">{{ section.settings.brand_eyebrow }}</p>
    <h1 class="bh-marketing__heading">{{ section.settings.brand_heading | replace: 'Brand', '<span class="bh-heading-accent">Brand</span>' }}</h1>
    <p class="bh-marketing__tagline">{{ section.settings.brand_tagline | replace: 'Brand DNA Blueprint', '<span class="bh-heading-accent">Brand DNA Blueprint</span>' }}</p>
    <div class="bh-marketing__subheading">{{ section.settings.brand_subheading }}</div>
  </div>
</div>

{% if bh_has_access %}
  <div id="brand-haus-app" data-section-id="{{ section.id }}"></div>

  {% comment %}
    Optional per-profile hero art for Chapter 1's identity section — one
    image per matched profile, named to match brand-haus-results.js's own
    profileSlug() helper. asset_url doesn't validate the file exists, so
    this stays harmless (renderChapter1's <img onerror> just hides itself)
    until each file is actually uploaded to assets/.
  {% endcomment %}
  <script>
    window.BrandHausHeroImages = {
      "trusted-guide": "{{ 'brand-haus-hero-trusted-guide.jpg' | asset_url }}",
      "bold-pioneer": "{{ 'brand-haus-hero-bold-pioneer.jpg' | asset_url }}",
      "cozy-craftsman": "{{ 'brand-haus-hero-cozy-craftsman.jpg' | asset_url }}",
      "elevated-icon": "{{ 'brand-haus-hero-elevated-icon.jpg' | asset_url }}",
      "free-spirit": "{{ 'brand-haus-hero-free-spirit.jpg' | asset_url }}",
      "joyful-connector": "{{ 'brand-haus-hero-joyful-connector.jpg' | asset_url }}",
      "quiet-authority": "{{ 'brand-haus-hero-quiet-authority.jpg' | asset_url }}",
      "modern-minimalist": "{{ 'brand-haus-hero-modern-minimalist.jpg' | asset_url }}",
      "community-builder": "{{ 'brand-haus-hero-community-builder.jpg' | asset_url }}",
      "luxe-rebel": "{{ 'brand-haus-hero-luxe-rebel.jpg' | asset_url }}",
      "trail-forger": "{{ 'brand-haus-hero-trail-forger.jpg' | asset_url }}"
    };
  </script>

  <script src="{{ 'brand-haus-util.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'brand-haus-engine.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'brand-haus-generators.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'brand-haus-favorites.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'brand-haus-identity.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'brand-haus-branddna.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'brand-haus-wheel.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'brand-haus-branding.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'brand-haus-logo.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'brand-haus-founderinterview.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'brand-haus-pathintake.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'brand-haus-results.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'brand-haus-blueprint.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'brand-haus-playbook-content.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'brand-haus-playbook.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'brand-haus-brandkit.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'brand-haus-generators-businesscardkit.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'brand-haus-generators-mediakit.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'brand-haus-generators-thankyoucard.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'brand-haus-generators-giftmessage.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'brand-haus-ui.js' | asset_url }}" defer="defer"></script>
{% else %}
  <div class="bh-locked">
    <h2 class="bh-locked__heading">{{ section.settings.locked_heading | replace: 'Brand', '<span class="bh-heading-accent">Brand</span>' }}</h2>
    <div class="bh-locked__body">{{ section.settings.locked_body }}</div>
    <div class="bh-locked__actions">
      {% if section.settings.access_product %}
        <a href="{{ section.settings.access_product.url }}" class="bh-btn bh-btn--copy">
          Get Access{% if section.settings.access_product.price %} — {{ section.settings.access_product.price | money }}{% endif %}
        </a>
      {% endif %}
      {% if section.settings.learn_more_url != blank %}
        <a href="{{ section.settings.learn_more_url }}" class="bh-btn bh-btn--reset bh-locked__learn-more">Learn more</a>
      {% endif %}
    </div>
  </div>
{% endif %}

{% render 'haus-links', current: 'brand-haus' %}

{% schema %}
{
  "name": "Brand Haus Builder",
  "settings": [
    {
      "type": "text",
      "id": "brand_eyebrow",
      "label": "Eyebrow text",
      "default": "Black Sheep Creations & Inspirations"
    },
    {
      "type": "text",
      "id": "brand_heading",
      "label": "Heading",
      "default": "The Brand Haus"
    },
    {
      "type": "text",
      "id": "brand_tagline",
      "label": "Tagline (smaller line under the heading)",
      "default": "Where You Define Your Brand DNA Blueprint™"
    },
    {
      "type": "textarea",
      "id": "brand_subheading",
      "label": "Subheading",
      "default": "Discover who you are as a brand before you create anything.<br>Powered by Black Sheep Creations."
    },
    {
      "type": "text",
      "id": "access_tag",
      "label": "Access tag",
      "default": "brand-haus-access",
      "info": "Customer tag that unlocks the tool. Must match the tag your Shopify Flow automation adds on purchase."
    },
    {
      "type": "product",
      "id": "access_product",
      "label": "Access product",
      "info": "Shown as the \"Get Access\" button for shoppers who don't have the tag yet."
    },
    {
      "type": "url",
      "id": "learn_more_url",
      "label": "Learn more link",
      "info": "e.g. link to your Brand Haus marketing page."
    },
    {
      "type": "text",
      "id": "locked_heading",
      "label": "Locked state heading",
      "default": "Unlock Brand Haus"
    },
    {
      "type": "richtext",
      "id": "locked_body",
      "label": "Locked state body",
      "default": "<p>Get instant access to the Brand DNA Assessment, Branding Studio, and Logo Studio — discover your brand identity before you create anything else.</p>"
    }
  ],
  "presets": [
    {
      "name": "Brand Haus Builder"
    }
  ]
}
{% endschema %}
