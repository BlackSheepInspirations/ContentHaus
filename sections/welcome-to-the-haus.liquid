{%- comment -%}
  Welcome to the Haus — public top-of-funnel landing for the whole Purpose 2 Profit ecosystem.
  Funnel flow: hero → transformation → meet the Hauses → offer (subscription-first) → proof → FAQ → CTA.
  Ungated (sells to cold traffic). Prices pull live from the products via all_products.
  OS aesthetic (black-opal + aurora + gold). Added 2026-08-07. See docs/p2p-access-mapping.md.
{%- endcomment -%}

{%- assign os_handle = section.settings.os_product | default: 'p2p-os-access' -%}
{%- assign os = all_products[os_handle] -%}

{%- assign hausen = 'content-haus-access-pass^Content Haus^Image & design prompts for any AI tool^/pages/content-haus-preview^content~marketing-haus-access-pass^Marketing Haus^Copy, ads, email & social content^/pages/marketing-haus-preview^marketing~graphic-haus-access-pass^Graphics Haus^Clipart, plates, mascots & a full studio^/pages/graphic-haus-preview^graphics~project-haus-access-pass^Project Haus^Journals, planners, stickers & print^/pages/project-haus-preview^project~brand-haus-access-pass^Brand Haus^Founders Assessment + Brand & Logo Studio^/pages/brand-haus-preview^brand~growth-haus-access-pass^Growth Haus^Your ROOTED launch cockpit, idea to live^/pages/growth-haus-preview^growth' | split: '~' -%}
{%- assign gpts = 'idea-haus-gpt^Frank^Your idea & validation Custom GPT^idea~build-haus-access-pass^Ruth^Your build & structure Custom GPT^build' | split: '~' -%}

<div id="wth">

  {%- comment -%} ---- HERO ---- {%- endcomment -%}
  <section class="wth-hero">
    <div class="wth-wrap">
      <div class="wth-eyebrow">Purpose 2 Profit</div>
      <h1 class="wth-h1">Welcome to the Haus.</h1>
      <p class="wth-lede">Everything you need to <strong>create, brand, and launch</strong> — the complete creator operating system. One membership. Every tool. A clear path from idea to income.</p>
      <div class="wth-cta-row">
        {%- if os != blank -%}<a class="wth-btn wth-btn--primary" href="{{ os.url }}">Get all-access →</a>{%- endif -%}
        <a class="wth-btn wth-btn--ghost" href="#wth-hausen">Explore the Hauses</a>
      </div>
      <div class="wth-hero-note">5 creator Hauses · 2 Custom GPTs · a gamified Learning Journey · one OS</div>
    </div>
  </section>

  {%- comment -%} ---- TRANSFORMATION ---- {%- endcomment -%}
  <section class="wth-transform">
    <div class="wth-wrap">
      <div class="wth-pains">
        <span class="wth-pains__label">Sound familiar?</span>
        <ul>
          <li>A dozen half-used AI tools that don't talk to each other.</li>
          <li>The blank-page stare every time you sit down to make something.</li>
          <li>No system tying your brand, your products, and your launch together.</li>
        </ul>
      </div>
      <div class="wth-fix">
        <span class="wth-fix__arrow" aria-hidden="true">→</span>
        <p>The Haus is <strong>one connected system</strong>: describe your idea once, and every Haus hands you the right tool at the right step — on-brand, print-ready, launch-ready.</p>
      </div>
    </div>
  </section>

  {%- comment -%} ---- MEET THE HAUSEN ---- {%- endcomment -%}
  <section class="wth-hausen" id="wth-hausen">
    <div class="wth-wrap">
      <h2 class="wth-h2">Meet the Hauses</h2>
      <p class="wth-sub">Each Haus is a focused tool you can own on its own — or unlock them all with the membership.</p>

      {%- comment -%} OS spotlight {%- endcomment -%}
      {%- if os != blank -%}
      <a class="wth-os" href="{{ os.url }}">
        <img class="wth-os__emblem" src="{{ 'haus-emblem-p2p.png' | asset_url }}" alt="Purpose 2 Profit" loading="lazy" width="96" height="96">
        <div class="wth-os__body">
          <div class="wth-os__badge">The hub</div>
          <h3 class="wth-os__name">The Purpose 2 Profit OS</h3>
          <p class="wth-os__desc">Your member home base — the Learning Journey, every Haus, both GPTs, your progress, community, and daily momentum, all in one place.</p>
        </div>
        <div class="wth-os__cta"><span>Enter the OS</span> <span aria-hidden="true">→</span></div>
      </a>
      {%- endif -%}

      {%- comment -%} the 6 tool Hauses {%- endcomment -%}
      <div class="wth-grid">
        {%- for h in hausen -%}
          {%- assign p = h | split: '^' -%}
          {%- assign prod = all_products[p[0]] -%}
          <div class="wth-card">
            <img class="wth-card__emblem" src="{{ p[4] | prepend: 'haus-emblem-' | append: '.png' | asset_url }}" alt="{{ p[1] }} emblem" loading="lazy" width="80" height="80">
            <h3 class="wth-card__name">{{ p[1] }}</h3>
            <p class="wth-card__tag">{{ p[2] }}</p>
            <div class="wth-card__foot">
              {%- if prod != blank -%}<span class="wth-card__price">{{ prod.price | money }}</span>{%- endif -%}
              <span class="wth-card__links">
                <a href="{{ p[3] }}">Learn more</a>
                {%- if prod != blank -%}<a class="wth-card__get" href="{{ prod.url }}">Get it →</a>{%- endif -%}
              </span>
            </div>
          </div>
        {%- endfor -%}
      </div>

      {%- comment -%} the 2 GPTs {%- endcomment -%}
      <h3 class="wth-gpt-h">Plus two Custom GPTs</h3>
      <div class="wth-gpts">
        {%- for g in gpts -%}
          {%- assign p = g | split: '^' -%}
          {%- assign prod = all_products[p[0]] -%}
          <div class="wth-gpt">
            <div class="wth-gpt__avatar"><img src="{{ p[3] | prepend: 'haus-emblem-' | append: '.png' | asset_url }}" alt="{{ p[1] }}" loading="lazy" width="48" height="48"></div>
            <div class="wth-gpt__body">
              <h4 class="wth-gpt__name">{{ p[1] }}</h4>
              <p class="wth-gpt__tag">{{ p[2] }}</p>
            </div>
            {%- if prod != blank -%}<a class="wth-gpt__get" href="{{ prod.url }}">{{ prod.price | money }} →</a>{%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    </div>
  </section>

  {%- comment -%} ---- THE OFFER (subscription-first) ---- {%- endcomment -%}
  <section class="wth-offer" id="wth-offer">
    <div class="wth-wrap">
      <h2 class="wth-h2">Get everything — the whole Haus.</h2>
      <p class="wth-sub">The best way in: one membership, every tool, always up to date.</p>

      {%- if os != blank -%}
      <div class="wth-anchor">
        <div class="wth-anchor__tag">Best value · Full access</div>
        <h3 class="wth-anchor__name">Purpose 2 Profit — Full Membership</h3>
        <ul class="wth-anchor__list">
          <li>All 5 creator Hauses + Brand Haus</li>
          <li>Both Custom GPTs — Frank &amp; Ruth</li>
          <li>The full gamified Learning Journey — 5 realms, 50+ courses</li>
          <li>Community, daily momentum, certificates &amp; every future update</li>
        </ul>
        <div class="wth-anchor__buy">
          {%- if os.price > 0 -%}
            <span class="wth-anchor__price">{{ os.price | money }}<span class="wth-anchor__per"> · membership</span></span>
          {%- else -%}
            <span class="wth-anchor__price wth-anchor__price--sub">Membership<span class="wth-anchor__per"> · choose your plan at checkout</span></span>
          {%- endif -%}
          <a class="wth-btn wth-btn--primary" href="{{ os.url }}">Start your membership →</a>
        </div>
      </div>
      {%- endif -%}

      <div class="wth-ala">
        <div class="wth-ala__label">Or start with just one Haus</div>
        <div class="wth-ala__grid">
          {%- for h in hausen -%}
            {%- assign p = h | split: '^' -%}
            {%- assign prod = all_products[p[0]] -%}
            {%- if prod != blank -%}
              <a class="wth-ala__item" href="{{ prod.url }}">
                <span class="wth-ala__name">{{ p[1] }}</span>
                <span class="wth-ala__price">{{ prod.price | money }}</span>
              </a>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>
    </div>
  </section>

  {%- comment -%} ---- SOCIAL PROOF (placeholder — swap with real reviews) ---- {%- endcomment -%}
  <section class="wth-proof">
    <div class="wth-wrap">
      <h2 class="wth-h2">From the flock</h2>
      <p class="wth-sub wth-placeholder-note">★ Sample quotes — replace with real member reviews.</p>
      <div class="wth-proof__grid">
        <blockquote class="wth-quote"><p>"I went from a folder of half-finished ideas to a launched product in a weekend. The Haus just handed me the next step every time."</p><cite>— Placeholder Member</cite></blockquote>
        <blockquote class="wth-quote"><p>"Every tool finally speaks the same language. My brand, my listings, my launch — all on-brand without me babysitting it."</p><cite>— Placeholder Member</cite></blockquote>
        <blockquote class="wth-quote"><p>"The GPTs alone are worth it. Frank helps me decide what to build, Ruth helps me build it right."</p><cite>— Placeholder Member</cite></blockquote>
      </div>
    </div>
  </section>

  {%- comment -%} ---- FAQ ---- {%- endcomment -%}
  <section class="wth-faq">
    <div class="wth-wrap">
      <h2 class="wth-h2">Questions, answered</h2>
      <details class="wth-q"><summary>Do I need all the Hauses?</summary><p>No — every Haus works on its own, so you can start with just the one you need. Most people find the full membership pays for itself fast, since the Hauses are built to work together.</p></details>
      <details class="wth-q"><summary>Is the membership a subscription?</summary><p>The full-access membership keeps you in every tool with every update. Individual Haus passes are also available if you'd rather own just one.</p></details>
      <details class="wth-q"><summary>How do I get access after I buy?</summary><p>It's instant and digital — your access unlocks in your account the moment you buy. The Custom GPTs (Frank &amp; Ruth) send you their private ChatGPT link right after checkout.</p></details>
      <details class="wth-q"><summary>What are Frank and Ruth?</summary><p>Two Custom GPTs that live in ChatGPT. Frank helps you find and validate your next product idea; Ruth helps you structure and build it.</p></details>
    </div>
  </section>

  {%- comment -%} ---- FINAL CTA ---- {%- endcomment -%}
  <section class="wth-final">
    <div class="wth-wrap">
      <h2 class="wth-final__h">Ready to build in the Haus?</h2>
      {%- if os != blank -%}<a class="wth-btn wth-btn--primary wth-btn--lg" href="{{ os.url }}">Get all-access →</a>{%- endif -%}
      <p class="wth-final__note">Don't follow the herd. Build like a black sheep.</p>
    </div>
  </section>

</div>

{%- style -%}
  #wth{--wth-bg:#080c16;--wth-bg2:#0e1626;--wth-card:#101c2e;--wth-line:rgba(143,240,224,.16);--wth-mint:#8ff0e0;--wth-gold:#f4e9c9;--wth-text:#e7eef6;--wth-mut:#9db3c2;
    background:var(--wth-bg);color:var(--wth-text);font-family:var(--font-body-family,system-ui);line-height:1.55;overflow:hidden}
  #wth .wth-wrap{max-width:1080px;margin:0 auto;padding:0 22px}
  #wth section{padding:clamp(48px,7vw,88px) 0}
  #wth h2.wth-h2{font-size:clamp(26px,3.4vw,38px);text-align:center;margin:0 0 8px;letter-spacing:-.01em}
  #wth .wth-sub{text-align:center;color:var(--wth-mut);max-width:620px;margin:0 auto 40px;font-size:16px}
  #wth .wth-btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;padding:14px 26px;border-radius:40px;font-weight:700;font-size:15px;letter-spacing:.01em;text-decoration:none;transition:transform .15s ease,box-shadow .15s ease,background .15s ease}
  #wth .wth-btn--primary{background:linear-gradient(135deg,#c9f5ea,#8ff0e0);color:#06120e;box-shadow:0 10px 30px rgba(143,240,224,.22)}
  #wth .wth-btn--primary:hover{transform:translateY(-2px);box-shadow:0 14px 38px rgba(143,240,224,.32)}
  #wth .wth-btn--ghost{background:transparent;color:var(--wth-text);border:1.5px solid var(--wth-line)}
  #wth .wth-btn--ghost:hover{border-color:var(--wth-mint)}
  #wth .wth-btn--lg{padding:17px 34px;font-size:17px}
  /* hero */
  #wth .wth-hero{background:radial-gradient(120% 120% at 20% 0%,#132844 0%,#0a1120 55%,var(--wth-bg) 100%);text-align:center;position:relative}
  #wth .wth-eyebrow{color:var(--wth-mint);font-size:12px;font-weight:700;letter-spacing:.32em;text-transform:uppercase;margin-bottom:18px}
  #wth .wth-h1{font-size:clamp(40px,7vw,76px);line-height:1.02;margin:0 0 18px;letter-spacing:-.02em;text-wrap:balance}
  #wth .wth-lede{max-width:660px;margin:0 auto 30px;font-size:clamp(16px,2.1vw,20px);color:#cdd9e5}
  #wth .wth-cta-row{display:flex;gap:14px;justify-content:center;flex-wrap:wrap}
  #wth .wth-hero-note{margin-top:26px;color:var(--wth-mut);font-size:13px;letter-spacing:.02em}
  /* transform */
  #wth .wth-transform .wth-wrap{display:grid;grid-template-columns:1fr 1fr;gap:26px;align-items:center}
  #wth .wth-pains__label{color:var(--wth-gold);font-weight:700;font-size:13px;letter-spacing:.14em;text-transform:uppercase}
  #wth .wth-pains ul{list-style:none;margin:14px 0 0;padding:0;display:flex;flex-direction:column;gap:12px}
  #wth .wth-pains li{padding-left:24px;position:relative;color:#cdd9e5}
  #wth .wth-pains li::before{content:"✕";position:absolute;left:0;color:#e0645f;font-weight:800}
  #wth .wth-fix{background:linear-gradient(160deg,var(--wth-bg2),var(--wth-card));border:1px solid var(--wth-line);border-radius:18px;padding:26px;display:flex;gap:16px;align-items:flex-start}
  #wth .wth-fix__arrow{color:var(--wth-mint);font-size:30px;line-height:1}
  #wth .wth-fix p{margin:0;font-size:17px}
  /* hausen */
  #wth .wth-os{display:flex;justify-content:space-between;align-items:center;gap:20px;flex-wrap:wrap;background:linear-gradient(135deg,#132844,#0d1a2c);border:1px solid rgba(143,240,224,.3);border-radius:20px;padding:30px 32px;text-decoration:none;color:inherit;margin-bottom:22px;transition:border-color .16s ease,transform .16s ease}
  #wth .wth-os:hover{border-color:var(--wth-mint);transform:translateY(-2px)}
  #wth .wth-os__emblem{width:92px;height:92px;flex:0 0 auto;border-radius:50%;box-shadow:0 6px 20px rgba(0,0,0,.45)}
  #wth .wth-os__body{flex:1;min-width:220px}
  #wth .wth-os__badge{display:inline-block;color:var(--wth-mint);font-size:11px;font-weight:800;letter-spacing:.16em;text-transform:uppercase;margin-bottom:8px}
  #wth .wth-os__name{margin:0 0 6px;font-size:24px}
  #wth .wth-os__desc{margin:0;color:var(--wth-mut);max-width:640px}
  #wth .wth-os__cta{display:flex;gap:8px;align-items:center;color:var(--wth-mint);font-weight:700;white-space:nowrap}
  #wth .wth-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:14px}
  #wth .wth-card{background:var(--wth-card);border:1px solid var(--wth-line);border-radius:16px;padding:22px;display:flex;flex-direction:column;align-items:center;text-align:center;gap:6px;transition:transform .16s ease,border-color .16s ease}
  #wth .wth-card:hover{transform:translateY(-3px);border-color:rgba(143,240,224,.4)}
  #wth .wth-card__emblem{width:88px;height:88px;border-radius:50%;margin-bottom:6px;box-shadow:0 5px 16px rgba(0,0,0,.4);transition:transform .16s ease}
  #wth .wth-card:hover .wth-card__emblem{transform:scale(1.05)}
  #wth .wth-card__name{margin:0;font-size:18px;color:var(--wth-gold)}
  #wth .wth-card__tag{margin:0;color:var(--wth-mut);font-size:14px;flex:1}
  #wth .wth-card__foot{width:100%}
  #wth .wth-card__foot{display:flex;align-items:center;justify-content:space-between;margin-top:10px;gap:10px}
  #wth .wth-card__price{color:var(--wth-mint);font-weight:700}
  #wth .wth-card__links{display:flex;gap:12px;align-items:center;font-size:13.5px}
  #wth .wth-card__links a{color:var(--wth-mut);text-decoration:none}
  #wth .wth-card__links a:hover{color:var(--wth-text)}
  #wth .wth-card__get{color:var(--wth-mint)!important;font-weight:700}
  #wth .wth-gpt-h{text-align:center;margin:40px 0 16px;font-size:15px;letter-spacing:.14em;text-transform:uppercase;color:var(--wth-mut);font-weight:700}
  #wth .wth-gpts{display:grid;grid-template-columns:1fr 1fr;gap:14px}
  #wth .wth-gpt{display:flex;align-items:center;gap:14px;background:var(--wth-card);border:1px solid var(--wth-line);border-radius:16px;padding:18px 20px}
  #wth .wth-gpt__avatar{width:52px;height:52px;flex:0 0 auto;display:flex;align-items:center;justify-content:center;border-radius:50%;overflow:hidden;background:linear-gradient(135deg,#1b3350,#12233a)}
  #wth .wth-gpt__avatar img{width:100%;height:100%;border-radius:50%;object-fit:cover;display:block}
  #wth .wth-gpt__name{margin:0;font-size:17px;color:var(--wth-gold)}
  #wth .wth-gpt__tag{margin:0;color:var(--wth-mut);font-size:13.5px}
  #wth .wth-gpt__body{flex:1}
  #wth .wth-gpt__get{color:var(--wth-mint);font-weight:700;text-decoration:none;white-space:nowrap}
  /* offer */
  #wth .wth-offer{background:linear-gradient(180deg,var(--wth-bg),#0b1524)}
  #wth .wth-anchor{max-width:560px;margin:0 auto;background:linear-gradient(160deg,#14294a,#0e1a2e);border:1.5px solid rgba(143,240,224,.4);border-radius:22px;padding:32px;box-shadow:0 24px 60px rgba(0,0,0,.4)}
  #wth .wth-anchor__tag{display:inline-block;background:rgba(143,240,224,.14);color:var(--wth-mint);font-size:12px;font-weight:800;letter-spacing:.1em;text-transform:uppercase;padding:6px 12px;border-radius:20px;margin-bottom:14px}
  #wth .wth-anchor__name{margin:0 0 16px;font-size:26px}
  #wth .wth-anchor__list{list-style:none;margin:0 0 22px;padding:0;display:flex;flex-direction:column;gap:11px}
  #wth .wth-anchor__list li{padding-left:28px;position:relative}
  #wth .wth-anchor__list li::before{content:"✓";position:absolute;left:0;color:var(--wth-mint);font-weight:800}
  #wth .wth-anchor__buy{display:flex;align-items:center;justify-content:space-between;gap:16px;flex-wrap:wrap;border-top:1px solid var(--wth-line);padding-top:20px}
  #wth .wth-anchor__price{font-size:26px;font-weight:800;color:#fff}
  #wth .wth-anchor__per{font-size:14px;font-weight:500;color:var(--wth-mut)}
  #wth .wth-ala{max-width:760px;margin:34px auto 0;text-align:center}
  #wth .wth-ala__label{color:var(--wth-mut);font-size:14px;margin-bottom:14px}
  #wth .wth-ala__grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:10px}
  #wth .wth-ala__item{display:flex;flex-direction:column;gap:3px;padding:13px;border-radius:12px;background:var(--wth-card);border:1px solid var(--wth-line);text-decoration:none;color:inherit;transition:border-color .15s ease}
  #wth .wth-ala__item:hover{border-color:var(--wth-mint)}
  #wth .wth-ala__name{font-size:14px;font-weight:600}
  #wth .wth-ala__price{color:var(--wth-mint);font-size:13px;font-weight:700}
  /* proof */
  #wth .wth-placeholder-note{color:#c9a24a;font-size:13px}
  #wth .wth-proof__grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:16px}
  #wth .wth-quote{margin:0;background:var(--wth-card);border:1px solid var(--wth-line);border-radius:16px;padding:24px}
  #wth .wth-quote p{margin:0 0 14px;font-size:15.5px;color:#dbe6f0}
  #wth .wth-quote cite{color:var(--wth-mut);font-style:normal;font-size:13.5px;font-weight:600}
  /* faq */
  #wth .wth-q{border:1px solid var(--wth-line);border-radius:12px;padding:2px 18px;margin:0 auto 10px;max-width:760px;background:var(--wth-card)}
  #wth .wth-q summary{cursor:pointer;padding:16px 0;font-weight:600;font-size:16px;list-style:none}
  #wth .wth-q summary::-webkit-details-marker{display:none}
  #wth .wth-q summary::after{content:"+";float:right;color:var(--wth-mint);font-weight:700}
  #wth .wth-q[open] summary::after{content:"–"}
  #wth .wth-q p{margin:0 0 16px;color:var(--wth-mut)}
  /* final */
  #wth .wth-final{text-align:center;background:radial-gradient(120% 120% at 50% 100%,#132844 0%,var(--wth-bg) 60%)}
  #wth .wth-final__h{font-size:clamp(28px,4vw,44px);margin:0 0 24px}
  #wth .wth-final__note{margin-top:22px;color:var(--wth-mut);font-style:italic}
  @media(max-width:720px){
    #wth .wth-transform .wth-wrap{grid-template-columns:1fr}
    #wth .wth-gpts{grid-template-columns:1fr}
    #wth .wth-anchor__buy{flex-direction:column;align-items:stretch;text-align:center}
  }
{%- endstyle -%}

{% schema %}
{
  "name": "Welcome to the Haus",
  "settings": [
    { "type": "text", "id": "os_product", "label": "OS / all-access product handle", "default": "p2p-os-access", "info": "The full-membership subscription product (anchors the offer)." }
  ],
  "presets": [{ "name": "Welcome to the Haus" }]
}
{% endschema %}
