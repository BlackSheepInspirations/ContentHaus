{% comment %}
  Founding Gate — the locked-screen lead-capture landing (built for the store's
  password page, previewable at /pages/founding-gate). ONE Shopify customer form
  joins the Founding Flock waitlist AND unlocks 3 free lead-magnet PDFs:
  customer -> tagged + accepts_marketing -> Klaviyo syncs natively (no API).
  Freebie unlock persists per-browser via localStorage. Self-contained, scoped #fgate.
  Dark "Open Water" teal-navy ground; bright cards float; animated gradient accents.
{% endcomment %}

<div id="fgate">
  <div class="fg-wrap">
    <header class="fg-hero">
      <p class="fg-eyebrow">{{ section.settings.eyebrow | default: 'Black Sheep Creations & Inspirations' }}</p>
      <h1 class="fg-h1">The doors aren’t open yet.<br>But <span class="fg-grad">the flock is forming</span> — and you’re early. We like that.</h1>
      <div class="fg-lede"><p>Here’s the deal: founding members get in <strong>first</strong>, lock in <span class="fg-grad">founder pricing</span> for good <em>(yes, forever — we’re not the raise-it-on-you-later type)</em>, and get a say in what this whole thing becomes. Drop your email, grab <strong class="fg-grad">three free guides</strong>, and claim your spot before the rest of the internet catches on.</p></div>
    </header>

    <p class="fg-freeline">Three guides — actually useful, actually free. Grab all of ’em 👇</p>

    {%- assign covers = 'freebie-cover-starter.jpg,freebie-cover-hooks.jpg,freebie-cover-mindset.jpg' | split: ',' -%}
    <div class="fg-cards">
      {%- for i in (1..3) -%}
        {%- assign tt = 'freebie_' | append: i | append: '_title' -%}
        {%- assign ds = 'freebie_' | append: i | append: '_desc' -%}
        {%- assign ur = 'freebie_' | append: i | append: '_url' -%}
        {%- assign furl = section.settings[ur] -%}
        <div class="fg-card">
          <img class="fg-cover" src="{{ covers[forloop.index0] | asset_url }}" alt="{{ section.settings[tt] }}" width="760" height="1010" loading="lazy">
          <h3>{{ section.settings[tt] }}</h3>
          {%- if section.settings[ds] != blank -%}<p>{{ section.settings[ds] }}</p>{%- endif -%}
          {%- if furl != blank -%}
            <a class="fg-dl" href="{{ furl }}" target="_blank" rel="noopener" download>Download PDF ↓</a>
          {%- else -%}
            <span class="fg-dl fg-dl--soon">Coming soon</span>
          {%- endif -%}
          <span class="fg-lock">🔒 Locked — drop your email</span>
        </div>
      {%- endfor -%}
    </div>

    <div class="fg-gate">
      {%- form 'customer' -%}
        <input type="hidden" name="contact[tags]" value="founding-flock, waitlist, freebies">
        {%- if form.posted_successfully? -%}<p class="fg-posted">🎉 You’re in! Your three guides just unlocked above. Welcome to the flock.</p>{%- endif -%}
        <label class="fg-label" for="fg-name">Drop your name + email — get the goods 👇</label>
        <input class="fg-input fg-input--name" id="fg-name" type="text" name="contact[first_name]" placeholder="First name" autocomplete="given-name" aria-label="First name">
        <div class="fg-row">
          <input class="fg-input" id="fg-email" type="email" name="contact[email]" placeholder="you@email.com" required autocomplete="email" inputmode="email" aria-label="Email address">
          <button class="fg-btn" type="submit">Send me the good stuff →</button>
        </div>
        <p class="fg-fine">{{ section.settings.fine | default: "First to know when the doors swing open. No spam, no nonsense — leave anytime (you won’t want to)." }} <a class="fg-link" href="/policies/privacy-policy" target="_blank" rel="noopener">Privacy Policy</a></p>
        {%- if form.errors -%}<p class="fg-err">Hmm — {{ form.errors | default_errors }}. Already on our list? Your downloads just unlocked above. 👆</p>{%- endif -%}
      {%- endform -%}
    </div>

    <div class="fg-beta">
      <div class="fg-beta-inner">
        <p class="fg-beta-kick">{{ section.settings.beta_kick | default: '⭐ Founding Beta — limited spots' }}</p>
        <h2 class="fg-beta-h">{{ section.settings.beta_heading | default: 'Want to help shape it — and get in the earliest?' }}</h2>
        <p class="fg-beta-desc">{{ section.settings.beta_desc | default: "Our Founding Beta is a small crew of creators who get hands-on early access before anyone else. You’ll test-drive the whole system, tell us what rocks and what’s rubbish, and help us build it right. It’s not for everyone — it’s for the ones who want in on the ground floor." }}</p>
        <ul class="fg-beta-perks">
          <li>🔑 Earliest access — before public launch</li>
          <li>🗣️ A real say in what we build next</li>
          <li>💛 Founder pricing, locked for good</li>
          <li>🤝 A live onboarding call to get you rolling</li>
        </ul>
        <button type="button" class="fg-btn fg-beta-open" aria-haspopup="dialog" aria-controls="fg-beta-modal">{{ section.settings.beta_btn | default: 'Apply to be a Founding Beta Tester →' }}</button>
        <p class="fg-beta-note">{{ section.settings.beta_note | default: 'Takes ~60 seconds · we hand-pick the crew' }}</p>
      </div>
    </div>

    <p class="fg-born">Born an original. <span class="fg-grad">Don’t die a copy.</span></p>
  </div>

  <hdt-modal id="password-form-popup" class="hdt-modal hdt-hidden" color-scheme="scheme-1">
    <h3 slot="header" class="hdt-s-text hdt-text-10xl hdt-font-normal">{{ 'general.password_page.login_form_heading' | t | default: 'Enter using password' }}</h3>
    <div class="fg-pwform">
      {%- form 'storefront_password' -%}
        <input type="password" name="password" id="Password" class="fg-input" autocomplete="current-password" required placeholder="Store password" aria-label="Store password"{% if form.errors %} aria-invalid="true"{% endif %}>
        {%- if form.errors -%}<p class="fg-err">{{ form.errors | default_errors }}</p>{%- endif -%}
        <button name="commit" type="submit" class="fg-btn">Enter →</button>
      {%- endform -%}
    </div>
  </hdt-modal>

  <div class="fg-beta-overlay" id="fg-beta-modal" role="dialog" aria-modal="true" aria-labelledby="fg-beta-title" hidden>
    <div class="fg-beta-card">
      <button type="button" class="fg-beta-x" aria-label="Close">&times;</button>
      <div class="fg-beta-body">
        <p class="fg-beta-kick">⭐ Founding Beta Application</p>
        <h3 class="fg-beta-title" id="fg-beta-title">Tell us a little about you</h3>
        <p class="fg-beta-sub">Six quick taps + your details. We read every single one. 🖤</p>
        {%- form 'customer', class: 'fg-beta-form' -%}
          <input type="hidden" name="contact[tags]" value="founding-flock, beta-applicant" data-beta-tags>
          <input class="fg-input fg-input--name" type="text" name="contact[first_name]" placeholder="First name" autocomplete="given-name" aria-label="First name">
          <input class="fg-input fg-input--name" type="email" name="contact[email]" placeholder="you@email.com" required autocomplete="email" inputmode="email" aria-label="Email address">

          <div class="fg-q">
            <p class="fg-q-label">1 · Where are you in your creator journey?</p>
            <div class="fg-opts">
              <label class="fg-opt"><input type="radio" name="q_stage" data-tag="beta-stage-idea"><span>Just an idea</span></label>
              <label class="fg-opt"><input type="radio" name="q_stage" data-tag="beta-stage-making"><span>Making, not selling</span></label>
              <label class="fg-opt"><input type="radio" name="q_stage" data-tag="beta-stage-selling"><span>Selling a little</span></label>
              <label class="fg-opt"><input type="radio" name="q_stage" data-tag="beta-stage-scaling"><span>Established &amp; scaling</span></label>
            </div>
          </div>

          <div class="fg-q">
            <p class="fg-q-label">2 · What do you want to sell?</p>
            <div class="fg-opts">
              <label class="fg-opt"><input type="radio" name="q_sell" data-tag="beta-sell-digital"><span>Digital products</span></label>
              <label class="fg-opt"><input type="radio" name="q_sell" data-tag="beta-sell-pod"><span>Print-on-demand</span></label>
              <label class="fg-opt"><input type="radio" name="q_sell" data-tag="beta-sell-services"><span>Services / coaching</span></label>
              <label class="fg-opt"><input type="radio" name="q_sell" data-tag="beta-sell-content"><span>Content &amp; audience</span></label>
              <label class="fg-opt"><input type="radio" name="q_sell" data-tag="beta-sell-unsure"><span>Still figuring it out</span></label>
            </div>
          </div>

          <div class="fg-q">
            <p class="fg-q-label">3 · How much time can you give over the next few weeks?</p>
            <div class="fg-opts">
              <label class="fg-opt"><input type="radio" name="q_time" data-tag="beta-time-low"><span>An hour or two</span></label>
              <label class="fg-opt"><input type="radio" name="q_time" data-tag="beta-time-mid"><span>A few hours a week</span></label>
              <label class="fg-opt"><input type="radio" name="q_time" data-tag="beta-time-allin"><span>I’m all in</span></label>
            </div>
          </div>

          <div class="fg-q">
            <p class="fg-q-label">4 · Down to give honest feedback along the way?</p>
            <div class="fg-opts">
              <label class="fg-opt"><input type="radio" name="q_fb" data-tag="beta-fb-yes"><span>Yes, love to</span></label>
              <label class="fg-opt"><input type="radio" name="q_fb" data-tag="beta-fb-maybe"><span>Maybe</span></label>
              <label class="fg-opt"><input type="radio" name="q_fb" data-tag="beta-fb-no"><span>Rather not</span></label>
            </div>
          </div>

          <div class="fg-q">
            <p class="fg-q-label">5 · ⭐ Would you join a live onboarding call to get started?</p>
            <div class="fg-opts">
              <label class="fg-opt"><input type="radio" name="q_call" data-tag="beta-call-yes"><span>Yes, count me in</span></label>
              <label class="fg-opt"><input type="radio" name="q_call" data-tag="beta-call-maybe"><span>Maybe, depends on timing</span></label>
              <label class="fg-opt"><input type="radio" name="q_call" data-tag="beta-call-no"><span>Prefer to go solo</span></label>
            </div>
          </div>

          <div class="fg-q">
            <p class="fg-q-label">6 · What are you hoping this finally helps you do?</p>
            <div class="fg-opts">
              <label class="fg-opt"><input type="radio" name="q_goal" data-tag="beta-goal-launch"><span>Finally launch the thing</span></label>
              <label class="fg-opt"><input type="radio" name="q_goal" data-tag="beta-goal-firstsale"><span>Make my first sale</span></label>
              <label class="fg-opt"><input type="radio" name="q_goal" data-tag="beta-goal-consistency"><span>Stay consistent</span></label>
              <label class="fg-opt"><input type="radio" name="q_goal" data-tag="beta-goal-grow"><span>Grow what I’ve started</span></label>
              <label class="fg-opt"><input type="radio" name="q_goal" data-tag="beta-goal-clarity"><span>Get clarity &amp; direction</span></label>
              <label class="fg-opt"><input type="radio" name="q_goal" data-tag="beta-goal-other" data-other="1"><span>Something else…</span></label>
            </div>
            <input type="text" class="fg-input fg-other-input" id="fg-goal-other" placeholder="Tell us in a few words…" maxlength="80" aria-label="Your answer" hidden>
          </div>

          <button type="submit" class="fg-btn fg-beta-submit">Submit my application →</button>
          {%- if form.errors -%}<p class="fg-err">Hmm — {{ form.errors | default_errors }}.</p>{%- endif -%}
          <p class="fg-fine" style="margin-top:14px">We hand-pick the founding crew — if it’s a fit, you’ll hear from us. <a class="fg-link" href="/policies/privacy-policy" target="_blank" rel="noopener">Privacy Policy</a></p>
        {%- endform -%}
      </div>
      <div class="fg-beta-thanks" hidden>
        <p class="fg-beta-kick">🖤 You’re in the flock</p>
        <h3 class="fg-beta-title">Application received.</h3>
        <p class="fg-beta-sub">Thank you! We’re working through applicants and reaching out to fits soon — keep an eye on your inbox. Spots are limited, but chosen or not, your founding-flock spot is locked in at a special rate. Can’t wait to see you inside. 🌊</p>
        <button type="button" class="fg-btn fg-beta-x2">Done</button>
      </div>
    </div>
  </div>
</div>

{%- style -%}
#fgate{--ink:#1A1815;--gold:#C9A84C;--goldb:#E4AE3C;--teal:#0D7377;--mut:#6B6860;--line:#e2ddd2;
  background:linear-gradient(135deg,#0c353b,#122540,#0e1a33,#122540,#0c353b);background-size:300% 300%;animation:fgbg 26s ease infinite;
  color:#e9f1ef;font-family:-apple-system,'Segoe UI',Roboto,sans-serif;padding:56px 20px 66px;min-height:100vh;box-sizing:border-box}
@keyframes fgbg{0%{background-position:0% 50%}50%{background-position:100% 50%}100%{background-position:0% 50%}}
#fgate *{box-sizing:border-box}
#fgate .fg-wrap{max-width:960px;margin:0 auto}
#fgate .fg-hero{text-align:center;max-width:780px;margin:0 auto 30px}
#fgate .fg-eyebrow{font-size:12px;font-weight:800;letter-spacing:.22em;text-transform:uppercase;color:var(--goldb);margin:0 0 14px}
#fgate .fg-h1{font-family:Georgia,'Iowan Old Style',serif;font-size:clamp(30px,5vw,46px);line-height:1.1;font-weight:700;color:#F4F1EA;margin:0 0 16px;text-shadow:0 2px 20px rgba(0,0,0,.3)}
#fgate .fg-lede{font-size:clamp(15px,2.2vw,18px);line-height:1.62;color:#cdd9d8}
#fgate .fg-lede strong{color:#F4F1EA}
#fgate .fg-lede em{color:#9db0af;font-style:italic}
#fgate .fg-grad{background:linear-gradient(90deg,#E4AE3C,#34c2b8,#5a97e6,#34c2b8,#E4AE3C);background-size:200% auto;-webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent;color:transparent;font-weight:800;animation:fgflow 5s linear infinite}
@keyframes fgflow{to{background-position:200% center}}
@media(prefers-reduced-motion:reduce){#fgate,#fgate .fg-grad,#fgate .fg-btn,#fgate .fg-dl{animation:none}}
#fgate .fg-freeline{text-align:center;font:700 15.5px/1.4 Georgia,serif;color:#eef4f2;margin:0 auto 22px}
#fgate .fg-cards{display:grid;grid-template-columns:repeat(3,1fr);gap:20px;margin:0 auto 30px;max-width:860px}
@media(max-width:720px){#fgate .fg-cards{grid-template-columns:1fr;max-width:340px}}
#fgate .fg-card{background:#fff;border:1.5px solid var(--goldb);border-radius:16px;padding:16px;text-align:center;box-shadow:0 16px 40px rgba(0,0,0,.32);display:flex;flex-direction:column}
#fgate .fg-cover{width:100%;height:auto;border-radius:9px;border:1px solid var(--line);margin-bottom:14px}
#fgate .fg-card h3{font:700 15.5px/1.3 Georgia,serif;color:var(--ink);margin:0 0 6px}
#fgate .fg-card p{font-size:12.5px;line-height:1.45;color:var(--mut);margin:0 0 12px}
#fgate .fg-dl,#fgate .fg-lock{margin-top:auto;font-weight:800;font-size:13px;border-radius:40px;padding:11px 16px;display:block}
#fgate .fg-dl{background:linear-gradient(90deg,#E4AE3C,#34c2b8,#5a97e6,#34c2b8,#E4AE3C);background-size:200% auto;animation:fgflow 5s linear infinite;color:#14201f;text-decoration:none;display:none}
#fgate .fg-dl--soon{background:#eee7d6;color:#9a8f74;cursor:default}
#fgate .fg-lock{background:#f4efe3;color:var(--mut);border:1px dashed var(--gold)}
#fgate.is-unlocked .fg-dl{display:block}
#fgate.is-unlocked .fg-lock{display:none}
#fgate .fg-gate{max-width:560px;margin:0 auto;background:#fff;border:1.5px solid var(--goldb);border-radius:20px;padding:24px;box-shadow:0 20px 48px rgba(0,0,0,.35)}
#fgate .fg-label{display:block;font:800 15px/1.3 -apple-system,sans-serif;color:var(--ink);margin-bottom:12px;text-align:center}
#fgate .fg-row{display:flex;gap:10px;flex-wrap:wrap}
#fgate .fg-input{flex:1 1 220px;min-width:0;border:1.5px solid var(--line);border-radius:40px;padding:14px 18px;font-size:15px;color:var(--ink);background:#F7F5EF;outline:none}
#fgate .fg-input:focus{border-color:var(--teal)}
#fgate .fg-input--name{width:100%;flex:none;margin-bottom:10px}
#fgate .fg-btn{flex:0 0 auto;background:linear-gradient(90deg,#E4AE3C,#34c2b8,#5a97e6,#34c2b8,#E4AE3C);background-size:200% auto;animation:fgflow 5s linear infinite;color:#14201f;font-weight:800;font-size:15px;border:0;border-radius:40px;padding:14px 24px;cursor:pointer;transition:transform .15s,box-shadow .15s;box-shadow:0 10px 26px rgba(0,0,0,.3)}
#fgate .fg-btn:hover{transform:translateY(-2px);box-shadow:0 14px 32px rgba(0,0,0,.4)}
#fgate .fg-fine{font-size:12px;color:var(--mut);text-align:center;margin:12px 0 0}
#fgate .fg-link{color:var(--teal);text-decoration:underline;font-weight:700;white-space:nowrap}
#fgate .fg-err{font-size:12.5px;color:#c0473f;text-align:center;margin:10px 0 0}
#fgate .fg-posted{background:#eaf6ef;color:#1c7a4a;border-radius:12px;padding:10px 14px;text-align:center;font-weight:700;font-size:13.5px;margin:0 0 14px}
#fgate .fg-born{text-align:center;font:700 16px/1.4 Georgia,serif;color:#F4F1EA;margin:34px 0 0}
#fgate .fg-pwform{display:flex;flex-direction:column;gap:12px}
#fgate .fg-pwform .fg-btn{width:100%;justify-content:center}
/* Founding Beta describer */
#fgate .fg-beta{max-width:720px;margin:36px auto 0}
#fgate .fg-beta-inner{background:rgba(255,255,255,.045);border:1.5px solid var(--goldb);border-radius:20px;padding:28px 26px;text-align:center}
#fgate .fg-beta-kick{font:800 12px/1 -apple-system,sans-serif;letter-spacing:.14em;text-transform:uppercase;color:var(--goldb);margin:0 0 12px}
#fgate .fg-beta-h{font:700 clamp(21px,3.4vw,28px)/1.2 Georgia,serif;color:#F4F1EA;margin:0 0 12px}
#fgate .fg-beta-desc{font-size:15px;line-height:1.62;color:#cdd9d8;margin:0 auto 18px;max-width:560px}
#fgate .fg-beta-perks{list-style:none;padding:0;margin:0 auto 22px;max-width:470px;display:grid;grid-template-columns:1fr 1fr;gap:9px 18px;text-align:left}
@media(max-width:560px){#fgate .fg-beta-perks{grid-template-columns:1fr;max-width:280px}}
#fgate .fg-beta-perks li{font-size:13.5px;line-height:1.4;color:#dbe7e5}
#fgate .fg-beta-note{font-size:12px;color:#9db0af;margin:12px 0 0}
#fgate .fg-beta-open.is-done{background:#eaf6ef;color:#1c7a4a;animation:none;box-shadow:none;cursor:default}
#fgate .fg-beta-open.is-done:hover{transform:none}
/* Founding Beta modal */
#fgate .fg-beta-overlay{position:fixed;inset:0;z-index:99999;display:flex;align-items:flex-start;justify-content:center;padding:24px 16px;overflow-y:auto;background:rgba(6,18,22,.74);-webkit-backdrop-filter:blur(4px);backdrop-filter:blur(4px)}
#fgate .fg-beta-overlay[hidden]{display:none}
#fgate .fg-beta-card{position:relative;background:#fff;border:1.5px solid var(--goldb);border-radius:20px;padding:30px 26px;max-width:530px;width:100%;margin:auto;box-shadow:0 30px 70px rgba(0,0,0,.55)}
#fgate .fg-beta-x{position:absolute;top:10px;right:14px;background:none;border:0;font-size:28px;line-height:1;color:var(--mut);cursor:pointer;padding:4px 8px}
#fgate .fg-beta-x:hover{color:var(--ink)}
#fgate .fg-beta-card .fg-beta-kick{color:var(--gold)}
#fgate .fg-beta-title{font:700 22px/1.2 Georgia,serif;color:var(--ink);margin:0 0 6px}
#fgate .fg-beta-sub{font-size:13.5px;line-height:1.5;color:var(--mut);margin:0 0 18px}
#fgate .fg-beta-form .fg-input{background:#F7F5EF;width:100%;flex:none;margin-bottom:10px}
#fgate .fg-other-input{margin-top:4px;margin-bottom:0}
#fgate .fg-q{margin:16px 0 0;text-align:left}
#fgate .fg-q-label{font:800 13.5px/1.35 -apple-system,sans-serif;color:var(--ink);margin:0 0 9px}
#fgate .fg-opts{display:flex;flex-wrap:wrap;gap:8px}
#fgate .fg-opt{position:relative;cursor:pointer;line-height:0}
#fgate .fg-opt input{position:absolute;opacity:0;width:0;height:0}
#fgate .fg-opt span{display:inline-block;padding:9px 14px;border:1.5px solid var(--line);border-radius:40px;font:700 13px/1.2 -apple-system,sans-serif;color:var(--ink);background:#F7F5EF;transition:background .14s,border-color .14s,color .14s}
#fgate .fg-opt:hover span{border-color:var(--teal)}
#fgate .fg-opt input:checked+span{border-color:var(--teal);background:var(--teal);color:#fff}
#fgate .fg-opt input:focus-visible+span{outline:2px solid var(--goldb);outline-offset:2px}
#fgate .fg-beta-submit{width:100%;justify-content:center;margin-top:24px}
#fgate .fg-beta-thanks{text-align:center;padding:10px 0}
#fgate .fg-beta-thanks .fg-btn{margin-top:18px;width:100%;justify-content:center}
{%- endstyle -%}

<script>
(function(){
  var g=document.getElementById('fgate');if(!g)return;
  var K='fg_unlocked';
  try{if(localStorage.getItem(K)==='1')g.classList.add('is-unlocked');}catch(e){}
  if(g.querySelector('.fg-posted'))g.classList.add('is-unlocked');
  var f=g.querySelector('.fg-gate form');
  if(f)f.addEventListener('submit',function(){try{localStorage.setItem(K,'1');}catch(e){}});

  /* ---- Founding Beta application ---- */
  var modal=document.getElementById('fg-beta-modal'),openBtn=g.querySelector('.fg-beta-open');
  if(modal&&openBtn){
    var betaForm=modal.querySelector('.fg-beta-form'),
        tagsInput=modal.querySelector('[data-beta-tags]'),
        bodyEl=modal.querySelector('.fg-beta-body'),
        thanksEl=modal.querySelector('.fg-beta-thanks'),
        DONE='fg_beta_done';
    function openM(){modal.hidden=false;document.documentElement.style.overflow='hidden';var fx=modal.querySelector('input:not([type=hidden]),button');if(fx)fx.focus();}
    function closeM(){modal.hidden=true;document.documentElement.style.overflow='';}
    openBtn.addEventListener('click',function(){if(!openBtn.classList.contains('is-done'))openM();else openM();});
    modal.addEventListener('click',function(e){if(e.target===modal)closeM();});
    Array.prototype.forEach.call(modal.querySelectorAll('.fg-beta-x,.fg-beta-x2'),function(x){x.addEventListener('click',closeM);});
    document.addEventListener('keydown',function(e){if(e.key==='Escape'&&!modal.hidden)closeM();});
    var otherIn=modal.querySelector('.fg-other-input');
    function syncOther(){
      var sel=betaForm.querySelector('input[name=q_goal]:checked');
      var show=!!(sel&&sel.getAttribute('data-other')==='1');
      if(otherIn){otherIn.hidden=!show;if(show)otherIn.focus();}
    }
    function rebuild(){
      var t=['founding-flock','beta-applicant'];
      Array.prototype.forEach.call(betaForm.querySelectorAll('input[type=radio]:checked'),function(r){var d=r.getAttribute('data-tag');if(d)t.push(d);});
      if(otherIn&&!otherIn.hidden){var v=otherIn.value.replace(/,/g,';').replace(/\s+/g,' ').trim().slice(0,80);if(v)t.push('note: '+v);}
      tagsInput.value=t.join(', ');
    }
    betaForm.addEventListener('change',function(){syncOther();rebuild();});
    betaForm.addEventListener('input',rebuild);
    betaForm.addEventListener('submit',function(){rebuild();try{sessionStorage.setItem('fg_beta_ok','1');}catch(e){}});
    /* returning from a submit (page reloads) */
    var justOk=false;try{justOk=sessionStorage.getItem('fg_beta_ok')==='1';sessionStorage.removeItem('fg_beta_ok');}catch(e){}
    var hasErr=!!betaForm.querySelector('.fg-err');
    if(justOk&&!hasErr){try{localStorage.setItem(DONE,'1');}catch(e){}}
    else if(justOk&&hasErr){openM();}
    var done=false;try{done=localStorage.getItem(DONE)==='1';}catch(e){}
    if(done){openBtn.textContent='Application received 🖤';openBtn.classList.add('is-done');bodyEl.hidden=true;thanksEl.hidden=false;if(justOk&&!hasErr)openM();}
  }
})();
</script>

