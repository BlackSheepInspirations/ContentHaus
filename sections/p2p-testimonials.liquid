{% comment %}
  Purpose 2 Profit — Testimonials (curated social proof).

  A hand-curated wall of testimonials. NOTHING is auto-published — Andrea adds one
  "Testimonial" block per approved review in the theme editor (★ rating + quote +
  name/role + optional avatar). Drop this section on any page (a /pages/testimonials
  page, a Haus preview, the home page, etc.).

  Two looks via the Colour scheme setting: "cream" (light store pages) or
  "dark" (matches the OS). Scoped to .bsc-tst so nothing leaks.
{% endcomment %}

{%- assign scheme = section.settings.scheme | default: 'cream' -%}
<section class="bsc-tst bsc-tst--{{ scheme }}" style="--cols: {{ section.settings.columns | default: 3 }};">
  <div class="bsc-tst__in">
    {%- if section.settings.kicker != blank -%}<p class="bsc-tst__kicker">{{ section.settings.kicker }}</p>{%- endif -%}
    {%- if section.settings.heading != blank -%}<h2 class="bsc-tst__h">{{ section.settings.heading }}</h2>{%- endif -%}
    {%- if section.settings.intro != blank -%}<p class="bsc-tst__intro">{{ section.settings.intro }}</p>{%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <div class="bsc-tst__grid">
        {%- for block in section.blocks -%}
          {%- assign r = block.settings.rating | default: 5 -%}
          <figure class="bsc-tst__card{% if block.settings.highlight %} is-featured{% endif %}" {{ block.shopify_attributes }}>
            {%- if section.settings.show_stars and r > 0 -%}
              <div class="bsc-tst__stars" aria-label="{{ r }} out of 5 stars">
                {%- for i in (1..5) -%}<span{% if i <= r %} class="on"{% endif %}>★</span>{%- endfor -%}
              </div>
            {%- endif -%}
            {%- if block.settings.quote != blank -%}<blockquote class="bsc-tst__quote">{{ block.settings.quote }}</blockquote>{%- endif -%}
            <figcaption class="bsc-tst__by">
              {%- if block.settings.avatar != blank -%}
                <span class="bsc-tst__avatar"><img src="{{ block.settings.avatar | image_url: width: 120 }}" alt="{{ block.settings.name | escape }}" loading="lazy" width="48" height="48"></span>
              {%- endif -%}
              <span class="bsc-tst__meta">
                {%- if block.settings.name != blank -%}<b>{{ block.settings.name }}</b>{%- endif -%}
                {%- if block.settings.role != blank -%}<span>{{ block.settings.role }}</span>{%- endif -%}
              </span>
              {%- if block.settings.source != blank -%}<span class="bsc-tst__source">{{ block.settings.source }}</span>{%- endif -%}
            </figcaption>
          </figure>
        {%- endfor -%}
      </div>
    {%- else -%}
      <p class="bsc-tst__empty">Add a “Testimonial” block to feature a review here.</p>
    {%- endif -%}
  </div>
</section>

<style>
  .bsc-tst{--gold:#c9a24a;--gold-bright:#e0b23e;--aurora:linear-gradient(100deg,#c9a24a,#8f6fd6,#27ae6e,#39c5c0,#2563eb,#d6336c,#c9a24a);
    padding:56px 20px;}
  .bsc-tst--cream{--bg:#faf8f3;--card:#ffffff;--text:#1a1815;--muted:#6b6660;--stroke:rgba(46,42,38,.14);background:var(--bg);}
  .bsc-tst--dark{--bg:#070f16;--card:#0d1a24;--text:#e7efeb;--muted:#8aa0a6;--stroke:rgba(255,255,255,.1);
    background:radial-gradient(120% 80% at 0% 0%,#0d1a26,#050a10);}
  .bsc-tst__in{max-width:1180px;margin:0 auto;}
  .bsc-tst__kicker{text-align:center;font:700 12px/1 system-ui;letter-spacing:.16em;text-transform:uppercase;color:var(--gold);margin:0 0 12px;}
  .bsc-tst__h{text-align:center;font:700 clamp(26px,4vw,38px)/1.15 Georgia,serif;color:var(--text);margin:0 0 12px;}
  .bsc-tst__intro{text-align:center;font:400 16px/1.6 system-ui;color:var(--muted);max-width:620px;margin:0 auto 40px;}
  .bsc-tst__grid{display:grid;grid-template-columns:repeat(var(--cols),1fr);gap:18px;}
  @media (max-width:900px){.bsc-tst__grid{grid-template-columns:repeat(2,1fr);}}
  @media (max-width:600px){.bsc-tst__grid{grid-template-columns:1fr;}}
  .bsc-tst__card{display:flex;flex-direction:column;gap:12px;padding:24px 22px;border:1px solid var(--stroke);border-radius:18px;
    background:var(--card);box-shadow:0 10px 30px rgba(0,0,0,.05);}
  .bsc-tst--dark .bsc-tst__card{box-shadow:0 12px 34px rgba(0,0,0,.35);}
  .bsc-tst__card.is-featured{border-color:var(--gold);box-shadow:0 14px 40px rgba(201,162,74,.18);}
  .bsc-tst__stars{display:flex;gap:3px;font-size:16px;line-height:1;color:var(--stroke);}
  .bsc-tst__stars .on{color:var(--gold-bright);}
  .bsc-tst__quote{margin:0;font:400 16px/1.6 Georgia,serif;color:var(--text);font-style:italic;}
  .bsc-tst--dark .bsc-tst__quote{color:#dbe7e2;}
  .bsc-tst__by{display:flex;align-items:center;gap:12px;margin-top:auto;padding-top:6px;}
  .bsc-tst__avatar img{width:44px;height:44px;border-radius:50%;object-fit:cover;display:block;border:1px solid var(--stroke);}
  .bsc-tst__meta{display:flex;flex-direction:column;min-width:0;}
  .bsc-tst__meta b{font:700 14px/1.2 system-ui;color:var(--text);}
  .bsc-tst__meta span{font:400 12.5px/1.3 system-ui;color:var(--muted);}
  .bsc-tst__source{margin-left:auto;font:700 10px/1.2 system-ui;letter-spacing:.04em;text-transform:uppercase;color:var(--gold);
    border:1px solid var(--stroke);border-radius:20px;padding:5px 9px;white-space:nowrap;}
  .bsc-tst__empty{text-align:center;color:var(--muted);font:400 14px/1.5 system-ui;}
</style>

{% schema %}
{
  "name": "P2P Testimonials",
  "tag": "section",
  "settings": [
    { "type": "select", "id": "scheme", "label": "Colour scheme", "default": "cream", "options": [
      { "value": "cream", "label": "Cream (light pages)" }, { "value": "dark", "label": "Dark (OS look)" } ] },
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "In their words" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Loved by creators like you" },
    { "type": "textarea", "id": "intro", "label": "Intro", "default": "Real words from real members. We only ever share the ones we've been given permission to." },
    { "type": "range", "id": "columns", "min": 2, "max": 4, "step": 1, "label": "Columns (desktop)", "default": 3 },
    { "type": "checkbox", "id": "show_stars", "label": "Show star ratings", "default": true }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Testimonial",
      "settings": [
        { "type": "range", "id": "rating", "min": 0, "max": 5, "step": 1, "label": "Star rating", "default": 5 },
        { "type": "textarea", "id": "quote", "label": "Quote" },
        { "type": "text", "id": "name", "label": "Name" },
        { "type": "text", "id": "role", "label": "Role / detail", "info": "e.g. “Etsy seller” or “Brand Haus member”." },
        { "type": "text", "id": "source", "label": "Source tag (optional)", "info": "e.g. “Brand Haus” or a course name." },
        { "type": "image_picker", "id": "avatar", "label": "Avatar (optional)" },
        { "type": "checkbox", "id": "highlight", "label": "Feature this one (gold border)", "default": false }
      ]
    }
  ],
  "presets": [
    { "name": "P2P Testimonials", "blocks": [
      { "type": "testimonial", "settings": { "rating": 5, "quote": "I finally sound like myself. Brand Haus gave me words I'd been circling for years.", "name": "Sample Name", "role": "Journal creator", "source": "Brand Haus" } },
      { "type": "testimonial", "settings": { "rating": 5, "quote": "I went from a blank page to a full launch plan in an afternoon. This is the map I needed.", "name": "Sample Name", "role": "New seller", "source": "Growth Haus" } },
      { "type": "testimonial", "settings": { "rating": 5, "quote": "Not techy at all, and I still made something I'm proud of. The steps just make sense.", "name": "Sample Name", "role": "Learning Journey member" } }
    ] }
  ]
}
{% endschema %}
