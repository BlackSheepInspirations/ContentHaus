{% comment %}
  The AI Creator's Content Haus (formerly Prompt Haus) — main tool section.
  Gated on customer.tags contains "prompt-haus-access" (added by a Shopify
  Flow automation on order paid — see docs/access-control-setup.md).
  request.design_mode bypasses the gate inside the theme editor only, so
  the merchant can preview/edit this section without needing the tag —
  it has no effect on the published storefront for real customers.
{% endcomment %}

{% assign ph_has_access = false %}
{% if customer and customer.tags contains section.settings.access_tag %}
  {% assign ph_has_access = true %}
{% endif %}
{% if request.design_mode %}
  {% assign ph_has_access = true %}
{% endif %}
{% comment %} master all-access tag unlocks every Haus {% endcomment %}
{% if customer and customer.tags contains 'all-access' %}
  {% assign ph_has_access = true %}
{% endif %}

{{ 'prompt-builder.css' | asset_url | stylesheet_tag }}
{{ 'haus-design-system.css' | asset_url | stylesheet_tag }}

{% comment %}
  Rendered as a sibling of #prompt-haus-app, never inside it — the JS does
  root.innerHTML = "" on every re-render, which would wipe out any
  Liquid-rendered content placed inside that div.
{% endcomment %}
<div class="ph-brand-header haus--content hds-hero">
  <div class="hds-hero__inner">
    <p class="hds-hero__eyebrow">{{ section.settings.brand_eyebrow }}</p>
    <div class="hds-hero__grid">
      <div class="hds-hero__intro">
        <h1 class="hds-hero__title">{{ section.settings.brand_heading | replace: 'Content', '<span class="accent">Content</span>' }}</h1>
        <div class="hds-hero__desc">{{ section.settings.brand_subheading }}</div>
      </div>
      <div class="hds-hero__media">
        <div class="hds-hero__frame">
          <video id="phHowToVideo" class="hds-hero__video" controls preload="metadata" poster="{{ 'how-to-content-poster.jpg' | asset_url }}">
            <source src="{{ 'how-to-content.mp4' | asset_url }}" type="video/mp4">
          </video>
          <div class="hds-hero__ph" id="phHowToPlaceholder" hidden>
            <span class="hds-hero__play" aria-hidden="true">&#9654;</span>
            <p class="hds-hero__ph-title">Tutorial coming soon</p>
            <p class="hds-hero__ph-note">A quick how-to for this generator</p>
          </div>
        </div>
        <p class="hds-hero__caption">Watch: build a prompt in about 60 seconds.</p>
      </div>
    </div>
  </div>
  <script>
    (function(){var v=document.getElementById('phHowToVideo'),ph=document.getElementById('phHowToPlaceholder');if(!v||!ph)return;var s=v.querySelector('source');function show(){if(ph.hidden){ph.hidden=false;v.style.display='none';}}if(s)s.addEventListener('error',show);v.addEventListener('error',show);setTimeout(function(){if(!v.readyState)show();},2500);})();
  </script>
</div>

{% if ph_has_access %}
  <div id="prompt-haus-app" class="haus--content" data-section-id="{{ section.id }}"></div>

  {% comment %} Music Prompt Studio (Suno) — self-contained, sibling of the app {% endcomment %}
  <div id="ph-music-studio" class="haus--content"></div>
  <script src="{{ 'prompt-builder-music.js' | asset_url }}" defer="defer"></script>

  <script src="{{ 'prompt-builder-styledna.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'prompt-builder-engine.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'prompt-builder-favorites.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'prompt-builder-character.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'prompt-builder-character-video.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'prompt-builder-text.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'prompt-builder-couples.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'prompt-builder-family.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'prompt-builder-combined.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'prompt-builder-graphics.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'prompt-builder-reference.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'prompt-builder-animals.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'prompt-builder-brandkit.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'prompt-builder-ui.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'p2p-launch-prefill.js' | asset_url }}" defer="defer"></script>
{% else %}
  <div class="ph-locked">
    <h2 class="ph-locked__heading">{{ section.settings.locked_heading | replace: 'Content', '<span class="ph-heading-accent">Content</span>' }}</h2>
    <div class="ph-locked__body">{{ section.settings.locked_body }}</div>
    <div class="ph-locked__actions">
      {% if section.settings.access_product %}
        <a href="{{ section.settings.access_product.url }}" class="ph-btn ph-btn--copy">
          Get Access{% if section.settings.access_product.price %} — {{ section.settings.access_product.price | money }}{% endif %}
        </a>
      {% endif %}
      {% if section.settings.learn_more_url != blank %}
        <a href="{{ section.settings.learn_more_url }}" class="ph-btn ph-btn--reset ph-locked__learn-more">Learn more</a>
      {% endif %}
    </div>
  </div>
{% endif %}

{% render 'haus-links', current: 'content-haus' %}

{% schema %}
{
  "name": "Content Haus Builder",
  "settings": [
    {
      "type": "text",
      "id": "brand_eyebrow",
      "label": "Eyebrow text",
      "default": "Black Sheep Creations & Inspirations"
    },
    {
      "type": "text",
      "id": "brand_heading",
      "label": "Heading",
      "default": "The Content Haus"
    },
    {
      "type": "textarea",
      "id": "brand_subheading",
      "label": "Subheading",
      "default": "Turn your ideas into ready-to-use AI prompts for characters, pets, illustrations, and creative content. Customized your way."
    },
    {
      "type": "text",
      "id": "access_tag",
      "label": "Access tag",
      "default": "prompt-haus-access",
      "info": "Customer tag that unlocks the tool. Must match the tag your Shopify Flow automation adds on purchase."
    },
    {
      "type": "product",
      "id": "access_product",
      "label": "Access product",
      "info": "Shown as the \"Get Access\" button for shoppers who don't have the tag yet."
    },
    {
      "type": "url",
      "id": "learn_more_url",
      "label": "Learn more link",
      "info": "e.g. link to your Content Haus marketing page."
    },
    {
      "type": "text",
      "id": "locked_heading",
      "label": "Locked state heading",
      "default": "Unlock The Content Haus"
    },
    {
      "type": "richtext",
      "id": "locked_body",
      "label": "Locked state body",
      "default": "<p>Get instant access to the full prompt builder — Character, Text, Couples, and Combined modes, 50+ holiday & lifestyle themes, and save up to 5 favorite prompts per mode.</p>"
    }
  ],
  "presets": [
    {
      "name": "Content Haus Builder"
    }
  ]
}
{% endschema %}
