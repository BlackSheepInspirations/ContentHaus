  #p2pos .osx-house-tag{margin-left:7px;font:800 9.5px/1 system-ui;letter-spacing:.05em;text-transform:uppercase;color:#0a1410;background:linear-gradient(100deg,#f4e2a6,#c9a24a);border-radius:999px;padding:3px 7px;vertical-align:middle;}
  #p2pos .osx-cw-post.house{border-color:var(--gstroke);background:linear-gradient(180deg,rgba(216,180,90,.06),rgba(9,17,24,.25));}
  /* comment button + thread */
  #p2pos .osx-cw-cbtn{border:1px solid var(--stroke);background:rgba(255,255,255,.04);color:var(--muted);cursor:pointer;border-radius:999px;padding:5px 11px;font:700 12px/1 system-ui;transition:.15s;display:inline-flex;align-items:center;gap:5px;}
  #p2pos .osx-cw-cbtn:hover{border-color:var(--gstroke);color:var(--text);}
  #p2pos .osx-cw-post-acts{display:flex;align-items:center;gap:8px;flex-wrap:wrap;}
  #p2pos .osx-cm{margin-top:12px;border-top:1px solid var(--stroke);padding-top:12px;}
