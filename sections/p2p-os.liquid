  #p2pos .osx-mate-badge img{width:100%;height:100%;border-radius:50%;object-fit:cover;display:block;}
  #p2pos .osx-mate-fallback{width:100%;height:100%;border-radius:50%;place-items:center;font:800 34px/1 Georgia,serif;color:#0a1410;background:linear-gradient(145deg,#f4e2a6,var(--gold));}
  #p2pos .osx-mate-kick{font:700 10px/1.1 system-ui;letter-spacing:.16em;text-transform:uppercase;color:var(--gold);}
  #p2pos .osx-mate-name{font:700 30px/1.05 Georgia,serif;margin:2px 0 0;
    background:var(--aurora);background-size:300% 100%;-webkit-background-clip:text;background-clip:text;color:transparent;animation:p2pos-shift 20s linear infinite;}
  #p2pos .osx-mate-haus{font:600 12.5px/1.4 system-ui;color:#dbe7e2;}
  #p2pos .osx-mate-haus i{color:var(--muted);font-style:italic;}
  #p2pos .osx-mate-dot{color:var(--gold);}
  #p2pos .osx-mate p{font:400 13.5px/1.6 system-ui;color:#c6d6d0;margin:8px 0 0;max-width:34ch;}
  #p2pos .osx-mate-for{font:400 12px/1.55 system-ui;color:var(--muted);margin-top:10px;max-width:36ch;}
  #p2pos .osx-mate-for b{color:var(--gold-bright);font-weight:700;}
  #p2pos .osx-mate-cta{display:inline-flex;align-items:center;gap:8px;margin-top:16px;padding:12px 24px;border-radius:11px;
    font:800 13px/1 system-ui;color:#0a1410;text-decoration:none;background:var(--aurora);background-size:300% 100%;
    animation:p2pos-shift 20s linear infinite;box-shadow:0 10px 26px rgba(0,0,0,.35);transition:transform .12s;}
  #p2pos .osx-mate-cta:hover{transform:translateY(-2px);}
  #p2pos .osx-mate-cta i{font-style:normal;transition:transform .15s;}
  #p2pos .osx-mate-cta:hover i{transform:translateX(3px);}
  #p2pos .osx-mate-note{font:400 12.5px/1.5 system-ui;color:var(--muted);text-align:center;margin-top:4px;}
  #p2pos .osx-mate-note::first-letter{color:var(--gold-bright);}
  @media (prefers-reduced-motion: reduce){#p2pos .osx-mate-name,#p2pos .osx-mate-cta{animation:none;}}

  /* external-site heads-up modal */
  #p2pos .osx-modal{position:fixed;inset:0;z-index:1100;display:grid;place-items:center;padding:20px;background:rgba(3,7,10,.66);backdrop-filter:blur(3px);}
  #p2pos .osx-modal[hidden]{display:none;}
  #p2pos .osx-modal-card{width:min(420px,100%);border:1px solid var(--gstroke);border-radius:20px;padding:28px 26px 24px;text-align:center;
    background:radial-gradient(120% 100% at 50% 0%,#0e1c28,#0a141c);box-shadow:0 24px 70px rgba(0,0,0,.6);}
  #p2pos .osx-modal-ic{width:48px;height:48px;margin:0 auto 14px;display:grid;place-items:center;border-radius:50%;font:800 22px/1 system-ui;color:#0a1410;
    background:var(--aurora);background-size:300% 100%;animation:p2pos-shift 20s linear infinite;}
  #p2pos .osx-modal-title{font:700 20px/1.2 Georgia,serif;margin:0 0 8px;color:var(--text);}
  #p2pos .osx-modal-body{font:400 14px/1.6 system-ui;color:#c6d6d0;margin:0 0 16px;}
  #p2pos .osx-modal-check{display:inline-flex;align-items:center;gap:9px;cursor:pointer;font:500 13px/1 system-ui;color:var(--muted);margin-bottom:20px;user-select:none;}
  #p2pos .osx-modal-check input{position:absolute;opacity:0;pointer-events:none;}
  #p2pos .osx-modal-cbx{flex:0 0 18px;width:18px;height:18px;border:1.5px solid var(--stroke);border-radius:5px;position:relative;transition:background .15s,border-color .15s;}
  #p2pos .osx-modal-check input:checked + .osx-modal-cbx{background:var(--emerald);border-color:var(--emerald);}
  #p2pos .osx-modal-check input:checked + .osx-modal-cbx:after{content:"✓";position:absolute;inset:0;display:grid;place-items:center;font:800 11px/1 system-ui;color:#06120e;}
  #p2pos .osx-modal-check input:focus-visible + .osx-modal-cbx{outline:2px solid var(--gold-bright);outline-offset:2px;}
  #p2pos .osx-modal-btns{display:flex;gap:10px;justify-content:center;flex-wrap:wrap;}
  #p2pos .osx-modal-cancel{cursor:pointer;padding:12px 20px;border-radius:11px;font:700 13px/1 system-ui;color:var(--muted);background:rgba(255,255,255,.05);border:1px solid var(--stroke);transition:.15s;}
  #p2pos .osx-modal-cancel:hover{color:var(--text);border-color:var(--gstroke);}
  #p2pos .osx-modal-go{display:inline-flex;align-items:center;gap:8px;cursor:pointer;padding:12px 24px;border-radius:11px;font:800 13px/1 system-ui;color:#0a1410;text-decoration:none;
    background:var(--aurora);background-size:300% 100%;animation:p2pos-shift 20s linear infinite;box-shadow:0 10px 26px rgba(0,0,0,.35);transition:transform .12s;}
  #p2pos .osx-modal-go:hover{transform:translateY(-2px);}
  #p2pos .osx-modal-go i{font-style:normal;}
  @media (prefers-reduced-motion: reduce){#p2pos .osx-modal-ic,#p2pos .osx-modal-go{animation:none;}}

  /* notebook (shared jr/je engine — ported from the Learning Journey) */
  #p2pos .jr-head{display:flex;align-items:flex-start;justify-content:space-between;gap:16px;flex-wrap:wrap;margin-bottom:4px;}
  #p2pos .jr-export-all{flex:none;font:700 12px/1 system-ui;color:var(--gold-bright);background:rgba(216,180,90,.1);border:1px solid var(--gstroke);border-radius:30px;padding:10px 16px;cursor:pointer;transition:.15s;}
  #p2pos .jr-export-all:hover{background:rgba(216,180,90,.18);}
  #p2pos .jr-tabs{display:flex;gap:8px;margin:18px 0;flex-wrap:wrap;}
  #p2pos .jr-tab{font:700 12px/1 system-ui;letter-spacing:.02em;color:var(--muted);background:rgba(255,255,255,.04);border:1px solid var(--stroke);border-radius:30px;padding:10px 16px;cursor:pointer;transition:.15s;}
  #p2pos .jr-tab:hover{color:var(--text);border-color:var(--gstroke);}
  #p2pos .jr-tab.on{color:#06120e;background:linear-gradient(145deg,#f4e2a6,var(--gold));border-color:transparent;}
  #p2pos .jr-pane[hidden]{display:none;}
  #p2pos .jr-compose{background:var(--panel);border:1px solid var(--stroke);border-radius:18px;padding:20px;margin-bottom:22px;}
  #p2pos .jr-title{width:100%;box-sizing:border-box;padding:11px 12px;border-radius:10px;font:700 14px/1 system-ui;color:var(--text);background:#0e1a20;border:1px solid var(--stroke);margin-bottom:12px;}
  #p2pos .jr-compose textarea{width:100%;box-sizing:border-box;padding:14px;border-radius:12px;font:400 15px/1.6 system-ui;color:var(--text);background:rgba(255,255,255,.05);border:1px solid var(--stroke);resize:vertical;outline:none;}
  #p2pos .jr-compose textarea:focus{border-color:var(--emerald);}
  #p2pos .jr-actions{display:flex;gap:10px;margin-top:14px;flex-wrap:wrap;}
  #p2pos .jr-save{cursor:pointer;border:0;padding:12px 22px;border-radius:11px;font:800 13px/1 system-ui;color:#06120e;background:linear-gradient(145deg,var(--emerald),var(--teal));}
  #p2pos .jr-toolbar{display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap;margin-bottom:14px;}
  #p2pos .jr-search{flex:1;min-width:180px;box-sizing:border-box;padding:10px 14px;border-radius:30px;font:600 13px/1 system-ui;color:var(--text);background:#0e1a20;border:1px solid var(--stroke);}
  #p2pos .jr-views{display:flex;gap:4px;background:rgba(255,255,255,.04);border:1px solid var(--stroke);border-radius:30px;padding:3px;}
  #p2pos .jr-view{font:700 11px/1 system-ui;color:var(--muted);background:none;border:0;border-radius:30px;padding:8px 13px;cursor:pointer;transition:.15s;}
  #p2pos .jr-view:hover{color:var(--text);}
  #p2pos .jr-view.on{color:#06120e;background:linear-gradient(145deg,#f4e2a6,var(--gold));}
  #p2pos .jr-list{display:flex;flex-direction:column;gap:12px;}
  #p2pos .jr-entry{background:rgba(255,255,255,.03);border:1px solid var(--stroke);border-radius:14px;padding:16px 18px;}
  #p2pos .jr-entry .je-top{display:flex;justify-content:space-between;align-items:baseline;gap:10px;margin-bottom:6px;}
  #p2pos .jr-entry .je-date{font:600 11px/1 system-ui;color:var(--muted);}
  #p2pos .jr-win .je-date{color:var(--gold-bright);}
  #p2pos .je-title{font:700 15px/1.25 system-ui;color:var(--gold-bright);margin:2px 0 4px;}
  #p2pos .jr-entry .je-prompt{font:700 13px/1.3 system-ui;color:var(--gold-bright);margin-bottom:6px;}
  #p2pos .jr-entry .je-text{font:400 14px/1.6 system-ui;color:#cfe0da;white-space:pre-wrap;}
  #p2pos .je-acts{display:flex;gap:6px;flex-wrap:wrap;}
  #p2pos .je-btn{font:700 11px/1 system-ui;color:var(--muted);background:rgba(255,255,255,.05);border:1px solid var(--stroke);border-radius:20px;padding:6px 11px;cursor:pointer;transition:.15s;}
  #p2pos .je-btn:hover{color:var(--text);border-color:var(--gstroke);}
  #p2pos .je-btn.je-restore:hover{color:var(--emerald);border-color:rgba(39,174,110,.5);}
  #p2pos .je-btn.je-del:hover{color:#ff9e9e;border-color:rgba(214,51,51,.45);}
  #p2pos .je-btn.je-share{color:var(--gold-bright);border-color:var(--gstroke);background:rgba(216,180,90,.08);}
  #p2pos .je-btn.je-share:hover{background:rgba(216,180,90,.16);border-color:var(--gold-bright);}
  #p2pos .je-shared{font:700 11px/1 system-ui;color:var(--gold-bright);padding:6px 4px;align-self:center;}
  #p2pos .osx-cw-hint{font:500 12px/1.3 system-ui;color:var(--muted);}
  #p2pos .jr-empty{color:var(--muted);font:400 14px/1.5 system-ui;text-align:center;padding:24px;}

  /* placeholder / locked views */
  #p2pos .osx-ph{max-width:460px;margin:60px auto;text-align:center;}
  #p2pos .osx-ph-ic{font-size:40px;margin-bottom:14px;}
  #p2pos .osx-ph h2{font:700 24px/1.2 Georgia,serif;margin:0 0 8px;}
  #p2pos .osx-ph p{font:400 14px/1.6 system-ui;color:var(--muted);margin:0;}

  @media (prefers-reduced-motion: reduce){#p2pos .osx-2,#p2pos .osx-name,#p2pos .osx-cta,#p2pos .osx-chip .p2pos-tier{animation:none;}}
  @media (max-width:820px){
    #p2pos.osx{grid-template-columns:1fr;}
    #p2pos .osx-burger{display:flex;flex-direction:column;justify-content:center;gap:4px;position:absolute;top:12px;left:12px;z-index:30;width:46px;height:46px;border:1px solid var(--gold);border-radius:12px;background:linear-gradient(180deg,var(--gold-bright),var(--gold));box-shadow:0 4px 16px rgba(216,180,90,.45);cursor:pointer;}
    #p2pos .osx-burger span{display:block;height:2.5px;width:20px;margin:0 auto;background:#0a1410;border-radius:2px;}
    #p2pos .osx-side{position:absolute;inset:0 auto 0 0;width:264px;z-index:5;transform:translateX(-100%);transition:transform .25s ease;box-shadow:0 0 40px rgba(0,0,0,.6);}
    #p2pos .osx-side.open{transform:translateX(0);}
    #p2pos .osx-view{padding:64px 20px 40px;}
  }
</style>

