  #p2pos .osx-cw-more{display:inline-block;margin-top:4px;font:700 12px/1 system-ui;color:var(--gold-bright);background:none;border:0;cursor:pointer;padding:0;}
  /* members · map · profile */
  #p2pos .osx-mb{max-width:840px;}
  #p2pos .osx-mb-tabs{display:flex;gap:8px;margin-bottom:18px;flex-wrap:wrap;}
  #p2pos .osx-mb-tab{border:1px solid var(--stroke);background:transparent;color:var(--muted);cursor:pointer;padding:8px 16px;border-radius:999px;font:700 13px/1 system-ui;transition:.14s;}
