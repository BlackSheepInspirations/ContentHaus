<script>
  /* How You Level Up — fill the "you're here" strip + tier ladder from live progress */
  (function(){
    var root = document.getElementById('p2pos'); if(!root) return;
    var view = root.querySelector('.osx-view[data-view="levelup"]'); if(!view) return;
    function esc(s){ return String(s==null?'':s).replace(/[&<>"]/g,function(c){ return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]; }); }
    function build(){
      var P = window.P2P, you = view.querySelector('[data-gam-you]'), ladder = view.querySelector('[data-gam-ladder]');
      if(!P || !P.tier){ if(you) you.innerHTML = '<div class="osx-gam-you-load">Your standing appears here once your progress loads.</div>'; return; }
      var t = P.tier(), pts = (P.points ? P.points() : 0) || 0, names = t.tiers || [], idx = t.index || 1;
      var step = (t.next - t.start) || 500, toNext = Math.max(0, (t.next || 0) - pts);
      if(you) you.innerHTML = '<div class="osx-gam-you-in"><div class="osx-gam-you-tier"><span class="osx-gam-you-k">You are a</span><b>'+esc(t.name)+'</b></div>'+
        '<div class="osx-gam-you-nums"><div><b>'+pts.toLocaleString()+'</b><span>points</span></div><div><b>'+(t.merits||0)+'</b><span>merits</span></div><div><b>'+toNext.toLocaleString()+'</b><span>pts to '+esc(t.nextName||'next')+'</span></div></div></div>';
      if(ladder){
        var rows = '';
        for(var j=0;j<names.length;j++){ var lo = j*step, cls = (j===idx-1)?'now':(j<idx-1?'done':'');
          rows += '<li class="'+cls+'"><span class="osx-gam-rank">'+(j+1)+'</span><span class="osx-gam-tname">'+esc(names[j])+'</span><span class="osx-gam-tpts">'+lo.toLocaleString()+(j===idx-1?' · you':'')+' pts</span></li>'; }
        ladder.innerHTML = rows;
      }
    }
    build();
    new MutationObserver(function(){ if(view.classList.contains('on')) build(); }).observe(view,{ attributes:true, attributeFilter:['class'] });
  })();
</script>
<script>
