    // Recolor the OS to the member's STAND OUT color (their choice — one signature
    // color, not the whole palette). Prefers the archetype's standOut (e.g. Bold
    // Pioneer = #3A86FF blue); falls back to the most-saturated color of a saved
    // custom brand kit. Hue + saturation come from that color; LIGHTNESS is forced
    // legible on the dark UI. The aurora becomes an analogous shimmer in that hue's
    // family, so the page reads as "their color" while keeping its living gradient.
    (function(){
      function J(k){ try{ return JSON.parse(localStorage.getItem(k)); }catch(e){ return null; } }
      function toHsl(hex){
        var h = String(hex == null ? '' : hex).trim().replace('#', '');
        if(h.length === 3){ h = h.replace(/(.)/g, '$1$1'); }
        if(!/^[0-9a-fA-F]{6}$/.test(h)) return null;
        var r = parseInt(h.slice(0,2),16)/255, g = parseInt(h.slice(2,4),16)/255, b = parseInt(h.slice(4,6),16)/255;
        var mx = Math.max(r,g,b), mn = Math.min(r,g,b), l = (mx+mn)/2, s, hue;
        if(mx === mn){ hue = 0; s = 0; }
        else { var d = mx-mn; s = l > 0.5 ? d/(2-mx-mn) : d/(mx+mn);
          hue = mx === r ? (g-b)/d + (g<b?6:0) : mx === g ? (b-r)/d + 2 : (r-g)/d + 4; hue *= 60; }
        return [hue, s*100, l*100];
      }
      function hsl(h,s,l){ return 'hsl(' + (((Math.round(h) % 360) + 360) % 360) + ',' + Math.round(s) + '%,' + Math.round(l) + '%)'; }
      function clamp(v,a,b){ return Math.max(a, Math.min(b, v)); }
      var arch = J('p2p_archetype'), vault = J('blackSheepBrandKitVault');
      var pick = arch && arch.standOut ? toHsl(arch.standOut) : null; // 1) archetype Stand Out wins
      if(!pick){ // 2) else the most-saturated color of a saved custom kit
        var kit = vault && vault.brandHausKits && vault.brandHausKits.length ? vault.brandHausKits[vault.brandHausKits.length - 1] : null;
        var kc = (kit && kit.colors ? kit.colors : []).map(toHsl).filter(Boolean).sort(function(a,b){ return b[1] - a[1]; });
        pick = kc[0] || null;
      }
      if(!pick) return; // no brand color -> keep the default aurora identity
      if(pick[1] < 12){
        // near-greyscale stand-out: no meaningful hue -> clean neutral accents, keep the default aurora.
        root.style.setProperty('--gold', hsl(0, 0, 80));
        root.style.setProperty('--gold-bright', hsl(0, 0, 90));
        root.style.setProperty('--gstroke', 'hsla(0,0%,82%,.30)');
        return;
      }
      var h = pick[0], sat = clamp(pick[1], 45, 90);
      root.style.setProperty('--gold', hsl(h, sat, 62));
      root.style.setProperty('--gold-bright', hsl(h, clamp(sat + 6, 50, 94), 70));
      root.style.setProperty('--gstroke', 'hsla(' + Math.round(h) + ',' + Math.round(sat) + '%,60%,.38)');
      // analogous shimmer around the stand-out hue -> alive, but all one color family
      var offs = [-28, -12, 0, 16, 30];
      var stops = offs.map(function(o, i){ return hsl(h + o, clamp(sat - Math.abs(o) * 0.4, 40, 90), 58 + (i % 2 ? 8 : 0)); });
      root.style.setProperty('--aurora', 'linear-gradient(100deg,' + stops.concat(stops[0]).join(',') + ')');
    })();

    // Trusted Guide logo — large on the LEFT, with each view's eyebrow/title/subtext stacked to its right.
    // Also Title-Cases hero titles (keeping ACRONYMS like ROOTED/P2P) and aura-colors chosen words.
    (function(){ try{
      var src = "{{ 'p2p-trusted-guide.png' | asset_url }}";
      var AURA = { checkpoint:['before'], rooted:['rooted'], mates:['partners'], members:['flock'], tools:['one','click'], notebook:['notebook'], bonus:['free','downloads'] };
      function tcWord(w){ return /[A-Z]/.test(w) ? w : (w.charAt(0).toUpperCase() + w.slice(1)); }
      function processH2(h, aura){
        Array.prototype.slice.call(h.childNodes).forEach(function(node){
          if(node.nodeType !== 3) return;
          var parts = node.textContent.split(/(\s+)/), frag = document.createDocumentFragment();
          parts.forEach(function(p){
            if(p === '' || /^\s+$/.test(p)){ frag.appendChild(document.createTextNode(p)); return; }
            var clean = p.replace(/[^A-Za-z]/g,'').toLowerCase(), cased = tcWord(p);
            if(clean && aura.indexOf(clean) > -1){ var s = document.createElement('span'); s.className = 'osx-aura'; s.textContent = cased; frag.appendChild(s); }
            else frag.appendChild(document.createTextNode(cased));
          });
          h.replaceChild(frag, node);
        });
      }
      root.querySelectorAll('.osx-view').forEach(function(v){
        var h = v.querySelector('.osx-h2');
        if(!h || h.closest('.osx-hero-lockrow')) return;
        processH2(h, AURA[v.getAttribute('data-view')] || []);
        var kick = (h.previousElementSibling && h.previousElementSibling.classList.contains('osx-kick')) ? h.previousElementSibling : null;
        var follow = [], n = h.nextElementSibling;
        while(n && (n.classList.contains('osx-comm-tag') || n.classList.contains('osx-lede'))){ var nx = n.nextElementSibling; follow.push(n); n = nx; }
        var row = document.createElement('div'); row.className = 'osx-hero-lockrow';
        var col = document.createElement('div'); col.className = 'osx-hero-textcol';
        var anchor = kick || h; if(!anchor || !anchor.parentNode){ return; }
        anchor.parentNode.insertBefore(row, anchor); // insert at the title's real parent (works even when nested, e.g. Notebook)
        row.innerHTML = '<span class="osx-hero-biglogo"><img src="' + src + '" alt="" aria-hidden="true"></span>';
        row.appendChild(col);
        if(kick) col.appendChild(kick);
        col.appendChild(h);
        follow.forEach(function(f){ col.appendChild(f); });
      });
    }catch(e){ if(window.console) console.warn('P2P hero-title block skipped:', e); } })();

