  #p2pos .osx-cw-time{margin-left:auto;font:500 12px/1 system-ui;color:var(--muted);}
  #p2pos .osx-cw-post-text{font:400 14px/1.55 system-ui;color:#dbe7e2;white-space:pre-wrap;word-break:break-word;}
  #p2pos .osx-cw-empty{padding:26px 16px;text-align:center;font:400 14px/1.5 system-ui;color:var(--muted);}
  #p2pos .osx-cw-post-acts{margin-top:9px;}
  #p2pos .osx-love{border:1px solid var(--stroke);background:rgba(255,255,255,.04);color:var(--muted);cursor:pointer;border-radius:999px;padding:5px 12px;font:700 12px/1 system-ui;transition:.15s;display:inline-flex;align-items:center;gap:5px;}
