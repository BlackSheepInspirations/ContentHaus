  #p2pos .osx-cm-item b{font:700 12.5px/1.2 system-ui;color:var(--text);}
  #p2pos .osx-cm-time{margin-left:7px;font:500 11px/1 system-ui;color:var(--muted);}
  #p2pos .osx-cm-text{font:400 13px/1.5 system-ui;color:#d7e3de;margin-top:4px;}
