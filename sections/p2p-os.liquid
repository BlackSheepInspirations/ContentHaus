  #p2pos .osx-side-p2p-logo img{width:100%;display:block;border-radius:8px;}
  /* ===== mini expandable cards (calendar / map) ===== */
  #p2pos .osx-mini{-webkit-appearance:none;appearance:none;font:inherit;color:inherit;cursor:pointer;text-align:left;width:100%;transition:.15s;}
  #p2pos .osx-mini:hover{border-color:var(--gstroke);background:rgba(216,180,90,.06);}
  #p2pos .osx-mini .osx-side-h{display:block;margin-bottom:8px;}
  #p2pos .osx-mini-body{display:flex;flex-direction:column;gap:3px;}
  #p2pos .osx-mini-body b{font:700 15px/1.2 Georgia,serif;color:var(--text);}
  #p2pos .osx-mini-hint{font:600 12px/1.3 system-ui;color:var(--gold-bright);}
  /* ===== expand modal (holds the full calendar / map) ===== */
  .osx-cal-pop-in.osx-expand{width:min(760px,100%);max-height:88vh;overflow:auto;padding:22px;text-align:left;}
  .osx-cal-pop-in.osx-expand-map{width:min(880px,100%);}
  #p2pos .osx-expand-map .osx-mb-map{height:62vh;min-height:320px;}
  #p2pos .osx-expand-cal .osx-cal{max-width:none;}
  /* ===== member board: directory + stacked calendar/map ===== */
  #p2pos .osx-members-grid{display:grid;grid-template-columns:minmax(0,2fr) minmax(340px,1fr);gap:24px;align-items:start;}
  #p2pos .osx-members-main{min-width:0;}
  #p2pos .osx-members-main .osx-mb{max-width:none;}
  #p2pos .osx-members-side{display:flex;flex-direction:column;gap:18px;}
  #p2pos .osx-members-side .osx-lower-card{border:1px solid var(--stroke);border-radius:16px;background:rgba(255,255,255,.03);padding:16px 18px;}
  #p2pos .osx-members-map{height:min(460px,52vh);}
  #p2pos .osx-members-side .osx-suggest{max-width:none;margin-top:0;}
  /* engagement toast (appended to body — global colors) */
  .osx-toast{position:fixed;left:50%;bottom:26px;transform:translateX(-50%) translateY(14px);z-index:3200;background:#0e1c28;border:1px solid rgba(216,180,90,.4);color:#e7efeb;font:700 13px/1.3 system-ui;padding:11px 18px;border-radius:999px;box-shadow:0 10px 30px rgba(0,0,0,.5);opacity:0;transition:opacity .25s,transform .25s;pointer-events:none;max-width:88vw;text-align:center;}
  .osx-toast.show{opacity:1;transform:translateX(-50%) translateY(0);}
  .osx-toast.pts{border-color:rgba(216,180,90,.7);color:#f4c534;}
  .osx-toast.warn{border-color:rgba(224,69,123,.6);color:#ffc2d8;background:#2a0f1a;}
  /* personal calendar day markers */
  #p2pos .osx-cal-d{position:relative;padding-bottom:10px;}
  #p2pos .osx-cal-marks{position:absolute;left:0;right:0;bottom:3px;display:flex;gap:3px;justify-content:center;align-items:center;line-height:1;pointer-events:none;}
  #p2pos .osx-cal-star{color:var(--gold-bright);font-size:8px;line-height:1;text-shadow:0 0 5px var(--gold-bright);}
  #p2pos .osx-cal-dot{width:5px;height:5px;border-radius:50%;display:inline-block;}
  #p2pos .osx-cal-dot.g{background:#39c5c0;}
  #p2pos .osx-cal-dot.m{background:#e0457b;}
  /* day popup (append to body — global colors) */
  .osx-day-pop{width:min(420px,100%);text-align:left;padding:20px;max-height:84vh;overflow:auto;}
  .osx-day-h{font:800 16px/1.35 Georgia,serif;color:#f0f5f2;margin-bottom:4px;}
  .osx-day-visit{font:700 11px/1 system-ui;color:#f4c534;margin-left:6px;white-space:nowrap;}
  .osx-day-sec{font:800 11px/1 system-ui;letter-spacing:.05em;text-transform:uppercase;color:#8aa0a6;margin:16px 0 8px;}
  .osx-day-ev{border:1px solid rgba(255,255,255,.1);border-radius:11px;padding:10px 12px;margin-bottom:8px;background:rgba(255,255,255,.03);}
  .osx-day-ev.mine{border-color:rgba(224,69,123,.4);background:rgba(224,69,123,.06);}
  .osx-day-evt{font:600 14px/1.35 system-ui;color:#e7efeb;display:flex;align-items:center;gap:6px;}
  .osx-day-del{margin-left:auto;background:none;border:0;color:#9fb3ad;cursor:pointer;font:700 13px/1 system-ui;}
  .osx-day-desc{font:400 12.5px/1.5 system-ui;color:#c9e6da;margin-top:4px;}
  .osx-day-join{display:inline-block;margin-top:8px;font:700 12.5px/1 system-ui;color:#0a1410;background:linear-gradient(100deg,#f4e2a6,#c9a24a);border-radius:999px;padding:8px 14px;text-decoration:none;}
  .osx-day-empty{font:400 13px/1.5 system-ui;color:#8aa0a6;padding:2px 0 4px;}
  .osx-day-add{display:flex;gap:8px;flex-wrap:wrap;margin-top:14px;border-top:1px solid rgba(255,255,255,.1);padding-top:14px;}
  .osx-day-title{flex:1;min-width:150px;background:rgba(9,17,24,.6);border:1px solid rgba(255,255,255,.14);border-radius:10px;padding:9px 12px;color:#e7efeb;font:400 13px/1.3 system-ui;outline:none;}
  .osx-day-time{width:120px;background:rgba(9,17,24,.6);border:1px solid rgba(255,255,255,.14);border-radius:10px;padding:9px 12px;color:#e7efeb;font:400 13px/1.3 system-ui;outline:none;}
  .osx-day-save{background:linear-gradient(100deg,#f4e2a6,#c9a24a);border:0;color:#0a1410;border-radius:999px;padding:9px 16px;font:800 12.5px/1 system-ui;cursor:pointer;}
  /* ===== Planner ===== */
  #p2pos .osx-pl-head{display:flex;align-items:center;justify-content:space-between;gap:14px;flex-wrap:wrap;margin-bottom:18px;}
  #p2pos .osx-pl-tfs{display:inline-flex;gap:4px;background:rgba(9,17,24,.5);border:1px solid var(--stroke);border-radius:999px;padding:4px;flex-wrap:wrap;}
  #p2pos .osx-pl-tf{border:0;background:none;color:var(--muted);cursor:pointer;border-radius:999px;padding:8px 15px;font:700 12.5px/1 system-ui;transition:.14s;}
  #p2pos .osx-pl-tf.on{color:#0a1410;background:linear-gradient(100deg,#f4e2a6,#c9a24a);}
  #p2pos .osx-pl-rollup{display:flex;flex-direction:column;align-items:flex-end;line-height:1.1;}
  #p2pos .osx-pl-rollup b{font:800 22px/1 Georgia,serif;color:var(--gold-bright);}
  #p2pos .osx-pl-rollup span{font:600 10px/1 system-ui;letter-spacing:.05em;text-transform:uppercase;color:var(--muted);margin-top:3px;}
  #p2pos .osx-pl-sec{margin-bottom:22px;}
  #p2pos .osx-pl-sech{display:flex;align-items:center;justify-content:space-between;gap:10px;font:800 12px/1 system-ui;letter-spacing:.04em;text-transform:uppercase;color:var(--gold-bright);margin-bottom:10px;}
  #p2pos .osx-pl-tmpl{border:1px solid var(--gstroke);background:rgba(216,180,90,.1);color:var(--gold-bright);cursor:pointer;border-radius:999px;padding:5px 11px;font:700 11px/1 system-ui;text-transform:none;letter-spacing:0;}
  #p2pos .osx-pl-item{display:flex;align-items:center;gap:11px;border:1px solid var(--stroke);border-radius:12px;background:rgba(255,255,255,.03);padding:11px 13px;margin-bottom:8px;}
  #p2pos .osx-pl-item.done{border-color:var(--gstroke);background:rgba(216,180,90,.07);}
  #p2pos .osx-pl-item.done .osx-pl-text{color:var(--muted);text-decoration:line-through;text-decoration-color:rgba(216,180,90,.6);}
  #p2pos .osx-pl-gauge{display:inline-flex;gap:2px;flex:none;cursor:pointer;}
  #p2pos .osx-pl-seg{width:9px;height:22px;border-radius:3px;background:rgba(255,255,255,.1);transition:.12s;}
  #p2pos .osx-pl-seg.on{background:var(--gold-bright);box-shadow:0 0 6px rgba(216,180,90,.5);}
  #p2pos .osx-pl-text{flex:1;min-width:0;font:600 14px/1.35 system-ui;color:var(--text);}
  #p2pos .osx-pl-pct{font:800 12px/1 system-ui;color:var(--muted);flex:none;width:38px;text-align:right;}
  #p2pos .osx-pl-del{border:0;background:none;color:var(--muted);cursor:pointer;font:700 13px/1 system-ui;flex:none;opacity:.6;}
  #p2pos .osx-pl-del:hover{opacity:1;color:#ff6b9d;}
  #p2pos .osx-pl-add{display:flex;gap:8px;margin-top:8px;}
  #p2pos .osx-pl-in{flex:1;min-width:0;background:rgba(9,17,24,.5);border:1px solid var(--stroke);border-radius:10px;padding:10px 13px;color:var(--text);font:400 13.5px/1.3 system-ui;outline:none;}
  #p2pos .osx-pl-in:focus{border-color:var(--gstroke);}
  #p2pos .osx-pl-addbtn{border:1px solid var(--gstroke);background:rgba(216,180,90,.12);color:var(--gold-bright);cursor:pointer;border-radius:10px;padding:9px 16px;font:700 12.5px/1 system-ui;}
  #p2pos .osx-pl-empty{font:400 13px/1.5 system-ui;color:var(--muted);padding:6px 2px 8px;}
  #p2pos .osx-pl-archbtn{border:1px solid var(--stroke);background:none;color:var(--muted);cursor:pointer;border-radius:999px;padding:9px 16px;font:700 12.5px/1 system-ui;}
  #p2pos .osx-pl-archbtn:hover{border-color:var(--gstroke);color:var(--text);}
  #p2pos .osx-pl-arch-grp{margin-bottom:16px;}
  #p2pos .osx-pl-arch-k{font:700 11px/1 system-ui;letter-spacing:.04em;text-transform:uppercase;color:var(--gold-bright);margin-bottom:7px;}
  #p2pos .osx-pl-arch-i{font:500 13px/1.5 system-ui;color:var(--muted);padding:3px 0;}
  /* planner sub-nav + rings + GROWS goals */
  #p2pos .osx-pl-nav{display:flex;gap:6px;margin-bottom:18px;border-bottom:1px solid var(--stroke);padding-bottom:12px;flex-wrap:wrap;}
  #p2pos .osx-pl-navb{border:1px solid var(--stroke);background:rgba(255,255,255,.03);color:var(--muted);cursor:pointer;border-radius:999px;padding:8px 15px;font:700 12.5px/1 system-ui;transition:.14s;}
  #p2pos .osx-pl-navb.on{color:#0a1410;background:linear-gradient(100deg,#f4e2a6,#c9a24a);border-color:transparent;}
  #p2pos .osx-pl-ring{position:relative;width:56px;height:56px;border-radius:50%;background:conic-gradient(var(--gold-bright) calc(var(--p,0)*1%),rgba(255,255,255,.09) 0);display:flex;align-items:center;justify-content:center;flex:none;}
  #p2pos .osx-pl-ring::before{content:"";position:absolute;inset:5px;border-radius:50%;background:var(--panel);}
  #p2pos .osx-pl-ring b{position:relative;font:800 13px/1 system-ui;color:var(--text);}
  #p2pos .osx-pl-strip{display:flex;gap:14px;flex-wrap:wrap;margin-bottom:20px;}
  #p2pos .osx-pl-dring{display:flex;flex-direction:column;align-items:center;gap:6px;}
  #p2pos .osx-pl-drl{font:700 10px/1 system-ui;letter-spacing:.04em;text-transform:uppercase;color:var(--muted);}
  #p2pos .osx-pl-gsum{display:flex;align-items:center;gap:12px;width:100%;text-align:left;border:1px solid var(--stroke);background:rgba(255,255,255,.03);border-radius:14px;padding:12px;margin-bottom:8px;cursor:pointer;transition:.14s;}
  #p2pos .osx-pl-gsum:hover{border-color:var(--gstroke);}
  #p2pos .osx-pl-gsum-b{display:flex;flex-direction:column;gap:4px;min-width:0;}
  #p2pos .osx-pl-gsum-b b{font:700 14px/1.25 system-ui;color:var(--text);}
  #p2pos .osx-pl-gsum-m{font:600 12px/1.3 system-ui;color:var(--muted);}
  #p2pos .osx-pl-stage-b{color:var(--gold-bright);font-weight:700;}
  #p2pos .osx-pl-newgoal{width:100%;border:1px dashed var(--gstroke);background:rgba(216,180,90,.06);color:var(--gold-bright);cursor:pointer;border-radius:14px;padding:12px;font:800 13px/1 system-ui;margin-bottom:14px;}
  #p2pos .osx-pl-goal{border:1px solid var(--stroke);border-radius:16px;background:rgba(255,255,255,.03);margin-bottom:12px;overflow:hidden;}
  #p2pos .osx-pl-goal.open{border-color:var(--gstroke);}
  #p2pos .osx-pl-gh{display:flex;align-items:center;gap:13px;padding:14px;cursor:pointer;}
  #p2pos .osx-pl-gh-b{flex:1;min-width:0;display:flex;flex-direction:column;gap:6px;}
  #p2pos .osx-pl-gh-b b{font:700 15px/1.25 system-ui;color:var(--text);}
  #p2pos .osx-pl-gh-m{display:flex;align-items:center;gap:10px;flex-wrap:wrap;}
  #p2pos .osx-pl-cd{font:700 11.5px/1.3 system-ui;color:var(--gold-bright);flex:none;text-align:right;}
  #p2pos .osx-pl-grows{display:inline-flex;align-items:center;gap:3px;}
  #p2pos .osx-pl-grows i{color:var(--muted);font-style:normal;font-size:10px;}
  #p2pos .osx-pl-grt{width:20px;height:20px;border-radius:50%;display:inline-flex;align-items:center;justify-content:center;font:800 10px/1 Georgia,serif;color:var(--muted);background:rgba(255,255,255,.05);border:1px solid var(--stroke);}
  #p2pos .osx-pl-grt.on{color:#0a1410;background:linear-gradient(100deg,#f4e2a6,#c9a24a);border-color:transparent;}
  #p2pos .osx-pl-mom{font:800 11px/1 system-ui;color:var(--emerald);letter-spacing:.02em;}
  #p2pos .osx-pl-mom.zero{color:#ff6b9d;}
  #p2pos .osx-pl-gbody{padding:0 16px 16px;border-top:1px solid var(--stroke);}
  #p2pos .osx-pl-stages{display:flex;gap:6px;flex-wrap:wrap;margin:14px 0;}
  #p2pos .osx-pl-stbtn{border:1px solid var(--stroke);background:rgba(255,255,255,.03);color:var(--muted);cursor:pointer;border-radius:999px;padding:7px 13px;font:700 12px/1 system-ui;}
  #p2pos .osx-pl-stbtn.on{color:#0a1410;background:linear-gradient(100deg,#f4e2a6,#c9a24a);border-color:transparent;}
  #p2pos .osx-pl-gdel{margin-left:auto;border:0;background:none;color:var(--muted);cursor:pointer;font:600 12px/1 system-ui;text-decoration:underline;}
  #p2pos .osx-pl-warn{border:1px solid rgba(224,69,123,.4);background:rgba(224,69,123,.08);border-radius:11px;padding:10px 13px;font:500 12.5px/1.5 system-ui;color:#ffc2d8;margin-bottom:14px;}
  #p2pos .osx-pl-warn b{color:#fff;}
  #p2pos .osx-pl-field{margin-bottom:12px;}
  #p2pos .osx-pl-flabel{font:800 11px/1.3 system-ui;letter-spacing:.03em;text-transform:uppercase;color:var(--gold-bright);margin:12px 0 7px;}
  #p2pos .osx-pl-flabel span{display:block;text-transform:none;letter-spacing:0;font:400 11.5px/1.4 system-ui;color:var(--muted);margin-top:2px;}
  #p2pos .osx-pl-ta{width:100%;box-sizing:border-box;background:rgba(9,17,24,.5);border:1px solid var(--stroke);border-radius:11px;padding:10px 13px;color:var(--text);font:400 13.5px/1.55 system-ui;resize:vertical;outline:none;}
  #p2pos .osx-pl-ta:focus{border-color:var(--gstroke);}
  #p2pos .osx-pl-ownrow{display:flex;gap:8px;flex-wrap:wrap;}
  #p2pos .osx-pl-owntog{border:1px solid var(--gstroke);background:rgba(216,180,90,.1);color:var(--gold-bright);cursor:pointer;border-radius:10px;padding:9px 14px;font:700 12px/1 system-ui;white-space:nowrap;}
  #p2pos .osx-pl-owntog.on{color:#0a1410;background:linear-gradient(100deg,#f4e2a6,#c9a24a);border-color:transparent;}
  #p2pos .osx-pl-date{background:rgba(9,17,24,.5);border:1px solid var(--stroke);border-radius:10px;padding:9px 12px;color:var(--text);font:600 13px/1 system-ui;color-scheme:dark;outline:none;}
  #p2pos .osx-pl-date:focus{border-color:var(--gstroke);}
  /* lives tracker */
  #p2pos .osx-lv-trend{display:flex;gap:16px;flex-wrap:wrap;align-items:center;border:1px solid var(--gstroke);border-radius:14px;background:rgba(216,180,90,.05);padding:14px 16px;margin-bottom:16px;}
  #p2pos .osx-lv-stat{display:flex;flex-direction:column;}
  #p2pos .osx-lv-stat b{font:800 20px/1 Georgia,serif;color:var(--gold-bright);}
  #p2pos .osx-lv-stat span{font:600 10px/1 system-ui;letter-spacing:.04em;text-transform:uppercase;color:var(--muted);margin-top:4px;}
  #p2pos .osx-lv-sparkwrap{margin-left:auto;display:flex;flex-direction:column;gap:4px;}
  #p2pos .osx-lv-sparkwrap span{font:600 10px/1 system-ui;text-transform:uppercase;letter-spacing:.04em;color:var(--muted);}
  #p2pos .osx-lv-spark{width:200px;height:40px;}
  #p2pos .osx-lv-card{border:1px solid var(--stroke);border-radius:14px;background:rgba(255,255,255,.03);margin-bottom:9px;overflow:hidden;}
  #p2pos .osx-lv-card.open{border-color:var(--gstroke);}
  #p2pos .osx-lv-h{display:flex;align-items:center;gap:12px;padding:13px 14px;cursor:pointer;}
  #p2pos .osx-lv-plat{flex:none;font:800 10px/1 system-ui;letter-spacing:.03em;text-transform:uppercase;color:#0a1410;background:linear-gradient(100deg,#f4e2a6,#c9a24a);border-radius:6px;padding:5px 8px;}
  #p2pos .osx-lv-hb{flex:1;min-width:0;display:flex;flex-direction:column;gap:3px;}
  #p2pos .osx-lv-hb b{font:700 14px/1.25 system-ui;color:var(--text);}
  #p2pos .osx-lv-hm{font:600 12px/1.3 system-ui;color:var(--muted);}
  #p2pos .osx-lv-when{font:700 11.5px/1.3 system-ui;color:var(--gold-bright);flex:none;}
  #p2pos .osx-lv-body{padding:0 15px 15px;border-top:1px solid var(--stroke);}
  #p2pos .osx-lv-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(130px,1fr));gap:10px;margin:12px 0;}
  #p2pos .osx-lv-f{display:flex;flex-direction:column;gap:5px;}
  #p2pos .osx-lv-f span{font:700 10px/1 system-ui;letter-spacing:.03em;text-transform:uppercase;color:var(--muted);}
  #p2pos .osx-lv-mkt{display:inline-block;margin-top:10px;font:700 12.5px/1 system-ui;color:var(--gold-bright);text-decoration:none;border:1px solid var(--gstroke);border-radius:999px;padding:9px 14px;}
  #p2pos .osx-lv-mkt:hover{background:rgba(216,180,90,.1);}
  #p2pos .osx-lv-check{border-top:1px solid var(--stroke);margin-top:14px;padding-top:12px;}
  #p2pos .osx-lv-donebtn{margin-top:12px;border:1px solid var(--gstroke);background:rgba(216,180,90,.12);color:var(--gold-bright);cursor:pointer;border-radius:999px;padding:10px 18px;font:800 12.5px/1 system-ui;}
  #p2pos .osx-lv-donebtn.on{color:#0a1410;background:linear-gradient(100deg,#f4e2a6,#c9a24a);border-color:transparent;}
  #p2pos .osx-lv-del{margin-top:12px;}
  #p2pos .osx-lv-del button{border:0;background:none;color:var(--muted);cursor:pointer;font:600 12px/1 system-ui;text-decoration:underline;}
  /* lives v2: pills, multi-platform, goal-vs-result, post-live, heart check */
  #p2pos .osx-lv-plats{display:flex;gap:5px;flex-wrap:wrap;flex:none;max-width:50%;}
  #p2pos .osx-plat-pill{font:800 10px/1 system-ui;color:#0a1410;background:linear-gradient(100deg,#f4e2a6,#c9a24a);border-radius:6px;padding:5px 8px;white-space:nowrap;}
  #p2pos .osx-plat-chips{display:flex;gap:7px;flex-wrap:wrap;}
  #p2pos .osx-plat-chip{border:1px solid var(--stroke);background:rgba(255,255,255,.03);color:var(--muted);cursor:pointer;border-radius:999px;padding:8px 13px;font:700 12px/1 system-ui;}
  #p2pos .osx-plat-chip.on{color:#0a1410;background:linear-gradient(100deg,#f4e2a6,#c9a24a);border-color:transparent;}
  #p2pos .osx-lv-f.met .osx-pl-in{border-color:#27ae6e;background:rgba(39,174,110,.14);color:#7ee2b0;}
  #p2pos .osx-lv-f.miss .osx-pl-in{border-color:#d4a017;background:rgba(212,160,23,.14);color:#f4d06a;}
  #p2pos .osx-lv-platblk{margin:10px 0;}
  #p2pos .osx-lv-platlbl{margin-bottom:6px;}
  #p2pos .osx-lv-post{border:1px solid var(--gstroke);border-radius:14px;background:rgba(216,180,90,.05);padding:14px;margin-top:16px;}
  #p2pos .osx-lv-post .osx-pl-in,#p2pos .osx-lv-post .osx-pl-ta{background:rgba(9,17,24,.4);}
  #p2pos .osx-lv-posth{font:800 12px/1 system-ui;letter-spacing:.03em;text-transform:uppercase;color:var(--text);margin-bottom:8px;}
  #p2pos .osx-lv-hint2{font:500 11.5px/1.4 system-ui;color:var(--muted);margin-bottom:10px;}
  #p2pos .osx-lv-hint2 b.g{color:#7ee2b0;} #p2pos .osx-lv-hint2 b.y{color:#f4d06a;}
  #p2pos .osx-lv-grid3{display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:10px;margin:12px 0;}
  #p2pos .osx-lv-heart{border-top:1px solid var(--stroke);margin-top:14px;padding-top:12px;}
