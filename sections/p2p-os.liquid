  #p2pos .osx-usermeta{display:block;font:600 10px/1.2 system-ui;letter-spacing:.03em;text-transform:uppercase;color:var(--gold-bright);}
  #p2pos .osx-bell{position:relative;flex:none;background:none;border:0;cursor:pointer;font-size:18px;line-height:1;padding:4px;filter:grayscale(.2);transition:transform .12s;}
