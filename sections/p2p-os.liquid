  #p2pos .osx-react{display:inline-flex;gap:6px;align-items:center;flex-wrap:wrap;}
  #p2pos .osx-react-b{border:1px solid var(--stroke);background:rgba(255,255,255,.04);color:var(--muted);cursor:pointer;border-radius:999px;padding:5px 10px;font:700 12px/1 system-ui;transition:.15s;display:inline-flex;align-items:center;gap:5px;}
