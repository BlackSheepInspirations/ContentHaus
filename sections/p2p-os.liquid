    // Daily Mindset · Purpose · Heart carousel — one item per pillar per day; auto-rotate + Next
    (function(){ try{
      var wrap = root.querySelector('[data-osx-moments]'); if(!wrap) return;
      var day = Math.floor(Date.now() / 864e5);
      var pillars = [
        { label: 'Mindset', pool: window.P2P_MOMENTS },
        { label: 'Purpose', pool: window.P2P_PURPOSE },
        { label: 'Heart', pool: window.P2P_HEART }
      ].filter(function(p){ return p.pool && p.pool.length; });
      if(!pillars.length) return;
      var titleEl = wrap.querySelector('[data-mo-title]'), textEl = wrap.querySelector('[data-mo-text]'), srcEl = wrap.querySelector('[data-mo-source]');
      var dotsWrap = wrap.querySelector('[data-mo-dots]');
      dotsWrap.innerHTML = pillars.map(function(_, di){ return '<button class="mo-dot' + (di === 0 ? ' on' : '') + '" type="button" aria-label="Check ' + (di + 1) + '"></button>'; }).join('');
      var dots = dotsWrap.querySelectorAll('.mo-dot');
      var i = 0, timer = null;
      function render(){
        var p = pillars[i], it = p.pool[day % p.pool.length] || {};
        titleEl.innerHTML = '<span class="mo-star">✦</span> <span class="mo-grad">' + p.label + '</span> Booster';
        textEl.textContent = it.t ? ('“' + it.t + '”') : '';
        srcEl.textContent = it.s || '';
        dots.forEach(function(d, di){ d.classList.toggle('on', di === i); });
      }
      function go(n){ i = ((n % pillars.length) + pillars.length) % pillars.length; render(); }
      function next(){ go(i + 1); }
      function stop(){ if(timer){ clearInterval(timer); timer = null; } }
      function start(){ stop(); timer = setInterval(next, 9000); }
      var nb = wrap.querySelector('[data-mo-next]'); if(nb) nb.addEventListener('click', function(){ next(); start(); });
      dots.forEach(function(d, di){ d.addEventListener('click', function(){ go(di); start(); }); });
      wrap.addEventListener('mouseenter', stop); wrap.addEventListener('mouseleave', start);
