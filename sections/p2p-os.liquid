    },
    {
      "type": "faq",
      "name": "FAQ",
      "settings": [
        { "type": "text", "id": "q", "label": "Question" },
        { "type": "richtext", "id": "a", "label": "Answer" }
      ]
    },
    {
      "type": "checkitem",
      "name": "Checkpoint item",
      "settings": [
        { "type": "text", "id": "label", "label": "Label" },
        { "type": "text", "id": "note", "label": "Note" }
      ]
    },
    {
      "type": "meet",
      "name": "Meet card (Haus / Mate)",
      "settings": [
        { "type": "text", "id": "title", "label": "Title" },
        { "type": "text", "id": "blurb", "label": "Blurb" },
        { "type": "select", "id": "icon", "label": "Icon", "default": "crown", "options": [
          { "value": "crown", "label": "Brand 👑" }, { "value": "prompt", "label": "Content ✍️" }, { "value": "palette", "label": "Graphics 🎨" },
          { "value": "box", "label": "Project 📦" }, { "value": "megaphone", "label": "Marketing 📣" }, { "value": "rocket", "label": "Growth 🚀" }, { "value": "mates", "label": "Haus Mates 🤝" }
        ] }
      ]
    }
  ],
  "presets": [ { "name": "P2P Operating System" } ]
}
