  /* Haus Mates — Frank (Idea) & Ruth (Build) */
  #p2pos .osx-mates{display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));gap:20px;margin-bottom:18px;}
  #p2pos .osx-mate{position:relative;display:flex;flex-direction:column;align-items:center;text-align:center;gap:6px;
    padding:30px 26px 28px;border:1px solid var(--stroke);border-radius:22px;overflow:hidden;
    background:linear-gradient(180deg,rgba(255,255,255,.035),rgba(9,17,24,.45));transition:transform .18s ease,border-color .18s ease;}
  #p2pos .osx-mate:hover{transform:translateY(-3px);}
  #p2pos .osx-mate::before{content:"";position:absolute;inset:-40% -20% auto -20%;height:70%;filter:blur(34px);opacity:.55;pointer-events:none;z-index:0;}
  #p2pos .osx-mate--idea{border-color:rgba(58,86,150,.4);}
  #p2pos .osx-mate--idea::before{background:radial-gradient(60% 100% at 50% 0%,rgba(58,86,150,.7),transparent 70%),radial-gradient(50% 100% at 70% 0%,rgba(201,162,74,.5),transparent 70%);}
  #p2pos .osx-mate--idea:hover{border-color:rgba(84,120,196,.75);}
  #p2pos .osx-mate--build{border-color:rgba(122,40,72,.42);}
  #p2pos .osx-mate--build::before{background:radial-gradient(60% 100% at 50% 0%,rgba(122,40,72,.7),transparent 70%),radial-gradient(50% 100% at 70% 0%,rgba(201,162,74,.5),transparent 70%);}
  #p2pos .osx-mate--build:hover{border-color:rgba(163,58,96,.8);}
  #p2pos .osx-mate > *{position:relative;z-index:1;}
