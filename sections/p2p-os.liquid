  #p2pos .osx-mb-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(210px,1fr));gap:14px;}
  #p2pos .osx-mb-card{border:1px solid var(--stroke);border-radius:16px;padding:18px 16px;background:linear-gradient(180deg,rgba(255,255,255,.03),rgba(9,17,24,.4));text-align:center;}
