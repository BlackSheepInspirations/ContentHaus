    { "type": "checkbox", "id": "show_stats", "label": "Show live stats (ring + points/badges/streak/tier)", "default": true },
    { "type": "checkbox", "id": "show_moment", "label": "Load progress engine", "default": true },
    { "type": "text", "id": "journey_access_tag", "label": "Journey access tag", "default": "p2p-learning" },
    { "type": "text", "id": "reassure_title", "label": "Reassurance title", "default": "You've got this." },
    { "type": "textarea", "id": "reassure_body", "label": "Reassurance body", "default": "You don't have to know it all today. Take one step at a time — we'll get you on the raft, help you float, then sail, and thrive as you grow." },
    { "type": "text", "id": "faq_heading", "label": "FAQ heading", "default": "Need help?" },
    { "type": "header", "content": "Checkpoint view" },
    { "type": "text", "id": "checkpoint_title", "label": "Checkpoint title", "default": "Set yourself up before you go" },
    { "type": "textarea", "id": "checkpoint_intro", "label": "Checkpoint intro", "default": "A few quick things to do while you're here today. Tick them off — when they're all done, you're ready for the next steps." },
    { "type": "text", "id": "meet_heading", "label": "Meet heading", "default": "Meet your Hausen & Haus Mates" },
    { "type": "header", "content": "Notebook view" },
    { "type": "text", "id": "notebook_title", "label": "Notebook title", "default": "Your Notebook" },
    { "type": "textarea", "id": "notebook_intro", "label": "Notebook intro", "default": "Jot ideas, plans, and notes as you build. Give each a title so you can find it again later." }
  ],
  "blocks": [
    {
      "type": "navitem",
      "name": "Sidebar item",
      "settings": [
        { "type": "text", "id": "label", "label": "Label" },
        { "type": "select", "id": "icon", "label": "Icon", "default": "spark", "options": [
          { "value": "spark", "label": "Spark" }, { "value": "check", "label": "Check" }, { "value": "fingerprint", "label": "Fingerprint" },
          { "value": "crown", "label": "Crown (Brand)" }, { "value": "prompt", "label": "Prompt (Content)" }, { "value": "palette", "label": "Palette (Graphics)" },
          { "value": "box", "label": "Box (Project)" }, { "value": "megaphone", "label": "Megaphone (Marketing)" }, { "value": "rocket", "label": "Rocket (Growth)" },
          { "value": "path", "label": "Path (ROOTED)" }, { "value": "mates", "label": "Haus Mates" }, { "value": "tools", "label": "Tools" },
          { "value": "notebook", "label": "Notebook" }, { "value": "gift", "label": "Gift (Bonus)" }
        ] },
        { "type": "select", "id": "mode", "label": "Behavior", "default": "view", "options": [
          { "value": "view", "label": "Show a built-in view" }, { "value": "embed", "label": "Embed a page in the pane" }, { "value": "link", "label": "Navigate to a page" }
        ] },
        { "type": "text", "id": "target", "label": "Target", "info": "A view id (start / checkpoint …) for 'view', or a URL for 'embed'/'link'." },
        { "type": "text", "id": "access_tag", "label": "Access tag (optional)", "info": "Locks the item unless the customer has this tag (or all-access)." },
