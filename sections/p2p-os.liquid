    { "type": "text", "id": "hero_title", "label": "Hero title", "default": "Your journey starts here" },
    { "type": "textarea", "id": "hero_body", "label": "Hero body", "default": "This is your home — built around you. Your fingerprint, your spark, your story. Everything you need to go from idea to income lives right here. Let's make it yours." },
    { "type": "text", "id": "hero_cta_label", "label": "Hero button label", "default": "Show me around →" },
