  /* help us be better */
  #p2pos .osx-suggest{max-width:560px;margin-top:34px;padding:18px;border:1px solid var(--stroke);border-radius:16px;background:rgba(255,255,255,.03);}
  #p2pos .osx-suggest-h{font:700 15px/1.2 system-ui;color:var(--text);margin-bottom:6px;}
  #p2pos .osx-suggest-sub{font:400 13px/1.5 system-ui;color:var(--muted);margin:0 0 12px;}
