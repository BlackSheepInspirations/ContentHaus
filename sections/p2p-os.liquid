      var i = 0;
      function tick(){
        var next = LINES[i];
        line.classList.add('is-out');
        setTimeout(function(){
          line.textContent = next;
          line.classList.remove('is-out'); line.classList.add('is-in');
          void line.offsetWidth; // reflow so the in-animation starts from below
          line.classList.remove('is-in');
          i = (i + 1) % LINES.length;
        }, 500);
      }
      setInterval(tick, 11000);
    }catch(e){ if(window.console) console.warn('P2P born-original skipped:', e); } })();

    // Checkpoint "Meet your Hausen" — flip a card to reveal more + a link (link click still navigates).
    (function(){ try{
      root.querySelectorAll('.osx-meetcard').forEach(function(card){
        if(card.hasAttribute('data-noflip')){ return; }  // e.g. Rewards Map card — its own click opens the pop-up, no flip
        function flip(){ card.classList.toggle('flipped'); }
        card.addEventListener('click', function(e){ if(e.target.closest('.osx-meetlink')){ return; } flip(); });
        card.addEventListener('keydown', function(e){ if(e.key === 'Enter' || e.key === ' '){ e.preventDefault(); flip(); } });
      });
    }catch(e){ if(window.console) console.warn('P2P meet-flip skipped:', e); } })();

    // Bonus Resources — nested accordion (category → sub-category). Each header toggles its own body.
    (function(){ try{
      root.querySelectorAll('[data-bacc]').forEach(function(btn){
        btn.addEventListener('click', function(){
          var open = btn.getAttribute('aria-expanded') === 'true';
          btn.setAttribute('aria-expanded', open ? 'false' : 'true');
          var body = btn.nextElementSibling; if(body) body.hidden = open;
        });
      });
    }catch(e){ if(window.console) console.warn('P2P bonus-accordion skipped:', e); } })();

    // "Your road ahead" — light up each step from real cross-Haus signals (same localStorage the Vault reads)
    (function(){ try{
      function J(k){ try{ return JSON.parse(localStorage.getItem(k)); }catch(e){ return null; } }
      function log(k){ var v = J(k); return Array.isArray(v) && v.length > 0; }
      var vault = J('blackSheepBrandKitVault'), gp = J('promptToProfit.currentProject'), P = window.P2P;
      var signals = {
        arrived: true,
        assessment: !!J('p2p_archetype'),
        brand: (vault && vault.brandHausKits && vault.brandHausKits.length > 0) || log('brandHausRecentLog'),
        content: log('promptHausRecentLog'),
        graphics: log('graphicsHausRecentLog'),
        project: log('productHausRecentLog'),
        marketing: log('marketingHausRecentLog'),
        growth: (gp && gp.rootedStages && Object.keys(gp.rootedStages).some(function(k){ return gp.rootedStages[k]; })) || (P && P.isCourseDone && P.isCourseDone('rooted'))
      };
      root.querySelectorAll('.osx-node[data-step]').forEach(function(node){
        if(signals[node.getAttribute('data-step')]){ node.classList.add('done'); var d = node.querySelector('.osx-dot'); if(d) d.textContent = '✓'; }
        // flip to reveal the exact task that earns this step's checkmark
        node.addEventListener('click', function(){ node.classList.toggle('flipped'); });
        node.addEventListener('keydown', function(e){ if(e.key === 'Enter' || e.key === ' '){ e.preventDefault(); node.classList.toggle('flipped'); } });
      });
    }catch(e){ if(window.console) console.warn('P2P road-ahead skipped:', e); } })();
  });
</script>

