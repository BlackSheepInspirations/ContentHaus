  /* Win of the Week — pinned gold card */
  #p2pos .osx-wow{position:relative;border:1.5px solid var(--gstroke);border-radius:16px;background:linear-gradient(180deg,rgba(216,180,90,.12),rgba(9,17,24,.35));padding:22px 16px 16px;margin-bottom:14px;box-shadow:0 0 26px rgba(216,180,90,.18);}
  #p2pos .osx-wow-ribbon{position:absolute;top:-11px;left:16px;font:800 11px/1 system-ui;letter-spacing:.05em;text-transform:uppercase;color:#0a1410;background:linear-gradient(100deg,#f4e2a6,#c9a24a);border-radius:999px;padding:5px 12px;box-shadow:0 3px 10px rgba(0,0,0,.35);}
  /* sidebar profile bubble + bell */
  #p2pos .osx-userbar{position:relative;display:flex;align-items:center;gap:10px;padding:4px 10px 12px;margin-bottom:8px;border-bottom:1px solid var(--stroke);}
