  #p2pos .osx-mb-loc{font:500 12px/1.3 system-ui;color:var(--muted);margin-top:4px;}
  #p2pos .osx-mb-since{font:500 11px/1.3 system-ui;color:var(--muted);margin-top:3px;opacity:.85;}
  #p2pos .osx-mb-quote{font:italic 400 13px/1.5 Georgia,serif;color:#c9e6da;margin:10px 0 0;}
