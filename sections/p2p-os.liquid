{%- comment -%}
  Purpose 2 Profit — Operating System SHELL (member home base).
  A persistent left sidebar + a content pane. Sidebar items are `navitem` blocks:
    mode "view"  -> shows a native view in the pane (only "start" is built in P1; others show a placeholder)
    mode "embed" -> loads the target page inside the pane (iframe; seamless once that Haus adds embedded-mode)
    mode "link"  -> navigates to the target URL
  The "Your Journey Starts Here" view is driven by settings + `step` (gamified map) + `faq` blocks.
  Gating matches every Haus: customer.tags contains the item's access_tag (or the all-access tag).
  Scoped to #p2pos. Phase 1 of docs/p2p-os-build-plan.md.
{%- endcomment -%}

{%- assign all_tag = section.settings.all_access_tag | default: 'all-access' -%}
{%- assign owns_all = false -%}
{%- if customer and all_tag != blank and customer.tags contains all_tag -%}{%- assign owns_all = true -%}{%- endif -%}
{%- if request.design_mode -%}{%- assign owns_all = true -%}{%- endif -%}
{%- assign has_journey = owns_all -%}
{%- if customer and section.settings.journey_access_tag != blank and customer.tags contains section.settings.journey_access_tag -%}{%- assign has_journey = true -%}{%- endif -%}

<div id="p2pos" class="osx">
  <button class="osx-burger" type="button" aria-label="Menu" data-osx-burger><span></span><span></span><span></span></button>

  <aside class="osx-side" data-osx-side>
    <button class="osx-brand" type="button" data-osx-home aria-label="Back to Operating System home">
      <div class="osx-brandmark">Purpose <span class="osx-2">2</span> Profit</div>
      <div class="osx-brandsub">{{ section.settings.brand_sub | default: 'powered by Black Sheep Creations &amp; Inspirations' }}</div>
    </button>
    <nav class="osx-nav">
      {%- comment -%} Sidebar nav is baked into the section (target^label^icon^mode^access_tag^get_url) so a
         theme-editor template revert can never empty it. Edit here in code, not the customizer. {%- endcomment -%}
      {%- capture os_nav -%}start^Your Journey Starts Here^spark^view^^|checkpoint^Checkpoint^check^view^^|/pages/brand-haus?bh_focus=1^Founders Assessment^fingerprint^link^brand-haus-access^/pages/brand-haus-preview|/pages/brand-haus^Brand Haus^crown^link^brand-haus-access^/pages/brand-haus-preview|/pages/content-haus^Content Haus^prompt^link^prompt-haus-access^/pages/content-haus-preview|/pages/graphics-haus^Graphics Haus^palette^link^graphics-haus-access^/pages/graphics-haus-preview|/pages/project-haus^Project Haus^box^link^product-haus-access^/pages/project-haus-preview|/pages/marketing-haus^Marketing Haus^megaphone^link^marketing-haus-access^/pages/marketing-haus-preview|/pages/growth-haus^Growth Haus^rocket^link^P2P-haus-access^/pages/growth-haus-preview|rooted^ROOTED — Light the Path^path^view^^|mates^Haus Mates^mates^view^^|community^Community^chat^view^^|tools^Tools & Resources^tools^view^^|notebook^Notebook^notebook^view^^|bonus^Bonus Resources^gift^view^^{%- endcapture -%}
      {%- assign os_nav_items = os_nav | split: '|' -%}
      {%- for it in os_nav_items -%}
        {%- assign f = it | split: '^' -%}
        {%- assign it_tag = f[4] -%}
        {%- assign owns = owns_all -%}
        {%- if it_tag == blank -%}{%- assign owns = true -%}{%- endif -%}
        {%- if customer and it_tag != blank and customer.tags contains it_tag -%}{%- assign owns = true -%}{%- endif -%}
        {%- if request.design_mode -%}{%- assign owns = true -%}{%- endif -%}
          <button class="osx-item{% if forloop.first %} on{% endif %}{% unless owns %} locked{% endunless %}" type="button"
            data-mode="{{ f[3] }}"
            data-target="{{ f[0] }}"
            {% unless owns %}data-get="{{ f[5] }}"{% endunless %}>
            <span class="osx-ico">
              {%- case f[2] -%}
                {%- when 'spark' -%}<svg viewBox="0 0 24 24"><path d="M12 3l2.6 5.6 6.1.7-4.5 4.2 1.2 6L12 16.9 6.6 19.5l1.2-6L3.3 9.3l6.1-.7z"/></svg>
                {%- when 'check' -%}<svg viewBox="0 0 24 24"><path d="M4 12l5 5L20 6"/></svg>
                {%- when 'fingerprint' -%}<svg viewBox="0 0 24 24"><path d="M12 11v3m-4-3a4 4 0 018 0v2M6 12a6 6 0 0112 0v3m-9 0a3 3 0 006 0"/></svg>
                {%- when 'crown' -%}<svg viewBox="0 0 24 24"><path d="M4 8l4 4 4-6 4 6 4-4v9H4z"/></svg>
                {%- when 'prompt' -%}<svg viewBox="0 0 24 24"><path d="M4 5h16v11H8l-4 3z"/><path d="M8 9h8M8 12h5"/></svg>
                {%- when 'palette' -%}<svg viewBox="0 0 24 24"><path d="M12 3a9 9 0 100 18c1.5 0 2-1 2-2 0-1.3-1-1.5-1-2.5S14 15 15 15h2a4 4 0 004-4c0-4.4-4-8-9-8z"/></svg>
                {%- when 'box' -%}<svg viewBox="0 0 24 24"><path d="M12 3l8 4v10l-8 4-8-4V7z"/><path d="M4 7l8 4 8-4M12 11v10"/></svg>
                {%- when 'megaphone' -%}<svg viewBox="0 0 24 24"><path d="M3 10v4h3l7 4V6l-7 4z"/><path d="M17 8a5 5 0 010 8"/></svg>
                {%- when 'rocket' -%}<svg viewBox="0 0 24 24"><path d="M12 3c4 2 6 6 6 10l-3 3H9l-3-3c0-4 2-8 6-10z"/><circle cx="12" cy="10" r="1.6"/><path d="M9 19l-2 2M15 19l2 2"/></svg>
                {%- when 'path' -%}<svg viewBox="0 0 24 24"><path d="M6 20c0-6 12-4 12-10a4 4 0 00-8 0"/><circle cx="6" cy="20" r="1.4"/><circle cx="14" cy="6" r="1.4"/></svg>
                {%- when 'mates' -%}<svg viewBox="0 0 24 24"><circle cx="8.5" cy="9" r="3"/><circle cx="16" cy="10" r="2.4"/><path d="M3 20c0-3 2.5-5 5.5-5S14 17 14 20M14.5 20c0-2 1.5-3.5 3.5-3.5s3 1.3 3 3"/></svg>
                {%- when 'tools' -%}<svg viewBox="0 0 24 24"><path d="M14 7a3 3 0 00-4 4l-6 6 2 2 6-6a3 3 0 004-4l-2 2-2-2z"/></svg>
                {%- when 'chat' -%}<svg viewBox="0 0 24 24"><path d="M4 6a2 2 0 012-2h12a2 2 0 012 2v8a2 2 0 01-2 2H9l-4 3V6z"/><circle cx="9" cy="10" r="1"/><circle cx="12.5" cy="10" r="1"/><circle cx="16" cy="10" r="1"/></svg>
                {%- when 'notebook' -%}<svg viewBox="0 0 24 24"><path d="M6 4h12v16H6z"/><path d="M6 9h12M9 4v16"/></svg>
                {%- when 'gift' -%}<svg viewBox="0 0 24 24"><path d="M4 11h16v9H4z"/><path d="M4 8h16v3H4zM12 8v12M12 8c-2-4-6-1-3 0 3 1 3 0 3 0zm0 0c2-4 6-1 3 0-3 1-3 0-3 0z"/></svg>
                {%- else -%}<svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="8"/></svg>
              {%- endcase -%}
            </span>
            <span class="osx-lbl">{{ f[1] }}</span>
            {%- unless owns -%}<span class="osx-lock">🔒</span>{%- endunless -%}
          </button>
      {%- endfor -%}
    </nav>
  </aside>

  <main class="osx-main" data-osx-main>
    {%- comment -%} ===== VIEW: Your Journey Starts Here ===== {%- endcomment -%}
    <section class="osx-view on" data-view="start">
      <header class="osx-hero"{% if section.settings.hero_image != blank %} style="--hero:url('{{ section.settings.hero_image | image_url: width: 2000 }}')"{% endif %}>
        <div class="osx-hero-glow"></div>
        <div class="osx-hero-in">
          {%- if section.settings.hero_eyebrow != blank -%}<div class="osx-eyebrow">{{ section.settings.hero_eyebrow }}</div>{%- endif -%}
          <h1>{{ section.settings.hero_title | default: 'Welcome home' }}{%- if customer.first_name != blank -%}<span class="osx-name">, {{ customer.first_name }}</span>{%- endif -%}</h1>
          {%- if section.settings.hero_body != blank -%}<p class="osx-hero-body">{{ section.settings.hero_body }}</p>{%- endif -%}
          {%- assign os_journey_url = section.settings.journey_url | default: '/pages/p2p-learning' -%}
          <div class="osx-hero-btns">
            {%- if section.settings.hero_cta_label != blank -%}<button class="osx-cta" type="button" data-osx-goto="{{ section.settings.hero_cta_target | default: 'checkpoint' }}">{{ section.settings.hero_cta_label }}</button>{%- endif -%}
            {%- if os_journey_url != blank -%}<a class="osx-cta ghost" href="{{ os_journey_url }}">{{ section.settings.journey_label | default: 'Enter your Learning Journey →' }}</a>{%- endif -%}
          </div>
          {%- comment -%} daily Mindset · Purpose · Heart carousel (auto-rotates + Next) {%- endcomment -%}
          <div class="osx-moments" data-osx-moments hidden>
            <div class="mo-title" data-mo-title></div>
            <blockquote class="mo-text" data-mo-text></blockquote>
            <cite class="mo-source" data-mo-source></cite>
            <div class="mo-foot">
              <div class="mo-dots" data-mo-dots></div>
              <button class="mo-next" type="button" data-mo-next aria-label="Next check">›</button>
            </div>
          </div>
        </div>
        {%- comment -%} personalized Brand DNA panel — filled by JS from p2p_archetype (set when the Founders Assessment completes) {%- endcomment -%}
        <aside class="osx-hero-dna" data-osx-dna hidden></aside>
      </header>
      <script>
        window.P2P_ARCHETYPE = window.P2P_ARCHETYPE || {};
        window.P2P_ARCHETYPE.assessUrl = {{ section.settings.assessment_url | default: '/pages/p2p-assessment' | json }};
        window.P2P_ARCHETYPE.img = {
          "bold-pioneer": {{ 'brand-haus-hero-bold-pioneer.jpg' | asset_url | json }},
          "trusted-guide": {{ 'brand-haus-hero-trusted-guide.jpg' | asset_url | json }},
          "cozy-craftsman": {{ 'brand-haus-hero-cozy-craftsman.jpg' | asset_url | json }},
          "elevated-icon": {{ 'brand-haus-hero-elevated-icon.jpg' | asset_url | json }},
          "free-spirit": {{ 'brand-haus-hero-free-spirit.jpg' | asset_url | json }},
          "joyful-connector": {{ 'brand-haus-hero-joyful-connector.jpg' | asset_url | json }},
          "quiet-authority": {{ 'brand-haus-hero-quiet-authority.jpg' | asset_url | json }},
          "modern-minimalist": {{ 'brand-haus-hero-modern-minimalist.jpg' | asset_url | json }},
          "community-builder": {{ 'brand-haus-hero-community-builder.jpg' | asset_url | json }},
          "luxe-rebel": {{ 'brand-haus-hero-luxe-rebel.jpg' | asset_url | json }},
          "trail-forger": {{ 'brand-haus-hero-trail-forger.jpg' | asset_url | json }}
        };
      </script>

      {%- if section.settings.show_stats -%}
      <div class="osx-stats" data-osx-stats hidden>
        <button class="osx-ring" type="button" data-osx-ring data-prog="courses" style="--p:0" aria-label="See your course progress"><div class="osx-ringin"><b class="p2pos-ringpct">0%</b><small>Complete</small></div></button>
        <div class="osx-chips">
          <button class="osx-chip" type="button" data-prog="points" aria-label="See where your points came from"><span class="osx-cico">⭐</span><span><b class="p2pos-points">0</b><small>Points</small></span></button>
          <button class="osx-chip" type="button" data-prog="badges" aria-label="See your badges"><span class="osx-cico">🏅</span><span><b class="p2pos-badges">0</b><small>Badges</small></span></button>
          <button class="osx-chip" type="button" data-prog="streak" aria-label="See your streak"><span class="osx-cico">🔥</span><span><b class="p2pos-streak">0</b><small>Day streak</small></span></button>
          <button class="osx-chip" type="button" data-prog="merit" aria-label="See Merit and Tiers"><span class="osx-cico">✦</span><span><b class="p2pos-tier">Dreamer</b><small>Merit tier</small></span></button>
        </div>
      </div>
      {%- endif -%}

      {%- comment -%} gamified step map (baked into the section — label^note) {%- endcomment -%}
      {%- comment -%} step keys drive the JS that lights each node from real cross-Haus signals {%- endcomment -%}
      {%- capture os_steps -%}You made it!^Your journey begins — first step complete.^arrived|Find your direction^Founders Assessment^assessment|Brand^Your identity^brand|Content^Your words^content|Graphics^Your look^graphics|Project^Your build^project|Marketing^Your reach^marketing|Growth^Launch with ROOTED^growth{%- endcapture -%}
      {%- assign os_step_items = os_steps | split: '|' -%}
      <div class="osx-block">
        <div class="osx-kick">Your road ahead</div>
        <div class="osx-map">
          {%- for st in os_step_items -%}
            {%- assign sf = st | split: '^' -%}
            <div class="osx-node{% if forloop.first %} done{% endif %}" data-step="{{ sf[2] }}">
              <span class="osx-dot">{% if forloop.first %}✓{% else %}{{ forloop.index }}{% endif %}</span>
              <span class="osx-nlbl">{{ sf[0] }}</span>
              {%- if sf[1] != blank -%}<span class="osx-nnote">{{ sf[1] }}</span>{%- endif -%}
            </div>
          {%- endfor -%}
        </div>
      </div>

      {%- comment -%} you've got this — reassurance {%- endcomment -%}
      {%- if section.settings.reassure_body != blank -%}
      <div class="osx-reassure">
        <img class="osx-reassure-ic" src="{{ 'bsc-sheep-mark.png' | asset_url }}" alt="" width="46" height="46" loading="lazy">
        <div>
          <b>{{ section.settings.reassure_title | default: 'Born an Original.' }}</b>
          <p>{{ section.settings.reassure_body }}</p>
          <div class="osx-reassure-note">{{ section.settings.reassure_note | default: "One step at a time. We're glad to be here with you." }}</div>
        </div>
      </div>
      {%- endif -%}

      {%- comment -%} Your Vault — read-only cross-Haus dashboard (filled by p2p-os-vault.js) {%- endcomment -%}
      <div class="osx-vault" data-osx-vault hidden></div>

      {%- comment -%} need help / FAQ {%- endcomment -%}
      <div class="osx-block">
        <div class="osx-kick">{{ section.settings.faq_heading | default: 'Need help?' }}</div>
        <div class="osx-faq">
          <details><summary>Where do I start?</summary><div class="osx-fa"><p>Right here. Work top to bottom down the sidebar — each step builds on the last, from finding your direction all the way to launching with ROOTED.</p></div></details>
          <details><summary>What if I only have one Haus?</summary><div class="osx-fa"><p>You'll still see everything here. What you own is unlocked; the rest shows a lock with a way to add it whenever you're ready.</p></div></details>
          <details><summary>I'm not techy — is that okay?</summary><div class="osx-fa"><p>Completely. This home base was built for exactly that. One step at a time, plain language, and your Haus Mates are here to help.</p></div></details>
          <details><summary>How do I get better results from the generators?</summary><div class="osx-fa"><p>Be specific, give an example of what &ldquo;good&rdquo; looks like, and tell it who it's for. Small, clear details beat long vague ones every time.</p></div></details>
        </div>
      </div>
    </section>

    {%- comment -%} ===== VIEW: Checkpoint ===== {%- endcomment -%}
    <section class="osx-view" data-view="checkpoint">
      <div class="osx-kick">Before you leave today</div>
      <h2 class="osx-h2">{{ section.settings.checkpoint_title | default: "Set yourself up before you go" }}</h2>
      {%- if section.settings.checkpoint_intro != blank -%}<p class="osx-lede">{{ section.settings.checkpoint_intro }}</p>{%- endif -%}

      {%- comment -%} checklist baked in (id^label^note) — ids stay stable for saved state {%- endcomment -%}
      {%- capture os_checks -%}ck1^Take the Founders Assessment^Find your direction before you build.|ck2^Create your brand identity in Brand Haus^Your card, logo and kit.|ck3^Peek into each Haus^See what's inside and where it helps.|ck4^Say hi to your Haus Mates^Frank and Ruth are here to help.|ck5^Jot your first idea in the Notebook^Capture the spark while it's hot.|ck6^Come back tomorrow^Keep your streak alive.{%- endcapture -%}
      {%- assign os_check_items = os_checks | split: '|' -%}
      <div class="osx-check" data-osx-check>
        <div class="osx-check-top"><div class="osx-check-bar"><i data-osx-check-bar style="width:0%"></i></div><div class="osx-check-count"><b data-osx-check-done>0</b>/<span data-osx-check-total>{{ os_check_items.size }}</span></div></div>
        <ul class="osx-check-list">
          {%- for ck in os_check_items -%}
            {%- assign cf = ck | split: '^' -%}
            <li><label><input type="checkbox" data-osx-checkitem="{{ cf[0] }}"><span class="osx-check-box"></span><span class="osx-check-txt"><b>{{ cf[1] }}</b>{% if cf[2] != blank %}<i>{{ cf[2] }}</i>{% endif %}</span></label></li>
          {%- endfor -%}
        </ul>
        <div class="osx-check-done" data-osx-check-msg hidden>🎉 <b>You're ready for the next steps.</b> Off you go — your journey's waiting.</div>
      </div>

      {%- comment -%} meet cards baked in (icon^title^blurb) {%- endcomment -%}
      <div class="osx-kick" style="margin-top:28px">{{ section.settings.meet_heading | default: 'Meet your Hausen & Haus Mates' }}</div>
      {%- capture os_meets -%}crown^Brand Haus^Your identity — brand card, logo, and kit. Start here so everything else sounds like you.|prompt^Content Haus^Your words — prompts and copy that carry your voice everywhere you show up.|palette^Graphics Haus^Your look — on-brand visuals and design without the degree.|box^Project Haus^Your build — turn the idea into a real product, step by step.|megaphone^Marketing Haus^Your reach — posts, ads and campaigns that get you seen.|rocket^Growth Haus^Your launch — generators that execute the ROOTED method and scale what works.|mates^Frank & Ruth — your Haus Mates^Frank, your Creative Director, and Ruth, your ruthless Design Meister. Ask them anything as you go.{%- endcapture -%}
      {%- assign os_meet_items = os_meets | split: '|' -%}
      <div class="osx-meet">
        {%- for mt in os_meet_items -%}
          {%- assign mf = mt | split: '^' -%}
          <div class="osx-meetcard">
            <span class="osx-meic">{%- case mf[0] -%}{%- when 'crown' -%}👑{%- when 'prompt' -%}✍️{%- when 'palette' -%}🎨{%- when 'box' -%}📦{%- when 'megaphone' -%}📣{%- when 'rocket' -%}🚀{%- when 'mates' -%}🤝{%- else -%}✦{%- endcase -%}</span>
            <b>{{ mf[1] }}</b>
            {%- if mf[2] != blank -%}<p>{{ mf[2] }}</p>{%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    </section>

    {%- comment -%} ===== VIEW: Notebook (shared engine — Journal shares data with the Learning Journey) ===== {%- endcomment -%}
    <section class="osx-view" data-view="notebook" data-osx-nb>
      <div class="jr-head">
        <div><div class="osx-kick">Notebook</div><h2 class="osx-h2">{{ section.settings.notebook_title | default: 'Your Notebook' }}</h2></div>
        <button class="jr-export-all" type="button" data-jr-export>Export everything</button>
      </div>
      {%- if section.settings.notebook_intro != blank -%}<p class="osx-lede">{{ section.settings.notebook_intro }}</p>{%- endif -%}
      <div class="jr-tabs">
        <button class="jr-tab on" type="button" data-jrmode="journal">Journal</button>
        <button class="jr-tab" type="button" data-jrmode="notes">Notes</button>
        <button class="jr-tab" type="button" data-jrmode="ideas">Ideas</button>
        <button class="jr-tab" type="button" data-jrmode="wins">Wins</button>
      </div>
      {%- comment -%} Journal + Wins share the Learning Journey's stores (p2p_journal / p2p_wins) {%- endcomment -%}
      <div class="jr-pane" data-jrpane="journal" data-store="p2p_journal" data-kind="reflection">
        <div class="jr-compose">
          <input class="jr-title" type="text" maxlength="80" placeholder="Title (optional)" data-jr-title />
          <textarea data-jr-text rows="5" placeholder="Reflect on what you're learning and building…"></textarea>
          <div class="jr-actions"><button class="jr-save" type="button" data-jr-save>Save entry</button></div>
        </div>
        <div class="jr-toolbar">
          <input class="jr-search" type="search" placeholder="Search titles &amp; text…" data-jr-search />
          <div class="jr-views"><button class="jr-view on" type="button" data-jr-view="active">Active</button><button class="jr-view" type="button" data-jr-view="archived">Archived</button><button class="jr-view" type="button" data-jr-view="trash">Trash</button></div>
        </div>
        <div class="jr-list" data-jr-list></div>
      </div>
      <div class="jr-pane" data-jrpane="notes" data-store="p2p_notes" data-kind="note" hidden>
        <div class="jr-compose">
          <input class="jr-title" type="text" maxlength="80" placeholder="Title — e.g. “Spring launch campaign”" data-jr-title />
          <textarea data-jr-text rows="4" placeholder="Jot a note…"></textarea>
          <div class="jr-actions"><button class="jr-save" type="button" data-jr-save>Save note</button></div>
        </div>
        <div class="jr-toolbar">
          <input class="jr-search" type="search" placeholder="Search titles &amp; text…" data-jr-search />
          <div class="jr-views"><button class="jr-view on" type="button" data-jr-view="active">Active</button><button class="jr-view" type="button" data-jr-view="archived">Archived</button><button class="jr-view" type="button" data-jr-view="trash">Trash</button></div>
        </div>
        <div class="jr-list" data-jr-list></div>
      </div>
      <div class="jr-pane" data-jrpane="ideas" data-store="p2p_ideas" data-kind="idea" hidden>
        <div class="jr-compose">
          <input class="jr-title" type="text" maxlength="80" placeholder="Title — e.g. “Devotional journal for new moms”" data-jr-title />
          <textarea data-jr-text rows="4" placeholder="Capture the idea…"></textarea>
          <div class="jr-actions"><button class="jr-save" type="button" data-jr-save>Save idea</button></div>
        </div>
        <div class="jr-toolbar">
          <input class="jr-search" type="search" placeholder="Search titles &amp; text…" data-jr-search />
          <div class="jr-views"><button class="jr-view on" type="button" data-jr-view="active">Active</button><button class="jr-view" type="button" data-jr-view="archived">Archived</button><button class="jr-view" type="button" data-jr-view="trash">Trash</button></div>
        </div>
        <div class="jr-list" data-jr-list></div>
      </div>
      <div class="jr-pane" data-jrpane="wins" data-store="p2p_wins" data-kind="win" hidden>
        <div class="jr-compose">
          <input class="jr-title" type="text" maxlength="80" placeholder="Title (optional)" data-jr-title />
          <textarea data-jr-text rows="4" placeholder="Big or small — a first sale, a finished course, showing up when it was hard…"></textarea>
          <div class="jr-actions"><button class="jr-save" type="button" data-jr-save>Save win</button></div>
        </div>
        <div class="jr-toolbar">
          <input class="jr-search" type="search" placeholder="Search titles &amp; text…" data-jr-search />
