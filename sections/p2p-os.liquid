{%- comment -%}
  Purpose 2 Profit — Operating System SHELL (member home base).
  A persistent left sidebar + a content pane. Sidebar items are `navitem` blocks:
    mode "view"  -> shows a native view in the pane (only "start" is built in P1; others show a placeholder)
    mode "embed" -> loads the target page inside the pane (iframe; seamless once that Haus adds embedded-mode)
    mode "link"  -> navigates to the target URL
  The "Your Journey Starts Here" view is driven by settings + `step` (gamified map) + `faq` blocks.
  Gating matches every Haus: customer.tags contains the item's access_tag (or the all-access tag).
  Scoped to #p2pos. Phase 1 of docs/p2p-os-build-plan.md.
{%- endcomment -%}

{%- assign all_tag = section.settings.all_access_tag | default: 'all-access' -%}
{%- assign owns_all = false -%}
{%- if customer and all_tag != blank and customer.tags contains all_tag -%}{%- assign owns_all = true -%}{%- endif -%}
{%- if request.design_mode -%}{%- assign owns_all = true -%}{%- endif -%}
{%- assign has_journey = owns_all -%}
{%- if customer and section.settings.journey_access_tag != blank and customer.tags contains section.settings.journey_access_tag -%}{%- assign has_journey = true -%}{%- endif -%}

<div id="p2pos" class="osx">
  <button class="osx-burger" type="button" aria-label="Menu" data-osx-burger><span></span><span></span><span></span></button>

  <aside class="osx-side" data-osx-side>
    <div class="osx-brand">
      <div class="osx-brandmark">Purpose <span class="osx-2">2</span> Profit</div>
      <div class="osx-brandsub">{{ section.settings.brand_sub | default: 'powered by Black Sheep Creations &amp; Inspirations' }}</div>
    </div>
    <nav class="osx-nav">
      {%- for block in section.blocks -%}
        {%- if block.type == 'navitem' -%}
          {%- assign owns = owns_all -%}
          {%- if block.settings.access_tag == blank -%}{%- assign owns = true -%}{%- endif -%}
          {%- if customer and block.settings.access_tag != blank and customer.tags contains block.settings.access_tag -%}{%- assign owns = true -%}{%- endif -%}
          {%- if request.design_mode -%}{%- assign owns = true -%}{%- endif -%}
          <button class="osx-item{% if forloop.first %} on{% endif %}{% unless owns %} locked{% endunless %}" type="button"
            data-mode="{{ block.settings.mode | default: 'view' }}"
            data-target="{{ block.settings.target }}"
            {% unless owns %}data-get="{{ block.settings.get_url }}"{% endunless %}
            {{ block.shopify_attributes }}>
            <span class="osx-ico">
              {%- case block.settings.icon -%}
                {%- when 'spark' -%}<svg viewBox="0 0 24 24"><path d="M12 3l2.6 5.6 6.1.7-4.5 4.2 1.2 6L12 16.9 6.6 19.5l1.2-6L3.3 9.3l6.1-.7z"/></svg>
                {%- when 'check' -%}<svg viewBox="0 0 24 24"><path d="M4 12l5 5L20 6"/></svg>
                {%- when 'fingerprint' -%}<svg viewBox="0 0 24 24"><path d="M12 11v3m-4-3a4 4 0 018 0v2M6 12a6 6 0 0112 0v3m-9 0a3 3 0 006 0"/></svg>
                {%- when 'crown' -%}<svg viewBox="0 0 24 24"><path d="M4 8l4 4 4-6 4 6 4-4v9H4z"/></svg>
                {%- when 'prompt' -%}<svg viewBox="0 0 24 24"><path d="M4 5h16v11H8l-4 3z"/><path d="M8 9h8M8 12h5"/></svg>
                {%- when 'palette' -%}<svg viewBox="0 0 24 24"><path d="M12 3a9 9 0 100 18c1.5 0 2-1 2-2 0-1.3-1-1.5-1-2.5S14 15 15 15h2a4 4 0 004-4c0-4.4-4-8-9-8z"/></svg>
                {%- when 'box' -%}<svg viewBox="0 0 24 24"><path d="M12 3l8 4v10l-8 4-8-4V7z"/><path d="M4 7l8 4 8-4M12 11v10"/></svg>
                {%- when 'megaphone' -%}<svg viewBox="0 0 24 24"><path d="M3 10v4h3l7 4V6l-7 4z"/><path d="M17 8a5 5 0 010 8"/></svg>
                {%- when 'rocket' -%}<svg viewBox="0 0 24 24"><path d="M12 3c4 2 6 6 6 10l-3 3H9l-3-3c0-4 2-8 6-10z"/><circle cx="12" cy="10" r="1.6"/><path d="M9 19l-2 2M15 19l2 2"/></svg>
                {%- when 'path' -%}<svg viewBox="0 0 24 24"><path d="M6 20c0-6 12-4 12-10a4 4 0 00-8 0"/><circle cx="6" cy="20" r="1.4"/><circle cx="14" cy="6" r="1.4"/></svg>
                {%- when 'mates' -%}<svg viewBox="0 0 24 24"><circle cx="8.5" cy="9" r="3"/><circle cx="16" cy="10" r="2.4"/><path d="M3 20c0-3 2.5-5 5.5-5S14 17 14 20M14.5 20c0-2 1.5-3.5 3.5-3.5s3 1.3 3 3"/></svg>
                {%- when 'tools' -%}<svg viewBox="0 0 24 24"><path d="M14 7a3 3 0 00-4 4l-6 6 2 2 6-6a3 3 0 004-4l-2 2-2-2z"/></svg>
                {%- when 'notebook' -%}<svg viewBox="0 0 24 24"><path d="M6 4h12v16H6z"/><path d="M6 9h12M9 4v16"/></svg>
                {%- when 'gift' -%}<svg viewBox="0 0 24 24"><path d="M4 11h16v9H4z"/><path d="M4 8h16v3H4zM12 8v12M12 8c-2-4-6-1-3 0 3 1 3 0 3 0zm0 0c2-4 6-1 3 0-3 1-3 0-3 0z"/></svg>
                {%- else -%}<svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="8"/></svg>
              {%- endcase -%}
            </span>
            <span class="osx-lbl">{{ block.settings.label }}</span>
            {%- unless owns -%}<span class="osx-lock">🔒</span>{%- endunless -%}
          </button>
        {%- endif -%}
      {%- endfor -%}
    </nav>
  </aside>

  <main class="osx-main" data-osx-main>
    {%- comment -%} ===== VIEW: Your Journey Starts Here ===== {%- endcomment -%}
    <section class="osx-view on" data-view="start">
      <header class="osx-hero"{% if section.settings.hero_image != blank %} style="--hero:url('{{ section.settings.hero_image | image_url: width: 2000 }}')"{% endif %}>
        <div class="osx-hero-glow"></div>
        <div class="osx-hero-in">
          {%- if section.settings.hero_eyebrow != blank -%}<div class="osx-eyebrow">{{ section.settings.hero_eyebrow }}</div>{%- endif -%}
          <h1>{{ section.settings.hero_title | default: 'Welcome home' }}{%- if customer.first_name != blank -%}<span class="osx-name">, {{ customer.first_name }}</span>{%- endif -%}</h1>
          {%- if section.settings.hero_body != blank -%}<p class="osx-hero-body">{{ section.settings.hero_body }}</p>{%- endif -%}
          {%- if section.settings.hero_cta_label != blank -%}<button class="osx-cta" type="button" data-osx-goto="{{ section.settings.hero_cta_target | default: 'checkpoint' }}">{{ section.settings.hero_cta_label }}</button>{%- endif -%}
        </div>
      </header>

      {%- if section.settings.show_stats -%}
      <div class="osx-stats" data-osx-stats hidden>
        <div class="osx-ring" data-osx-ring style="--p:0"><div class="osx-ringin"><b class="p2pos-ringpct">0%</b><small>Complete</small></div></div>
        <div class="osx-chips">
          <div class="osx-chip"><span class="osx-cico">⭐</span><span><b class="p2pos-points">0</b><small>Points</small></span></div>
          <div class="osx-chip"><span class="osx-cico">🏅</span><span><b class="p2pos-badges">0</b><small>Badges</small></span></div>
          <div class="osx-chip"><span class="osx-cico">🔥</span><span><b class="p2pos-streak">0</b><small>Day streak</small></span></div>
          <div class="osx-chip"><span class="osx-cico">✦</span><span><b class="p2pos-tier">Dreamer</b><small>Merit tier</small></span></div>
        </div>
      </div>
      {%- endif -%}

      {%- comment -%} gamified step map {%- endcomment -%}
      {%- assign steps = section.blocks | where: 'type', 'step' -%}
      {%- if steps.size > 0 -%}
      <div class="osx-block">
        <div class="osx-kick">Your road ahead</div>
        <div class="osx-map">
          {%- assign i = 0 -%}
          {%- for block in section.blocks -%}
            {%- if block.type == 'step' -%}
              {%- assign i = i | plus: 1 -%}
              <div class="osx-node{% if forloop.first %} done{% endif %}" {{ block.shopify_attributes }}>
                <span class="osx-dot">{% if forloop.first %}✓{% else %}{{ i }}{% endif %}</span>
                <span class="osx-nlbl">{{ block.settings.label }}</span>
                {%- if block.settings.note != blank -%}<span class="osx-nnote">{{ block.settings.note }}</span>{%- endif -%}
              </div>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>
      {%- endif -%}

      {%- comment -%} you've got this — reassurance {%- endcomment -%}
      {%- if section.settings.reassure_body != blank -%}
      <div class="osx-reassure">
        <div class="osx-reassure-ic">🛶</div>
        <div>
          <b>{{ section.settings.reassure_title | default: "You've got this." }}</b>
          <p>{{ section.settings.reassure_body }}</p>
          <div class="osx-rjourney"><span>Get on the raft</span><i>→</i><span>Float</span><i>→</i><span>Sail</span><i>→</i><span>Thrive</span></div>
        </div>
      </div>
      {%- endif -%}

      {%- comment -%} need help / FAQ {%- endcomment -%}
      {%- assign faqs = section.blocks | where: 'type', 'faq' -%}
      {%- if faqs.size > 0 -%}
      <div class="osx-block">
        <div class="osx-kick">{{ section.settings.faq_heading | default: 'Need help?' }}</div>
        <div class="osx-faq">
          {%- for block in section.blocks -%}
            {%- if block.type == 'faq' -%}
              <details {{ block.shopify_attributes }}><summary>{{ block.settings.q }}</summary><div class="osx-fa">{{ block.settings.a }}</div></details>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>
      {%- endif -%}
    </section>

    {%- comment -%} ===== VIEW: Checkpoint ===== {%- endcomment -%}
    <section class="osx-view" data-view="checkpoint">
      <div class="osx-kick">Before you leave today</div>
      <h2 class="osx-h2">{{ section.settings.checkpoint_title | default: "Set yourself up before you go" }}</h2>
      {%- if section.settings.checkpoint_intro != blank -%}<p class="osx-lede">{{ section.settings.checkpoint_intro }}</p>{%- endif -%}

      {%- assign checks = section.blocks | where: 'type', 'checkitem' -%}
      {%- if checks.size > 0 -%}
      <div class="osx-check" data-osx-check>
        <div class="osx-check-top"><div class="osx-check-bar"><i data-osx-check-bar style="width:0%"></i></div><div class="osx-check-count"><b data-osx-check-done>0</b>/<span data-osx-check-total>{{ checks.size }}</span></div></div>
        <ul class="osx-check-list">
          {%- for block in section.blocks -%}
            {%- if block.type == 'checkitem' -%}
              <li {{ block.shopify_attributes }}><label><input type="checkbox" data-osx-checkitem="{{ block.id }}"><span class="osx-check-box"></span><span class="osx-check-txt"><b>{{ block.settings.label }}</b>{% if block.settings.note != blank %}<i>{{ block.settings.note }}</i>{% endif %}</span></label></li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
        <div class="osx-check-done" data-osx-check-msg hidden>🎉 <b>You're ready for the next steps.</b> Off you go — your journey's waiting.</div>
      </div>
      {%- endif -%}

      {%- assign meets = section.blocks | where: 'type', 'meet' -%}
      {%- if meets.size > 0 -%}
      <div class="osx-kick" style="margin-top:28px">{{ section.settings.meet_heading | default: 'Meet your Hausen & Haus Mates' }}</div>
      <div class="osx-meet">
        {%- for block in section.blocks -%}
          {%- if block.type == 'meet' -%}
            <div class="osx-meetcard" {{ block.shopify_attributes }}>
              <span class="osx-meic">
                {%- case block.settings.icon -%}
                  {%- when 'crown' -%}👑{%- when 'prompt' -%}✍️{%- when 'palette' -%}🎨{%- when 'box' -%}📦{%- when 'megaphone' -%}📣{%- when 'rocket' -%}🚀{%- when 'mates' -%}🤝{%- else -%}✦
                {%- endcase -%}
              </span>
              <b>{{ block.settings.title }}</b>
              {%- if block.settings.blurb != blank -%}<p>{{ block.settings.blurb }}</p>{%- endif -%}
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
      {%- endif -%}
    </section>

    {%- comment -%} ===== VIEW: Notebook ===== {%- endcomment -%}
    <section class="osx-view" data-view="notebook">
      <div class="osx-kick">Notebook</div>
      <h2 class="osx-h2">{{ section.settings.notebook_title | default: 'Your Notebook' }}</h2>
      {%- if section.settings.notebook_intro != blank -%}<p class="osx-lede">{{ section.settings.notebook_intro }}</p>{%- endif -%}
      <div class="osx-nb" data-osx-nb>
        <div class="osx-nb-compose">
          <input class="osx-nb-title" data-nb-title type="text" placeholder="Title — e.g. “Spring launch campaign”" maxlength="120">
          <textarea class="osx-nb-body" data-nb-body rows="4" placeholder="Jot your idea, plan, or note…"></textarea>
          <div class="osx-nb-actions">
            <button class="osx-nb-save" type="button" data-nb-save>Save note</button>
            <button class="osx-nb-cancel" type="button" data-nb-cancel hidden>Cancel</button>
          </div>
        </div>
        <div class="osx-nb-searchrow">
          <input class="osx-nb-search" data-nb-search type="search" placeholder="Search your notes…">
          <span class="osx-nb-count" data-nb-count></span>
        </div>
        <div class="osx-nb-list" data-nb-list></div>
        <div class="osx-nb-empty" data-nb-empty hidden>No notes yet — your first idea goes above. ✦</div>
      </div>
    </section>

    {%- comment -%} ===== generic placeholder + embed frame ===== {%- endcomment -%}
    <section class="osx-view" data-view="__placeholder">
      <div class="osx-ph"><div class="osx-ph-ic">✦</div><h2 data-osx-ph-title>Coming together</h2><p>This part of your OS is being built. Check back very soon.</p></div>
    </section>
    <section class="osx-view" data-view="__locked">
      <div class="osx-ph"><div class="osx-ph-ic">🔒</div><h2 data-osx-lock-title>Locked</h2><p>You don't have access to this yet.</p><a class="osx-cta as-link" data-osx-get href="#">Get access →</a></div>
    </section>
    <iframe class="osx-frame" data-osx-frame title="Tool" hidden></iframe>
  </main>
</div>

<style>
  #p2pos.osx{--text:#e7efeb;--muted:#8aa0a6;--gold:#c9a24a;--gold-bright:#f4c534;--stroke:rgba(255,255,255,.09);--gstroke:rgba(216,180,90,.38);
    --panel:#0b1620;--side:#081119;--aurora:linear-gradient(100deg,#f4e2a6,#8f6fd6,#27ae6e,#39c5c0,#2563eb,#d6336c,#f4e2a6);
    display:grid;grid-template-columns:264px 1fr;gap:0;min-height:80vh;color:var(--text);font-family:system-ui,-apple-system,sans-serif;
    background:radial-gradient(120% 80% at 0% 0%,#0d1a26,#050a10);border:1px solid var(--stroke);border-radius:22px;overflow:hidden;}
  @keyframes p2pos-shift{0%{background-position:0% 50%;}100%{background-position:300% 50%;}}
  #p2pos .osx-2{background:var(--aurora);background-size:300% 100%;-webkit-background-clip:text;background-clip:text;color:transparent;animation:p2pos-shift 20s linear infinite;font-style:italic;}
  #p2pos .osx-burger{display:none;}

  /* sidebar */
  #p2pos .osx-side{background:linear-gradient(180deg,var(--side),#060d14);border-right:1px solid var(--stroke);padding:22px 14px;display:flex;flex-direction:column;gap:6px;}
  #p2pos .osx-brand{padding:6px 10px 16px;border-bottom:1px solid var(--stroke);margin-bottom:10px;}
  #p2pos .osx-brandmark{font:700 19px/1.1 Georgia,serif;letter-spacing:.01em;}
  #p2pos .osx-brandsub{margin-top:5px;font:600 9.5px/1.3 system-ui;letter-spacing:.03em;text-transform:uppercase;color:var(--muted);}
  #p2pos .osx-nav{display:flex;flex-direction:column;gap:3px;overflow-y:auto;}
  #p2pos .osx-item{display:flex;align-items:center;gap:11px;width:100%;padding:11px 12px;border:1px solid transparent;border-radius:11px;background:none;color:#cdd9dd;font:600 13.5px/1.2 system-ui;text-align:left;cursor:pointer;transition:background .15s,border-color .15s,color .15s;}
  #p2pos .osx-item:hover{background:rgba(255,255,255,.04);color:var(--text);}
  #p2pos .osx-item.on{background:linear-gradient(100deg,rgba(216,180,90,.16),rgba(143,111,214,.12));border-color:var(--gstroke);color:#fff;}
  #p2pos .osx-ico{flex:0 0 20px;height:20px;display:grid;place-items:center;}
  #p2pos .osx-ico svg{width:18px;height:18px;fill:none;stroke:var(--gold-bright);stroke-width:1.5;stroke-linecap:round;stroke-linejoin:round;}
  #p2pos .osx-item.locked .osx-ico svg{stroke:var(--muted);}
  #p2pos .osx-lbl{flex:1;min-width:0;}
  #p2pos .osx-lock{font-size:11px;opacity:.7;}

  /* main pane */
  #p2pos .osx-main{position:relative;overflow-y:auto;max-height:88vh;}
  #p2pos .osx-view{display:none;padding:30px 34px 44px;}
  #p2pos .osx-view.on{display:block;}
  #p2pos .osx-frame{width:100%;height:88vh;border:0;background:#0b1620;}

  /* hero */
  #p2pos .osx-hero{position:relative;border-radius:20px;overflow:hidden;padding:44px 36px;margin-bottom:24px;
    background:linear-gradient(120deg,rgba(143,111,214,.16),rgba(57,197,192,.08)),#0a141c;}
  #p2pos .osx-hero[style*="--hero"]{background:linear-gradient(180deg,rgba(5,10,16,.55),rgba(5,10,16,.82)),var(--hero) center/cover no-repeat;}
  #p2pos .osx-hero-glow{position:absolute;inset:-40% -10% auto -10%;height:60%;background:radial-gradient(50% 100% at 30% 0%,rgba(143,111,214,.5),transparent 70%),radial-gradient(50% 100% at 75% 10%,rgba(57,197,192,.4),transparent 70%);filter:blur(20px);opacity:.6;pointer-events:none;}
  #p2pos .osx-hero-in{position:relative;}
  #p2pos .osx-eyebrow{font:700 11px/1 system-ui;letter-spacing:.2em;text-transform:uppercase;color:var(--gold);margin-bottom:12px;}
  #p2pos .osx-hero h1{font:700 clamp(28px,4.5vw,42px)/1.1 Georgia,serif;margin:0 0 12px;}
  #p2pos .osx-name{background:var(--aurora);background-size:300% 100%;-webkit-background-clip:text;background-clip:text;color:transparent;animation:p2pos-shift 20s linear infinite;}
  #p2pos .osx-hero-body{font:400 16px/1.6 system-ui;color:#dbe7e2;max-width:600px;margin:0 0 20px;}
  #p2pos .osx-cta{display:inline-block;padding:14px 28px;border:0;border-radius:12px;font:800 14px/1 system-ui;color:#0a1410;text-decoration:none;cursor:pointer;
    background:var(--aurora);background-size:300% 100%;animation:p2pos-shift 20s linear infinite;box-shadow:0 12px 30px rgba(0,0,0,.35);transition:transform .12s;}
  #p2pos .osx-cta:hover{transform:translateY(-2px);}
  #p2pos .osx-cta.as-link{margin-top:8px;}

  /* stat strip */
  #p2pos .osx-stats{display:flex;align-items:center;gap:20px;flex-wrap:wrap;margin-bottom:26px;}
  #p2pos .osx-ring{flex:0 0 104px;width:104px;height:104px;border-radius:50%;display:grid;place-items:center;background:conic-gradient(from -90deg,#39c5c0,#8f6fd6,#f4c534 calc(var(--p)*1%),rgba(255,255,255,.08) calc(var(--p)*1%));}
  #p2pos .osx-ringin{width:80px;height:80px;border-radius:50%;background:var(--panel);display:grid;place-items:center;text-align:center;}
  #p2pos .osx-ringin b{font:800 20px/1 system-ui;color:var(--gold-bright);}
  #p2pos .osx-ringin small{display:block;margin-top:2px;font:600 8.5px/1 system-ui;letter-spacing:.06em;text-transform:uppercase;color:var(--muted);}
  #p2pos .osx-chips{display:grid;grid-template-columns:repeat(auto-fit,minmax(120px,1fr));gap:11px;flex:1;min-width:240px;}
  #p2pos .osx-chip{display:flex;align-items:center;gap:10px;padding:11px 13px;border:1px solid var(--stroke);border-radius:13px;background:rgba(255,255,255,.03);}
  #p2pos .osx-cico{font-size:17px;}
  #p2pos .osx-chip b{display:block;font:800 18px/1 system-ui;color:var(--gold-bright);}
  #p2pos .osx-chip .p2pos-tier{font:700 14px/1.1 Georgia,serif;background:var(--aurora);background-size:300% 100%;-webkit-background-clip:text;background-clip:text;color:transparent;animation:p2pos-shift 20s linear infinite;}
  #p2pos .osx-chip small{display:block;margin-top:3px;font:600 9px/1 system-ui;letter-spacing:.03em;text-transform:uppercase;color:var(--muted);}

  /* blocks / kickers */
  #p2pos .osx-block{margin-bottom:26px;}
  #p2pos .osx-kick{font:700 12px/1 system-ui;letter-spacing:.06em;text-transform:uppercase;color:var(--muted);margin-bottom:14px;}

  /* gamified map */
  #p2pos .osx-map{display:flex;flex-wrap:wrap;gap:10px;}
  #p2pos .osx-node{position:relative;flex:1 1 150px;min-width:140px;padding:16px 14px;border:1px solid var(--stroke);border-radius:14px;background:linear-gradient(180deg,rgba(255,255,255,.03),rgba(9,17,24,.4));}
  #p2pos .osx-node.done{border-color:rgba(39,174,110,.5);background:linear-gradient(180deg,rgba(39,174,110,.12),rgba(9,17,24,.4));}
  #p2pos .osx-dot{display:grid;place-items:center;width:26px;height:26px;border-radius:50%;font:800 12px/1 system-ui;color:#0a1410;background:linear-gradient(145deg,#f4e2a6,var(--gold));margin-bottom:9px;}
  #p2pos .osx-node.done .osx-dot{background:var(--em,#27ae6e);color:#fff;}
  #p2pos .osx-nlbl{display:block;font:700 13.5px/1.2 system-ui;color:var(--text);}
  #p2pos .osx-nnote{display:block;margin-top:4px;font:400 11.5px/1.4 system-ui;color:var(--muted);}

  /* reassurance */
  #p2pos .osx-reassure{display:flex;gap:16px;align-items:flex-start;padding:20px 22px;border:1px solid var(--gstroke);border-radius:16px;margin-bottom:26px;background:linear-gradient(120deg,rgba(216,180,90,.1),rgba(57,197,192,.06));}
  #p2pos .osx-reassure-ic{font-size:30px;line-height:1;}
  #p2pos .osx-reassure b{font:700 16px/1.2 Georgia,serif;}
  #p2pos .osx-reassure p{margin:6px 0 12px;font:400 14px/1.6 system-ui;color:#dbe7e2;}
  #p2pos .osx-rjourney{display:flex;flex-wrap:wrap;align-items:center;gap:8px;font:700 12px/1 system-ui;color:var(--gold-bright);}
  #p2pos .osx-rjourney i{color:var(--muted);font-style:normal;}

  /* faq */
  #p2pos .osx-faq{display:flex;flex-direction:column;gap:8px;}
  #p2pos .osx-faq details{border:1px solid var(--stroke);border-radius:12px;background:rgba(255,255,255,.02);overflow:hidden;}
  #p2pos .osx-faq summary{padding:14px 16px;font:600 13.5px/1.3 system-ui;cursor:pointer;list-style:none;}
  #p2pos .osx-faq summary::-webkit-details-marker{display:none;}
  #p2pos .osx-faq summary::after{content:'+';float:right;color:var(--gold);font-weight:800;}
  #p2pos .osx-faq details[open] summary::after{content:'–';}
  #p2pos .osx-fa{padding:0 16px 14px;font:400 13px/1.6 system-ui;color:#c6d6d0;}

  /* checkpoint */
  #p2pos .osx-h2{font:700 26px/1.15 Georgia,serif;margin:0 0 8px;}
  #p2pos .osx-lede{font:400 15px/1.6 system-ui;color:#c6d6d0;max-width:640px;margin:0 0 22px;}
  #p2pos .osx-check{border:1px solid var(--gstroke);border-radius:18px;padding:22px 24px;background:linear-gradient(180deg,rgba(216,180,90,.06),rgba(9,17,24,.4));margin-bottom:8px;}
  #p2pos .osx-check-top{display:flex;align-items:center;gap:14px;margin-bottom:16px;}
  #p2pos .osx-check-bar{flex:1;height:9px;border-radius:6px;background:rgba(255,255,255,.08);overflow:hidden;}
  #p2pos .osx-check-bar i{display:block;height:100%;border-radius:6px;background:linear-gradient(90deg,#39c5c0,#8f6fd6 55%,#f4c534);transition:width .35s ease;}
  #p2pos .osx-check-count{font:800 14px/1 system-ui;color:var(--gold-bright);white-space:nowrap;}
  #p2pos .osx-check-list{list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:4px;}
  #p2pos .osx-check-list label{display:flex;align-items:flex-start;gap:12px;padding:11px 12px;border-radius:11px;cursor:pointer;transition:background .15s;}
  #p2pos .osx-check-list label:hover{background:rgba(255,255,255,.03);}
  #p2pos .osx-check-list input{position:absolute;opacity:0;pointer-events:none;}
  #p2pos .osx-check-box{flex:0 0 20px;width:20px;height:20px;margin-top:1px;border:1.5px solid var(--stroke);border-radius:6px;position:relative;transition:background .15s,border-color .15s;}
  #p2pos .osx-check-list input:checked + .osx-check-box{background:var(--em,#27ae6e);border-color:var(--em,#27ae6e);}
  #p2pos .osx-check-list input:checked + .osx-check-box:after{content:"✓";position:absolute;inset:0;display:grid;place-items:center;font:800 11px/1 system-ui;color:#06120e;}
  #p2pos .osx-check-txt b{display:block;font:600 14px/1.35 system-ui;color:var(--text);}
  #p2pos .osx-check-list input:checked ~ .osx-check-txt b{color:var(--muted);text-decoration:line-through;}
  #p2pos .osx-check-txt i{display:block;margin-top:2px;font:400 12px/1.4 system-ui;font-style:normal;color:var(--muted);}
  #p2pos .osx-check-done{margin-top:14px;padding:14px 16px;border-radius:12px;background:linear-gradient(120deg,rgba(39,174,110,.18),rgba(57,197,192,.1));border:1px solid rgba(39,174,110,.4);font:400 14px/1.5 system-ui;color:#dbeee4;}
  #p2pos .osx-check-done b{color:#8be0b0;}
  #p2pos .osx-meet{display:grid;grid-template-columns:repeat(auto-fill,minmax(210px,1fr));gap:12px;}
  #p2pos .osx-meetcard{padding:16px 16px 18px;border:1px solid var(--stroke);border-radius:14px;background:linear-gradient(180deg,rgba(255,255,255,.03),rgba(9,17,24,.4));}
  #p2pos .osx-meic{font-size:22px;line-height:1;}
  #p2pos .osx-meetcard b{display:block;margin:10px 0 5px;font:700 14.5px/1.2 system-ui;}
  #p2pos .osx-meetcard p{margin:0;font:400 12.5px/1.5 system-ui;color:var(--muted);}

  /* notebook */
  #p2pos .osx-nb-compose{border:1px solid var(--gstroke);border-radius:16px;padding:16px;background:linear-gradient(180deg,rgba(216,180,90,.05),rgba(9,17,24,.4));margin-bottom:18px;}
  #p2pos .osx-nb-title,#p2pos .osx-nb-body,#p2pos .osx-nb-search{width:100%;box-sizing:border-box;background:rgba(0,0,0,.25);border:1px solid var(--stroke);border-radius:10px;color:var(--text);font:400 14px/1.5 system-ui;padding:11px 13px;}
  #p2pos .osx-nb-title{font-weight:700;margin-bottom:9px;}
  #p2pos .osx-nb-body{resize:vertical;min-height:84px;}
  #p2pos .osx-nb-title:focus,#p2pos .osx-nb-body:focus,#p2pos .osx-nb-search:focus{outline:none;border-color:var(--gstroke);}
  #p2pos .osx-nb-actions{display:flex;gap:9px;margin-top:11px;}
  #p2pos .osx-nb-save{padding:10px 20px;border:0;border-radius:10px;font:800 13px/1 system-ui;color:#0a1410;cursor:pointer;background:linear-gradient(145deg,#f4e2a6,var(--gold));transition:transform .12s;}
  #p2pos .osx-nb-save:hover{transform:translateY(-1px);}
  #p2pos .osx-nb-cancel{padding:10px 16px;border:1px solid var(--stroke);border-radius:10px;background:none;color:var(--muted);font:600 13px/1 system-ui;cursor:pointer;}
  #p2pos .osx-nb-searchrow{display:flex;align-items:center;gap:12px;margin-bottom:14px;}
  #p2pos .osx-nb-search{flex:1;}
  #p2pos .osx-nb-count{font:600 11.5px/1 system-ui;color:var(--muted);white-space:nowrap;}
  #p2pos .osx-nb-list{display:flex;flex-direction:column;gap:10px;}
  #p2pos .osx-nb-item{border:1px solid var(--stroke);border-radius:13px;padding:14px 16px;background:rgba(255,255,255,.02);transition:border-color .15s;}
  #p2pos .osx-nb-item:hover{border-color:var(--gstroke);}
  #p2pos .osx-nb-ihead{display:flex;align-items:baseline;justify-content:space-between;gap:12px;}
  #p2pos .osx-nb-ititle{font:700 15px/1.25 system-ui;color:var(--text);}
  #p2pos .osx-nb-idate{font:600 10.5px/1 system-ui;color:var(--muted);white-space:nowrap;}
  #p2pos .osx-nb-ibody{margin:6px 0 0;font:400 13px/1.55 system-ui;color:#c6d6d0;white-space:pre-wrap;overflow-wrap:anywhere;}
  #p2pos .osx-nb-irow{display:flex;gap:14px;margin-top:11px;}
  #p2pos .osx-nb-irow button{background:none;border:0;padding:0;font:700 12px/1 system-ui;cursor:pointer;color:var(--gold-bright);}
  #p2pos .osx-nb-irow button.del{color:#d6707a;}
  #p2pos .osx-nb-irow button:hover{text-decoration:underline;}
  #p2pos .osx-nb-empty{margin-top:8px;padding:24px;text-align:center;font:400 13.5px/1.5 system-ui;color:var(--muted);border:1px dashed var(--stroke);border-radius:13px;}

  /* placeholder / locked views */
  #p2pos .osx-ph{max-width:460px;margin:60px auto;text-align:center;}
  #p2pos .osx-ph-ic{font-size:40px;margin-bottom:14px;}
  #p2pos .osx-ph h2{font:700 24px/1.2 Georgia,serif;margin:0 0 8px;}
  #p2pos .osx-ph p{font:400 14px/1.6 system-ui;color:var(--muted);margin:0;}

  @media (prefers-reduced-motion: reduce){#p2pos .osx-2,#p2pos .osx-name,#p2pos .osx-cta,#p2pos .osx-chip .p2pos-tier{animation:none;}}
  @media (max-width:820px){
    #p2pos.osx{grid-template-columns:1fr;}
    #p2pos .osx-burger{display:flex;flex-direction:column;justify-content:center;gap:4px;position:absolute;top:14px;left:14px;z-index:6;width:40px;height:40px;border:1px solid var(--stroke);border-radius:10px;background:var(--side);cursor:pointer;}
    #p2pos .osx-burger span{display:block;height:2px;width:18px;margin:0 auto;background:var(--gold-bright);}
    #p2pos .osx-side{position:absolute;inset:0 auto 0 0;width:264px;z-index:5;transform:translateX(-100%);transition:transform .25s ease;box-shadow:0 0 40px rgba(0,0,0,.6);}
    #p2pos .osx-side.open{transform:translateX(0);}
    #p2pos .osx-view{padding:64px 20px 40px;}
  }
</style>

{%- if section.settings.show_stats or section.settings.show_moment -%}
<script src="{{ 'p2p-progress.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'p2p-journey-map.js' | asset_url }}" defer="defer"></script>
{%- endif -%}
<script>
  document.addEventListener('DOMContentLoaded', function(){
    var root = document.getElementById('p2pos'); if(!root) return;
    var main = root.querySelector('[data-osx-main]');
    var frame = root.querySelector('[data-osx-frame]');
    var items = root.querySelectorAll('.osx-item');
    var views = root.querySelectorAll('.osx-view');
    function put(cls, val){ var el = root.querySelector(cls); if(el) el.textContent = val; }
    function showView(name){ views.forEach(function(v){ v.classList.toggle('on', v.getAttribute('data-view') === name); }); if(frame){ frame.hidden = true; frame.removeAttribute('src'); } if(main) main.scrollTop = 0; }
    function activate(btn){
      items.forEach(function(b){ b.classList.toggle('on', b === btn); });
      var mode = btn.getAttribute('data-mode'), target = btn.getAttribute('data-target') || '';
      if(btn.classList.contains('locked')){
        showView('__locked');
        var lt = root.querySelector('[data-osx-lock-title]'); if(lt) lt.textContent = (btn.querySelector('.osx-lbl')||{}).textContent || 'Locked';
        var g = root.querySelector('[data-osx-get]'); if(g) g.setAttribute('href', btn.getAttribute('data-get') || '#');
        return;
      }
      if(mode === 'link'){ if(target) window.location.href = target; return; }
      if(mode === 'embed'){
        views.forEach(function(v){ v.classList.remove('on'); });
        if(frame && target){ frame.hidden = false; frame.src = target; if(main) main.scrollTop = 0; }
        return;
      }
      // view
      var exists = root.querySelector('.osx-view[data-view="' + target + '"]');
      if(exists){ showView(target); }
      else { showView('__placeholder'); var pt = root.querySelector('[data-osx-ph-title]'); if(pt) pt.textContent = (btn.querySelector('.osx-lbl')||{}).textContent || 'Coming together'; }
    }
    items.forEach(function(b){ b.addEventListener('click', function(){ activate(b); closeSide(); }); });
    // hero CTA -> jump to a view by target
    root.querySelectorAll('[data-osx-goto]').forEach(function(b){ b.addEventListener('click', function(){
      var t = b.getAttribute('data-osx-goto');
      var nav = Array.prototype.filter.call(items, function(x){ return x.getAttribute('data-target') === t; })[0];
      if(nav) nav.click();
    }); });
    // mobile drawer
    var side = root.querySelector('[data-osx-side]'), burger = root.querySelector('[data-osx-burger]');
    function closeSide(){ if(side) side.classList.remove('open'); }
    if(burger && side) burger.addEventListener('click', function(){ side.classList.toggle('open'); });

    // Checkpoint checklist — persisted per-item; awards a one-time bonus when all done
    (function(){
      var box = root.querySelector('[data-osx-check]'); if(!box) return;
      var CK = 'p2p_os_checkpoint', boxes = box.querySelectorAll('[data-osx-checkitem]');
      var bar = box.querySelector('[data-osx-check-bar]'), done = box.querySelector('[data-osx-check-done]');
      var msg = box.querySelector('[data-osx-check-msg]'), total = boxes.length;
      var state = {}; try{ state = JSON.parse(localStorage.getItem(CK) || '{}') || {}; }catch(e){}
      function save(){ try{ localStorage.setItem(CK, JSON.stringify(state)); }catch(e){} }
      function refresh(){
        var n = 0; boxes.forEach(function(cb){ if(cb.checked) n++; });
        if(bar) bar.style.width = (total ? Math.round(n / total * 100) : 0) + '%';
        if(done) done.textContent = n;
        if(msg) msg.hidden = !(total && n === total);
        if(total && n === total && !state.__bonus){ state.__bonus = 1; save(); if(window.P2P && window.P2P.completeCheck){ window.P2P.completeCheck('os:checkpoint'); if(window.P2P.push) window.P2P.push(); } }
      }
      boxes.forEach(function(cb){
        var id = cb.getAttribute('data-osx-checkitem');
        if(state[id]) cb.checked = true;
        cb.addEventListener('change', function(){ state[id] = cb.checked; save(); refresh(); });
      });
      refresh();
    })();

    // Notebook — titled notes with search; persisted (syncs cross-device via the p2p_ prefix)
    (function(){
      var nb = root.querySelector('[data-osx-nb]'); if(!nb) return;
      var NK = 'p2p_os_notebook';
      var elTitle = nb.querySelector('[data-nb-title]'), elBody = nb.querySelector('[data-nb-body]');
      var elSave = nb.querySelector('[data-nb-save]'), elCancel = nb.querySelector('[data-nb-cancel]');
      var elSearch = nb.querySelector('[data-nb-search]'), elList = nb.querySelector('[data-nb-list]');
      var elCount = nb.querySelector('[data-nb-count]'), elEmpty = nb.querySelector('[data-nb-empty]');
      var editing = null;
      function esc(s){ return String(s == null ? '' : s).replace(/[&<>"]/g, function(c){ return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]; }); }
      function load(){ try{ return JSON.parse(localStorage.getItem(NK) || '[]') || []; }catch(e){ return []; } }
      function save(a){ try{ localStorage.setItem(NK, JSON.stringify(a)); }catch(e){} if(window.P2P && window.P2P.push) window.P2P.push(); }
      function fmt(ts){ try{ return new Date(ts).toLocaleDateString(undefined, { month:'short', day:'numeric', year:'numeric' }); }catch(e){ return ''; } }
      function reset(){ editing = null; elTitle.value = ''; elBody.value = ''; elCancel.hidden = true; elSave.textContent = 'Save note'; }
      function render(){
        var notes = load(), q = (elSearch.value || '').trim().toLowerCase();
        var shown = notes.filter(function(n){ return !q || (n.title + ' ' + n.body).toLowerCase().indexOf(q) !== -1; });
        elCount.textContent = notes.length ? (q ? shown.length + ' of ' + notes.length : notes.length + (notes.length === 1 ? ' note' : ' notes')) : '';
        elEmpty.hidden = notes.length !== 0;
        elList.innerHTML = shown.map(function(n){
          return '<div class="osx-nb-item" data-id="' + n.id + '">' +
            '<div class="osx-nb-ihead"><span class="osx-nb-ititle">' + (esc(n.title) || '<em style="color:var(--muted)">Untitled</em>') + '</span><span class="osx-nb-idate">' + fmt(n.ts) + '</span></div>' +
            (n.body ? '<p class="osx-nb-ibody">' + esc(n.body) + '</p>' : '') +
            '<div class="osx-nb-irow"><button data-edit>Edit</button><button class="del" data-del>Delete</button></div>' +
          '</div>';
        }).join('');
      }
      elSave.addEventListener('click', function(){
        var title = (elTitle.value || '').trim(), body = (elBody.value || '').trim();
        if(!title && !body) return;
        var notes = load();
        if(editing){ notes = notes.map(function(n){ return n.id === editing ? Object.assign({}, n, { title:title, body:body, ts:Date.now() }) : n; }); }
        else { notes.unshift({ id: 'n' + Date.now() + Math.random().toString(36).slice(2,6), title:title, body:body, ts:Date.now() }); }
        save(notes); reset(); render();
      });
      elCancel.addEventListener('click', reset);
      elSearch.addEventListener('input', render);
      elList.addEventListener('click', function(e){
        var item = e.target.closest('[data-id]'); if(!item) return; var id = item.getAttribute('data-id');
        if(e.target.hasAttribute('data-edit')){
          var n = load().filter(function(x){ return x.id === id; })[0]; if(!n) return;
          editing = id; elTitle.value = n.title || ''; elBody.value = n.body || ''; elCancel.hidden = false; elSave.textContent = 'Update note';
          elTitle.focus(); nb.scrollIntoView({ behavior:'smooth', block:'start' });
        } else if(e.target.hasAttribute('data-del')){
          if(!window.confirm('Delete this note?')) return;
          save(load().filter(function(x){ return x.id !== id; }));
          if(editing === id) reset();
          render();
        }
      });
      render();
    })();

    // live stats + ring (reuse the engine)
    if(root.querySelector('[data-osx-stats]') && window.P2P){
      put('.p2pos-points', window.P2P.points());
      var bs = window.P2P.badgesStat(); put('.p2pos-badges', bs ? bs.earned : window.P2P.earnedSet().length);
      put('.p2pos-streak', window.P2P.streak().count);
      if(window.P2P.tier) put('.p2pos-tier', window.P2P.tier().name);
      var ring = root.querySelector('[data-osx-ring]');
      if(ring && window.P2P_MAP){
        var total = 0, done = 0;
        window.P2P_MAP.forEach(function(r){ (r.courses || []).forEach(function(c){ total++; if(window.P2P.isCourseDone(c.h)) done++; }); });
        var pct = total ? Math.round(done / total * 100) : 0; ring.style.setProperty('--p', pct); put('.p2pos-ringpct', pct + '%');
      }
      root.querySelector('[data-osx-stats]').hidden = false;
    }
  });
</script>

