  @media (max-width:820px){#p2pos .osx-comm-lower{grid-template-columns:1fr;}}
  @media (max-width:820px){#p2pos .osx-comm{flex-direction:column;} #p2pos .osx-comm-side{flex-basis:auto;width:100%;}}
  /* community v3 */
