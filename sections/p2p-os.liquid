<script>
  document.addEventListener('DOMContentLoaded', function(){
    var root = document.getElementById('p2pos'); if(!root) return;
    if(root.hasAttribute('data-osx-gated')) return; // non-member preview splash — no shell to wire
    var main = root.querySelector('[data-osx-main]');
    var frame = root.querySelector('[data-osx-frame]');
    var items = root.querySelectorAll('.osx-item');
    var views = root.querySelectorAll('.osx-view');
    function put(cls, val){ var el = root.querySelector(cls); if(el) el.textContent = val; }
    function showView(name){
      views.forEach(function(v){ v.classList.toggle('on', v.getAttribute('data-view') === name); });
      if(frame){ frame.hidden = true; frame.removeAttribute('src'); }
      if(main) main.scrollTop = 0;
      // if the shell has scrolled up under the sticky theme header, bring its top (and the view title) back into view
      var r = root.getBoundingClientRect();
      var hdr = document.querySelector('.shopify-section-group-header-group');
      var off = hdr ? Math.max(0, hdr.getBoundingClientRect().bottom) : 0;
      if(r.top < off + 4){ window.scrollTo(0, Math.max(0, window.pageYOffset + r.top - off - 12)); }
    }
    function activate(btn){
      items.forEach(function(b){ b.classList.toggle('on', b === btn); });
      var mode = btn.getAttribute('data-mode'), target = btn.getAttribute('data-target') || '';
      if(btn.classList.contains('locked')){
        showView('__locked');
        var lt = root.querySelector('[data-osx-lock-title]'); if(lt) lt.textContent = (btn.querySelector('.osx-lbl')||{}).textContent || 'Locked';
        var g = root.querySelector('[data-osx-get]'); if(g) g.setAttribute('href', btn.getAttribute('data-get') || '#');
        return;
      }
      if(mode === 'link'){ if(target) window.location.href = target; return; }
      if(mode === 'embed'){
        views.forEach(function(v){ v.classList.remove('on'); });
        if(frame && target){ frame.hidden = false; frame.src = target; if(main) main.scrollTop = 0; }
        return;
      }
      // view
      var exists = root.querySelector('.osx-view[data-view="' + target + '"]');
      if(exists){ showView(target); }
      else { showView('__placeholder'); var pt = root.querySelector('[data-osx-ph-title]'); if(pt) pt.textContent = (btn.querySelector('.osx-lbl')||{}).textContent || 'Coming together'; }
    }
    items.forEach(function(b){ b.addEventListener('click', function(){ activate(b); closeSide(); }); });
    // brand + P2P emblem -> back to OS home (the Start view)
    root.querySelectorAll('[data-osx-home]').forEach(function(brand){ brand.addEventListener('click', function(){
      var startNav = Array.prototype.filter.call(items, function(x){ return x.getAttribute('data-target') === 'start'; })[0];
      if(startNav){ activate(startNav); } else { showView('start'); }
      closeSide();
    }); });
    // hero CTA -> jump to a view by target
    root.querySelectorAll('[data-osx-goto]').forEach(function(b){ b.addEventListener('click', function(){
      var t = b.getAttribute('data-osx-goto');
      var nav = Array.prototype.filter.call(items, function(x){ return x.getAttribute('data-target') === t; })[0];
      if(nav) nav.click();
    }); });
    // hero 'i' help button -> open the Haus Helper
    var helpBtn = root.querySelector('[data-osx-help]');
    if(helpBtn) helpBtn.addEventListener('click', function(){ var h = document.querySelector('[data-p2ph-launch]'); if(h) h.click(); });
    // deep-link: /pages/p2p-os?v=<view> opens that view directly
    // (the shared rail on the Haus pages links here for view-mode items like Checkpoint / Notebook)
    (function(){
      var m = /[?&]v=([^&]+)/.exec(window.location.search); if(!m) return;
      var want = decodeURIComponent(m[1]).replace(/[^a-z0-9_-]/gi, '');
      var nav = Array.prototype.filter.call(items, function(x){ return x.getAttribute('data-target') === want; })[0];
      if(nav){ activate(nav); }
      // consume the deep-link param so a refresh (or a duplicated tab) returns to the dashboard, not this view
      try{ history.replaceState(null, '', window.location.pathname); }catch(e){}
    })();
    // mobile drawer
    var side = root.querySelector('[data-osx-side]'), burger = root.querySelector('[data-osx-burger]');
    function closeSide(){ if(side) side.classList.remove('open'); }
    if(burger && side) burger.addEventListener('click', function(){ side.classList.toggle('open'); });

    // Checkpoint checklist — persisted per-item; awards a one-time bonus when all done
    (function(){
      var box = root.querySelector('[data-osx-check]'); if(!box) return;
      var CK = 'p2p_os_checkpoint', boxes = box.querySelectorAll('[data-osx-checkitem]');
      var bar = box.querySelector('[data-osx-check-bar]'), done = box.querySelector('[data-osx-check-done]');
      var msg = box.querySelector('[data-osx-check-msg]'), total = boxes.length;
      var state = {}; try{ state = JSON.parse(localStorage.getItem(CK) || '{}') || {}; }catch(e){}
      function save(){ try{ localStorage.setItem(CK, JSON.stringify(state)); }catch(e){} }
      function refresh(){
        var n = 0; boxes.forEach(function(cb){ if(cb.checked) n++; });
        if(bar) bar.style.width = (total ? Math.round(n / total * 100) : 0) + '%';
        if(done) done.textContent = n;
        if(msg) msg.hidden = !(total && n === total);
        if(total && n === total && !state.__bonus){ state.__bonus = 1; save(); if(window.P2P && window.P2P.completeCheck){ window.P2P.completeCheck('os:checkpoint'); if(window.P2P.push) window.P2P.push(); } }
      }
      boxes.forEach(function(cb){
        var id = cb.getAttribute('data-osx-checkitem');
        if(state[id]) cb.checked = true;
        cb.addEventListener('change', function(){ state[id] = cb.checked; save(); refresh(); });
      });
      refresh();
    })();

    // Notebook — shared engine (assets/p2p-notebook.js). Journal + Wins share the Journey's data.
    (function(){
      var nbRoot = root.querySelector('[data-osx-nb]');
      if(nbRoot && window.P2PNotebook){
        window.P2PNotebook.mount(nbRoot, {
          onSave: function(kind){ if(kind === 'reflection' && window.P2P){ window.P2P.checkJournal(); window.P2P.addJournalPoint(); } }
        });
      }
    })();

    // Your Vault — read-only cross-Haus dashboard (assets/p2p-os-vault.js)
    (function(){
      var vRoot = root.querySelector('[data-osx-vault]');
      if(vRoot && window.P2POSVault){ try{ window.P2POSVault.mount(vRoot); }catch(e){} }
    })();

    // External-site heads-up — the Haus Mate buttons open ChatGPT in a new tab.
    // Confirm once (with a "don't show again" that's remembered) before leaving.
    (function(){
      var modal = root.querySelector('[data-osx-extmodal]'); if(!modal) return;
      var EXT_KEY = 'p2p_ext_ok';
      var titleEl = modal.querySelector('[data-osx-ext-title]');
      var bodyEl = modal.querySelector('[data-osx-ext-body]');
      var goBtn = modal.querySelector('[data-osx-ext-go]');
      var cancel = modal.querySelector('[data-osx-ext-cancel]');
      var dontShow = modal.querySelector('[data-osx-ext-dontshow]');
      function skip(){ try{ return localStorage.getItem(EXT_KEY) === '1'; }catch(e){ return false; } }
      function close(){ modal.hidden = true; }
      function open(href, name){
        var who = name && name !== 'your Haus Mate' ? name : 'Your Haus Mate';
        if(titleEl) titleEl.textContent = 'You’re heading to ChatGPT';
        if(bodyEl) bodyEl.textContent = who + ' lives in ChatGPT and opens in a new tab — your OS stays right here.';
        goBtn.setAttribute('href', href);
        if(dontShow) dontShow.checked = false;
        modal.hidden = false;
      }
      root.querySelectorAll('.osx-mate-cta').forEach(function(a){
        a.addEventListener('click', function(e){
          if(skip()) return; // preference remembered — let the link through
          e.preventDefault();
          var card = a.closest('.osx-mate');
          var nameEl = card && card.querySelector('.osx-mate-name');
          open(a.getAttribute('href'), nameEl ? nameEl.textContent.trim() : 'your Haus Mate');
        });
      });
      if(goBtn) goBtn.addEventListener('click', function(){
        if(dontShow && dontShow.checked){ try{ localStorage.setItem(EXT_KEY, '1'); }catch(e){} }
        close(); // the anchor still opens its href in a new tab (real user click)
      });
      if(cancel) cancel.addEventListener('click', close);
      modal.addEventListener('click', function(e){ if(e.target === modal) close(); });
      document.addEventListener('keydown', function(e){ if(e.key === 'Escape' && !modal.hidden) close(); });
    })();

    // Recolor the OS to the member's STAND OUT color (their choice — one signature
    // color, not the whole palette). Prefers the archetype's standOut (e.g. Bold
    // Pioneer = #3A86FF blue); falls back to the most-saturated color of a saved
    // custom brand kit. Hue + saturation come from that color; LIGHTNESS is forced
    // legible on the dark UI. The aurora becomes an analogous shimmer in that hue's
    // family, so the page reads as "their color" while keeping its living gradient.
    (function(){
      function J(k){ try{ return JSON.parse(localStorage.getItem(k)); }catch(e){ return null; } }
      function toHsl(hex){
        var h = String(hex == null ? '' : hex).trim().replace('#', '');
        if(h.length === 3){ h = h.replace(/(.)/g, '$1$1'); }
        if(!/^[0-9a-fA-F]{6}$/.test(h)) return null;
        var r = parseInt(h.slice(0,2),16)/255, g = parseInt(h.slice(2,4),16)/255, b = parseInt(h.slice(4,6),16)/255;
        var mx = Math.max(r,g,b), mn = Math.min(r,g,b), l = (mx+mn)/2, s, hue;
        if(mx === mn){ hue = 0; s = 0; }
        else { var d = mx-mn; s = l > 0.5 ? d/(2-mx-mn) : d/(mx+mn);
          hue = mx === r ? (g-b)/d + (g<b?6:0) : mx === g ? (b-r)/d + 2 : (r-g)/d + 4; hue *= 60; }
        return [hue, s*100, l*100];
      }
      function hsl(h,s,l){ return 'hsl(' + (((Math.round(h) % 360) + 360) % 360) + ',' + Math.round(s) + '%,' + Math.round(l) + '%)'; }
      function clamp(v,a,b){ return Math.max(a, Math.min(b, v)); }
      var arch = J('p2p_archetype'), vault = J('blackSheepBrandKitVault');
      var pick = arch && arch.standOut ? toHsl(arch.standOut) : null; // 1) archetype Stand Out wins
      if(!pick){ // 2) else the most-saturated color of a saved custom kit
        var kit = vault && vault.brandHausKits && vault.brandHausKits.length ? vault.brandHausKits[vault.brandHausKits.length - 1] : null;
        var kc = (kit && kit.colors ? kit.colors : []).map(toHsl).filter(Boolean).sort(function(a,b){ return b[1] - a[1]; });
        pick = kc[0] || null;
      }
      if(!pick) return; // no brand color -> keep the default aurora identity
      if(pick[1] < 12){
        // near-greyscale stand-out: no meaningful hue -> clean neutral accents, keep the default aurora.
        root.style.setProperty('--gold', hsl(0, 0, 80));
        root.style.setProperty('--gold-bright', hsl(0, 0, 90));
        root.style.setProperty('--gstroke', 'hsla(0,0%,82%,.30)');
        return;
      }
      var h = pick[0], sat = clamp(pick[1], 45, 90);
      root.style.setProperty('--gold', hsl(h, sat, 62));
      root.style.setProperty('--gold-bright', hsl(h, clamp(sat + 6, 50, 94), 70));
      root.style.setProperty('--gstroke', 'hsla(' + Math.round(h) + ',' + Math.round(sat) + '%,60%,.38)');
      // analogous shimmer around the stand-out hue -> alive, but all one color family
      var offs = [-28, -12, 0, 16, 30];
      var stops = offs.map(function(o, i){ return hsl(h + o, clamp(sat - Math.abs(o) * 0.4, 40, 90), 58 + (i % 2 ? 8 : 0)); });
      root.style.setProperty('--aurora', 'linear-gradient(100deg,' + stops.concat(stops[0]).join(',') + ')');
    })();

    // Trusted Guide logo — large on the LEFT, with each view's eyebrow/title/subtext stacked to its right.
    // Also Title-Cases hero titles (keeping ACRONYMS like ROOTED/P2P) and aura-colors chosen words.
    (function(){ try{
      var src = "{{ 'p2p-trusted-guide.png' | asset_url }}";
      var AURA = { checkpoint:['before'], rooted:['rooted'], mates:['partners'], members:['flock'], tools:['one','click'], notebook:['notebook'], bonus:['free','downloads'] };
      function tcWord(w){ return /[A-Z]/.test(w) ? w : (w.charAt(0).toUpperCase() + w.slice(1)); }
      function processH2(h, aura){
        Array.prototype.slice.call(h.childNodes).forEach(function(node){
          if(node.nodeType !== 3) return;
          var parts = node.textContent.split(/(\s+)/), frag = document.createDocumentFragment();
          parts.forEach(function(p){
            if(p === '' || /^\s+$/.test(p)){ frag.appendChild(document.createTextNode(p)); return; }
            var clean = p.replace(/[^A-Za-z]/g,'').toLowerCase(), cased = tcWord(p);
            if(clean && aura.indexOf(clean) > -1){ var s = document.createElement('span'); s.className = 'osx-aura'; s.textContent = cased; frag.appendChild(s); }
            else frag.appendChild(document.createTextNode(cased));
          });
          h.replaceChild(frag, node);
        });
      }
      root.querySelectorAll('.osx-view').forEach(function(v){
        var h = v.querySelector('.osx-h2');
        if(!h || h.closest('.osx-hero-lockrow')) return;
        processH2(h, AURA[v.getAttribute('data-view')] || []);
        var kick = (h.previousElementSibling && h.previousElementSibling.classList.contains('osx-kick')) ? h.previousElementSibling : null;
        var follow = [], n = h.nextElementSibling;
        while(n && (n.classList.contains('osx-comm-tag') || n.classList.contains('osx-lede'))){ var nx = n.nextElementSibling; follow.push(n); n = nx; }
        var row = document.createElement('div'); row.className = 'osx-hero-lockrow';
        var col = document.createElement('div'); col.className = 'osx-hero-textcol';
        var anchor = kick || h; if(!anchor || !anchor.parentNode){ return; }
        anchor.parentNode.insertBefore(row, anchor); // insert at the title's real parent (works even when nested, e.g. Notebook)
        row.innerHTML = '<span class="osx-hero-biglogo"><img src="' + src + '" alt="" aria-hidden="true"></span>';
        row.appendChild(col);
        if(kick) col.appendChild(kick);
        col.appendChild(h);
        follow.forEach(function(f){ col.appendChild(f); });
      });
    }catch(e){ if(window.console) console.warn('P2P hero-title block skipped:', e); } })();

    // Personalized Brand DNA panel — reads p2p_archetype (set when the Founders Assessment completes)
    (function(){ try{
      var dna = root.querySelector('[data-osx-dna]'); if(!dna) return;
      var A = window.P2P_ARCHETYPE || {}, imgs = A.img || {}, assessUrl = A.assessUrl || '/pages/brand-haus?bh_focus=1';
      var rec = null; try{ rec = JSON.parse(localStorage.getItem('p2p_archetype') || 'null'); }catch(e){}
      function esc(s){ return String(s == null ? '' : s).replace(/[&<>"]/g, function(c){ return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]; }); }
      if(rec && rec.name){
        var img = imgs[rec.slug] || '';
        var traits = (rec.traits || []).slice(0, 3).map(function(t){ return '<span class="dna-trait">' + esc(t) + '</span>'; }).join('');
        dna.className = 'osx-hero-dna is-result';
        dna.innerHTML =
          (img ? '<div class="dna-img' + (rec.slug === 'quiet-authority' ? ' dna-img--onblack' : '') + '"><img src="' + esc(img) + '" alt="' + esc(rec.name) + '" loading="lazy"></div>' : '') +
          '<div class="dna-meta"><div class="dna-kick">Your Brand DNA</div>' +
          '<div class="dna-name">' + esc(rec.name) + '</div>' +
          (rec.word ? '<div class="dna-word">' + esc(rec.word) + '</div>' : '') +
          (traits ? '<div class="dna-traits">' + traits + '</div>' : '') +
          '<a class="dna-link" href="' + esc(assessUrl) + '">Refresh your assessment →</a></div>';
        dna.hidden = false;
      } else {
        dna.className = 'osx-hero-dna is-nudge';
        dna.innerHTML = '<a class="dna-nudge" href="' + esc(assessUrl) + '"><span class="dna-nudge-ic">✦</span><b>Discover your Brand DNA</b><span class="dna-nudge-sub">Take your Founders Assessment to reveal your archetype →</span></a>';
        dna.hidden = false;
      }
    }catch(e){ if(window.console) console.warn('P2P DNA panel skipped:', e); } })();

    // Daily Mindset · Purpose · Heart carousel — one item per pillar per day; auto-rotate + Next
    (function(){ try{
      var wrap = root.querySelector('[data-osx-moments]'); if(!wrap) return;
      var day = Math.floor(Date.now() / 864e5);
      var pillars = [
        { label: 'Mindset', pool: window.P2P_MOMENTS },
        { label: 'Purpose', pool: window.P2P_PURPOSE },
        { label: 'Heart', pool: window.P2P_HEART }
      ].filter(function(p){ return p.pool && p.pool.length; });
      if(!pillars.length) return;
      var titleEl = wrap.querySelector('[data-mo-title]'), textEl = wrap.querySelector('[data-mo-text]'), srcEl = wrap.querySelector('[data-mo-source]');
      var dotsWrap = wrap.querySelector('[data-mo-dots]');
      dotsWrap.innerHTML = pillars.map(function(_, di){ return '<button class="mo-dot' + (di === 0 ? ' on' : '') + '" type="button" aria-label="Check ' + (di + 1) + '"></button>'; }).join('');
      var dots = dotsWrap.querySelectorAll('.mo-dot');
      var i = 0, timer = null;
      function render(){
        var p = pillars[i], it = p.pool[day % p.pool.length] || {};
        titleEl.innerHTML = '<span class="mo-star">✦</span> <span class="mo-grad">' + p.label + '</span> Booster';
        textEl.textContent = it.t ? ('“' + it.t + '”') : '';
        srcEl.textContent = it.s || '';
        dots.forEach(function(d, di){ d.classList.toggle('on', di === i); });
      }
      function go(n){ i = ((n % pillars.length) + pillars.length) % pillars.length; render(); }
      function next(){ go(i + 1); }
      function stop(){ if(timer){ clearInterval(timer); timer = null; } }
      function start(){ stop(); timer = setInterval(next, 9000); }
      var nb = wrap.querySelector('[data-mo-next]'); if(nb) nb.addEventListener('click', function(){ next(); start(); });
      dots.forEach(function(d, di){ d.addEventListener('click', function(){ go(di); start(); }); });
      wrap.addEventListener('mouseenter', stop); wrap.addEventListener('mouseleave', start);
      render(); wrap.hidden = false; start();
    }catch(e){ if(window.console) console.warn('P2P boosters skipped:', e); } })();

    // live stats + ring (reuse the engine)
    if(root.querySelector('[data-osx-stats]') && window.P2P){
      put('.p2pos-points', window.P2P.points());
      var bs = window.P2P.badgesStat(); put('.p2pos-badges', bs ? bs.earned : window.P2P.earnedSet().length);
      put('.p2pos-streak', window.P2P.streak().count);
      if(window.P2P.tier) put('.p2pos-tier', window.P2P.tier().name);
      var ring = root.querySelector('[data-osx-ring]');
      if(ring && window.P2P_MAP){
        var total = 0, done = 0;
        window.P2P_MAP.forEach(function(r){ (r.courses || []).forEach(function(c){ total++; if(window.P2P.isCourseDone(c.h)) done++; }); });
        var pct = total ? Math.round(done / total * 100) : 0; ring.style.setProperty('--p', pct); put('.p2pos-ringpct', pct + '%');
      }
      root.querySelector('[data-osx-stats]').hidden = false;
    }

    // clickable stat chips + ring -> shared Progress detail pop-ups (Points/Badges/Streak/Merit/Courses)
    if(window.P2PProgressPopups){ window.P2PProgressPopups.mount(root); }

    // "Born an Original" — rotate the middle line every 11s (up-slide). Mark, title & gold note stay fixed.
    (function(){ try{
      var box = root.querySelector('[data-osx-reassure]'); if(!box) return;
      var line = box.querySelector('.osx-reassure-line'); if(!line) return;
      var LINES = [
        "There is only one YOU — and that's not just a nice thought, it is your actual advantage.",
        "Nobody can copy your spark.",
        "The world has enough echoes. Be the original sound.",
        "There's no competition when you refuse to be a copy.",
        "You're not too much. They're just not used to someone like you.",
        "Plot twist: the thing that makes you different is the whole point.",
        "Nobody can out-you you. That is your unfair advantage.",
        "Trends fade. Originals get remembered.",
        "Your weird is your worth. Spend it boldly.",
        "Be so unapologetically you that they have to invent a new category.",
        "The market has room for a lot of good. It only has room for one you.",
        "You don't have to be everything. Just be unmistakably you.",
        "Your fingerprint has never existed before. Neither has your voice.",
        "Comparison is rent paid on a version of you that isn't even real.",
        "The right people are searching for exactly what only you can make.",
        "You are not behind. You are on your own road, at your own pace.",
        "Build the thing only you can build. The world is waiting for it.",
        "Your story is the one credential no one else can ever claim.",
        "You were made on purpose, for a purpose — original from the very first breath.",
        "The world needs your particular light in its particular corner.",
        "Being yourself isn't the risk. It's the only sure thing you've got.",
        "You are enough to begin, and original enough to matter.",
        "One of a kind is not a slogan. It is simply the truth about you.",
        "Dare to be the first draft that no one else could ever write.",
        "Somewhere, someone is waiting for a spark that only you carry.",
        "The knock-offs are already taken. Originality is the only lane left wide open.",
        "You don't find your voice. You use it until the world learns the sound.",
        "Authenticity is the one thing that never goes out of style.",
        "Stop shrinking to fit a room that was too small for you anyway.",
        "Your quirks aren't bugs. They're the features nobody can install.",
        "The people trying to copy you already know who the original is.",
        "Blend in and disappear. Stand out and get remembered.",
        "You were not made to be a footnote in someone else's story.",
        "Different isn't a disadvantage. It's the whole reason they'll choose you.",
