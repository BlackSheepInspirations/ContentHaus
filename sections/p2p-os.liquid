    {%- comment -%} ===== VIEW: Bonus Resources (downloadable freebies — PDFs) ===== {%- endcomment -%}
    <section class="osx-view" data-view="bonus">
      <div class="osx-kick">Bonus Resources</div>
      <h2 class="osx-h2">{{ section.settings.bonus_title | default: 'Free downloads, just for you' }}</h2>
      <p class="osx-lede">{{ section.settings.bonus_intro | default: "Guides, checklists and templates to download and keep. New drops are added regularly — grab whatever helps." }}</p>

      {%- comment -%} Baked freebies (revert-proof): one per line (| separated), fields ^ separated:
         title^description^download-url^type-label^thumbnail-asset-filename.
         Thumbnail is an assets/ filename (resolved with asset_url); leave blank for a 📄 icon. {%- endcomment -%}
      {%- capture os_bonus -%}Journal Creator Quickstart Series — Vol. 1^Turn a broad journal thought into one clear concept you're ready to build.^https://canva.link/vol-1-journal-creator-series^eBook^bonus-journal-creator-vol1.jpg{%- endcapture -%}
      {%- assign os_bonus_clean = os_bonus | strip -%}
      {%- assign bonus_blocks = section.blocks | where: 'type', 'bonus' -%}

      {%- if os_bonus_clean != blank or bonus_blocks.size > 0 -%}
        <div class="osx-bonusgrid">
          {%- if os_bonus_clean != blank -%}
            {%- assign os_bonus_items = os_bonus_clean | split: '|' -%}
            {%- for bo in os_bonus_items -%}
              {%- assign bf = bo | split: '^' -%}
              <a class="osx-bonuscard" href="{{ bf[2] }}" download target="_blank" rel="noopener">
                {%- if bf[4] != blank -%}
                  <span class="osx-bonus-thumb"><img src="{{ bf[4] | asset_url }}" alt="{{ bf[0] | escape }}" loading="lazy"></span>
                {%- else -%}
                  <span class="osx-bonus-thumb osx-bonus-thumb--ic">📄</span>
                {%- endif -%}
                <span class="osx-bonus-type">{{ bf[3] | default: 'PDF' }}</span>
                <b>{{ bf[0] }}</b>
                {%- if bf[1] != blank -%}<span class="osx-bonus-desc">{{ bf[1] }}</span>{%- endif -%}
                <span class="osx-bonus-dl">Download <i>↓</i></span>
              </a>
            {%- endfor -%}
          {%- endif -%}

          {%- for b in bonus_blocks -%}
            <a class="osx-bonuscard" href="{{ b.settings.file_url | default: '#' }}" download target="_blank" rel="noopener" {{ b.shopify_attributes }}>
              {%- if b.settings.thumb != blank -%}
                <span class="osx-bonus-thumb"><img src="{{ b.settings.thumb | image_url: width: 600 }}" alt="{{ b.settings.title | escape }}" loading="lazy"></span>
              {%- else -%}
                <span class="osx-bonus-thumb osx-bonus-thumb--ic">📄</span>
              {%- endif -%}
              <span class="osx-bonus-type">{{ b.settings.badge | default: 'PDF' }}</span>
              <b>{{ b.settings.title | default: 'Free download' }}</b>
              {%- if b.settings.desc != blank -%}<span class="osx-bonus-desc">{{ b.settings.desc }}</span>{%- endif -%}
              <span class="osx-bonus-dl">Download <i>↓</i></span>
            </a>
          {%- endfor -%}
        </div>
      {%- else -%}
        <div class="osx-bonus-empty">
          <div class="osx-bonus-empty-ic">🎁</div>
          <b>Fresh freebies are on the way</b>
          <p>Downloadable guides, checklists and templates will land right here. Check back soon — new drops are added regularly.</p>
        </div>
      {%- endif -%}
    </section>

    {%- comment -%} ===== generic placeholder + embed frame ===== {%- endcomment -%}
    <section class="osx-view" data-view="__placeholder">
      <div class="osx-ph"><div class="osx-ph-ic">✦</div><h2 data-osx-ph-title>Coming together</h2><p>This part of your OS is being built. Check back very soon.</p></div>
    </section>
    <section class="osx-view" data-view="__locked">
      <div class="osx-ph"><div class="osx-ph-ic">🔒</div><h2 data-osx-lock-title>Locked</h2><p>You don't have access to this yet.</p><a class="osx-cta as-link" data-osx-get href="#">Get access →</a></div>
    </section>
    <iframe class="osx-frame" data-osx-frame title="Tool" hidden></iframe>
  </main>
</div>

{%- comment -%} Rule-based guided help widget (floating). Add to haus-links.liquid to put it site-wide. {%- endcomment -%}
{% render 'p2p-helper' %}

<style>
  #p2pos.osx{--text:#e7efeb;--muted:#8aa0a6;--gold:#c9a24a;--gold-bright:#f4c534;--stroke:rgba(255,255,255,.09);--gstroke:rgba(216,180,90,.38);
    --panel:#0b1620;--side:#081119;--emerald:#27ae6e;--teal:#39c5c0;--aurora:linear-gradient(100deg,#f4e2a6,#8f6fd6,#27ae6e,#39c5c0,#2563eb,#d6336c,#f4e2a6);
    display:grid;grid-template-columns:264px 1fr;gap:0;min-height:80vh;color:var(--text);font-family:system-ui,-apple-system,sans-serif;
    background:radial-gradient(120% 80% at 0% 0%,#0d1a26,#050a10);border:1px solid var(--stroke);border-radius:22px;overflow:hidden;}
  @keyframes p2pos-shift{0%{background-position:0% 50%;}100%{background-position:300% 50%;}}
  #p2pos .osx-2{background:var(--aurora);background-size:300% 100%;-webkit-background-clip:text;background-clip:text;color:transparent;animation:p2pos-shift 20s linear infinite;font-style:italic;}
  #p2pos .osx-burger{display:none;}

  /* sidebar */
  #p2pos .osx-side{background:linear-gradient(180deg,var(--side),#060d14);border-right:1px solid var(--stroke);padding:22px 14px;display:flex;flex-direction:column;gap:6px;}
  #p2pos .osx-brand{display:block;width:100%;text-align:left;background:none;border:0;border-bottom:1px solid var(--stroke);padding:6px 10px 16px;margin-bottom:10px;cursor:pointer;border-radius:8px 8px 0 0;transition:background .15s;}
  #p2pos .osx-brand:hover{background:rgba(255,255,255,.03);}
  #p2pos .osx-brandmark{font:700 19px/1.1 Georgia,serif;letter-spacing:.01em;color:var(--text);}
  #p2pos .osx-brandsub{margin-top:5px;font:600 9.5px/1.3 system-ui;letter-spacing:.03em;text-transform:uppercase;color:var(--muted);}
  #p2pos .osx-nav{display:flex;flex-direction:column;gap:3px;overflow-y:auto;}
  #p2pos .osx-item{display:flex;align-items:center;gap:11px;width:100%;padding:11px 12px;border:1px solid transparent;border-radius:11px;background:none;color:#cdd9dd;font:600 13.5px/1.2 system-ui;text-align:left;cursor:pointer;transition:background .15s,border-color .15s,color .15s;}
  #p2pos .osx-item:hover{background:rgba(255,255,255,.04);color:var(--text);}
  #p2pos .osx-item.on{background:linear-gradient(100deg,rgba(216,180,90,.16),rgba(143,111,214,.12));border-color:var(--gstroke);color:#fff;}
  #p2pos .osx-ico{flex:0 0 20px;height:20px;display:grid;place-items:center;}
  #p2pos .osx-ico svg{width:18px;height:18px;fill:none;stroke:var(--gold-bright);stroke-width:1.5;stroke-linecap:round;stroke-linejoin:round;}
  #p2pos .osx-item.locked .osx-ico svg{stroke:var(--muted);}
  #p2pos .osx-lbl{flex:1;min-width:0;}
  #p2pos .osx-lock{font-size:11px;opacity:.7;}

  /* main pane */
  #p2pos .osx-main{position:relative;overflow-y:auto;max-height:88vh;}
  #p2pos .osx-view{display:none;padding:30px 34px 44px;}
  #p2pos .osx-view.on{display:block;}
  #p2pos .osx-frame{width:100%;height:88vh;border:0;background:#0b1620;}

  /* hero */
  #p2pos .osx-hero{position:relative;border-radius:20px;overflow:hidden;padding:44px 36px;margin-bottom:24px;
    display:flex;gap:30px;align-items:center;flex-wrap:wrap;
    background:linear-gradient(120deg,rgba(143,111,214,.16),rgba(57,197,192,.08)),#0a141c;}
  #p2pos .osx-hero[style*="--hero"]{background:linear-gradient(180deg,rgba(5,10,16,.55),rgba(5,10,16,.82)),var(--hero) center/cover no-repeat;}
  #p2pos .osx-hero-glow{position:absolute;inset:-40% -10% auto -10%;height:60%;background:radial-gradient(50% 100% at 30% 0%,rgba(143,111,214,.5),transparent 70%),radial-gradient(50% 100% at 75% 10%,rgba(57,197,192,.4),transparent 70%);filter:blur(20px);opacity:.6;pointer-events:none;}
  #p2pos .osx-hero-in{position:relative;flex:1;min-width:280px;}
  /* personalized Brand DNA panel */
  #p2pos .osx-hero-dna{position:relative;flex:0 0 300px;max-width:340px;}
  #p2pos .osx-hero-dna.is-result{border:1px solid var(--gstroke);border-radius:18px;padding:16px;background:rgba(5,10,16,.5);backdrop-filter:blur(4px);}
  #p2pos .osx-hero-dna .dna-img{border-radius:12px;overflow:hidden;aspect-ratio:4/3;margin-bottom:12px;border:1px solid var(--stroke);}
  #p2pos .osx-hero-dna .dna-img img{width:100%;height:100%;object-fit:cover;display:block;}
  #p2pos .osx-hero-dna .dna-kick{font:700 10px/1 system-ui;letter-spacing:.16em;text-transform:uppercase;color:var(--gold);margin-bottom:6px;}
  #p2pos .osx-hero-dna .dna-name{font:700 22px/1.1 Georgia,serif;background:var(--aurora);background-size:300% 100%;-webkit-background-clip:text;background-clip:text;color:transparent;animation:p2pos-shift 20s linear infinite;}
  #p2pos .osx-hero-dna .dna-word{font:800 11px/1 system-ui;letter-spacing:.2em;text-transform:uppercase;color:var(--gold-bright);margin-top:5px;}
  #p2pos .osx-hero-dna .dna-traits{display:flex;flex-wrap:wrap;gap:6px;margin-top:11px;}
  #p2pos .osx-hero-dna .dna-trait{font:600 10.5px/1 system-ui;color:#dbe7e2;background:rgba(255,255,255,.06);border:1px solid var(--stroke);border-radius:20px;padding:6px 10px;}
  #p2pos .osx-hero-dna .dna-link{display:inline-block;margin-top:12px;font:700 11.5px/1 system-ui;color:var(--gold-bright);text-decoration:none;}
  #p2pos .osx-hero-dna .dna-link:hover{text-decoration:underline;}
  #p2pos .osx-hero-dna .dna-nudge{display:block;padding:20px 18px;border:1px dashed var(--gstroke);border-radius:16px;background:rgba(216,180,90,.06);text-decoration:none;text-align:center;transition:background .15s;}
  #p2pos .osx-hero-dna .dna-nudge:hover{background:rgba(216,180,90,.12);}
  #p2pos .osx-hero-dna .dna-nudge-ic{display:block;font-size:22px;margin-bottom:8px;color:var(--gold-bright);}
  #p2pos .osx-hero-dna .dna-nudge b{display:block;font:700 15px/1.2 Georgia,serif;color:var(--text);margin-bottom:6px;}
  #p2pos .osx-hero-dna .dna-nudge-sub{display:block;font:500 12px/1.4 system-ui;color:var(--muted);}
  @media (max-width:760px){#p2pos .osx-hero-dna{flex:1 1 100%;max-width:none;}}
  /* daily Mindset · Purpose · Heart carousel */
  #p2pos .osx-moments{margin-top:22px;border:1px solid var(--gstroke);border-radius:14px;padding:15px 18px;background:rgba(5,10,16,.45);}
  #p2pos .mo-title{font:700 10.5px/1.2 system-ui;letter-spacing:.05em;text-transform:uppercase;color:var(--gold);margin-bottom:9px;}
  #p2pos .mo-star{color:var(--gold-bright);}
  #p2pos .mo-grad{background:var(--aurora);background-size:300% 100%;-webkit-background-clip:text;background-clip:text;color:transparent;animation:p2pos-shift 20s linear infinite;}
  #p2pos .mo-text{font:italic 400 15px/1.5 Georgia,serif;color:var(--text);margin:0 0 7px;min-height:2.9em;}
  #p2pos .mo-source{font:600 11.5px/1.3 system-ui;color:var(--muted);font-style:normal;}
  #p2pos .mo-foot{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-top:12px;}
  #p2pos .mo-dots{display:flex;gap:7px;}
  #p2pos .mo-dot{width:7px;height:7px;border-radius:50%;border:0;padding:0;background:rgba(255,255,255,.22);cursor:pointer;transition:background .15s,transform .15s;}
  #p2pos .mo-dot.on{background:var(--gold-bright);transform:scale(1.25);}
  #p2pos .mo-dot:hover{background:rgba(255,255,255,.42);}
  #p2pos .mo-next{width:30px;height:30px;border-radius:50%;border:1px solid var(--stroke);background:rgba(255,255,255,.04);color:var(--gold-bright);font:700 18px/1 system-ui;cursor:pointer;transition:.15s;display:grid;place-items:center;}
  #p2pos .mo-next:hover{border-color:var(--gstroke);background:rgba(216,180,90,.1);}
  #p2pos .osx-eyebrow{font:700 11px/1 system-ui;letter-spacing:.2em;text-transform:uppercase;color:var(--gold);margin-bottom:12px;}
  #p2pos .osx-hero h1{font:700 clamp(28px,4.5vw,42px)/1.1 Georgia,serif;margin:0 0 12px;}
  #p2pos .osx-name{background:var(--aurora);background-size:300% 100%;-webkit-background-clip:text;background-clip:text;color:transparent;animation:p2pos-shift 20s linear infinite;}
  #p2pos .osx-hero-body{font:400 16px/1.6 system-ui;color:#dbe7e2;max-width:600px;margin:0 0 20px;}
  #p2pos .osx-cta{display:inline-block;padding:14px 28px;border:0;border-radius:12px;font:800 14px/1 system-ui;color:#0a1410;text-decoration:none;cursor:pointer;
    background:var(--aurora);background-size:300% 100%;animation:p2pos-shift 20s linear infinite;box-shadow:0 12px 30px rgba(0,0,0,.35);transition:transform .12s;}
  #p2pos .osx-cta:hover{transform:translateY(-2px);}
  #p2pos .osx-cta.as-link{margin-top:8px;}
  #p2pos .osx-hero-btns{display:flex;gap:12px;flex-wrap:wrap;}
  #p2pos .osx-cta.ghost{background:transparent;border:1px solid var(--gstroke);color:var(--gold-bright);box-shadow:none;animation:none;}
  #p2pos .osx-cta.ghost:hover{border-color:var(--gold-bright);background:rgba(216,180,90,.08);}

  /* stat strip */
  #p2pos .osx-stats{display:flex;align-items:center;gap:20px;flex-wrap:wrap;margin-bottom:26px;}
  #p2pos .osx-ring{flex:0 0 104px;width:104px;height:104px;border:0;padding:0;cursor:pointer;border-radius:50%;display:grid;place-items:center;background:conic-gradient(from -90deg,#39c5c0,#8f6fd6,#f4c534 calc(var(--p)*1%),rgba(255,255,255,.08) calc(var(--p)*1%));transition:transform .12s;}
  #p2pos .osx-ring:hover{transform:scale(1.03);}
  #p2pos .osx-ringin{width:80px;height:80px;border-radius:50%;background:var(--panel);display:grid;place-items:center;text-align:center;}
  #p2pos .osx-ringin b{font:800 20px/1 system-ui;color:var(--gold-bright);}
  #p2pos .osx-ringin small{display:block;margin-top:2px;font:600 8.5px/1 system-ui;letter-spacing:.06em;text-transform:uppercase;color:var(--muted);}
  #p2pos .osx-chips{display:grid;grid-template-columns:repeat(auto-fit,minmax(120px,1fr));gap:11px;flex:1;min-width:240px;}
  #p2pos .osx-chip{display:flex;align-items:center;gap:10px;padding:11px 13px;border:1px solid var(--stroke);border-radius:13px;background:rgba(255,255,255,.03);cursor:pointer;text-align:left;color:inherit;font:inherit;transition:border-color .15s,transform .12s,background .15s;}
  #p2pos .osx-chip:hover{border-color:var(--gstroke);background:rgba(216,180,90,.06);transform:translateY(-1px);}
  #p2pos .osx-cico{font-size:17px;}
  #p2pos .osx-chip b{display:block;font:800 18px/1 system-ui;color:var(--gold-bright);}
  #p2pos .osx-chip .p2pos-tier{font:700 14px/1.1 Georgia,serif;background:var(--aurora);background-size:300% 100%;-webkit-background-clip:text;background-clip:text;color:transparent;animation:p2pos-shift 20s linear infinite;}
  #p2pos .osx-chip small{display:block;margin-top:3px;font:600 9px/1 system-ui;letter-spacing:.03em;text-transform:uppercase;color:var(--muted);}

  /* blocks / kickers */
  #p2pos .osx-block{margin-bottom:26px;}
  #p2pos .osx-kick{font:700 12px/1 system-ui;letter-spacing:.06em;text-transform:uppercase;color:var(--muted);margin-bottom:14px;}

  /* gamified map */
  #p2pos .osx-map{display:flex;flex-wrap:wrap;gap:10px;}
  #p2pos .osx-node{position:relative;flex:1 1 150px;min-width:140px;padding:16px 14px;border:1px solid var(--stroke);border-radius:14px;background:linear-gradient(180deg,rgba(255,255,255,.03),rgba(9,17,24,.4));}
  #p2pos .osx-node.done{border-color:rgba(39,174,110,.5);background:linear-gradient(180deg,rgba(39,174,110,.12),rgba(9,17,24,.4));}
  #p2pos .osx-dot{display:grid;place-items:center;width:26px;height:26px;border-radius:50%;font:800 12px/1 system-ui;color:#0a1410;background:linear-gradient(145deg,#f4e2a6,var(--gold));margin-bottom:9px;}
  #p2pos .osx-node.done .osx-dot{background:var(--em,#27ae6e);color:#fff;}
  #p2pos .osx-nlbl{display:block;font:700 13.5px/1.2 system-ui;color:var(--text);}
  #p2pos .osx-nnote{display:block;margin-top:4px;font:400 11.5px/1.4 system-ui;color:var(--muted);}

  /* reassurance */
  #p2pos .osx-reassure{display:flex;gap:16px;align-items:flex-start;padding:20px 22px;border:1px solid var(--gstroke);border-radius:16px;margin-bottom:26px;background:linear-gradient(120deg,rgba(216,180,90,.1),rgba(57,197,192,.06));}
  #p2pos .osx-reassure-ic{flex:none;width:46px;height:46px;border-radius:50%;object-fit:cover;background:#0a1410;border:1px solid var(--gstroke);}
  #p2pos .osx-reassure b{font:700 18px/1.2 Georgia,serif;}
  #p2pos .osx-reassure p{margin:7px 0 10px;font:400 14px/1.6 system-ui;color:#dbe7e2;}
  #p2pos .osx-reassure-note{font:italic 500 13.5px/1.5 system-ui;color:var(--gold-bright);}

  /* faq */
  #p2pos .osx-faq{display:flex;flex-direction:column;gap:8px;}
  #p2pos .osx-faq details{border:1px solid var(--stroke);border-radius:12px;background:rgba(255,255,255,.02);overflow:hidden;}
  #p2pos .osx-faq summary{padding:14px 16px;font:600 13.5px/1.3 system-ui;cursor:pointer;list-style:none;}
  #p2pos .osx-faq summary::-webkit-details-marker{display:none;}
  #p2pos .osx-faq summary::after{content:'+';float:right;color:var(--gold);font-weight:800;}
  #p2pos .osx-faq details[open] summary::after{content:'–';}
  #p2pos .osx-fa{padding:0 16px 14px;font:400 13px/1.6 system-ui;color:#c6d6d0;}

  /* checkpoint */
  #p2pos .osx-h2{font:700 26px/1.15 Georgia,serif;margin:0 0 8px;}
  #p2pos .osx-lede{font:400 15px/1.6 system-ui;color:#c6d6d0;max-width:640px;margin:0 0 22px;}
  #p2pos .osx-check{border:1px solid var(--gstroke);border-radius:18px;padding:22px 24px;background:linear-gradient(180deg,rgba(216,180,90,.06),rgba(9,17,24,.4));margin-bottom:8px;}
  #p2pos .osx-check-top{display:flex;align-items:center;gap:14px;margin-bottom:16px;}
  #p2pos .osx-check-bar{flex:1;height:9px;border-radius:6px;background:rgba(255,255,255,.08);overflow:hidden;}
  #p2pos .osx-check-bar i{display:block;height:100%;border-radius:6px;background:linear-gradient(90deg,#39c5c0,#8f6fd6 55%,#f4c534);transition:width .35s ease;}
  #p2pos .osx-check-count{font:800 14px/1 system-ui;color:var(--gold-bright);white-space:nowrap;}
  #p2pos .osx-check-list{list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:4px;}
  #p2pos .osx-check-list label{display:flex;align-items:flex-start;gap:12px;padding:11px 12px;border-radius:11px;cursor:pointer;transition:background .15s;}
  #p2pos .osx-check-list label:hover{background:rgba(255,255,255,.03);}
  #p2pos .osx-check-list input{position:absolute;opacity:0;pointer-events:none;}
  #p2pos .osx-check-box{flex:0 0 20px;width:20px;height:20px;margin-top:1px;border:1.5px solid var(--stroke);border-radius:6px;position:relative;transition:background .15s,border-color .15s;}
  #p2pos .osx-check-list input:checked + .osx-check-box{background:var(--em,#27ae6e);border-color:var(--em,#27ae6e);}
  #p2pos .osx-check-list input:checked + .osx-check-box:after{content:"✓";position:absolute;inset:0;display:grid;place-items:center;font:800 11px/1 system-ui;color:#06120e;}
  #p2pos .osx-check-txt b{display:block;font:600 14px/1.35 system-ui;color:var(--text);}
  #p2pos .osx-check-list input:checked ~ .osx-check-txt b{color:var(--muted);text-decoration:line-through;}
  #p2pos .osx-check-txt i{display:block;margin-top:2px;font:400 12px/1.4 system-ui;font-style:normal;color:var(--muted);}
  #p2pos .osx-check-done{margin-top:14px;padding:14px 16px;border-radius:12px;background:linear-gradient(120deg,rgba(39,174,110,.18),rgba(57,197,192,.1));border:1px solid rgba(39,174,110,.4);font:400 14px/1.5 system-ui;color:#dbeee4;}
  #p2pos .osx-check-done b{color:#8be0b0;}
  #p2pos .osx-meet{display:grid;grid-template-columns:repeat(auto-fill,minmax(210px,1fr));gap:12px;}
  #p2pos .osx-meetcard{padding:16px 16px 18px;border:1px solid var(--stroke);border-radius:14px;background:linear-gradient(180deg,rgba(255,255,255,.03),rgba(9,17,24,.4));}
  #p2pos .osx-meic{font-size:22px;line-height:1;}
  #p2pos .osx-meetcard b{display:block;margin:10px 0 5px;font:700 14.5px/1.2 system-ui;}
  #p2pos .osx-meetcard p{margin:0;font:400 12.5px/1.5 system-ui;color:var(--muted);}

  /* ROOTED — Light the Path (the lit 6-stage trail) */
  #p2pos .osx-rooted{list-style:none;margin:0 0 26px;padding:0;position:relative;}
  #p2pos .osx-rooted::before{content:"";position:absolute;left:23px;top:24px;bottom:24px;width:2px;
    background:linear-gradient(180deg,#f4e2a6,#8f6fd6,#27ae6e,#39c5c0,#2563eb,#d6336c);opacity:.55;border-radius:2px;}
  #p2pos .osx-rstep{position:relative;display:flex;align-items:flex-start;gap:16px;padding:9px 0;}
  #p2pos .osx-rletter{position:relative;z-index:1;flex:0 0 48px;width:48px;height:48px;border-radius:50%;display:grid;place-items:center;
    font:800 20px/1 Georgia,serif;color:#0a1410;background:linear-gradient(145deg,#f4e2a6,var(--gold));
    box-shadow:0 0 0 4px #0a141c,0 8px 22px rgba(0,0,0,.45);}
  #p2pos .osx-rbody{padding-top:5px;}
  #p2pos .osx-rbody b{display:block;font:700 16px/1.2 Georgia,serif;color:var(--text);}
  #p2pos .osx-rbody span{display:block;margin-top:3px;font:400 13.5px/1.55 system-ui;color:#c6d6d0;max-width:52ch;}
  #p2pos .osx-rooted-cta{display:flex;gap:18px;align-items:flex-start;padding:22px 24px;border:1px solid var(--gstroke);border-radius:18px;
    background:linear-gradient(120deg,rgba(39,174,110,.12),rgba(57,197,192,.06));margin-bottom:14px;}
  #p2pos .osx-rooted-cta-ic{font-size:30px;line-height:1;}
  #p2pos .osx-rooted-cta-in b{font:700 17px/1.2 Georgia,serif;color:var(--text);}
  #p2pos .osx-rooted-cta-in p{margin:7px 0 14px;font:400 14px/1.6 system-ui;color:#dbe7e2;max-width:60ch;}
  #p2pos .osx-rooted-cta-in i{color:var(--gold-bright);font-style:italic;}
  #p2pos .osx-rooted-foot{font:400 13px/1.6 system-ui;color:var(--muted);margin:0;}
  #p2pos .osx-rooted-foot a{color:var(--gold-bright);text-decoration:none;font-weight:700;}
  #p2pos .osx-rooted-foot a:hover{text-decoration:underline;}

  /* Tools & Resources hub */
  #p2pos .osx-resgroup{margin-bottom:26px;}
  #p2pos .osx-reslabel{font:700 11px/1 system-ui;letter-spacing:.08em;text-transform:uppercase;color:var(--gold);margin-bottom:12px;}
  #p2pos .osx-resgrid{display:grid;grid-template-columns:repeat(auto-fill,minmax(240px,1fr));gap:12px;}
  #p2pos .osx-rescard{position:relative;display:block;width:100%;text-align:left;cursor:pointer;
    padding:18px 16px 18px;border:1px solid var(--stroke);border-radius:15px;background:linear-gradient(180deg,rgba(255,255,255,.03),rgba(9,17,24,.4));
    color:var(--text);text-decoration:none;transition:transform .15s ease,border-color .15s ease,background .15s ease;font:inherit;}
  #p2pos .osx-rescard:hover{transform:translateY(-2px);border-color:var(--gstroke);background:rgba(216,180,90,.06);}
  #p2pos .osx-rescard .osx-resic{font-size:22px;line-height:1;}
  #p2pos .osx-rescard b{display:block;margin:10px 0 4px;font:700 14.5px/1.2 system-ui;}
  #p2pos .osx-rescard > span:not(.osx-resic){display:block;font:400 12.5px/1.5 system-ui;color:var(--muted);max-width:30ch;}
  #p2pos .osx-rescard i{position:absolute;top:16px;right:16px;font-style:normal;font-weight:800;color:var(--gold-bright);opacity:.7;transition:transform .15s,opacity .15s;}
  #p2pos .osx-rescard:hover i{transform:translateX(3px);opacity:1;}
  #p2pos .osx-restips{display:flex;flex-direction:column;gap:8px;margin-bottom:16px;}
  #p2pos .osx-restips details{border:1px solid var(--stroke);border-radius:12px;background:rgba(255,255,255,.02);overflow:hidden;}
  #p2pos .osx-restips summary{padding:14px 16px;font:600 13.5px/1.3 system-ui;cursor:pointer;list-style:none;}
  #p2pos .osx-restips summary::-webkit-details-marker{display:none;}
  #p2pos .osx-restips summary::after{content:'+';float:right;color:var(--gold);font-weight:800;}
  #p2pos .osx-restips details[open] summary::after{content:'–';}
  #p2pos .osx-ressupport{display:flex;gap:13px;align-items:flex-start;padding:16px 18px;border:1px solid var(--gstroke);border-radius:14px;background:linear-gradient(120deg,rgba(216,180,90,.09),rgba(57,197,192,.05));}
  #p2pos .osx-ressupport-ic{font-size:20px;line-height:1.2;}
  #p2pos .osx-ressupport{font:400 13.5px/1.6 system-ui;color:#dbe7e2;}
  #p2pos .osx-ressupport a{color:var(--gold-bright);text-decoration:none;font-weight:700;}
  #p2pos .osx-ressupport a:hover{text-decoration:underline;}
  #p2pos .osx-ressupport small{color:var(--muted);font-size:12px;}

  /* Bonus Resources — downloadable freebies */
  #p2pos .osx-bonusgrid{display:grid;grid-template-columns:repeat(auto-fill,minmax(230px,1fr));gap:14px;}
  #p2pos .osx-bonuscard{position:relative;display:flex;flex-direction:column;padding:14px 14px 16px;border:1px solid var(--stroke);border-radius:16px;
    background:linear-gradient(180deg,rgba(255,255,255,.03),rgba(9,17,24,.4));color:var(--text);text-decoration:none;transition:transform .15s ease,border-color .15s ease;}
  #p2pos .osx-bonuscard:hover{transform:translateY(-3px);border-color:var(--gstroke);}
  #p2pos .osx-bonus-thumb{display:block;aspect-ratio:3/4;border-radius:11px;overflow:hidden;margin-bottom:12px;border:1px solid var(--stroke);background:linear-gradient(145deg,rgba(216,180,90,.14),rgba(57,197,192,.08));}
  #p2pos .osx-bonus-thumb img{width:100%;height:100%;object-fit:cover;object-position:center top;display:block;}
  #p2pos .osx-bonus-thumb--ic{display:grid;place-items:center;font-size:38px;}
  #p2pos .osx-bonus-type{align-self:flex-start;font:800 9.5px/1 system-ui;letter-spacing:.1em;text-transform:uppercase;color:#0a1410;background:linear-gradient(145deg,#f4e2a6,var(--gold));padding:5px 9px;border-radius:20px;margin-bottom:8px;}
  #p2pos .osx-bonuscard b{font:700 15px/1.25 system-ui;margin-bottom:4px;}
  #p2pos .osx-bonus-desc{font:400 12.5px/1.5 system-ui;color:var(--muted);flex:1;}
  #p2pos .osx-bonus-dl{margin-top:12px;font:800 12px/1 system-ui;color:var(--gold-bright);display:inline-flex;align-items:center;gap:6px;}
  #p2pos .osx-bonus-dl i{font-style:normal;transition:transform .15s;}
  #p2pos .osx-bonuscard:hover .osx-bonus-dl i{transform:translateY(2px);}
  #p2pos .osx-bonus-empty{max-width:460px;margin:36px auto;text-align:center;padding:34px 26px;border:1px dashed var(--gstroke);border-radius:18px;background:rgba(216,180,90,.05);}
  #p2pos .osx-bonus-empty-ic{font-size:38px;margin-bottom:12px;}
  #p2pos .osx-bonus-empty b{display:block;font:700 18px/1.2 Georgia,serif;color:var(--text);margin-bottom:6px;}
  #p2pos .osx-bonus-empty p{margin:0;font:400 13.5px/1.6 system-ui;color:var(--muted);}

  /* Your Vault — cross-Haus dashboard */
  #p2pos .osx-vault{margin-bottom:28px;}
  #p2pos .ov-head{margin-bottom:16px;}
  #p2pos .ov-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:14px;margin-bottom:14px;}
  #p2pos .ov-grid--two{grid-template-columns:repeat(auto-fit,minmax(240px,1fr));}
  #p2pos .ov-card{border:1px solid var(--stroke);border-radius:16px;padding:18px 18px 16px;background:linear-gradient(180deg,rgba(255,255,255,.03),rgba(9,17,24,.4));}
  #p2pos .ov-card-head{display:flex;align-items:center;gap:9px;margin-bottom:12px;font:700 13px/1 system-ui;color:var(--text);}
  #p2pos .ov-card-head .ov-ic{font-size:16px;}
  #p2pos .ov-card-head .ov-count{margin-left:auto;font:800 11px/1 system-ui;color:#0a1410;background:linear-gradient(145deg,#f4e2a6,var(--gold));padding:4px 8px;border-radius:20px;}
  #p2pos .ov-kit-name{font:700 16px/1.2 Georgia,serif;color:var(--gold-bright);margin-bottom:10px;}
  #p2pos .ov-swatches{display:flex;flex-wrap:wrap;gap:6px;margin-bottom:10px;}
  #p2pos .ov-swatch{width:22px;height:22px;border-radius:6px;border:1px solid rgba(255,255,255,.18);}
  #p2pos .ov-kit-voice{font:400 12.5px/1.5 system-ui;color:var(--muted);margin-bottom:12px;}
  #p2pos .ov-kit-voice i{color:#c6d6d0;font-style:italic;}
  #p2pos .ov-link{font:700 12px/1 system-ui;color:var(--gold-bright);text-decoration:none;}
  #p2pos .ov-link:hover{text-decoration:underline;}
  #p2pos .ov-recent-list{display:flex;flex-direction:column;gap:2px;}
  #p2pos .ov-recent-row{display:flex;align-items:center;gap:10px;padding:8px 8px;border-radius:9px;text-decoration:none;transition:background .15s;}
  #p2pos .ov-recent-row:hover{background:rgba(255,255,255,.04);}
  #p2pos .ov-chip{flex:0 0 auto;font:700 9.5px/1 system-ui;letter-spacing:.03em;text-transform:uppercase;color:var(--gold);background:rgba(216,180,90,.12);border:1px solid var(--gstroke);border-radius:20px;padding:5px 8px;}
  #p2pos .ov-recent-text{flex:1;min-width:0;font:500 13px/1.35 system-ui;color:#dbe7e2;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;}
  #p2pos .ov-recent-time{flex:0 0 auto;font:500 11px/1 system-ui;color:var(--muted);}
  #p2pos .ov-mini-list{display:flex;flex-direction:column;gap:6px;}
  #p2pos .ov-mini-row{display:block;padding:9px 11px;border:1px solid var(--stroke);border-radius:10px;text-decoration:none;transition:border-color .15s,background .15s;}
  #p2pos .ov-mini-row:hover{border-color:var(--gstroke);background:rgba(255,255,255,.03);}
  #p2pos .ov-mini-row b{display:block;font:700 13px/1.25 system-ui;color:var(--text);}
  #p2pos .ov-mini-row span{display:block;margin-top:2px;font:400 11.5px/1.4 system-ui;color:var(--muted);}
  #p2pos .ov-totals{display:flex;align-items:center;gap:14px;flex-wrap:wrap;padding:14px 18px;border:1px solid var(--stroke);border-radius:14px;background:rgba(255,255,255,.02);}
  #p2pos .ov-totals-lead{font:700 13px/1.3 system-ui;color:var(--text);}
  #p2pos .ov-total-chips{display:flex;flex-wrap:wrap;gap:8px;}
  #p2pos .ov-total-chip{display:flex;align-items:baseline;gap:6px;padding:6px 11px;border:1px solid var(--stroke);border-radius:20px;text-decoration:none;transition:border-color .15s;}
  #p2pos .ov-total-chip:hover{border-color:var(--gstroke);}
  #p2pos .ov-total-chip b{font:800 14px/1 system-ui;color:var(--gold-bright);}
  #p2pos .ov-total-chip span{font:600 11px/1 system-ui;color:var(--muted);}
  #p2pos .ov-empty{max-width:520px;margin:10px 0;padding:26px 24px;border:1px dashed var(--gstroke);border-radius:18px;background:rgba(216,180,90,.05);}
  #p2pos .ov-empty-ic{font-size:32px;margin-bottom:10px;}
  #p2pos .ov-empty b{display:block;font:700 17px/1.2 Georgia,serif;color:var(--text);margin-bottom:6px;}
  #p2pos .ov-empty p{margin:0 0 12px;font:400 13.5px/1.6 system-ui;color:var(--muted);}
  #p2pos .ov-empty-links a{font:700 12.5px/1 system-ui;color:var(--gold-bright);text-decoration:none;}
  #p2pos .ov-empty-links a:hover{text-decoration:underline;}

  /* Community */
  #p2pos .osx-community-embed{border:1px solid var(--stroke);border-radius:16px;overflow:hidden;background:#0b1620;}
  #p2pos .osx-community-embed iframe{width:100%;height:72vh;min-height:520px;border:0;display:block;}
  #p2pos .osx-community-ph{max-width:520px;margin:20px auto;text-align:center;padding:38px 28px;border:1px dashed var(--gstroke);border-radius:20px;background:rgba(57,197,192,.05);}
  #p2pos .osx-community-ph-ic{font-size:40px;margin-bottom:12px;}
  #p2pos .osx-community-ph b{display:block;font:700 20px/1.2 Georgia,serif;color:var(--text);margin-bottom:8px;}
  #p2pos .osx-community-ph p{margin:0 0 16px;font:400 14px/1.6 system-ui;color:var(--muted);}

  /* Haus Mates — Frank (Idea) & Ruth (Build) */
  #p2pos .osx-mates{display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));gap:20px;margin-bottom:18px;}
  #p2pos .osx-mate{position:relative;display:flex;flex-direction:column;align-items:center;text-align:center;gap:6px;
    padding:30px 26px 28px;border:1px solid var(--stroke);border-radius:22px;overflow:hidden;
    background:linear-gradient(180deg,rgba(255,255,255,.035),rgba(9,17,24,.45));transition:transform .18s ease,border-color .18s ease;}
  #p2pos .osx-mate:hover{transform:translateY(-3px);}
  #p2pos .osx-mate::before{content:"";position:absolute;inset:-40% -20% auto -20%;height:70%;filter:blur(34px);opacity:.55;pointer-events:none;z-index:0;}
  #p2pos .osx-mate--idea{border-color:rgba(58,86,150,.4);}
  #p2pos .osx-mate--idea::before{background:radial-gradient(60% 100% at 50% 0%,rgba(58,86,150,.7),transparent 70%),radial-gradient(50% 100% at 70% 0%,rgba(201,162,74,.5),transparent 70%);}
  #p2pos .osx-mate--idea:hover{border-color:rgba(84,120,196,.75);}
  #p2pos .osx-mate--build{border-color:rgba(122,40,72,.42);}
  #p2pos .osx-mate--build::before{background:radial-gradient(60% 100% at 50% 0%,rgba(122,40,72,.7),transparent 70%),radial-gradient(50% 100% at 70% 0%,rgba(201,162,74,.5),transparent 70%);}
  #p2pos .osx-mate--build:hover{border-color:rgba(163,58,96,.8);}
  #p2pos .osx-mate > *{position:relative;z-index:1;}
  #p2pos .osx-mate-badge{width:130px;height:130px;border-radius:50%;margin-bottom:6px;box-shadow:0 10px 34px rgba(0,0,0,.5);}
  #p2pos .osx-mate-badge img{width:100%;height:100%;border-radius:50%;object-fit:cover;display:block;}
  #p2pos .osx-mate-fallback{width:100%;height:100%;border-radius:50%;place-items:center;font:800 34px/1 Georgia,serif;color:#0a1410;background:linear-gradient(145deg,#f4e2a6,var(--gold));}
  #p2pos .osx-mate-kick{font:700 10px/1.1 system-ui;letter-spacing:.16em;text-transform:uppercase;color:var(--gold);}
  #p2pos .osx-mate-name{font:700 30px/1.05 Georgia,serif;margin:2px 0 0;
    background:var(--aurora);background-size:300% 100%;-webkit-background-clip:text;background-clip:text;color:transparent;animation:p2pos-shift 20s linear infinite;}
  #p2pos .osx-mate-haus{font:600 12.5px/1.4 system-ui;color:#dbe7e2;}
  #p2pos .osx-mate-haus i{color:var(--muted);font-style:italic;}
  #p2pos .osx-mate-dot{color:var(--gold);}
  #p2pos .osx-mate p{font:400 13.5px/1.6 system-ui;color:#c6d6d0;margin:8px 0 0;max-width:34ch;}
  #p2pos .osx-mate-for{font:400 12px/1.55 system-ui;color:var(--muted);margin-top:10px;max-width:36ch;}
  #p2pos .osx-mate-for b{color:var(--gold-bright);font-weight:700;}
  #p2pos .osx-mate-cta{display:inline-flex;align-items:center;gap:8px;margin-top:16px;padding:12px 24px;border-radius:11px;
    font:800 13px/1 system-ui;color:#0a1410;text-decoration:none;background:var(--aurora);background-size:300% 100%;
    animation:p2pos-shift 20s linear infinite;box-shadow:0 10px 26px rgba(0,0,0,.35);transition:transform .12s;}
  #p2pos .osx-mate-cta:hover{transform:translateY(-2px);}
  #p2pos .osx-mate-cta i{font-style:normal;transition:transform .15s;}
  #p2pos .osx-mate-cta:hover i{transform:translateX(3px);}
  #p2pos .osx-mate-note{font:400 12.5px/1.5 system-ui;color:var(--muted);text-align:center;margin-top:4px;}
  #p2pos .osx-mate-note::first-letter{color:var(--gold-bright);}
  @media (prefers-reduced-motion: reduce){#p2pos .osx-mate-name,#p2pos .osx-mate-cta{animation:none;}}

  /* external-site heads-up modal */
  #p2pos .osx-modal{position:fixed;inset:0;z-index:1100;display:grid;place-items:center;padding:20px;background:rgba(3,7,10,.66);backdrop-filter:blur(3px);}
  #p2pos .osx-modal[hidden]{display:none;}
  #p2pos .osx-modal-card{width:min(420px,100%);border:1px solid var(--gstroke);border-radius:20px;padding:28px 26px 24px;text-align:center;
    background:radial-gradient(120% 100% at 50% 0%,#0e1c28,#0a141c);box-shadow:0 24px 70px rgba(0,0,0,.6);}
  #p2pos .osx-modal-ic{width:48px;height:48px;margin:0 auto 14px;display:grid;place-items:center;border-radius:50%;font:800 22px/1 system-ui;color:#0a1410;
    background:var(--aurora);background-size:300% 100%;animation:p2pos-shift 20s linear infinite;}
  #p2pos .osx-modal-title{font:700 20px/1.2 Georgia,serif;margin:0 0 8px;color:var(--text);}
  #p2pos .osx-modal-body{font:400 14px/1.6 system-ui;color:#c6d6d0;margin:0 0 16px;}
  #p2pos .osx-modal-check{display:inline-flex;align-items:center;gap:9px;cursor:pointer;font:500 13px/1 system-ui;color:var(--muted);margin-bottom:20px;user-select:none;}
  #p2pos .osx-modal-check input{position:absolute;opacity:0;pointer-events:none;}
  #p2pos .osx-modal-cbx{flex:0 0 18px;width:18px;height:18px;border:1.5px solid var(--stroke);border-radius:5px;position:relative;transition:background .15s,border-color .15s;}
  #p2pos .osx-modal-check input:checked + .osx-modal-cbx{background:var(--emerald);border-color:var(--emerald);}
  #p2pos .osx-modal-check input:checked + .osx-modal-cbx:after{content:"✓";position:absolute;inset:0;display:grid;place-items:center;font:800 11px/1 system-ui;color:#06120e;}
  #p2pos .osx-modal-check input:focus-visible + .osx-modal-cbx{outline:2px solid var(--gold-bright);outline-offset:2px;}
  #p2pos .osx-modal-btns{display:flex;gap:10px;justify-content:center;flex-wrap:wrap;}
  #p2pos .osx-modal-cancel{cursor:pointer;padding:12px 20px;border-radius:11px;font:700 13px/1 system-ui;color:var(--muted);background:rgba(255,255,255,.05);border:1px solid var(--stroke);transition:.15s;}
  #p2pos .osx-modal-cancel:hover{color:var(--text);border-color:var(--gstroke);}
  #p2pos .osx-modal-go{display:inline-flex;align-items:center;gap:8px;cursor:pointer;padding:12px 24px;border-radius:11px;font:800 13px/1 system-ui;color:#0a1410;text-decoration:none;
    background:var(--aurora);background-size:300% 100%;animation:p2pos-shift 20s linear infinite;box-shadow:0 10px 26px rgba(0,0,0,.35);transition:transform .12s;}
  #p2pos .osx-modal-go:hover{transform:translateY(-2px);}
  #p2pos .osx-modal-go i{font-style:normal;}
  @media (prefers-reduced-motion: reduce){#p2pos .osx-modal-ic,#p2pos .osx-modal-go{animation:none;}}

  /* notebook (shared jr/je engine — ported from the Learning Journey) */
  #p2pos .jr-head{display:flex;align-items:flex-start;justify-content:space-between;gap:16px;flex-wrap:wrap;margin-bottom:4px;}
  #p2pos .jr-export-all{flex:none;font:700 12px/1 system-ui;color:var(--gold-bright);background:rgba(216,180,90,.1);border:1px solid var(--gstroke);border-radius:30px;padding:10px 16px;cursor:pointer;transition:.15s;}
  #p2pos .jr-export-all:hover{background:rgba(216,180,90,.18);}
  #p2pos .jr-tabs{display:flex;gap:8px;margin:18px 0;flex-wrap:wrap;}
  #p2pos .jr-tab{font:700 12px/1 system-ui;letter-spacing:.02em;color:var(--muted);background:rgba(255,255,255,.04);border:1px solid var(--stroke);border-radius:30px;padding:10px 16px;cursor:pointer;transition:.15s;}
  #p2pos .jr-tab:hover{color:var(--text);border-color:var(--gstroke);}
  #p2pos .jr-tab.on{color:#06120e;background:linear-gradient(145deg,#f4e2a6,var(--gold));border-color:transparent;}
  #p2pos .jr-pane[hidden]{display:none;}
  #p2pos .jr-compose{background:var(--panel);border:1px solid var(--stroke);border-radius:18px;padding:20px;margin-bottom:22px;}
  #p2pos .jr-title{width:100%;box-sizing:border-box;padding:11px 12px;border-radius:10px;font:700 14px/1 system-ui;color:var(--text);background:#0e1a20;border:1px solid var(--stroke);margin-bottom:12px;}
  #p2pos .jr-compose textarea{width:100%;box-sizing:border-box;padding:14px;border-radius:12px;font:400 15px/1.6 system-ui;color:var(--text);background:rgba(255,255,255,.05);border:1px solid var(--stroke);resize:vertical;outline:none;}
  #p2pos .jr-compose textarea:focus{border-color:var(--emerald);}
  #p2pos .jr-actions{display:flex;gap:10px;margin-top:14px;flex-wrap:wrap;}
  #p2pos .jr-save{cursor:pointer;border:0;padding:12px 22px;border-radius:11px;font:800 13px/1 system-ui;color:#06120e;background:linear-gradient(145deg,var(--emerald),var(--teal));}
  #p2pos .jr-toolbar{display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap;margin-bottom:14px;}
  #p2pos .jr-search{flex:1;min-width:180px;box-sizing:border-box;padding:10px 14px;border-radius:30px;font:600 13px/1 system-ui;color:var(--text);background:#0e1a20;border:1px solid var(--stroke);}
  #p2pos .jr-views{display:flex;gap:4px;background:rgba(255,255,255,.04);border:1px solid var(--stroke);border-radius:30px;padding:3px;}
  #p2pos .jr-view{font:700 11px/1 system-ui;color:var(--muted);background:none;border:0;border-radius:30px;padding:8px 13px;cursor:pointer;transition:.15s;}
  #p2pos .jr-view:hover{color:var(--text);}
  #p2pos .jr-view.on{color:#06120e;background:linear-gradient(145deg,#f4e2a6,var(--gold));}
  #p2pos .jr-list{display:flex;flex-direction:column;gap:12px;}
  #p2pos .jr-entry{background:rgba(255,255,255,.03);border:1px solid var(--stroke);border-radius:14px;padding:16px 18px;}
  #p2pos .jr-entry .je-top{display:flex;justify-content:space-between;align-items:baseline;gap:10px;margin-bottom:6px;}
  #p2pos .jr-entry .je-date{font:600 11px/1 system-ui;color:var(--muted);}
  #p2pos .jr-win .je-date{color:var(--gold-bright);}
  #p2pos .je-title{font:700 15px/1.25 system-ui;color:var(--gold-bright);margin:2px 0 4px;}
  #p2pos .jr-entry .je-prompt{font:700 13px/1.3 system-ui;color:var(--gold-bright);margin-bottom:6px;}
  #p2pos .jr-entry .je-text{font:400 14px/1.6 system-ui;color:#cfe0da;white-space:pre-wrap;}
  #p2pos .je-acts{display:flex;gap:6px;flex-wrap:wrap;}
  #p2pos .je-btn{font:700 11px/1 system-ui;color:var(--muted);background:rgba(255,255,255,.05);border:1px solid var(--stroke);border-radius:20px;padding:6px 11px;cursor:pointer;transition:.15s;}
  #p2pos .je-btn:hover{color:var(--text);border-color:var(--gstroke);}
  #p2pos .je-btn.je-restore:hover{color:var(--emerald);border-color:rgba(39,174,110,.5);}
  #p2pos .je-btn.je-del:hover{color:#ff9e9e;border-color:rgba(214,51,51,.45);}
  #p2pos .jr-empty{color:var(--muted);font:400 14px/1.5 system-ui;text-align:center;padding:24px;}

  /* placeholder / locked views */
  #p2pos .osx-ph{max-width:460px;margin:60px auto;text-align:center;}
  #p2pos .osx-ph-ic{font-size:40px;margin-bottom:14px;}
  #p2pos .osx-ph h2{font:700 24px/1.2 Georgia,serif;margin:0 0 8px;}
  #p2pos .osx-ph p{font:400 14px/1.6 system-ui;color:var(--muted);margin:0;}

  @media (prefers-reduced-motion: reduce){#p2pos .osx-2,#p2pos .osx-name,#p2pos .osx-cta,#p2pos .osx-chip .p2pos-tier{animation:none;}}
  @media (max-width:820px){
    #p2pos.osx{grid-template-columns:1fr;}
    #p2pos .osx-burger{display:flex;flex-direction:column;justify-content:center;gap:4px;position:absolute;top:14px;left:14px;z-index:6;width:40px;height:40px;border:1px solid var(--stroke);border-radius:10px;background:var(--side);cursor:pointer;}
    #p2pos .osx-burger span{display:block;height:2px;width:18px;margin:0 auto;background:var(--gold-bright);}
    #p2pos .osx-side{position:absolute;inset:0 auto 0 0;width:264px;z-index:5;transform:translateX(-100%);transition:transform .25s ease;box-shadow:0 0 40px rgba(0,0,0,.6);}
    #p2pos .osx-side.open{transform:translateX(0);}
    #p2pos .osx-view{padding:64px 20px 40px;}
  }
</style>

