  .osx-tour-back{background:none;border:1px solid rgba(255,255,255,.18);color:#c9e6da;border-radius:999px;padding:9px 16px;font:700 13px/1 system-ui;cursor:pointer;}
  .osx-tour-next{background:linear-gradient(100deg,#f4e2a6,#c9a24a);border:0;color:#0a1410;border-radius:999px;padding:10px 20px;font:800 13px/1 system-ui;cursor:pointer;margin-left:auto;}
  #p2pos .osx-side-card{border:1px solid var(--stroke);border-radius:16px;background:rgba(255,255,255,.03);padding:14px 15px;}
