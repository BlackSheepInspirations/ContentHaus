  #p2pos .osx-cw-tab.on{color:#0a1410;background:linear-gradient(100deg,#f4e2a6,#c9a24a);border-color:transparent;}
  #p2pos .osx-cw-feed{display:flex;flex-direction:column;gap:12px;min-height:340px;flex:1;}
  #p2pos .osx-cw-post{border:1px solid var(--stroke);border-radius:14px;padding:14px 16px;background:linear-gradient(180deg,rgba(255,255,255,.03),rgba(9,17,24,.4));}
  #p2pos .osx-cw-post.is-win{border-color:rgba(216,180,90,.5);background:linear-gradient(180deg,rgba(216,180,90,.08),rgba(9,17,24,.4));}
