{%- comment -%}
  Purpose 2 Profit — Operating System (member home base).
  A personalized hub: every tool shows as UNLOCKED (clickable) if the customer owns
  its access tag (or the all-access tag), or LOCKED with a "Get access" link if not.
  Gating matches every other Haus: customer.tags contains <access_tag>. Theme editor
  bypasses all gates (request.design_mode). Scoped to #p2pos.
{%- endcomment -%}

{%- assign all_tag = section.settings.all_access_tag | default: 'all-access' -%}
{%- assign owns_all = false -%}
{%- if customer and all_tag != blank and customer.tags contains all_tag -%}{%- assign owns_all = true -%}{%- endif -%}

{%- assign has_journey = owns_all -%}
{%- if customer and section.settings.journey_access_tag != blank and customer.tags contains section.settings.journey_access_tag -%}{%- assign has_journey = true -%}{%- endif -%}
{%- if request.design_mode -%}{%- assign has_journey = true -%}{%- assign owns_all = true -%}{%- endif -%}

<div id="p2pos">
  <header class="p2pos-hero">
    {%- if section.settings.eyebrow != blank -%}<div class="p2pos-eyebrow">{{ section.settings.eyebrow }}</div>{%- endif -%}
    <h1>{{ section.settings.title | default: 'Your Operating System' }}{%- if customer.first_name != blank -%}<span class="p2pos-name">, {{ customer.first_name }}</span>{%- endif -%}</h1>
    {%- if section.settings.intro != blank -%}<p class="p2pos-intro">{{ section.settings.intro }}</p>{%- endif -%}
  </header>

  {%- comment -%} ---- Continue the Learning Journey (owners) / unlock promo (non-owners) ---- {%- endcomment -%}
  {%- if section.settings.show_journey -%}
    {%- if has_journey -%}
      <section class="p2pos-journey" data-p2pos-journey>
        <div class="pj-copy">
          <div class="pj-kicker">✦ Learning Journey</div>
          <h2>{{ section.settings.journey_heading | default: 'Pick up where you left off' }}</h2>
          {%- if section.settings.show_stats -%}
          <div class="pj-stats" hidden data-p2pos-stats>
            <div class="pj-stat"><b class="p2pos-points">0</b><small>Points</small></div>
            <div class="pj-stat"><b class="p2pos-badges">0</b><small>Badges</small></div>
            <div class="pj-stat"><b class="p2pos-streak">0</b><small>Day streak</small></div>
            <div class="pj-stat"><b class="p2pos-tier">Dreamer</b><small>Merit tier</small></div>
          </div>
          {%- endif -%}
          <a class="pj-go" href="{{ section.settings.journey_url | default: '/pages/p2p-learning' }}">{{ section.settings.journey_cta | default: 'Continue your journey →' }}</a>
        </div>
        <div class="pj-art" aria-hidden="true"><div class="pj-aurora"></div><svg viewBox="0 0 24 24"><path d="M3 6l6-2 6 2 6-2v14l-6 2-6-2-6 2z"/><path d="M9 4v14M15 6v14"/></svg></div>
      </section>
    {%- else -%}
      <section class="p2pos-journey locked">
        <div class="pj-copy">
          <div class="pj-kicker">✦ Learning Journey</div>
          <h2>{{ section.settings.journey_locked_heading | default: 'Start the Learning Journey' }}</h2>
          <p class="pj-lockedbody">{{ section.settings.journey_locked_body | default: 'A gamified, step-by-step path from the shore all the way to a business that runs — courses, badges, streaks and more.' }}</p>
          {%- if section.settings.journey_get_url != blank -%}<a class="pj-go" href="{{ section.settings.journey_get_url }}">{{ section.settings.journey_get_label | default: 'Get access →' }}</a>{%- endif -%}
        </div>
        <div class="pj-art locked" aria-hidden="true"><span class="pj-lock">🔒</span></div>
      </section>
    {%- endif -%}
  {%- endif -%}

  {%- comment -%} ---- Your tools grid (gated per card) ---- {%- endcomment -%}
  {%- assign tool_blocks = section.blocks | where: 'type', 'tool' -%}
  {%- if tool_blocks.size > 0 -%}
    {%- if section.settings.tools_heading != blank -%}<h3 class="p2pos-secttl">{{ section.settings.tools_heading }}</h3>{%- endif -%}
    <div class="p2pos-grid">
      {%- for block in section.blocks -%}
        {%- if block.type == 'tool' -%}
          {%- assign owns = owns_all -%}
          {%- if customer and block.settings.access_tag != blank and customer.tags contains block.settings.access_tag -%}{%- assign owns = true -%}{%- endif -%}
          {%- if request.design_mode -%}{%- assign owns = true -%}{%- endif -%}
          {%- if owns -%}
            <a class="p2pos-card is-owned" href="{{ block.settings.url | default: '#' }}" {{ block.shopify_attributes }}>
          {%- else -%}
            <a class="p2pos-card is-locked" href="{{ block.settings.get_url | default: '#' }}" {{ block.shopify_attributes }}>
          {%- endif -%}
            <span class="pc-ico">
              {%- case block.settings.icon -%}
                {%- when 'prompt' -%}<svg viewBox="0 0 24 24"><path d="M4 5h16v11H8l-4 3z"/><path d="M8 9h8M8 12h5"/></svg>
                {%- when 'palette' -%}<svg viewBox="0 0 24 24"><path d="M12 3a9 9 0 100 18c1.5 0 2-1 2-2 0-1.3-1-1.5-1-2.5S14 15 15 15h2a4 4 0 004-4c0-4.4-4-8-9-8z"/><circle cx="7.5" cy="10.5" r="1"/><circle cx="12" cy="7.5" r="1"/><circle cx="16.5" cy="10.5" r="1"/></svg>
                {%- when 'megaphone' -%}<svg viewBox="0 0 24 24"><path d="M3 10v4h3l7 4V6l-7 4z"/><path d="M17 8a5 5 0 010 8"/></svg>
                {%- when 'box' -%}<svg viewBox="0 0 24 24"><path d="M12 3l8 4v10l-8 4-8-4V7z"/><path d="M4 7l8 4 8-4M12 11v10"/></svg>
                {%- when 'crown' -%}<svg viewBox="0 0 24 24"><path d="M4 8l4 4 4-6 4 6 4-4v9H4z"/></svg>
                {%- when 'rocket' -%}<svg viewBox="0 0 24 24"><path d="M12 3c4 2 6 6 6 10l-3 3H9l-3-3c0-4 2-8 6-10z"/><circle cx="12" cy="10" r="1.6"/><path d="M9 19l-2 2M15 19l2 2"/></svg>
                {%- when 'book' -%}<svg viewBox="0 0 24 24"><path d="M12 6C10 4.4 5.5 4.2 3.5 5.2v13.6c2-1 6.5-.8 8.5.8 2-1.6 6.5-1.8 8.5-.8V5.2C18.5 4.2 14 4.4 12 6z"/><path d="M12 6v13.6"/></svg>
                {%- else -%}<svg viewBox="0 0 24 24"><path d="M12 3l2.6 5.6 6.1.7-4.5 4.2 1.2 6L12 16.9 6.6 19.5l1.2-6L3.3 9.3l6.1-.7z"/></svg>
              {%- endcase -%}
            </span>
            <span class="pc-body">
              <span class="pc-title">{{ block.settings.title | default: 'Tool' }}</span>
              {%- if block.settings.blurb != blank -%}<span class="pc-blurb">{{ block.settings.blurb }}</span>{%- endif -%}
            </span>
            {%- if owns -%}
              <span class="pc-go">Open →</span>
            {%- else -%}
              <span class="pc-lock" aria-label="Locked">🔒<em>Get access</em></span>
            {%- endif -%}
          </a>
        {%- endif -%}
      {%- endfor -%}
    </div>
  {%- endif -%}

  {%- comment -%} ---- Help & resources ---- {%- endcomment -%}
  {%- assign has_help = false -%}
  {%- if section.settings.tutorial_url != blank or section.settings.milestones_url != blank or section.settings.support_url != blank or section.settings.support_email != blank -%}{%- assign has_help = true -%}{%- endif -%}
  {%- if has_help -%}
    <h3 class="p2pos-secttl">{{ section.settings.help_heading | default: 'Help & resources' }}</h3>
    <div class="p2pos-help">
      {%- if section.settings.tutorial_url != blank -%}<a class="ph-item" href="{{ section.settings.tutorial_url }}"><b>How it works</b><span>The full walkthrough</span></a>{%- endif -%}
      {%- if section.settings.milestones_url != blank -%}<a class="ph-item" href="{{ section.settings.milestones_url }}"><b>Milestones</b><span>Your badges & certificates</span></a>{%- endif -%}
      {%- if section.settings.support_url != blank -%}<a class="ph-item" href="{{ section.settings.support_url }}"><b>Support</b><span>Get help</span></a>
      {%- elsif section.settings.support_email != blank -%}<a class="ph-item" href="mailto:{{ section.settings.support_email }}"><b>Support</b><span>{{ section.settings.support_email }}</span></a>{%- endif -%}
    </div>
  {%- endif -%}
</div>

<style>
  #p2pos{--text:#e7efeb;--muted:#8aa0a6;--gold:#c9a24a;--gold-bright:#f4c534;--stroke:rgba(255,255,255,.09);--gstroke:rgba(216,180,90,.4);
    --aurora:linear-gradient(100deg,#f4e2a6,#8f6fd6,#27ae6e,#39c5c0,#2563eb,#d6336c,#f4e2a6);
    max-width:1080px;margin:0 auto;padding:40px 20px 64px;color:var(--text);font-family:system-ui,-apple-system,sans-serif;}
  @keyframes p2pos-shift{0%{background-position:0% 50%;}100%{background-position:300% 50%;}}
  #p2pos .p2pos-hero{margin-bottom:30px;}
  #p2pos .p2pos-eyebrow{font:700 12px/1 system-ui;letter-spacing:.2em;text-transform:uppercase;color:var(--gold);margin-bottom:12px;}
  #p2pos .p2pos-hero h1{font:700 clamp(28px,5vw,44px)/1.1 Georgia,serif;margin:0 0 10px;}
  #p2pos .p2pos-name{background:var(--aurora);background-size:300% 100%;-webkit-background-clip:text;background-clip:text;color:transparent;animation:p2pos-shift 18s linear infinite;}
  #p2pos .p2pos-intro{font:400 16px/1.6 system-ui;color:#c6d6d0;max-width:640px;margin:0;}

  #p2pos .p2pos-journey{display:grid;grid-template-columns:1fr 200px;gap:20px;align-items:center;margin:0 0 30px;
    border:1px solid var(--gstroke);border-radius:20px;padding:26px;background:linear-gradient(120deg,rgba(143,111,214,.14),rgba(57,197,192,.08));overflow:hidden;position:relative;}
  #p2pos .pj-kicker{font:700 11px/1 system-ui;letter-spacing:.16em;text-transform:uppercase;color:var(--gold);margin-bottom:8px;}
  #p2pos .p2pos-journey h2{font:700 24px/1.15 Georgia,serif;margin:0 0 14px;}
  #p2pos .pj-lockedbody{font:400 14px/1.6 system-ui;color:#c6d6d0;margin:0 0 16px;max-width:520px;}
  #p2pos .pj-stats{display:flex;flex-wrap:wrap;gap:22px;margin:0 0 18px;}
  #p2pos .pj-stat b{display:block;font:800 22px/1 system-ui;color:var(--gold-bright);}
  #p2pos .pj-stat .p2pos-tier{font:700 18px/1.1 Georgia,serif;background:var(--aurora);background-size:300% 100%;-webkit-background-clip:text;background-clip:text;color:transparent;animation:p2pos-shift 18s linear infinite;}
  #p2pos .pj-stat small{display:block;margin-top:5px;font:600 10.5px/1 system-ui;letter-spacing:.02em;text-transform:uppercase;color:var(--muted);}
  #p2pos .pj-go{display:inline-block;padding:13px 24px;border-radius:12px;font:800 14px/1 system-ui;color:#0a1410;text-decoration:none;
    background:var(--aurora);background-size:300% 100%;animation:p2pos-shift 18s linear infinite;box-shadow:0 12px 30px rgba(0,0,0,.3);transition:transform .12s;}
  #p2pos .pj-go:hover{transform:translateY(-2px);}
  #p2pos .pj-art{position:relative;display:grid;place-items:center;height:130px;}
  #p2pos .pj-art svg{width:64px;height:64px;fill:none;stroke:var(--gold-bright);stroke-width:1.3;position:relative;z-index:2;}
  #p2pos .pj-aurora{position:absolute;inset:0;background:radial-gradient(circle at 50% 45%,rgba(244,197,52,.35),transparent 65%);filter:blur(8px);}
  #p2pos .p2pos-journey.locked{background:linear-gradient(120deg,rgba(255,255,255,.03),rgba(9,17,24,.4));border-color:var(--stroke);}
  #p2pos .pj-art.locked .pj-lock{font-size:44px;opacity:.5;}

  #p2pos .p2pos-secttl{font:700 13px/1 system-ui;letter-spacing:.06em;text-transform:uppercase;color:var(--muted);margin:26px 0 14px;}
  #p2pos .p2pos-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(250px,1fr));gap:14px;}
  #p2pos .p2pos-card{display:flex;align-items:center;gap:14px;padding:18px;border:1px solid var(--stroke);border-radius:16px;text-decoration:none;color:var(--text);
    background:linear-gradient(180deg,rgba(255,255,255,.03),rgba(9,17,24,.35));transition:transform .12s,border-color .18s,box-shadow .18s;}
  #p2pos .p2pos-card:hover{transform:translateY(-2px);border-color:var(--gstroke);box-shadow:0 12px 28px rgba(0,0,0,.35);}
  #p2pos .p2pos-card.is-locked{opacity:.72;}
  #p2pos .p2pos-card.is-locked:hover{opacity:1;}
  #p2pos .pc-ico{flex:0 0 46px;width:46px;height:46px;border-radius:12px;display:grid;place-items:center;background:radial-gradient(circle at 40% 30%,#1c2b31,#0a1216);border:1px solid var(--gstroke);}
  #p2pos .pc-ico svg{width:24px;height:24px;fill:none;stroke:var(--gold-bright);stroke-width:1.4;stroke-linecap:round;stroke-linejoin:round;}
  #p2pos .p2pos-card.is-locked .pc-ico svg{stroke:var(--muted);}
  #p2pos .pc-body{flex:1;min-width:0;}
  #p2pos .pc-title{display:block;font:700 15px/1.2 system-ui;}
  #p2pos .pc-blurb{display:block;margin-top:4px;font:400 12.5px/1.4 system-ui;color:var(--muted);}
  #p2pos .pc-go{font:800 12.5px/1 system-ui;color:var(--gold-bright);white-space:nowrap;}
  #p2pos .pc-lock{display:flex;flex-direction:column;align-items:center;gap:3px;font-size:16px;white-space:nowrap;}
  #p2pos .pc-lock em{font:700 9.5px/1 system-ui;font-style:normal;letter-spacing:.04em;text-transform:uppercase;color:var(--gold);}

  #p2pos .p2pos-help{display:grid;grid-template-columns:repeat(auto-fill,minmax(180px,1fr));gap:12px;}
  #p2pos .ph-item{padding:14px 16px;border:1px solid var(--stroke);border-radius:12px;text-decoration:none;background:rgba(255,255,255,.02);transition:border-color .18s;}
  #p2pos .ph-item:hover{border-color:var(--gstroke);}
  #p2pos .ph-item b{display:block;font:700 13.5px/1.2 system-ui;color:var(--text);}
  #p2pos .ph-item span{display:block;margin-top:3px;font:400 12px/1.3 system-ui;color:var(--muted);}
  @media (prefers-reduced-motion: reduce){#p2pos .p2pos-name,#p2pos .pj-go,#p2pos .pj-stat .p2pos-tier{animation:none;}}
  @media (max-width:620px){#p2pos .p2pos-journey{grid-template-columns:1fr;}#p2pos .pj-art{height:90px;}}
</style>

{%- if section.settings.show_journey and section.settings.show_stats and has_journey -%}
<script src="{{ 'p2p-progress.js' | asset_url }}" defer="defer"></script>
<script>
  document.addEventListener('DOMContentLoaded', function(){
    var root = document.getElementById('p2pos'); if(!root || !window.P2P) return;
    var wrap = root.querySelector('[data-p2pos-stats]'); if(!wrap) return;
    function put(cls, val){ var el = root.querySelector(cls); if(el) el.textContent = val; }
    put('.p2pos-points', window.P2P.points());
    var bs = window.P2P.badgesStat(); put('.p2pos-badges', bs ? bs.earned : window.P2P.earnedSet().length);
    put('.p2pos-streak', window.P2P.streak().count);
    if(window.P2P.tier) put('.p2pos-tier', window.P2P.tier().name);
    wrap.hidden = false;
  });
</script>
{%- endif -%}

{% schema %}
{
  "name": "P2P Operating System",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Purpose 2 Profit" },
    { "type": "text", "id": "title", "label": "Title", "default": "Your Operating System" },
    { "type": "textarea", "id": "intro", "label": "Intro", "default": "Your home base — everything you own, in one place. Jump back into your journey, open your tools, and keep building." },
    { "type": "header", "content": "Access" },
    { "type": "text", "id": "all_access_tag", "label": "All-access tag", "info": "Customers with this tag unlock every card. Add it via a Shopify Flow on your all-access bundle.", "default": "all-access" },
    { "type": "header", "content": "Learning Journey module" },
    { "type": "checkbox", "id": "show_journey", "label": "Show the Journey module", "default": true },
    { "type": "checkbox", "id": "show_stats", "label": "Show live stats (points/badges/streak/tier)", "default": true },
    { "type": "text", "id": "journey_access_tag", "label": "Journey access tag", "default": "p2p-learning" },
    { "type": "url", "id": "journey_url", "label": "Journey page URL" },
    { "type": "text", "id": "journey_heading", "label": "Heading (owners)", "default": "Pick up where you left off" },
    { "type": "text", "id": "journey_cta", "label": "Button label (owners)", "default": "Continue your journey →" },
    { "type": "text", "id": "journey_locked_heading", "label": "Heading (non-owners)", "default": "Start the Learning Journey" },
    { "type": "textarea", "id": "journey_locked_body", "label": "Body (non-owners)", "default": "A gamified, step-by-step path from the shore all the way to a business that runs — courses, badges, streaks and more." },
    { "type": "url", "id": "journey_get_url", "label": "Get-access URL (non-owners)" },
    { "type": "text", "id": "journey_get_label", "label": "Get-access label", "default": "Get access →" },
    { "type": "header", "content": "Tools grid" },
    { "type": "text", "id": "tools_heading", "label": "Tools heading", "default": "Your tools" },
    { "type": "header", "content": "Help & resources" },
    { "type": "text", "id": "help_heading", "label": "Help heading", "default": "Help & resources" },
    { "type": "url", "id": "tutorial_url", "label": "Tutorial page URL" },
    { "type": "url", "id": "milestones_url", "label": "Milestones (badges) URL" },
    { "type": "url", "id": "support_url", "label": "Support page URL" },
    { "type": "text", "id": "support_email", "label": "Support email", "info": "Used if no support page URL is set." }
  ],
  "blocks": [
    {
      "type": "tool",
      "name": "Tool",
      "settings": [
        { "type": "text", "id": "title", "label": "Title" },
        { "type": "text", "id": "blurb", "label": "Blurb" },
        { "type": "select", "id": "icon", "label": "Icon", "default": "sparkle", "options": [
          { "value": "sparkle", "label": "Sparkle" },
          { "value": "prompt", "label": "Prompt / chat" },
          { "value": "palette", "label": "Palette (graphics)" },
          { "value": "megaphone", "label": "Megaphone (marketing)" },
          { "value": "box", "label": "Box (product)" },
          { "value": "crown", "label": "Crown (brand)" },
          { "value": "rocket", "label": "Rocket" },
          { "value": "book", "label": "Book (journey)" }
        ] },
        { "type": "text", "id": "access_tag", "label": "Access tag", "info": "The customer tag that unlocks this tool (e.g. graphics-haus-access)." },
        { "type": "url", "id": "url", "label": "Tool URL (when unlocked)" },
        { "type": "url", "id": "get_url", "label": "Get-access URL (when locked)", "info": "Your marketing/preview page for this tool." }
      ]
    }
  ],
  "presets": [
    {
      "name": "P2P Operating System",
      "blocks": [
        { "type": "tool", "settings": { "title": "Prompt Haus", "blurb": "Your AI prompt studio.", "icon": "prompt", "access_tag": "prompt-haus-access" } },
        { "type": "tool", "settings": { "title": "Prompt to Profit Haus", "blurb": "Turn prompts into products.", "icon": "rocket", "access_tag": "P2P-haus-access" } },
        { "type": "tool", "settings": { "title": "Graphics Haus", "blurb": "Brand kits & design.", "icon": "palette", "access_tag": "graphics-haus-access" } },
        { "type": "tool", "settings": { "title": "Marketing Haus", "blurb": "Ads, posts & campaigns.", "icon": "megaphone", "access_tag": "marketing-haus-access" } },
        { "type": "tool", "settings": { "title": "Product Haus", "blurb": "Build & ship products.", "icon": "box", "access_tag": "product-haus-access" } },
        { "type": "tool", "settings": { "title": "Brand Haus", "blurb": "Define your brand DNA.", "icon": "crown", "access_tag": "brand-haus-access" } }
      ]
    }
  ]
}
{% endschema %}
