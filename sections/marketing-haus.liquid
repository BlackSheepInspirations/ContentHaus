{% comment %}
  The AI Creator's Marketing Haus — main tool section.
  Gated on customer.tags contains "marketing-haus-access" (added by its own
  Shopify Flow automation on order paid — separate product/tag from
  Prompt Haus's own access control, so the two are independently
  purchasable). request.design_mode bypasses the gate inside the theme
  editor only.
{% endcomment %}

{% assign mh_has_access = false %}
{% if customer and customer.tags contains section.settings.access_tag %}
  {% assign mh_has_access = true %}
{% endif %}
{% if request.design_mode %}
  {% assign mh_has_access = true %}
{% endif %}
{% comment %} master all-access tag unlocks every Haus {% endcomment %}
{% if customer and customer.tags contains 'all-access' %}
  {% assign mh_has_access = true %}
{% endif %}

{{ 'marketing-haus.css' | asset_url | stylesheet_tag }}

{% comment %}
  Rendered as a sibling of #marketing-haus-app, never inside it — the JS
  does root.innerHTML = "" on every re-render.
{% endcomment %}
<div class="mh-brand-header">
  <div class="mh-marketing__hero">
    <p class="mh-marketing__eyebrow">{{ section.settings.brand_eyebrow }}</p>
    <h1 class="mh-marketing__heading">{{ section.settings.brand_heading | replace: 'Marketing', '<span class="mh-heading-accent">Marketing</span>' }}</h1>
    <div class="mh-marketing__subheading">{{ section.settings.brand_subheading }}</div>
  </div>
</div>

{% if mh_has_access %}
  <div id="marketing-haus-app" data-section-id="{{ section.id }}"></div>

  <script src="{{ 'marketing-haus-util.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'marketing-haus-engine.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'marketing-haus-favorites.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'marketing-haus-styledna.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'marketing-haus-brandkit.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'marketing-haus-looklock.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'marketing-haus-customerprofiles.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'marketing-haus-mockup.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'marketing-haus-social.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'marketing-haus-adcopy.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'marketing-haus-email.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'marketing-haus-sales.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'marketing-haus-testimonial.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'marketing-haus-generators.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'marketing-haus-generators-flyer.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'marketing-haus-generators-infographic.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'marketing-haus-generators-pinterestpin.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'marketing-haus-generators-quotegraphic.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'marketing-haus-generators-leadmagnet.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'marketing-haus-generators-productad.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'marketing-haus-generators-videomotion.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'marketing-haus-generators-videoscript.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'marketing-haus-generators-mediakit.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'marketing-haus-generators-socialcover.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'marketing-haus-generators-posttemplate.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'marketing-haus-generators-digitalelements.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'marketing-haus-generators-thankyoucard.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'marketing-haus-generators-giftmessage.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'marketing-haus-generators-videoadbundle.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'marketing-haus-generators-launchbundle.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'marketing-haus-generators-seocopy.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'marketing-haus-generators-suno.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'marketing-haus-generators-tagshashtags.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'marketing-haus-generators-geooptimization.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'marketing-haus-generators-productlisting.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'marketing-haus-generators-creativedirection.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'marketing-haus-generators-herobanner.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'marketing-haus-generators-listingimage.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'marketing-haus-customerintel.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'marketing-haus-ui.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'p2p-launch-prefill.js' | asset_url }}" defer="defer"></script>
{% else %}
  <div class="mh-locked">
    <h2 class="mh-locked__heading">{{ section.settings.locked_heading | replace: 'Marketing', '<span class="mh-heading-accent">Marketing</span>' }}</h2>
    <div class="mh-locked__body">{{ section.settings.locked_body }}</div>
    <div class="mh-locked__actions">
      {% if section.settings.access_product %}
        <a href="{{ section.settings.access_product.url }}" class="mh-btn mh-btn--copy">
          Get Access{% if section.settings.access_product.price %} — {{ section.settings.access_product.price | money }}{% endif %}
        </a>
      {% endif %}
      {% if section.settings.learn_more_url != blank %}
        <a href="{{ section.settings.learn_more_url }}" class="mh-btn mh-btn--reset mh-locked__learn-more">Learn more</a>
      {% endif %}
    </div>
  </div>
{% endif %}

{% render 'haus-links', current: 'marketing-haus' %}

{% schema %}
{
  "name": "Marketing Haus Builder",
  "settings": [
    {
      "type": "text",
      "id": "brand_eyebrow",
      "label": "Eyebrow text",
      "default": "Black Sheep Creations & Inspirations"
    },
    {
      "type": "text",
      "id": "brand_heading",
      "label": "Heading",
      "default": "The Marketing Haus"
    },
    {
      "type": "textarea",
      "id": "brand_subheading",
      "label": "Subheading",
      "default": "Create the mockups, posts, ads, emails, and marketing content around your brand. Customized your way."
    },
    {
      "type": "text",
      "id": "access_tag",
      "label": "Access tag",
      "default": "marketing-haus-access",
      "info": "Customer tag that unlocks the tool. Must match the tag your Shopify Flow automation adds on purchase."
    },
    {
      "type": "product",
      "id": "access_product",
      "label": "Access product",
      "info": "Shown as the \"Get Access\" button for shoppers who don't have the tag yet."
    },
    {
      "type": "url",
      "id": "learn_more_url",
      "label": "Learn more link",
      "info": "e.g. link to your Marketing Haus marketing page."
    },
    {
      "type": "text",
      "id": "locked_heading",
      "label": "Locked state heading",
      "default": "Unlock The Marketing Haus"
    },
    {
      "type": "richtext",
      "id": "locked_body",
      "label": "Locked state body",
      "default": "<p>Get instant access to Product Mockup Studio, Social Media Studio, Ad Copy, Email, Sales Copy, and the Testimonial Formatter — create marketing content across every channel in one place.</p>"
    }
  ],
  "presets": [
    {
      "name": "Marketing Haus Builder"
    }
  ]
}
{% endschema %}
