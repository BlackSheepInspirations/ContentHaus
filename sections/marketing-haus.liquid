{% else %}
  <div class="mh-locked">
    <h2 class="mh-locked__heading">{{ section.settings.locked_heading | replace: 'Marketing', '<span class="mh-heading-accent">Marketing</span>' }}</h2>
    <div class="mh-locked__body">{{ section.settings.locked_body }}</div>
    <div class="mh-locked__actions">
      {% if section.settings.access_product %}
        <a href="{{ section.settings.access_product.url }}" class="mh-btn mh-btn--copy">
          Get Access{% if section.settings.access_product.price %} — {{ section.settings.access_product.price | money }}{% endif %}
        </a>
      {% endif %}
      {% if section.settings.learn_more_url != blank %}
        <a href="{{ section.settings.learn_more_url }}" class="mh-btn mh-btn--reset mh-locked__learn-more">Learn more</a>
      {% endif %}
    </div>
  </div>
{% endif %}

{% render 'haus-links', current: 'marketing-haus' %}

{% schema %}
{
  "name": "Marketing Haus Builder",
  "settings": [
    {
      "type": "text",
      "id": "brand_eyebrow",
      "label": "Eyebrow text",
      "default": "Black Sheep Creations & Inspirations"
    },
    {
      "type": "text",
      "id": "brand_heading",
      "label": "Heading",
      "default": "The Marketing Haus"
    },
    {
      "type": "textarea",
      "id": "brand_subheading",
      "label": "Subheading",
      "default": "Create the mockups, posts, ads, emails, and marketing content around your brand. Customized your way."
    },
    {
      "type": "text",
      "id": "access_tag",
      "label": "Access tag",
      "default": "marketing-haus-access",
      "info": "Customer tag that unlocks the tool. Must match the tag your Shopify Flow automation adds on purchase."
    },
    {
      "type": "product",
      "id": "access_product",
      "label": "Access product",
      "info": "Shown as the \"Get Access\" button for shoppers who don't have the tag yet."
    },
    {
      "type": "url",
      "id": "learn_more_url",
      "label": "Learn more link",
      "info": "e.g. link to your Marketing Haus marketing page."
    },
    {
      "type": "text",
      "id": "locked_heading",
      "label": "Locked state heading",
      "default": "Unlock The Marketing Haus"
    },
    {
      "type": "richtext",
      "id": "locked_body",
      "label": "Locked state body",
      "default": "<p>Get instant access to Product Mockup Studio, Social Media Studio, Ad Copy, Email, Sales Copy, and the Testimonial Formatter — create marketing content across every channel in one place.</p>"
    }
  ],
  "presets": [
    {
      "name": "Marketing Haus Builder"
    }
  ]
}
{% endschema %}
