{% comment %}
  The AI Creator's Graphics Haus — main tool section.
  Gated on customer.tags contains "graphics-haus-access" (added by its own
  Shopify Flow automation on order paid — separate product/tag from every
  sibling Haus's own access control, so each is independently purchasable).
  request.design_mode bypasses the gate inside the theme editor only.
{% endcomment %}

{% assign gh_has_access = false %}
{% if customer and customer.tags contains section.settings.access_tag %}
  {% assign gh_has_access = true %}
{% endif %}
{% if request.design_mode %}
  {% assign gh_has_access = true %}
{% endif %}
{% comment %} master all-access tag unlocks every Haus {% endcomment %}
{% if customer and customer.tags contains 'all-access' %}
  {% assign gh_has_access = true %}
{% endif %}

{{ 'graphics-haus.css' | asset_url | stylesheet_tag }}
{{ 'haus-design-system.css' | asset_url | stylesheet_tag }}

{% comment %}
  Rendered as a sibling of #graphics-haus-app, never inside it — the JS
  does root.innerHTML = "" on every re-render. Shared design-system hero
  (docs/haus-design-system.md) — same black-opal aurora as every Haus.
{% endcomment %}
<div class="gh-brand-header haus--graphics hds-hero">
  <div class="hds-hero__inner">
    <p class="hds-hero__eyebrow">{{ section.settings.brand_eyebrow }}</p>
    <div class="hds-hero__grid">
      <div class="hds-hero__intro">
        <h1 class="hds-hero__title">{{ section.settings.brand_heading | replace: 'Graphics', '<span class="accent">Graphics</span>' }}</h1>
        <div class="hds-hero__desc">{{ section.settings.brand_subheading }}</div>
      </div>
      <div class="hds-hero__media">
        <div class="hds-hero__frame">
          <video id="ghHowToVideo" class="hds-hero__video" controls preload="metadata" poster="{{ 'how-to-graphics-poster.jpg' | asset_url }}">
            <source src="{{ 'how-to-graphics.mp4' | asset_url }}" type="video/mp4">
          </video>
          <div class="hds-hero__ph" id="ghHowToPlaceholder" hidden>
            <span class="hds-hero__play" aria-hidden="true">&#9654;</span>
            <p class="hds-hero__ph-title">Tutorial coming soon</p>
            <p class="hds-hero__ph-note">A quick how-to for this studio</p>
          </div>
        </div>
        <p class="hds-hero__caption">Watch: design a graphic in about 60 seconds.</p>
      </div>
    </div>
  </div>
  <script>
    (function(){var v=document.getElementById('ghHowToVideo'),ph=document.getElementById('ghHowToPlaceholder');if(!v||!ph)return;var s=v.querySelector('source');function show(){if(ph.hidden){ph.hidden=false;v.style.display='none';}}if(s)s.addEventListener('error',show);v.addEventListener('error',show);setTimeout(function(){if(!v.readyState)show();},2500);})();
  </script>
</div>

{% if gh_has_access %}
  <div id="graphics-haus-app" class="haus--graphics" data-section-id="{{ section.id }}"></div>

  <script src="{{ 'graphics-haus-util.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'graphics-haus-engine.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'graphics-haus-favorites.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'graphics-haus-styledna.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'graphics-haus-brandkit.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'graphics-haus-looklock.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'graphics-haus-mascotlock.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'graphics-haus-generators.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'graphics-haus-generators-clipartpack.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'graphics-haus-generators-seasonalanimal.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'graphics-haus-generators-fauxtextile.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'graphics-haus-generators-retroicon.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'graphics-haus-generators-licenseplate.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'graphics-haus-generators-vanityplate.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'graphics-haus-generators-mascot.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'graphics-haus-generators-graphicsstudio.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'graphics-haus-combined.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'graphics-haus-reference.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'graphics-haus-collection.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'graphics-haus-ui.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'p2p-launch-prefill.js' | asset_url }}" defer="defer"></script>
{% else %}
  <div class="gh-locked">
    <h2 class="gh-locked__heading">{{ section.settings.locked_heading | replace: 'Graphics', '<span class="gh-heading-accent">Graphics</span>' }}</h2>
    <div class="gh-locked__body">{{ section.settings.locked_body }}</div>
    <div class="gh-locked__actions">
      {% if section.settings.access_product %}
        <a href="{{ section.settings.access_product.url }}" class="gh-btn gh-btn--copy">
          Get Access{% if section.settings.access_product.price %} — {{ section.settings.access_product.price | money }}{% endif %}
        </a>
      {% endif %}
      {% if section.settings.learn_more_url != blank %}
        <a href="{{ section.settings.learn_more_url }}" class="gh-btn gh-btn--reset gh-locked__learn-more">Learn more</a>
      {% endif %}
    </div>
  </div>
{% endif %}

{% render 'haus-links', current: 'graphics-haus' %}

{% schema %}
{
  "name": "Graphics Haus Builder",
  "settings": [
    {
      "type": "text",
      "id": "brand_eyebrow",
      "label": "Eyebrow text",
      "default": "Black Sheep Creations & Inspirations"
    },
    {
      "type": "text",
      "id": "brand_heading",
      "label": "Heading",
      "default": "The Graphics Haus"
    },
    {
      "type": "textarea",
      "id": "brand_subheading",
      "label": "Subheading",
      "default": "Build the clipart, characters, and printable graphics your shop sells — clean, on-theme, and consistent across every set."
    },
    {
      "type": "text",
      "id": "access_tag",
      "label": "Access tag",
      "default": "graphics-haus-access",
      "info": "Customer tag that unlocks the tool. Must match the tag your Shopify Flow automation adds on purchase."
    },
    {
      "type": "product",
      "id": "access_product",
      "label": "Access product",
      "info": "Shown as the \"Get Access\" button for shoppers who don't have the tag yet."
    },
    {
      "type": "url",
      "id": "learn_more_url",
      "label": "Learn more link",
      "info": "e.g. link to your Graphics Haus marketing page."
    },
    {
      "type": "text",
      "id": "locked_heading",
      "label": "Locked state heading",
      "default": "Unlock The Graphics Haus"
    },
    {
      "type": "richtext",
      "id": "locked_body",
      "label": "Locked state body",
      "default": "<p>Get instant access to the full Graphics Haus generator grid — clipart packs, seasonal cute animals, faux textile characters, retro object icons, and license plates, all built to share one consistent look.</p>"
    }
  ],
  "presets": [
    {
      "name": "Graphics Haus Builder"
    }
  ]
}
{% endschema %}
