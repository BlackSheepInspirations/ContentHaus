{% comment %}
  Cross-product navigation — one pill per sibling Haus product, shown at
  the bottom of every Haus tool page. Each pill checks the visiting
  customer's own tags for THAT product's access tag: if they already
  own it, the pill goes straight to the tool; if not, it goes to that
  product's own preview/marketing page instead — never straight to a
  gated page they can't actually use. Coming Soon items always link to
  their preview page since there's no tool to gate yet.

  Two groups: "Haus Tools" (the 6 live/purchasable products) and
  "Coming Soon" (Curriculum Haus + its GPT companion).

  Usage: {% render 'haus-links', current: 'brand-haus' %}
  `current` excludes that one entry — a product doesn't link to itself.
  Valid values: 'p2p-haus', 'brand-haus', 'content-haus', 'marketing-haus',
  'product-haus', 'graphics-haus', 'idea-haus-gpt', 'curriculum-haus',
  'curriculum-haus-gpt'.
{% endcomment %}
{% assign haus_current = current | default: '' %}

<div class="haus-links">
  <p class="haus-links__label">Haus Tools</p>
  <div class="haus-links__row">
    {% unless haus_current == 'p2p-haus' %}
      {% if customer and customer.tags contains 'P2P-haus-access' %}
        <a href="/pages/p2p-haus" class="haus-links__pill haus-links__pill--crown">Prompt to Profit Haus</a>
      {% else %}
        <a href="/pages/p2p-haus-preview" class="haus-links__pill haus-links__pill--crown">Prompt to Profit Haus</a>
      {% endif %}
    {% endunless %}

    {% unless haus_current == 'content-haus' %}
      {% if customer and customer.tags contains 'prompt-haus-access' %}
        <a href="/pages/content-haus" class="haus-links__pill">Content Haus</a>
      {% else %}
        <a href="/pages/content-haus-preview" class="haus-links__pill">Content Haus</a>
      {% endif %}
    {% endunless %}

    {% unless haus_current == 'marketing-haus' %}
      {% if customer and customer.tags contains 'marketing-haus-access' %}
        <a href="/pages/marketing-haus" class="haus-links__pill">Marketing Haus</a>
      {% else %}
        <a href="/pages/marketing-haus-preview" class="haus-links__pill">Marketing Haus</a>
      {% endif %}
    {% endunless %}

    {% unless haus_current == 'product-haus' %}
      {% if customer and customer.tags contains 'product-haus-access' %}
        <a href="/pages/product-haus" class="haus-links__pill">Project Haus</a>
      {% else %}
        <a href="/pages/product-haus-preview" class="haus-links__pill">Project Haus</a>
      {% endif %}
    {% endunless %}

    {% unless haus_current == 'graphics-haus' %}
      {% if customer and customer.tags contains 'graphics-haus-access' %}
        <a href="/pages/graphics-haus" class="haus-links__pill">Graphics Haus</a>
      {% else %}
        <a href="/pages/graphics-haus-preview" class="haus-links__pill">Graphics Haus</a>
      {% endif %}
    {% endunless %}

    {% unless haus_current == 'brand-haus' %}
      {% if customer and customer.tags contains 'brand-haus-access' %}
        <a href="/pages/brand-haus" class="haus-links__pill">Brand Haus</a>
      {% else %}
        <a href="/pages/brand-haus-preview" class="haus-links__pill">Brand Haus</a>
      {% endif %}
    {% endunless %}

    {% unless haus_current == 'idea-haus-gpt' %}
      {% if customer and customer.tags contains 'idea-haus-access' %}
        <a href="https://chatgpt.com/g/g-6a489ad05ac48191a7692939b09fc6f1-the-idea-haus" target="_blank" rel="noopener" class="haus-links__pill">Idea Haus: GPT</a>
      {% else %}
        <a href="/pages/idea-haus-custom-gpt" class="haus-links__pill">Idea Haus: GPT</a>
      {% endif %}
    {% endunless %}
  </div>

  <p class="haus-links__label haus-links__label--soon">Coming Soon</p>
  <div class="haus-links__row">
    {% unless haus_current == 'curriculum-haus' %}
      <a href="/pages/curriculum-haus-preview" class="haus-links__pill haus-links__pill--soon">Curriculum Haus</a>
    {% endunless %}

    {% unless haus_current == 'curriculum-haus-gpt' %}
      <a href="/pages/curriculum-haus-preview" class="haus-links__pill haus-links__pill--soon">Curriculum Haus: GPT</a>
    {% endunless %}
  </div>
</div>

<style>
  .haus-links {
    max-width: 1360px;
    margin: 0 auto;
    padding: 24px 16px 40px;
    text-align: left;
  }
  .haus-links__label {
    font-size: 12px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: rgba(46, 42, 38, 0.55);
    margin: 0 0 10px;
  }
  .haus-links__label--soon {
    margin-top: 20px;
  }
  .haus-links__row {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  .haus-links__pill {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 8px 16px;
    border-radius: 999px;
    border: 1px solid rgba(46, 42, 38, 0.2);
    background: #fff;
    color: #1A1815;
    font-size: 13px;
    font-weight: 600;
    text-decoration: none;
    transition: border-color 0.15s, background 0.15s;
  }
  .haus-links__pill:hover {
    border-color: rgba(46, 42, 38, 0.4);
    background: rgba(46, 42, 38, 0.04);
  }
  .haus-links__pill--soon {
    opacity: 0.6;
  }
  /* The crown jewel — a small black-opal gem dot before the label. */
  .haus-links__pill--crown {
    border-color: rgba(30, 142, 90, 0.45);
    font-weight: 700;
  }
  .haus-links__pill--crown::before {
    content: "";
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: linear-gradient(100deg, #27ae6e, #0d7377 35%, #2563eb 55%, #5b3c8c 72%, #d6336c 88%, #c9a84c);
    box-shadow: 0 0 0 1px rgba(0, 0, 0, 0.06);
  }
  .haus-links__pill--crown:hover {
    border-color: rgba(30, 142, 90, 0.75);
    background: rgba(30, 142, 90, 0.05);
  }
</style>
