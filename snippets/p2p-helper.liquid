{% comment %}
  Purpose 2 Profit — Haus Helper (rule-based guided help widget).

  A floating helper that answers the common "where do I go / how do I start /
  I'm stuck" questions with a scripted decision tree — NO AI, no API, no cost.
  Pure client-side. Every path ends with a way to reach a human, so a confused
  member never dead-ends (the "stop a bad review" safety net).

  Self-contained + scoped to #p2phelp (fixed position, so it can be rendered
  anywhere). Currently rendered on the OS page; add `{% render 'p2p-helper' %}`
  to snippets/haus-links.liquid to put it on every Haus page too.

  Edit the knowledge base in the NODES object below — plain data, no code needed.
{% endcomment %}

<div id="p2phelp" data-p2phelp>
  <button class="p2ph-launch" type="button" data-p2ph-launch aria-label="Open the Haus Helper">
    <img class="p2ph-launch-ic" src="{{ 'bsc-sheep-mark.png' | asset_url }}" alt="" aria-hidden="true" width="24" height="24">
    <span class="p2ph-launch-lbl">Need help?</span>
  </button>

  <div class="p2ph-panel" data-p2ph-panel hidden role="dialog" aria-label="Haus Helper">
    <div class="p2ph-head">
      <div class="p2ph-head-l">
        <img class="p2ph-avatar" src="{{ 'bsc-sheep-mark.png' | asset_url }}" alt="" aria-hidden="true">
        <div><b>Haus Helper</b><small>Quick answers, no waiting</small></div>
      </div>
      <button class="p2ph-close" type="button" data-p2ph-close aria-label="Close">✕</button>
    </div>
    <div class="p2ph-log" data-p2ph-log></div>
    <div class="p2ph-foot">
      <a href="mailto:{{ shop.email | default: 'Hello@blacksheepcreations.com' }}">Still stuck? Talk to a human →</a>
    </div>
  </div>
</div>

<style>
  #p2phelp{--hg:#f4c534;--hgs:rgba(216,180,90,.38);--hstroke:rgba(255,255,255,.1);--hmuted:#8aa0a6;
    font-family:system-ui,-apple-system,sans-serif;}
  #p2phelp .p2ph-launch{position:fixed;right:22px;bottom:22px;z-index:1200;display:inline-flex;align-items:center;gap:9px;
    padding:12px 18px 12px 14px;border:1px solid var(--hgs);border-radius:40px;cursor:pointer;
    background:linear-gradient(180deg,#0d1a24,#081019);color:#e7efeb;font:700 14px/1 system-ui;
    box-shadow:0 10px 28px rgba(0,0,0,.4);transition:transform .14s ease,box-shadow .14s ease;}
  #p2phelp .p2ph-launch:hover{transform:translateY(-2px);box-shadow:0 14px 34px rgba(0,0,0,.5);}
  #p2phelp .p2ph-launch-ic{width:24px;height:24px;border-radius:50%;object-fit:cover;display:block;background:#0a1410;}
  #p2phelp.is-open .p2ph-launch{transform:scale(.9);opacity:0;pointer-events:none;}

  #p2phelp .p2ph-panel{position:fixed;right:22px;bottom:22px;z-index:1201;width:min(370px,calc(100vw - 32px));
    max-height:min(560px,calc(100vh - 120px));display:flex;flex-direction:column;overflow:hidden;
    border:1px solid var(--hgs);border-radius:20px;background:radial-gradient(120% 80% at 100% 0%,#0e1c28,#070f16);
    box-shadow:0 24px 70px rgba(0,0,0,.6);animation:p2ph-in .18s ease;}
  #p2phelp .p2ph-panel[hidden]{display:none;}
  @keyframes p2ph-in{from{transform:translateY(12px);opacity:0;}to{transform:translateY(0);opacity:1;}}
  #p2phelp .p2ph-head{display:flex;align-items:center;justify-content:space-between;gap:10px;padding:15px 16px;border-bottom:1px solid var(--hstroke);
    background:linear-gradient(100deg,rgba(216,180,90,.14),rgba(143,111,214,.1));}
  #p2phelp .p2ph-head-l{display:flex;align-items:center;gap:11px;}
  #p2phelp .p2ph-avatar{width:38px;height:38px;border-radius:50%;object-fit:cover;display:block;background:#0a1410;border:1px solid var(--hstroke);}
  #p2phelp .p2ph-head b{display:block;font:700 15px/1.1 system-ui;color:#e7efeb;}
  #p2phelp .p2ph-head small{font:500 11.5px/1.2 system-ui;color:var(--hmuted);}
  #p2phelp .p2ph-close{border:0;background:rgba(255,255,255,.06);color:#cdd9dd;width:30px;height:30px;border-radius:50%;cursor:pointer;font:700 13px/1 system-ui;transition:background .15s;}
  #p2phelp .p2ph-close:hover{background:rgba(255,255,255,.12);}
  #p2phelp .p2ph-log{flex:1;overflow-y:auto;padding:16px;display:flex;flex-direction:column;gap:10px;}
  #p2phelp .p2ph-bot,#p2phelp .p2ph-user{max-width:88%;padding:11px 14px;border-radius:14px;font:400 13.5px/1.5 system-ui;}
  #p2phelp .p2ph-bot{align-self:flex-start;background:rgba(255,255,255,.05);border:1px solid var(--hstroke);color:#dbe7e2;border-bottom-left-radius:5px;}
  #p2phelp .p2ph-bot strong{color:var(--hg);}
  #p2phelp .p2ph-user{align-self:flex-end;background:linear-gradient(145deg,#f4e2a6,#c9a24a);color:#0a1410;font-weight:600;border-bottom-right-radius:5px;}
  #p2phelp .p2ph-opts{display:flex;flex-direction:column;gap:7px;margin-top:2px;}
  #p2phelp .p2ph-opt{text-align:left;padding:10px 13px;border:1px solid var(--hgs);border-radius:11px;background:rgba(216,180,90,.06);
    color:#f4e2c0;font:600 13px/1.35 system-ui;cursor:pointer;text-decoration:none;display:block;transition:background .14s,border-color .14s;}
  #p2phelp .p2ph-opt:hover{background:rgba(216,180,90,.14);border-color:var(--hg);}
  #p2phelp .p2ph-opt.is-link::after{content:" ↗";color:var(--hmuted);}
  #p2phelp .p2ph-foot{padding:11px 16px;border-top:1px solid var(--hstroke);text-align:center;}
  #p2phelp .p2ph-foot a{font:600 12px/1 system-ui;color:var(--hg);text-decoration:none;}
  #p2phelp .p2ph-foot a:hover{text-decoration:underline;}

  @media (max-width:600px){
    #p2phelp .p2ph-launch{right:14px;bottom:76px;padding:11px 15px;}
    #p2phelp .p2ph-launch-lbl{display:none;}
    #p2phelp .p2ph-panel{right:10px;left:10px;bottom:76px;width:auto;max-height:calc(100vh - 150px);}
  }
  @media (prefers-reduced-motion:reduce){#p2phelp .p2ph-panel{animation:none;}}
</style>

<script>
  (function(){
    var root = document.getElementById('p2phelp'); if(!root) return;
    var launch = root.querySelector('[data-p2ph-launch]');
    var panel = root.querySelector('[data-p2ph-panel]');
    var closeBtn = root.querySelector('[data-p2ph-close]');
    var log = root.querySelector('[data-p2ph-log]');

    // ---- Knowledge base: plain data. `to` = go to another node; `url` = open a link. ----
    var SUPPORT = {{ shop.email | default: 'Hello@blacksheepcreations.com' | json }};
    var NODES = {
      root: { msg: "Hi! I'm your **Haus Helper** 🐑 Pick what you need and I'll point you the right way.", opts: [
        { t: "Which Haus should I use?", to: "which" },
        { t: "How do I get started?", to: "start" },
        { t: "Is this for me?", to: "fit" },
        { t: "Get better results from the tools", to: "tips" },
        { t: "What's ROOTED?", to: "rooted" },
        { t: "Billing, account & access", to: "billing" },
        { t: "Meet Frank & Ruth", to: "mates" }
      ]},
      which: { msg: "What are you trying to do right now?", opts: [
        { t: "Figure out my brand", to: "w_brand" },
        { t: "Write content or copy", to: "w_content" },
        { t: "Make graphics or visuals", to: "w_graphics" },
        { t: "Build a product", to: "w_project" },
        { t: "Market or promote it", to: "w_marketing" },
        { t: "Launch or scale", to: "w_growth" },
        { t: "Learn the whole method", to: "w_learn" },
        { t: "← Back", to: "root" }
      ]},
      w_brand: { msg: "Start in **Brand Haus** — it defines your Brand DNA (voice, colours, values) so everything else you make sounds like you.", opts: [
        { t: "Take the Founders Assessment", url: "/pages/brand-haus?bh_focus=1" },
        { t: "Open Brand Haus", url: "/pages/brand-haus" }, { t: "← Back", to: "which" } ]},
      w_content: { msg: "That's **Content Haus** — prompts and copy that carry your voice everywhere you show up.", opts: [
        { t: "Open Content Haus", url: "/pages/content-haus" }, { t: "← Back", to: "which" } ]},
      w_graphics: { msg: "Head to **Graphics Haus** — on-brand visuals and design without the degree.", opts: [
        { t: "Open Graphics Haus", url: "/pages/graphics-haus" }, { t: "← Back", to: "which" } ]},
      w_project: { msg: "That's **Project Haus** — turn the idea into a real product, step by step.", opts: [
        { t: "Open Project Haus", url: "/pages/project-haus" }, { t: "← Back", to: "which" } ]},
      w_marketing: { msg: "**Marketing Haus** — posts, ads and campaigns that get you seen.", opts: [
        { t: "Open Marketing Haus", url: "/pages/marketing-haus" }, { t: "← Back", to: "which" } ]},
      w_growth: { msg: "**Growth Haus** — generators that run the ROOTED launch method and scale what works.", opts: [
        { t: "Open Growth Haus", url: "/pages/growth-haus" }, { t: "What's ROOTED?", to: "rooted" }, { t: "← Back", to: "which" } ]},
      w_learn: { msg: "Your **Learning Journey** is the gamified course map — realms, courses and badges that teach the whole thing, one step at a time.", opts: [
        { t: "Enter the Learning Journey", url: "/pages/p2p-learning" }, { t: "← Back", to: "which" } ]},
      start: { msg: "Great place to begin! Work top-to-bottom down your sidebar: take the **Founders Assessment**, lock your Brand DNA, then Content → Graphics → Project → Marketing, and launch with ROOTED. One step at a time.", opts: [
        { t: "Take the Founders Assessment", url: "/pages/brand-haus?bh_focus=1" },
        { t: "Enter the Learning Journey", url: "/pages/p2p-learning" }, { t: "← Back", to: "root" } ]},
      tips: { msg: "Three quick wins for any generator: **1)** be specific, **2)** say who it's for, **3)** show an example of what “good” looks like. Small concrete details beat long vague ones every time.", opts: [
        { t: "More in Tools & Resources", url: "/pages/p2p-os?v=tools" }, { t: "← Back", to: "root" } ]},
      rooted: { msg: "**ROOTED** is your 6-stage launch method — Reach, Open, Offer, Trigger, Escalate, Deepen. It carries you from ready to launched, and the full course lives in the Evergreens realm.", opts: [
        { t: "See the ROOTED path", url: "/pages/p2p-os?v=rooted" }, { t: "← Back", to: "root" } ]},
      mates: { msg: "**Frank** (Idea Haus) sparks and sharpens ideas; **Ruth** (Build Haus) makes them sellable. They're your AI partners — open either any time you're stuck.", opts: [
        { t: "Meet your Haus Mates", url: "/pages/p2p-os?v=mates" }, { t: "← Back", to: "root" } ]},
      access: { msg: "Login or access hiccup? It's almost always a billing blip — updating your payment info usually restores access right away. If not, email us and we'll sort it fast.", opts: [
        { t: "Update payment / email support", url: "mailto:" + SUPPORT }, { t: "← Back", to: "billing" } ]},
      fit: { msg: "Purpose 2 Profit is built for creators and sellers who want to go from idea to income — especially if you're not techy. Everything is plain language, one step at a time, with help all the way. If you can follow a recipe, you can do this.", opts: [
        { t: "How do I get started?", to: "start" }, { t: "Which Haus should I use?", to: "which" }, { t: "← Back", to: "root" } ]},
      billing: { msg: "Billing, account, or access — what do you need a hand with?", opts: [
        { t: "What's included / my plan", to: "included" },
        { t: "Login or access problem", to: "access" },
        { t: "Something's not working", to: "tech" },
        { t: "Cancel or change my plan", to: "cancel" },
        { t: "Refunds", to: "refunds" },
        { t: "← Back", to: "root" } ]},
      included: { msg: "Each Haus is its own tool you can unlock, and the Learning Journey is the full step-by-step course path. For exactly what's in your plan and current pricing, the clearest answer is on that Haus's page — or just ask us and we'll spell it out.", opts: [
        { t: "Email us", url: "mailto:" + SUPPORT }, { t: "← Back", to: "billing" } ]},
      tech: { msg: "Sorry about that! Quick fixes that solve most things: refresh the page, try a different browser, or sign out and back in — your progress is saved to your account, not the browser. Still stuck? Tell us what you were doing and we'll jump on it.", opts: [
        { t: "Email support", url: "mailto:" + SUPPORT }, { t: "← Back", to: "billing" } ]},
      cancel: { msg: "You're always in control — no hoops. To cancel or change a plan, sign in to your account, or email us and we'll take care of it for you.", opts: [
        { t: "Email us", url: "mailto:" + SUPPORT }, { t: "← Back", to: "billing" } ]},
      refunds: { msg: "For anything to do with refunds or a billing question, the fastest path is to email us with your account email — a real person will look after it personally.", opts: [
        { t: "Email support", url: "mailto:" + SUPPORT }, { t: "← Back", to: "billing" } ]}
    };

    function fmt(s){ return String(s).replace(/\*\*(.+?)\*\*/g, "<strong>$1</strong>"); }
    function scroll(){ log.scrollTop = log.scrollHeight; }
    function addBot(node){
      var b = document.createElement("div"); b.className = "p2ph-bot"; b.innerHTML = fmt(node.msg); log.appendChild(b);
      var wrap = document.createElement("div"); wrap.className = "p2ph-opts";
      (node.opts || []).forEach(function(o){
        var el;
        if(o.url){ el = document.createElement("a"); el.className = "p2ph-opt is-link"; el.href = o.url;
          if(o.url.indexOf("mailto:") !== 0){ el.target = "_top"; } }
        else { el = document.createElement("button"); el.type = "button"; el.className = "p2ph-opt"; }
        el.textContent = o.t;
        if(o.to){ el.addEventListener("click", function(){ addUser(o.t); go(o.to); }); }
        wrap.appendChild(el);
      });
      log.appendChild(wrap); scroll();
    }
    function addUser(t){ var u = document.createElement("div"); u.className = "p2ph-user"; u.textContent = t; log.appendChild(u); scroll(); }
    function go(id){ var n = NODES[id] || NODES.root; addBot(n); }

    var started = false;
    function open(){ root.classList.add("is-open"); panel.hidden = false; if(!started){ started = true; go("root"); } }
    function close(){ root.classList.remove("is-open"); panel.hidden = true; }
    launch.addEventListener("click", open);
    closeBtn.addEventListener("click", close);
    document.addEventListener("keydown", function(e){ if(e.key === "Escape" && !panel.hidden) close(); });
  })();
</script>
